FROM golang:1.26.4-bookworm AS builder

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git unzip wget && \
    rm -rf /var/lib/apt/lists/*

ENV PIXI_HOME=/opt/pixi
ENV PATH="${PIXI_HOME}/bin:${PATH}"
RUN curl -fsSL https://pixi.sh/install.sh -o /tmp/pixi-install.sh && \
    PIXI_VERSION=v0.81.0 PIXI_HOME=${PIXI_HOME} PIXI_NO_PATH_UPDATE=1 \
    sh /tmp/pixi-install.sh && rm /tmp/pixi-install.sh

# This development image intentionally builds the MatrixOne + cuVS Go
# workspace. Its CUDA/RAPIDS dependencies still come only from MO's Pixi lock.
WORKDIR /app
COPY matrixone matrixone
COPY cuvs cuvs
COPY go.work .
COPY go.work.sum .

ARG GOPROXY="https://proxy.golang.org,direct"
RUN go env -w GOPROXY=${GOPROXY}
RUN cd matrixone && \
    module_files="$(sha256sum go.mod go.sum ../go.work ../go.work.sum)" && \
    go mod download && \
    test "$module_files" = "$(sha256sum go.mod go.sum ../go.work ../go.work.sum)"

RUN cd matrixone/optools/gpu && \
    pixi run --frozen make -C ../.. MO_CL_CUDA=1 -j8

RUN mkdir -p /gpu-runtime && \
    cp -a matrixone/optools/gpu/.pixi/envs/default/lib/*.so* /gpu-runtime/ && \
    cp -a matrixone/optools/gpu/.pixi/envs/default/targets/x86_64-linux/lib/*.so* /gpu-runtime/ && \
    test -z "$(find /gpu-runtime -maxdepth 1 \
      \( -name 'libcuda.so*' -o -name 'libnvidia-*' \) -print -quit)"

FROM ubuntu:24.04

COPY --from=builder /app/matrixone/mo-service /mo-service
COPY --from=builder /app/matrixone/mocl_kernel64.fatbin /mocl_kernel64.fatbin
COPY --from=builder /app/matrixone/etc /etc
COPY --from=builder /app/matrixone/thirdparties/install/lib/*.so /usr/local/lib/
COPY --from=builder /app/matrixone/cgo/*.so /usr/local/lib/
COPY --from=builder /gpu-runtime/ /usr/local/lib/

ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /
EXPOSE 6001
ENTRYPOINT ["/mo-service", "-debug-http=:12345", "-launch", "/etc/quickstart/launch.toml"]
