service-type = "CN"
data-dir = "./mo-data"

[log]
level = "info"
format = "console"
max-size = 512

[hakeeper-client]
service-addresses = [
	"127.0.0.1:32001",
]

[[fileservice]]
name = "LOCAL"
backend = "DISK-V2"
data-dir = "mo-data/local-cn%[3]d"

[[fileservice]]
name = "SHARED"
backend = "DISK-V2"
data-dir = "mo-data/shared2"

[fileservice.cache]
memory-capacity = "128MB"
disk-capacity = "128MB"
disk-path = "mo-data/file-service-cache"

[[fileservice]]
name = "ETL"
backend = "DISK-ETL"

[observability]

[cn]
uuid = "dd1dccb%[1]d-4d3c-41f8-b482-5251dc7a41bf"
port-base = %[2]d
service-host = "cn%[3]d"

[cn.Engine]
type = "distributed-tae"

[cn.frontend]
port = %[4]d
unix-socket = "/tmp/mysql%[5]d.sock"

[cn.frontend.iceberg]
enable = true
enable-write = true
enable-delete = true
enable-dml = true
enable-maintenance = true
