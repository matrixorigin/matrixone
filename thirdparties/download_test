set -eu

mock_curl() {
	output=
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--output)
				output=$2
				shift 2
				;;
			--connect-timeout | --max-time | --max-filesize | --proto | --proto-redir)
				shift 2
				;;
			*)
				shift
				;;
		esac
	done

	[ -n "$output" ] || exit 2
	if [ "$MO_DOWNLOAD_MOCK_MODE" = concurrent-success ]; then
		cp "$MO_DOWNLOAD_MOCK_FIXTURE" "$output"
		exit 0
	fi

	count=0
	if [ -f "$MO_DOWNLOAD_MOCK_STATE/count" ]; then
		IFS= read -r count < "$MO_DOWNLOAD_MOCK_STATE/count"
	fi
	count=$((count + 1))
	printf '%s\n' "$count" > "$MO_DOWNLOAD_MOCK_STATE/count"

	case "$MO_DOWNLOAD_MOCK_MODE:$count" in
		transport-once:1 | always-fail:*)
			exit 56
			;;
		corrupt-once:1 | always-corrupt:*)
			printf 'corrupt response\n' > "$output"
			;;
		*)
			cp "$MO_DOWNLOAD_MOCK_FIXTURE" "$output"
			;;
	esac
}

if [ "${MO_DOWNLOAD_MOCK_CHILD:-}" = 1 ]; then
	mock_curl "$@"
	exit 0
fi

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
download_script="$script_dir/download"
test_root=$(mktemp -d "${TMPDIR:-/tmp}/mo-download-test.XXXXXX")
cleanup() {
	rm -rf "$test_root"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM

fixture="$test_root/fixture"
printf 'verified dependency payload\n' > "$fixture"
if command -v sha256sum >/dev/null 2>&1; then
	expected_sha256=$(sha256sum "$fixture" | awk '{print $1}')
else
	expected_sha256=$(shasum -a 256 "$fixture" | awk '{print $1}')
fi

export MO_DOWNLOAD_ATTEMPTS=3
export MO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=1
export MO_DOWNLOAD_MAX_TIME_SECONDS=1
export MO_DOWNLOAD_MAX_BYTES=1048576
export MO_DOWNLOAD_INITIAL_BACKOFF_SECONDS=0
export MO_DOWNLOAD_MAX_BACKOFF_SECONDS=0
export MO_DOWNLOAD_CURL_BIN="$0"
export MO_DOWNLOAD_MOCK_CHILD=1
export MO_DOWNLOAD_MOCK_FIXTURE="$fixture"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

assert_count() {
	expected=$1
	actual=0
	if [ -f "$MO_DOWNLOAD_MOCK_STATE/count" ]; then
		IFS= read -r actual < "$MO_DOWNLOAD_MOCK_STATE/count"
	fi
	[ "$actual" -eq "$expected" ] || fail "expected $expected curl calls, got $actual"
}

assert_no_temp_files() {
	case_dir=$1
	[ -z "$(find "$case_dir" -name '*.download.*' -print -quit)" ] || fail "temporary download was not cleaned up"
}

new_case() {
	case_name=$1
	MO_DOWNLOAD_MOCK_STATE="$test_root/$case_name"
	mkdir -p "$MO_DOWNLOAD_MOCK_STATE"
	export MO_DOWNLOAD_MOCK_STATE
}

new_case cache-hit
cp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result"
MO_DOWNLOAD_MOCK_MODE=always-fail
export MO_DOWNLOAD_MOCK_MODE
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"
assert_count 0
cmp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "cache hit changed destination"

new_case insecure-url
MO_DOWNLOAD_MOCK_MODE=success
export MO_DOWNLOAD_MOCK_MODE
if "$download_script" http://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"; then
	fail "insecure dependency URL unexpectedly succeeded"
fi
assert_count 0

new_case transport-retry
MO_DOWNLOAD_MOCK_MODE=transport-once
export MO_DOWNLOAD_MOCK_MODE
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"
assert_count 2
cmp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "transport retry installed wrong content"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

new_case checksum-retry
MO_DOWNLOAD_MOCK_MODE=corrupt-once
export MO_DOWNLOAD_MOCK_MODE
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"
assert_count 2
cmp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "checksum retry installed wrong content"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

new_case stale-cache
printf 'old dependency version\n' > "$MO_DOWNLOAD_MOCK_STATE/result"
MO_DOWNLOAD_MOCK_MODE=success
export MO_DOWNLOAD_MOCK_MODE
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"
assert_count 1
cmp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "stale cache was not replaced"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

new_case exhausted-transport
printf 'previous invalid dependency\n' > "$MO_DOWNLOAD_MOCK_STATE/result"
cp "$MO_DOWNLOAD_MOCK_STATE/result" "$MO_DOWNLOAD_MOCK_STATE/original"
MO_DOWNLOAD_MOCK_MODE=always-fail
export MO_DOWNLOAD_MOCK_MODE
if "$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"; then
	fail "persistent transport failure unexpectedly succeeded"
fi
assert_count 3
cmp "$MO_DOWNLOAD_MOCK_STATE/original" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "failed download replaced existing destination"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

new_case exhausted-checksum
MO_DOWNLOAD_MOCK_MODE=always-corrupt
export MO_DOWNLOAD_MOCK_MODE
if "$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"; then
	fail "persistent checksum failure unexpectedly succeeded"
fi
assert_count 3
[ ! -e "$MO_DOWNLOAD_MOCK_STATE/result" ] || fail "invalid download was installed"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

new_case byte-limit
MO_DOWNLOAD_MOCK_MODE=success
MO_DOWNLOAD_ATTEMPTS=1
MO_DOWNLOAD_MAX_BYTES=8
export MO_DOWNLOAD_MOCK_MODE MO_DOWNLOAD_ATTEMPTS MO_DOWNLOAD_MAX_BYTES
if "$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result"; then
	fail "oversized response unexpectedly succeeded"
fi
assert_count 1
[ ! -e "$MO_DOWNLOAD_MOCK_STATE/result" ] || fail "oversized response was installed"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"
MO_DOWNLOAD_ATTEMPTS=3
MO_DOWNLOAD_MAX_BYTES=1048576
export MO_DOWNLOAD_ATTEMPTS MO_DOWNLOAD_MAX_BYTES

new_case concurrent
MO_DOWNLOAD_MOCK_MODE=concurrent-success
export MO_DOWNLOAD_MOCK_MODE
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result" &
pid1=$!
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result" &
pid2=$!
"$download_script" https://example.invalid/dependency "$expected_sha256" "$MO_DOWNLOAD_MOCK_STATE/result" &
pid3=$!
wait "$pid1"
wait "$pid2"
wait "$pid3"
cmp "$fixture" "$MO_DOWNLOAD_MOCK_STATE/result" || fail "concurrent downloads installed wrong content"
assert_no_temp_files "$MO_DOWNLOAD_MOCK_STATE"

echo "PASS: download retry, verification, cache, and failure atomicity"
