set -eu

usage() {
	echo "usage: $0 URL SHA256 DESTINATION" >&2
	exit 2
}

[ "$#" -eq 3 ] || usage

url=$1
expected_sha256=$2
destination=$3

attempts=${MO_DOWNLOAD_ATTEMPTS:-4}
connect_timeout=${MO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS:-15}
max_time=${MO_DOWNLOAD_MAX_TIME_SECONDS:-120}
max_bytes=${MO_DOWNLOAD_MAX_BYTES:-134217728}
backoff=${MO_DOWNLOAD_INITIAL_BACKOFF_SECONDS:-2}
max_backoff=${MO_DOWNLOAD_MAX_BACKOFF_SECONDS:-10}
curl_bin=${MO_DOWNLOAD_CURL_BIN:-curl}

case "$url" in
	https://*) ;;
	*)
		echo "dependency URL must use HTTPS" >&2
		exit 2
		;;
esac
command -v "$curl_bin" >/dev/null 2>&1 || {
	echo "curl command not found: $curl_bin" >&2
	exit 2
}

require_positive_integer() {
	name=$1
	value=$2
	case "$value" in
		'' | *[!0-9]* | 0)
			echo "$name must be a positive integer, got '$value'" >&2
			exit 2
			;;
	esac
}

require_non_negative_integer() {
	name=$1
	value=$2
	case "$value" in
		'' | *[!0-9]*)
			echo "$name must be a non-negative integer, got '$value'" >&2
			exit 2
			;;
	esac
}

require_positive_integer MO_DOWNLOAD_ATTEMPTS "$attempts"
require_positive_integer MO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS "$connect_timeout"
require_positive_integer MO_DOWNLOAD_MAX_TIME_SECONDS "$max_time"
require_positive_integer MO_DOWNLOAD_MAX_BYTES "$max_bytes"
require_non_negative_integer MO_DOWNLOAD_INITIAL_BACKOFF_SECONDS "$backoff"
require_non_negative_integer MO_DOWNLOAD_MAX_BACKOFF_SECONDS "$max_backoff"
if [ "$backoff" -gt "$max_backoff" ]; then
	backoff=$max_backoff
fi

case "$expected_sha256" in
	*[!0-9a-fA-F]*)
		echo "SHA256 must contain exactly 64 hexadecimal characters" >&2
		exit 2
		;;
esac
[ "${#expected_sha256}" -eq 64 ] || {
	echo "SHA256 must contain exactly 64 hexadecimal characters" >&2
	exit 2
}
expected_sha256=$(printf '%s' "$expected_sha256" | tr 'A-F' 'a-f')

if command -v sha256sum >/dev/null 2>&1; then
	sha256_file() {
		sha256sum "$1" | awk '{print $1}'
	}
elif command -v shasum >/dev/null 2>&1; then
	sha256_file() {
		shasum -a 256 "$1" | awk '{print $1}'
	}
else
	echo "sha256sum or shasum is required" >&2
	exit 2
fi

verify_file() {
	file=$1
	actual_bytes=$(wc -c < "$file" | tr -d '[:space:]')
	if [ "$actual_bytes" -gt "$max_bytes" ]; then
		verification_error="download exceeds byte limit: $actual_bytes > $max_bytes"
		return 1
	fi
	actual_sha256=$(sha256_file "$file")
	if [ "$actual_sha256" != "$expected_sha256" ]; then
		verification_error="download checksum mismatch: expected $expected_sha256, got $actual_sha256"
		return 1
	fi
	verification_error=
	return 0
}

if [ -f "$destination" ] && verify_file "$destination"; then
	echo "using verified cached download: $destination"
	exit 0
fi

destination_dir=$(dirname "$destination")
[ -d "$destination_dir" ] || {
	echo "destination directory does not exist: $destination_dir" >&2
	exit 2
}

tmp=
cleanup() {
	[ -z "$tmp" ] || rm -f "$tmp"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM
tmp=$(mktemp "${destination}.download.XXXXXX")

attempt=1
delay=$backoff
while [ "$attempt" -le "$attempts" ]; do
	echo "downloading dependency (attempt $attempt/$attempts)"
	if "$curl_bin" --disable --fail --location --show-error \
		--proto '=https' --proto-redir '=https' \
		--connect-timeout "$connect_timeout" --max-time "$max_time" \
		--max-filesize "$max_bytes" \
		--output "$tmp" "$url"; then
		if verify_file "$tmp"; then
			mv -f "$tmp" "$destination"
			echo "downloaded and verified: $destination"
			exit 0
		fi
		echo "$verification_error" >&2
	else
		status=$?
		echo "download failed with curl exit code $status" >&2
	fi

	if [ "$attempt" -eq "$attempts" ]; then
		break
	fi

	if [ "$delay" -gt 0 ]; then
		# Equal jitter keeps concurrent CI builds from retrying in lockstep while
		# retaining a bounded exponential backoff.
		half_delay=$((delay / 2))
		jitter=$(( $$ % (delay - half_delay + 1) ))
		sleep_for=$((half_delay + jitter))
		echo "retrying in ${sleep_for}s" >&2
		sleep "$sleep_for"
	fi
	attempt=$((attempt + 1))
	if [ "$delay" -lt "$max_backoff" ]; then
		delay=$((delay * 2))
		if [ "$delay" -gt "$max_backoff" ]; then
			delay=$max_backoff
		fi
	fi
done

echo "dependency download failed after $attempts attempts" >&2
exit 1
