set -eu

usage() {
	echo "usage: $0 URL SHA256 DESTINATION" >&2
	exit 2
}

[ "$#" -eq 3 ] || usage

url=$1
expected_sha256=$2
destination=$3

# CI runners reach immutable third-party artifacts through a shared proxy. Give
# short TLS outages enough time to recover without making retries unbounded.
attempts=${MO_DOWNLOAD_ATTEMPTS:-6}
connect_timeout=${MO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS:-15}
max_time=${MO_DOWNLOAD_MAX_TIME_SECONDS:-120}
max_bytes=${MO_DOWNLOAD_MAX_BYTES:-134217728}
retry_delay=${MO_DOWNLOAD_RETRY_DELAY_SECONDS:-1}
curl_bin=${MO_DOWNLOAD_CURL_BIN:-curl}

case "$url" in
	https://*) ;;
	*)
		echo "dependency URL must use HTTPS" >&2
		exit 2
		;;
esac
[ ! -d "$destination" ] || {
	echo "destination must be a file path, got directory: $destination" >&2
	exit 2
}
require_positive_integer() {
	name=$1
	value=$2
	case "$value" in
		'' | *[!0-9]* | 0)
			echo "$name must be a positive integer, got '$value'" >&2
			exit 2
			;;
	esac
}

require_positive_integer MO_DOWNLOAD_ATTEMPTS "$attempts"
require_positive_integer MO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS "$connect_timeout"
require_positive_integer MO_DOWNLOAD_MAX_TIME_SECONDS "$max_time"
require_positive_integer MO_DOWNLOAD_MAX_BYTES "$max_bytes"

case "$retry_delay" in
	'' | *[!0-9]*)
		echo "MO_DOWNLOAD_RETRY_DELAY_SECONDS must be a non-negative integer, got '$retry_delay'" >&2
		exit 2
		;;
esac

case "$expected_sha256" in
	*[!0-9a-fA-F]*)
		echo "SHA256 must contain exactly 64 hexadecimal characters" >&2
		exit 2
		;;
esac
[ "${#expected_sha256}" -eq 64 ] || {
	echo "SHA256 must contain exactly 64 hexadecimal characters" >&2
	exit 2
}
expected_sha256=$(printf '%s' "$expected_sha256" | tr 'A-F' 'a-f')

if command -v sha256sum >/dev/null 2>&1; then
	sha256_file() {
		sha256sum "$1" | awk '{print $1}'
	}
elif command -v shasum >/dev/null 2>&1; then
	sha256_file() {
		shasum -a 256 "$1" | awk '{print $1}'
	}
else
	echo "sha256sum or shasum is required" >&2
	exit 2
fi

verify_file() {
	file=$1
	actual_bytes=$(wc -c < "$file" | tr -d '[:space:]')
	if [ "$actual_bytes" -gt "$max_bytes" ]; then
		verification_error="download exceeds byte limit: $actual_bytes > $max_bytes"
		return 1
	fi
	actual_sha256=$(sha256_file "$file")
	if [ "$actual_sha256" != "$expected_sha256" ]; then
		verification_error="download checksum mismatch: expected $expected_sha256, got $actual_sha256"
		return 1
	fi
	verification_error=
	return 0
}

if [ -f "$destination" ] && verify_file "$destination"; then
	chmod 0644 "$destination"
	echo "using verified cached download: $destination"
	exit 0
fi

command -v "$curl_bin" >/dev/null 2>&1 || {
	echo "curl command not found: $curl_bin" >&2
	exit 2
}

destination_dir=$(dirname "$destination")
[ -d "$destination_dir" ] || {
	echo "destination directory does not exist: $destination_dir" >&2
	exit 2
}

tmp=
cleanup() {
	[ -z "$tmp" ] || rm -f "$tmp"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM
tmp=$(mktemp "${destination}.download.XXXXXX")

# curl versions before 8.4 only honor --max-filesize when the server declares
# Content-Length. A POSIX file-size limit also bounds chunked/unknown-length
# responses. The checksum/byte verification below enforces the exact limit;
# ulimit has the POSIX-mandated 512-byte granularity.
max_file_blocks=$((max_bytes / 512))
if [ $((max_bytes % 512)) -ne 0 ]; then
	max_file_blocks=$((max_file_blocks + 1))
fi

run_curl() (
	current_file_blocks=$(ulimit -f)
	case "$current_file_blocks" in
		unlimited)
			ulimit -f "$max_file_blocks"
			;;
		*[!0-9]*)
			echo "cannot determine inherited file-size limit: $current_file_blocks" >&2
			exit 2
			;;
		*)
			# Never relax a stricter limit inherited from the caller.
			if [ "$current_file_blocks" -gt "$max_file_blocks" ]; then
				ulimit -f "$max_file_blocks"
			fi
			;;
	esac

	exec "$curl_bin" --disable --fail --location --show-error \
		--proto '=https' --proto-redir '=https' \
		--connect-timeout "$connect_timeout" --max-time "$max_time" \
		--max-filesize "$max_bytes" \
		"$@" \
		--output "$tmp" "$url"
)

# curl 7.71 added --retry-all-errors. Prefer curl's native retry engine when
# available because it understands Retry-After. Ubuntu 20.04 ships curl 7.68,
# so retain a bounded POSIX fallback for otherwise retryable transport errors.
if "$curl_bin" --disable --help all 2>/dev/null \
	| grep -q -- '--retry-all-errors'; then
	retry_count=$((attempts - 1))
	retry_max_time=$((max_time * attempts))
	echo "downloading dependency (up to $attempts attempts)"
	if run_curl \
		--retry "$retry_count" --retry-all-errors \
		--retry-max-time "$retry_max_time"; then
		:
	else
		status=$?
		echo "dependency download failed with curl exit code $status" >&2
		exit 1
	fi
else
	attempt=1
	while :; do
		# Do not let bytes from a failed legacy attempt influence the next one.
		: > "$tmp"
		echo "downloading dependency (attempt $attempt/$attempts; legacy curl retry)"
		if run_curl; then
			break
		else
			status=$?
		fi
		if [ "$attempt" -ge "$attempts" ]; then
			echo "dependency download failed with curl exit code $status after $attempt attempts" >&2
			exit 1
		fi
		if [ "$retry_delay" -gt 0 ]; then
			sleep "$retry_delay"
		fi
		attempt=$((attempt + 1))
	done
fi
if ! verify_file "$tmp"; then
	echo "$verification_error" >&2
	exit 1
fi

chmod 0644 "$tmp"
mv -f "$tmp" "$destination"
echo "downloaded and verified: $destination"
