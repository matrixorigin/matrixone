# Publish the flat thirdparty library set beside mo-service. Each changed file
# is first completed in the destination directory and then renamed, so a copy,
# link, rename, or signal failure cannot replace the last usable destination.

set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 <thirdparty-lib-dir> <destination-lib-dir>" >&2
    exit 2
fi

source_dir=$1
destination_dir=$2
temporary=

cleanup() {
    if [ -n "$temporary" ]; then
        rm -f "$temporary"
    fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

[ -d "$source_dir" ] || {
    echo "native staging source directory does not exist: $source_dir" >&2
    exit 1
}
mkdir -p "$destination_dir"

for source in "$source_dir"/*; do
    [ -e "$source" ] || [ -L "$source" ] || continue
    destination="$destination_dir/${source##*/}"

    # A prior interrupted implementation may have left one of these files.
    # They are never published artifacts, so the next owner recycles them.
    for stale in "$destination.tmp."*; do
        [ -e "$stale" ] || [ -L "$stale" ] || continue
        rm -f "$stale"
    done

    if [ -d "$source" ] && [ ! -L "$source" ]; then
        echo "native library staging only supports files and symlinks: $source" >&2
        exit 1
    fi
    if [ -d "$destination" ] && [ ! -L "$destination" ]; then
        echo "native library destination is unexpectedly a directory: $destination" >&2
        exit 1
    fi

    if [ -L "$source" ]; then
        link_target=$(readlink "$source")
        if [ -L "$destination" ] &&
           [ "$(readlink "$destination")" = "$link_target" ]; then
            continue
        fi
        temporary="$destination.tmp.$$"
        rm -f "$temporary"
        ln -s "$link_target" "$temporary"
    elif [ -f "$destination" ] && [ ! -L "$destination" ] &&
         cmp -s "$source" "$destination"; then
        continue
    else
        temporary="$destination.tmp.$$"
        rm -f "$temporary"
        cp "$source" "$temporary"
    fi

    mv -f "$temporary" "$destination"
    temporary=
done

trap - EXIT HUP INT TERM
