# mo-ha-deploy.sh 配置文件示例（CLI 参数覆盖本文件）
# 用法： ./mo-ha-deploy.sh --config deploy.env --bootstrap --yes
# 注意 1：本文件含凭据，权限请设 600，不要提交到仓库。
# 注意 2：本文件由脚本用 shell source 加载（内容会被 root 执行，不是纯数据）；
#         仅使用可信来源，group/other 可写的文件会被脚本拒绝。

# ===== 节点（必填）=====
SELF="node1"
PEER="node2"
SELF_IP="10.0.0.1"
PEER_IP="10.0.0.2"

# ===== 集群 / DRBD（可选，括号内为默认值）=====
CLUSTER="mo"
DRBD_DEVICE="/dev/vdb"          # 两台各自的裸盘
DRBD_VOLUME="/dev/drbd0"
DRBD_RESOURCE="mo"
DRBD_PORT="7789"
DATA_DIR="/mnt/mo-data"

# ===== MatrixOne（可选）=====
MO_IMAGE="matrixorigin/matrixone:latest"
MO_PORT="6001"
MO_BIND_IP="0.0.0.0"           # 生产建议改为本机内网 IP；填 VIP 时必须同时配置 VIP=；MO 启动后务必改掉默认 root 密码 111
MO_DIR="/opt/mo-ha"
MO_HOSTNAME="mo-ha"             # explicit-hostname，两台必须一致
MO_ROOT_PASSWORD=""            # 仅用于 check 阶段验证 SQL 可登录；留空则跳过该步
# NO_MO="1"                     # 只部署存储与集群，不创建 MO 资源
# VIP="10.0.0.100/24"           # 可选虚拟 IP

# ===== 对象存储（可选；填了 S3_BUCKET 才启用，否则用本地盘）=====
# S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
# S3_BUCKET="mo-on-oss-demo"
# S3_REGION="cn-hangzhou"
# S3_KEY_ID="<AK>"
# S3_KEY_SECRET="<SK>"
# S3_KEY_PREFIX="server/data"

# ===== fencing（必填）=====
FENCE_SCENARIO="ipmi"           # ipmi|redfish|pdu|vmware|proxmox|virsh|aws|azure|gce|aliyun|custom_http|sbd
# 每节点带外地址（ipmi/redfish/custom_http）
FENCE_TARGET_SELF="10.0.0.201"
FENCE_TARGET_PEER="10.0.0.202"
# 共享入口 + plug（pdu/vmware/proxmox/virsh/云）
# FENCE_SHARED_IP="10.0.0.50"
# FENCE_PLUG_SELF="3"
# FENCE_PLUG_PEER="4"
FENCE_LOGIN="admin"
FENCE_PASSWORD="change-me"         # 仅限字母/数字与 ._@%+=,:/_-（会经 shell 拼接，含引号/空白/$ 会被拒绝）
FENCE_SNMP="public"
FENCE_EXTRA=""                  # "k=v,k=v"
FENCE_DELAY_MAX="5"
# SBD 场景：
# SBD_DEVICE="/dev/sdc"
# WATCHDOG="/dev/watchdog"

# ===== DRBD 内核模块 =====
# 发行版/ELRepo 无匹配 kmod 时（常见 aarch64/EL9）从源码构建；可传本地 tar.gz 路径
DRBD_SRC_URL="https://pkg.linbit.com//downloads/drbd/9/drbd-9.2.20.tar.gz"
# DRBD_KERNEL_FALLBACK="never"  # auto(默认,允许源码构建)|never(禁止)

# ===== 行为 =====
DOCKER_MODE="official"          # official|distro|skip
HACLUSTER_PW="change-me"        # 必填（无默认值），两台一致；仅限字母/数字与 ._@%+=,:/_-
PULL_IMAGE="1"                  # 1=部署时预拉 MO 镜像(推荐，避免 p_mo 启动超时)
# MO_START_TIMEOUT="600"        # p_mo start 操作超时(秒)
# CHECK_SETTLE_SEC="180"        # check 前等待资源稳态(秒)
# CHECK_MO_WAIT="300"           # check 等待 p_mo Started(秒)
# STAGES="pre,pkg,docker,moconf,drbd,cluster,fence,resources,check"
# FORMAT_DRBD="1"               # 仅首次部署在 bootstrap 节点使用
# DRBD9_QUORUM="1"
