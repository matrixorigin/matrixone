#!/bin/sh
# Version: 1.1.2
# Date: 2020-06-24
#
# Resource script for running docker-compose
#
# Description:  Manages docker services using docker-compose as an OCF
#               resource in an High Availability setup.
#               It relies on a well-tested docker compose YAML file which
#               distributed on an identical location on all cluster nodes.
#
# Caveat: 1. A YAML file (docker-compose.yml) and an optional Dockerfile
#            must be provided in a working directory.
#         2. It is suggested to test run the docker-compose and verify
#            on all cluster nodes before enabling this agent.
#
# docker-compose OCF script's Author: Kenny Chen <netman@study-area.org>
# License: GNU General Public License (GPL)
#
#	usage: $0 {start|stop|status|monitor|validate-all|meta-data}
#
#	The "start" arg starts docker service.
#	The "stop" arg stops it.
#
# OCF parameters:
# OCF_RESKEY_binpath
# OCF_RESKEY_dirpath
# OCF_RESKEY_ymlfile
#
##########################################################################
# Initialization:

: ${OCF_ROOT:=/usr/lib/ocf}
: ${OCF_FUNCTIONS_DIR=${OCF_ROOT}/lib/heartbeat}
. ${OCF_FUNCTIONS_DIR}/ocf-shellfuncs

# Defaults
OCF_RESKEY_binpath_default=/usr/bin/docker-compose
OCF_RESKEY_ymlfile_default=docker-compose.yml
: ${OCF_RESKEY_binpath=${OCF_RESKEY_binpath_default}}
: ${OCF_RESKEY_ymlfile=${OCF_RESKEY_ymlfile_default}}

USAGE="Usage: $0 {start|stop|status|monitor|validate-all|meta-data}"

##########################################################################

usage()
{
	echo $USAGE >&2
}

meta_data()
{
cat <<END
<?xml version="1.0"?>
<!DOCTYPE resource-agent SYSTEM "ra-api-1.dtd">
<resource-agent name="docker-compose" version="1.0.3">
<version>1.0</version>
<longdesc lang="en">
Manages docker services using docker-compose as an OCF resource in an High Availability setup.
It relies on a well-tested docker compose YAML file which distributed on an identical location on all cluster nodes.

Caveat: 1. A YAML file (docker-compose.yml) and an optional Dockerfile
           must be provided in a working directory.
        2. It is suggested to test run the docker-compose and verify on all cluster nodes
           before enabling this agent.
</longdesc>
<shortdesc lang="en">This script manages docker services using docker-compose.</shortdesc> 

<parameters>

<parameter name="binpath">
<longdesc lang="en">
The docker-composer binary path.
For example, "/usr/bin/docker-compose"
</longdesc>
<shortdesc lang="en">The docker-composer binary path</shortdesc>
<content type="string" default="$OCF_RESKEY_binpath_default"/>
</parameter>

<parameter name="dirpath" required="1">
<longdesc lang="en">
The directory contains docker compose yaml file.
For example, "/data/docker"
</longdesc>
<shortdesc lang="en">Directory contains docker compose files</shortdesc>
<content type="string"/>
</parameter>

<parameter name="ymlfile">
<longdesc lang="en">
The docker-compose yaml file.
For example, "docker-compose.yml"
</longdesc>
<shortdesc lang="en">The docker compose yaml</shortdesc>
<content type="string" default="$OCF_RESKEY_ymlfile_default"/>
</parameter>

</parameters>

<actions>
<action name="start" timeout="240s"/>
<action name="stop" timeout="120s"/>
<action name="monitor" depth="0" timeout="10s" interval="60s" />
<action name="validate-all" timeout="5s" />
<action name="meta-data"  timeout="5s"/>
</actions>
</resource-agent>
END
exit $OCF_SUCCESS
}

if [ -r "$OCF_RESKEY_binpath" -a -x "$OCF_RESKEY_binpath" ]; then
	COMMAND="$OCF_RESKEY_binpath"
else
	COMMAND="$OCF_RESKEY_binpath_default"
fi

DIR="$OCF_RESKEY_dirpath"
# Internal status for a successful inspection that found a partial project.
# Only start may reconcile it. A monitor always reports it as an OCF error.
COMPOSE_PARTIAL=42
# docker inspect failed. Distinct from a classified OCF result so status can
# refresh when a listed container has disappeared.
INSPECT_FAILED=99
YML="$OCF_RESKEY_ymlfile"
case "$YML" in
	/*) CONFIG_FILE=$YML ;;
	*)  CONFIG_FILE=$DIR/$YML ;;
esac

run_compose()
(
	CDPATH= cd "$DIR" || exit 1
	"$COMMAND" -f "$YML" "$@"
)

labeled_container_ids()
{
	# Compose labels retain the config path after the file disappears or
	# its project name changes. An empty Compose result alone is inconclusive.
	project_dir=$(CDPATH= cd "$(dirname "$CONFIG_FILE")" && pwd) || return "$OCF_ERR_GENERIC"
	config_path=${project_dir%/}/${CONFIG_FILE##*/}
	format='{{.ID}}{{"\t"}}{{.Names}}{{"\t"}}{{.Label "com.docker.compose.project"}}{{"\t"}}{{.Label "com.docker.compose.project.config_files"}}{{"\t"}}{{.Label "com.docker.compose.oneoff"}}{{"\t"}}{{.State}}'
	containers=$(docker ps --all --no-trunc --format "$format") || {
		ocf_log err "failed to enumerate Docker containers for $config_path"
		return "$OCF_ERR_GENERIC"
	}

	# Names only flag possible ownership conflicts. They cannot authorize
	# stopping a container, even when it has the template name "matrixone".
	# An exited project left behind by a rename is not a second owner.
	# Only a project that still has an active container can conflict.
	if ! ids=$(printf '%s\n' "$containers" |
		OCF_COMPOSE_CONFIG="$config_path" OCF_COMPOSE_DIR="${project_dir##*/}" OCF_COMPOSE_PROJECT="$compose_project" OCF_CURRENT_IDS="${2:-}" awk -F '\t' -v selection="$1" '
		BEGIN {
			prefix = tolower(ENVIRON["OCF_COMPOSE_DIR"])
			gsub(/[^a-z0-9_-]/, "", prefix)
			legacy = prefix
			gsub(/[_-]/, "", legacy)
			n = split(ENVIRON["OCF_CURRENT_IDS"], current, "\n")
			for (i = 1; i <= n; i++)
				if (current[i] != "") unverified[current[i]] = 1
		}
		{
			oneoff = (tolower($5) == "true")
			active = ($6 != "exited" && $6 != "created")
		}
		oneoff && !active && selection != "reconcile" { next }
		$3 != "" && $4 == ENVIRON["OCF_COMPOSE_CONFIG"] {
			if (active) active_project[$3] = 1
			count++
			cid[count] = $1
			cproj[count] = $3
			coneoff[count] = oneoff
			cactive[count] = active
			if (selection == "reconcile") {
				if (active && (oneoff || !($1 in unverified))) ambiguous = 1
				delete unverified[$1]
			}
			next
		}
		$2 == "matrixone" ||
		($2 ~ /[_-][0-9]+$/ && (index($2, prefix "-") == 1 ||
			index($2, prefix "_") == 1 || index($2, legacy "-") == 1 ||
			index($2, legacy "_") == 1)) { ambiguous = 1 }
		END {
			active_count = 0
			for (project in active_project) {
				active_count++
				current_project = project
			}
			# Two active projects are an ownership conflict for monitor and
			# start. Stop can still name the containers compose down will
			# skip, because those targets belong to different projects.
			if (active_count > 1 && selection != "shutdown") ambiguous = 1
			if (!ambiguous && selection != "reconcile") {
				for (i = 1; i <= count; i++) {
					# Health follows the one active project. Removal lists
					# every verified service. Shutdown lists one-offs and
					# other projects, which compose down does not stop.
					if (selection != "services" && selection != "shutdown" &&
						(active_count == 0 || cproj[i] != current_project)) continue
					if (selection == "monitor") selected = 1
					else if (selection == "oneoff") selected = (coneoff[i] && cactive[i])
					else if (selection == "active") selected = cactive[i]
					else if (selection == "shutdown")
						selected = cactive[i] && (coneoff[i] || cproj[i] != ENVIRON["OCF_COMPOSE_PROJECT"])
					else selected = !coneoff[i]
					if (selected) print cid[i]
				}
			}
			for (id in unverified) ambiguous = 1
			exit ambiguous
		}
	'); then
		ocf_log err "cannot verify container ownership for $config_path"
		return "$OCF_ERR_GENERIC"
	fi
	printf '%s\n' "$ids"
}

remove_containers()
{
	ids=$(labeled_container_ids services) || return "$OCF_ERR_GENERIC"
	failed=0
	for id in $ids; do
		# kill can fail for an already stopped container. rm without --force
		# succeeds only when Docker can remove the container safely.
		docker kill "$id" >/dev/null 2>&1
		if ! docker rm "$id" >/dev/null; then
			ocf_log err "failed to remove Docker container $id"
			failed=$OCF_ERR_GENERIC
		fi
	done
	return "$failed"
}

desired_services()
(
	# Ask Compose to resolve profiles, interpolation and deploy/scale settings.
	model=$(run_compose config --format json) || exit 1
	printf '%s\n' "$model" | python3 -I -c '
import json
import sys

document = json.load(sys.stdin)
services = document["services"]
completed = set()
for service in services.values():
    dependencies = service.get("depends_on") or {}
    if not isinstance(dependencies, dict):
        continue
    for name, spec in dependencies.items():
        if isinstance(spec, dict) and spec.get("condition") == "service_completed_successfully":
            completed.add(name)
for name, service in services.items():
    deploy = service.get("deploy") or {}
    if not isinstance(deploy, dict):
        deploy = {}
    replicas = service.get("scale", deploy.get("replicas", 1))
    mode = "completed" if name in completed else "running"
    print(name, replicas, mode)
'
)

docker_container_status()
{
	expected_services=$1
	shift
	[ "$#" -gt 0 ] || return "$OCF_NOT_RUNNING"
	format='{{.State.Running}}|{{.State.Status}}|{{.State.ExitCode}}|{{index .Config.Labels "com.docker.compose.oneoff"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{index .Config.Labels "com.docker.compose.depends_on"}}'
	states=$(docker inspect --format="$format" "$@") || return "$INSPECT_FAILED"

	# The resolved Compose model decides which services may be ready after a
	# successful exit. Dependent container labels survive a later change from
	# initializer to long-running service, so they are not authoritative.
	# Successful initializer exits count toward the desired completed count.
	# Further successful exits left by a scale-down do not. Only an unexpected
	# number of active replicas is a surplus. Exited replicas of a long-running
	# service likewise stay out of that comparison.
	printf '%s\n' "$states" | OCF_EXPECTED_SERVICES="$expected_services" awk -F '[|]' \
		-v containers="$#" -v not_running="$OCF_NOT_RUNNING" -v partial="$COMPOSE_PARTIAL" '
		BEGIN {
			n = split(ENVIRON["OCF_EXPECTED_SERVICES"], lines, "\n")
			for (i = 1; i <= n; i++) {
				split(lines[i], fields, " ")
				if (fields[1] == "") continue
				desired[fields[1]] = fields[2] + 0
				if (fields[3] == "completed") init[fields[1]] = 1
			}
		}
		NF != 6 || ($1 != "true" && $1 != "false") { invalid = 1; next }
		{
			active = ($2 != "created" && $2 != "exited")
			if (tolower($4) == "true") {
				if (active) task = 1
				next
			}
			if (!($5 in desired) || desired[$5] == 0) {
				if (active) orphan = 1
				next
			}
			if ($1 == "true" && $2 == "running") {
				running = 1
				ready[$5]++
			} else if ($2 == "exited" && $3 == "0") exited[$5]++
			else if (active) invalid = 1
		}
		END {
			if (invalid || NR != containers) exit 2
			if (orphan) exit 3
			if (!running) exit (task ? 4 : not_running)
			for (service in desired) {
				active = ready[service] + 0
				if (service in init) {
					if (active + exited[service] < desired[service]) stopped = 1
					if (active > desired[service]) exit 2
				} else if (active < desired[service]) stopped = 1
				else if (active > desired[service]) exit 2
			}
			if (stopped && task) exit 4
			exit stopped ? partial : 0
		}
	'
	result=$?
	case "$result" in
		"$OCF_SUCCESS"|"$OCF_NOT_RUNNING") return "$result" ;;
		"$COMPOSE_PARTIAL") ocf_log warn "only some Compose services are running"; return "$result" ;;
		3) ocf_log err "unexpected service container still active for $CONFIG_FILE" ;;
		4) ocf_log err "one-off container still active while services are stopped or incomplete for $CONFIG_FILE" ;;
		*) ocf_log err "cannot confirm safe service state for $CONFIG_FILE" ;;
	esac
	return "$OCF_ERR_GENERIC"
}

# Sets compose_ids for the caller. A command substitution would discard it,
# and start uses that exact Compose snapshot to prove ownership before repair.
observe_containers()
{
	compose_ids=$(run_compose ps -aq) || {
		ocf_log err "failed to enumerate Compose containers for $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	}
	# Compose may omit old services or one-off jobs. Inspect the union only
	# once per ID so the replica count reflects actual containers.
	owned_ids=$(labeled_container_ids monitor) || return "$OCF_ERR_GENERIC"
	observed_ids=$(printf '%s\n' "$compose_ids" "$owned_ids" | awk 'NF && !seen[$1]++') || return "$OCF_ERR_GENERIC"
}

# Success means the later snapshot no longer contains every container the
# earlier snapshot listed. A finished `compose run --rm` task is that case.
container_disappeared()
{
	printf '%s\n' "$1" | REFRESHED_IDS="$2" awk '
		BEGIN {
			n = split(ENVIRON["REFRESHED_IDS"], found, "\n")
			for (i = 1; i <= n; i++) if (found[i] != "") present[found[i]] = 1
		}
		$0 != "" && !($0 in present) { missing = 1 }
		END { exit missing ? 0 : 1 }
	'
}

docker_compose_status()
{
	if [ ! -r "$CONFIG_FILE" ]; then
		ids=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
		[ -n "$ids" ] || return "$OCF_NOT_RUNNING"
		ocf_log err "containers are active but cannot verify expected services without $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	fi
	services=$(desired_services) && [ -n "$services" ] || {
		ocf_log err "cannot determine the configured services for $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	}
	observe_containers || return "$OCF_ERR_GENERIC"
	docker_container_status "$services" $observed_ids
	result=$?
	if [ "$result" -eq "$INSPECT_FAILED" ]; then
		# The listed object can disappear after enumeration. Re-read the
		# current set and evaluate that. An inspect or enumeration failure
		# that still applies to a container we can list stays an error.
		previous_ids=$observed_ids
		observe_containers || return "$OCF_ERR_GENERIC"
		if container_disappeared "$previous_ids" "$observed_ids"; then
			ocf_log info "listed container disappeared before inspection; rechecking $CONFIG_FILE"
			docker_container_status "$services" $observed_ids
			result=$?
			if [ "$result" -eq "$INSPECT_FAILED" ]; then
				ocf_log err "failed to inspect Docker containers for $CONFIG_FILE"
				return "$OCF_ERR_GENERIC"
			fi
		else
			ocf_log err "failed to inspect Docker containers for $CONFIG_FILE"
			return "$OCF_ERR_GENERIC"
		fi
	fi
	return "$result"
}

docker_compose_start()
{
	docker_compose_validate_all
	docker_compose_status
	case "$?" in
		"$OCF_SUCCESS") return "$OCF_SUCCESS" ;;
		"$COMPOSE_PARTIAL"|"$OCF_NOT_RUNNING")
			# up targets the current project. Prove that its IDs belong to
			# this config and no other project still runs its services.
			labeled_container_ids reconcile "$compose_ids" >/dev/null || return "$OCF_ERR_GENERIC"
			;;
		*) return "$OCF_ERR_GENERIC" ;;
	esac

	if ! run_compose up -d; then
		ocf_log err "docker compose up failed"
		return "$OCF_ERR_GENERIC"
	fi
	if ! docker_compose_status; then
		ocf_log err "Compose containers could not be confirmed running after up"
		return "$OCF_ERR_GENERIC"
	fi
	return "$OCF_SUCCESS"
}

# The project name compose down will use. Prefer the resolved Compose
# model, then the directory name Compose uses when the file sets none.
compose_project_name()
{
	fallback=$(printf '%s\n' "${DIR##*/}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')
	name=
	if [ -r "$CONFIG_FILE" ] && [ -x "$OCF_RESKEY_binpath" ]; then
		if model=$(run_compose config --format json); then
			name=$(printf '%s\n' "$model" | python3 -I -c '
import json, re, sys
document = json.load(sys.stdin)
value = document.get("name") or ""
if not isinstance(value, str):
    value = ""
print(re.sub(r"[^a-z0-9_-]", "", value.lower()))
') || name=
		fi
	fi
	[ -n "$name" ] || name=$fallback
	printf '%s\n' "$name"
}

confirm_containers_stopped()
{
	[ "$#" -gt 0 ] || return "$OCF_SUCCESS"
	states=$(docker inspect --format='{{.State.Status}}' "$@") || return "$OCF_ERR_GENERIC"
	if printf '%s\n' "$states" | awk -v count="$#" '
		$0 != "exited" && $0 != "created" { active = 1 }
		END { exit (NR != count || active) }
	'; then
		return "$OCF_SUCCESS"
	fi
	ocf_log err "Compose containers could not be confirmed stopped"
	return "$OCF_ERR_GENERIC"
}

docker_compose_stop()
{
	# compose down stops the current project in dependency order and keeps
	# each service's configured grace period. It does not stop one-offs or
	# containers that still belong to an earlier project. One docker stop
	# signals only those skipped containers, overlapped with down, so two
	# 60s grace periods fit in the 120s Pacemaker budget. No shorter
	# timeout is passed: Docker uses each container's StopTimeout.
	stop_pid=
	compose_project=
	if [ -r "$CONFIG_FILE" ] && [ -x "$OCF_RESKEY_binpath" ]; then
		compose_project=$(compose_project_name) || compose_project=
		if [ -n "$compose_project" ] && skipped=$(labeled_container_ids shutdown); then
			if [ -n "$skipped" ]; then
				docker stop $skipped >/dev/null 2>&1 &
				stop_pid=$!
			fi
		fi
	fi

	compose_ids=
	if ! { [ -r "$CONFIG_FILE" ] && [ -x "$OCF_RESKEY_binpath" ] &&
		run_compose down && compose_ids=$(run_compose ps -aq); }; then
		compose_ids=
		if [ -n "$stop_pid" ]; then
			wait "$stop_pid" || true
			stop_pid=
		fi
		ocf_log warn "Compose shutdown unavailable or failed, trying Docker label-based removal"
		remove_containers || return "$OCF_ERR_GENERIC"
	fi
	if [ -n "$stop_pid" ]; then
		wait "$stop_pid" || true
	fi

	# down can miss one-offs and services under an earlier project name.
	remaining=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
	if [ -n "$remaining" ]; then
		docker stop $remaining >/dev/null
		# A --rm container may disappear during stop. Verify the final state.
		remaining=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
		if [ -n "$remaining" ]; then
			ocf_log err "containers still active for $CONFIG_FILE: $remaining"
			return "$OCF_ERR_GENERIC"
		fi
	fi
	if [ -n "$compose_ids" ]; then
		compose_ids=$(run_compose ps -aq) || return "$OCF_ERR_GENERIC"
		confirm_containers_stopped $compose_ids || return "$OCF_ERR_GENERIC"
	fi
	return "$OCF_SUCCESS"
}

docker_compose_validate_all()
{
	if ! check_binary "$OCF_RESKEY_binpath"; then
		ocf_log err "missing binary $OCF_RESKEY_binpath."
		exit $OCF_ERR_ARGS
	fi
	if [ ! -e "$OCF_RESKEY_dirpath" ]; then
		ocf_log err "diretory $OCF_RESKEY_dirpath is not found."
		exit $OCF_ERR_ARGS
	elif [ ! -d "$OCF_RESKEY_dirpath" ]; then
		ocf_log err "diretory $OCF_RESKEY_dirpath is not a directory."
		exit $OCF_ERR_ARGS
	fi
	if [ ! -r "$CONFIG_FILE" ]; then
		ocf_log err "cannot read Compose file $CONFIG_FILE"
		exit $OCF_ERR_ARGS
	fi

	return $OCF_SUCCESS
}


#
# Main
#

if [ $# -ne 1 ]; then
	usage
	exit $OCF_ERR_ARGS
fi

case $1 in
	start)	
		docker_compose_start
		;;

	stop)	
		docker_compose_stop
		;;

	status|monitor)
		docker_compose_status
		result=$?
		[ "$result" != "$COMPOSE_PARTIAL" ] || result=$OCF_ERR_GENERIC
		exit "$result"
		;;

	validate-all)
		docker_compose_validate_all
		;;

	meta-data)
		meta_data
		;;

	usage)	usage
		exit $OCF_SUCCESS
		;;

	*)	usage
		exit $OCF_ERR_UNIMPLEMENTED
		;;
esac
