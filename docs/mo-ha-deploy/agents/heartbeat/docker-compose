#!/bin/sh
# Version: 1.1.2
# Date: 2020-06-24
#
# Resource script for running docker-compose
#
# Description:  Manages docker services using docker-compose as an OCF
#               resource in an High Availability setup.
#               It relies on a well-tested docker compose YAML file which
#               distributed on an identical location on all cluster nodes.
#
# Caveat: 1. A YAML file (docker-compose.yml) and an optional Dockerfile
#            must be provided in a working directory.
#         2. It is suggested to test run the docker-compose and verify
#            on all cluster nodes before enabling this agent.
#
# docker-compose OCF script's Author: Kenny Chen <netman@study-area.org>
# License: GNU General Public License (GPL)
#
#	usage: $0 {start|stop|status|monitor|validate-all|meta-data}
#
#	The "start" arg starts docker service.
#	The "stop" arg stops it.
#
# OCF parameters:
# OCF_RESKEY_binpath
# OCF_RESKEY_dirpath
# OCF_RESKEY_ymlfile
#
##########################################################################
# Initialization:

: ${OCF_ROOT:=/usr/lib/ocf}
: ${OCF_FUNCTIONS_DIR=${OCF_ROOT}/lib/heartbeat}
. ${OCF_FUNCTIONS_DIR}/ocf-shellfuncs

# Defaults
OCF_RESKEY_binpath_default=/usr/bin/docker-compose
OCF_RESKEY_ymlfile_default=docker-compose.yml
: ${OCF_RESKEY_binpath=${OCF_RESKEY_binpath_default}}
: ${OCF_RESKEY_ymlfile=${OCF_RESKEY_ymlfile_default}}

USAGE="Usage: $0 {start|stop|status|monitor|validate-all|meta-data}"

##########################################################################

usage()
{
	echo $USAGE >&2
}

meta_data()
{
cat <<END
<?xml version="1.0"?>
<!DOCTYPE resource-agent SYSTEM "ra-api-1.dtd">
<resource-agent name="docker-compose" version="1.0.3">
<version>1.0</version>
<longdesc lang="en">
Manages docker services using docker-compose as an OCF resource in an High Availability setup.
It relies on a well-tested docker compose YAML file which distributed on an identical location on all cluster nodes.

Caveat: 1. A YAML file (docker-compose.yml) and an optional Dockerfile
           must be provided in a working directory.
        2. It is suggested to test run the docker-compose and verify on all cluster nodes
           before enabling this agent.
</longdesc>
<shortdesc lang="en">This script manages docker services using docker-compose.</shortdesc> 

<parameters>

<parameter name="binpath">
<longdesc lang="en">
The docker-composer binary path.
For example, "/usr/bin/docker-compose"
</longdesc>
<shortdesc lang="en">The docker-composer binary path</shortdesc>
<content type="string" default="$OCF_RESKEY_binpath_default"/>
</parameter>

<parameter name="dirpath" required="1">
<longdesc lang="en">
The directory contains docker compose yaml file.
For example, "/data/docker"
</longdesc>
<shortdesc lang="en">Directory contains docker compose files</shortdesc>
<content type="string"/>
</parameter>

<parameter name="ymlfile">
<longdesc lang="en">
The docker-compose yaml file.
For example, "docker-compose.yml"
</longdesc>
<shortdesc lang="en">The docker compose yaml</shortdesc>
<content type="string" default="$OCF_RESKEY_ymlfile_default"/>
</parameter>

</parameters>

<actions>
<action name="start" timeout="240s"/>
<action name="stop" timeout="120s"/>
<action name="monitor" depth="0" timeout="10s" interval="60s" />
<action name="validate-all" timeout="5s" />
<action name="meta-data"  timeout="5s"/>
</actions>
</resource-agent>
END
exit $OCF_SUCCESS
}

if [ -r "$OCF_RESKEY_binpath" -a -x "$OCF_RESKEY_binpath" ]; then
	COMMAND="$OCF_RESKEY_binpath"
else
	COMMAND="$OCF_RESKEY_binpath_default"
fi

DIR="$OCF_RESKEY_dirpath"
# Internal status for a successful inspection that found a partial project.
# Only start may reconcile it. A monitor always reports it as an OCF error.
COMPOSE_PARTIAL=42
YML="$OCF_RESKEY_ymlfile"
case "$YML" in
	/*) CONFIG_FILE=$YML ;;
	*)  CONFIG_FILE=$DIR/$YML ;;
esac

run_compose()
(
	CDPATH= cd "$DIR" || exit 1
	"$COMMAND" -f "$YML" "$@"
)

labeled_container_ids()
{
	# Compose labels retain the config path after the file disappears or
	# its project name changes. An empty Compose result alone is inconclusive.
	project_dir=$(CDPATH= cd "$(dirname "$CONFIG_FILE")" && pwd) || return "$OCF_ERR_GENERIC"
	config_path=${project_dir%/}/${CONFIG_FILE##*/}
	format='{{.ID}}{{"\t"}}{{.Names}}{{"\t"}}{{.Label "com.docker.compose.project"}}{{"\t"}}{{.Label "com.docker.compose.project.config_files"}}{{"\t"}}{{.Label "com.docker.compose.oneoff"}}{{"\t"}}{{.State}}'
	containers=$(docker ps --all --no-trunc --format "$format") || {
		ocf_log err "failed to enumerate Docker containers for $config_path"
		return "$OCF_ERR_GENERIC"
	}

	# Names only flag possible ownership conflicts. They cannot authorize
	# stopping a container, even when it has the template name "matrixone".
	if ! ids=$(printf '%s\n' "$containers" |
		OCF_COMPOSE_CONFIG="$config_path" OCF_COMPOSE_DIR="${project_dir##*/}" OCF_CURRENT_IDS="${2:-}" awk -F '\t' -v selection="$1" '
		BEGIN {
			prefix = tolower(ENVIRON["OCF_COMPOSE_DIR"])
			gsub(/[^a-z0-9_-]/, "", prefix)
			legacy = prefix
			gsub(/[_-]/, "", legacy)
			n = split(ENVIRON["OCF_CURRENT_IDS"], current, "\n")
			for (i = 1; i <= n; i++)
				if (current[i] != "") unverified[current[i]] = 1
		}
		{
			oneoff = (tolower($5) == "true")
			active = ($6 != "exited" && $6 != "created")
		}
		oneoff && (selection == "monitor" || (!active && selection != "reconcile")) { next }
		$3 != "" && $4 == ENVIRON["OCF_COMPOSE_CONFIG"] {
			if (project != "" && project != $3) ambiguous = 1
			project = $3
			if (selection == "reconcile") {
				if (active && !oneoff && !($1 in unverified)) ambiguous = 1
				delete unverified[$1]
			} else if (selection == "active" ? active : !oneoff) print $1
			next
		}
		$2 == "matrixone" ||
		($2 ~ /[_-][0-9]+$/ && (index($2, prefix "-") == 1 ||
			index($2, prefix "_") == 1 || index($2, legacy "-") == 1 ||
			index($2, legacy "_") == 1)) { ambiguous = 1 }
		END {
			for (id in unverified) ambiguous = 1
			exit ambiguous
		}
	'); then
		ocf_log err "cannot verify container ownership for $config_path"
		return "$OCF_ERR_GENERIC"
	fi
	printf '%s\n' "$ids"
}

remove_containers()
{
	ids=$(labeled_container_ids services) || return "$OCF_ERR_GENERIC"
	failed=0
	for id in $ids; do
		# kill can fail for an already stopped container. rm without --force
		# succeeds only when Docker can remove the container safely.
		docker kill "$id" >/dev/null 2>&1
		if ! docker rm "$id" >/dev/null; then
			ocf_log err "failed to remove Docker container $id"
			failed=$OCF_ERR_GENERIC
		fi
	done
	return "$failed"
}

docker_container_status()
{
	expected_services=$1
	shift
	[ "$#" -gt 0 ] || return "$OCF_NOT_RUNNING"
	format='{{.State.Running}}|{{.State.Status}}|{{.State.ExitCode}}|{{index .Config.Labels "com.docker.compose.oneoff"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{index .Config.Labels "com.docker.compose.depends_on"}}'
	states=$(docker inspect --format="$format" "$@") || {
		ocf_log err "failed to inspect Docker containers for $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	}

	# Compose records service_completed_successfully dependencies on the
	# dependent container. Only a successful exit satisfies that condition.
	printf '%s\n' "$states" | OCF_EXPECTED_SERVICES="$expected_services" awk -F '[|]' -v not_running="$OCF_NOT_RUNNING" -v partial="$COMPOSE_PARTIAL" '
		NF != 6 || ($1 != "true" && $1 != "false") { invalid = 1; next }
		tolower($4) == "true" { next }
		{
			seen[$5] = 1
			if ($1 == "true") running = 1
			else if ($2 == "exited" && $3 == "0") exited[$5] = 1
			else stopped = 1

			count = split($6, dependencies, ",")
			for (i = 1; i <= count; i++) {
				split(dependencies[i], dependency, ":")
				if (dependency[2] == "service_completed_successfully")
					init[dependency[1]] = 1
			}
		}
		END {
			if (invalid) exit 2
			if (!running) exit not_running
			count = split(ENVIRON["OCF_EXPECTED_SERVICES"], services, "\n")
			for (i = 1; i <= count; i++)
				if (services[i] != "" && !(services[i] in seen)) stopped = 1
			for (service in exited)
				if (!(service in init)) stopped = 1
			exit stopped ? partial : 0
		}
	'
	result=$?
	case "$result" in
		"$OCF_SUCCESS"|"$OCF_NOT_RUNNING") return "$result" ;;
		"$COMPOSE_PARTIAL") ocf_log warn "only some Compose services are running"; return "$result" ;;
		*) ocf_log err "invalid state for Docker containers of $CONFIG_FILE" ;;
	esac
	return "$OCF_ERR_GENERIC"
}

docker_compose_status()
{
	if [ ! -r "$CONFIG_FILE" ]; then
		ids=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
		[ -n "$ids" ] || return "$OCF_NOT_RUNNING"
		ocf_log err "containers are active but cannot verify expected services without $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	fi
	services=$(run_compose config --services) && [ -n "$services" ] || {
		ocf_log err "cannot determine the configured services for $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	}
	compose_ids=$(run_compose ps -aq) || {
		ocf_log err "failed to enumerate Compose containers for $CONFIG_FILE"
		return "$OCF_ERR_GENERIC"
	}
	docker_container_status "$services" $compose_ids
	result=$?
	[ "$result" = "$OCF_NOT_RUNNING" ] || return "$result"

	ids=$(labeled_container_ids monitor) || return "$OCF_ERR_GENERIC"
	docker_container_status "$services" $ids
}

docker_compose_start()
{
	docker_compose_validate_all
	docker_compose_status
	case "$?" in
		"$OCF_SUCCESS") return "$OCF_SUCCESS" ;;
		"$COMPOSE_PARTIAL")
			# up targets the current project. Prove that its IDs belong to
			# this config and no other project still runs its services.
			labeled_container_ids reconcile "$compose_ids" >/dev/null || return "$OCF_ERR_GENERIC"
			;;
		"$OCF_NOT_RUNNING") ;;
		*) return "$OCF_ERR_GENERIC" ;;
	esac

	if ! run_compose up -d; then
		ocf_log err "docker compose up failed"
		return "$OCF_ERR_GENERIC"
	fi
	if ! docker_compose_status; then
		ocf_log err "Compose containers could not be confirmed running after up"
		return "$OCF_ERR_GENERIC"
	fi
	return "$OCF_SUCCESS"
}

confirm_containers_stopped()
{
	docker_container_status "" "$@"
	[ "$?" = "$OCF_NOT_RUNNING" ] && return "$OCF_SUCCESS"
	ocf_log err "Compose containers could not be confirmed stopped"
	return "$OCF_ERR_GENERIC"
}

docker_compose_stop()
{
	compose_ids=
	if ! { [ -r "$CONFIG_FILE" ] && [ -x "$OCF_RESKEY_binpath" ] &&
		run_compose down && compose_ids=$(run_compose ps -aq); }; then
		compose_ids=
		ocf_log warn "Compose shutdown unavailable or failed, trying Docker label-based removal"
		remove_containers || return "$OCF_ERR_GENERIC"
	fi

	# down can miss one-offs and services under an earlier project name.
	remaining=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
	if [ -n "$remaining" ]; then
		docker stop $remaining >/dev/null
		# A --rm container may disappear during stop. Verify the final state.
		remaining=$(labeled_container_ids active) || return "$OCF_ERR_GENERIC"
		if [ -n "$remaining" ]; then
			ocf_log err "containers still active for $CONFIG_FILE: $remaining"
			return "$OCF_ERR_GENERIC"
		fi
	fi
	if [ -n "$compose_ids" ]; then
		compose_ids=$(run_compose ps -aq) || return "$OCF_ERR_GENERIC"
		confirm_containers_stopped $compose_ids || return "$OCF_ERR_GENERIC"
	fi
	return "$OCF_SUCCESS"
}

docker_compose_validate_all()
{
	if ! check_binary "$OCF_RESKEY_binpath"; then
		ocf_log err "missing binary $OCF_RESKEY_binpath."
		exit $OCF_ERR_ARGS
	fi
	if [ ! -e "$OCF_RESKEY_dirpath" ]; then
		ocf_log err "diretory $OCF_RESKEY_dirpath is not found."
		exit $OCF_ERR_ARGS
	elif [ ! -d "$OCF_RESKEY_dirpath" ]; then
		ocf_log err "diretory $OCF_RESKEY_dirpath is not a directory."
		exit $OCF_ERR_ARGS
	fi
	if [ ! -r "$CONFIG_FILE" ]; then
		ocf_log err "cannot read Compose file $CONFIG_FILE"
		exit $OCF_ERR_ARGS
	fi

	return $OCF_SUCCESS
}


#
# Main
#

if [ $# -ne 1 ]; then
	usage
	exit $OCF_ERR_ARGS
fi

case $1 in
	start)	
		docker_compose_start
		;;

	stop)	
		docker_compose_stop
		;;

	status|monitor)
		docker_compose_status
		result=$?
		[ "$result" != "$COMPOSE_PARTIAL" ] || result=$OCF_ERR_GENERIC
		exit "$result"
		;;

	validate-all)
		docker_compose_validate_all
		;;

	meta-data)
		meta_data
		;;

	usage)	usage
		exit $OCF_SUCCESS
		;;

	*)	usage
		exit $OCF_ERR_UNIMPLEMENTED
		;;
esac
