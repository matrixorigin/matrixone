+++ b/pkg/vm/engine/readutil/r3_local_real_reader_test.go
@@ -0,0 +1,196 @@
+//go:build mo_m0
+
+package readutil
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+
+	pkgcatalog "github.com/matrixorigin/matrixone/pkg/catalog"
+	"github.com/matrixorigin/matrixone/pkg/common/mpool"
+	"github.com/matrixorigin/matrixone/pkg/container/batch"
+	"github.com/matrixorigin/matrixone/pkg/container/types"
+	"github.com/matrixorigin/matrixone/pkg/container/vector"
+	"github.com/matrixorigin/matrixone/pkg/defines"
+	"github.com/matrixorigin/matrixone/pkg/fileservice"
+	"github.com/matrixorigin/matrixone/pkg/objectio"
+	"github.com/matrixorigin/matrixone/pkg/objectio/ioutil"
+	"github.com/matrixorigin/matrixone/pkg/pb/plan"
+	"github.com/matrixorigin/matrixone/pkg/pb/timestamp"
+	"github.com/matrixorigin/matrixone/pkg/vm/engine"
+	"github.com/stretchr/testify/require"
+)
+
+func r3Table(version uint32) *plan.TableDef {
+	id := &plan.ColDef{Name: "id", Seqnum: 0, Typ: plan.Type{Id: int32(types.T_int32)}}
+	tenant := &plan.ColDef{Name: "tenant", Seqnum: 1, Typ: plan.Type{Id: int32(types.T_int32)}}
+	pk := &plan.ColDef{Name: pkgcatalog.CPrimaryKeyColName, Seqnum: 2, Hidden: true, Primary: true, Typ: plan.Type{Id: int32(types.T_varchar)}}
+	added := &plan.ColDef{Name: "added", Seqnum: 3, Typ: plan.Type{Id: int32(types.T_int32)}, Default: &plan.Default{NullAbility: true}}
+	rowid := &plan.ColDef{Name: pkgcatalog.Row_ID, Seqnum: 4, Hidden: true, Typ: plan.Type{Id: int32(types.T_Rowid)}}
+	return &plan.TableDef{
+		Name: "r3", Version: version,
+		Pkey:          &plan.PrimaryKeyDef{Names: []string{"id", "tenant"}, PkeyColName: pk.Name, CompPkeyCol: pk},
+		Cols:          []*plan.ColDef{id, tenant, pk, added, rowid},
+		Name2ColIndex: map[string]int32{"id": 0, "tenant": 1, pk.Name: 2, "added": 3, rowid.Name: 4},
+	}
+}
+
+func r3WriteBlock(t *testing.T, fs fileservice.FileService, mp *mpool.MPool, badType, hole bool) objectio.BlockInfo {
+	t.Helper()
+	seqs := []uint16{0, 1, 2}
+	if hole {
+		seqs = []uint16{0, 2}
+	}
+	bat := batch.NewWithSize(len(seqs))
+	t.Cleanup(func() { bat.Clean(mp) })
+	for i, seq := range seqs {
+		switch {
+		case seq == 2:
+			bat.Vecs[i] = vector.NewVec(types.T_varchar.ToType())
+			require.NoError(t, vector.AppendBytes(bat.Vecs[i], []byte("one"), false, mp))
+			require.NoError(t, vector.AppendBytes(bat.Vecs[i], []byte("two"), false, mp))
+		case seq == 0 && badType:
+			bat.Vecs[i] = vector.NewVec(types.T_int64.ToType())
+			require.NoError(t, vector.AppendFixedList(bat.Vecs[i], []int64{11, 22}, nil, mp))
+		default:
+			bat.Vecs[i] = vector.NewVec(types.T_int32.ToType())
+			values := []int32{11, 22}
+			if seq == 1 {
+				values = []int32{1, 2}
+			}
+			require.NoError(t, vector.AppendFixedList(bat.Vecs[i], values, nil, mp))
+		}
+	}
+	bat.SetRowCount(2)
+	writer := ioutil.ConstructWriter(0, seqs, len(seqs)-1, true, false, fs)
+	_, err := writer.WriteBatch(bat)
+	require.NoError(t, err)
+	_, _, err = writer.Sync(context.Background())
+	require.NoError(t, err)
+	stats := writer.GetObjectStats()
+	return stats.ConstructBlockInfo(0)
+}
+
+func r3Env(t *testing.T) (fileservice.FileService, *mpool.MPool) {
+	t.Helper()
+	fs, err := fileservice.NewMemoryFS(defines.SharedFileServiceName, fileservice.DisabledCacheConfig, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { fs.Close(context.Background()) })
+	mp := mpool.MustNewZero()
+	t.Cleanup(func() { require.Zero(t, mp.CurrNB()); mpool.DeleteMPool(mp) })
+	return fs, mp
+}
+
+func r3Read(t *testing.T, fs fileservice.FileService, mp *mpool.MPool, table *plan.TableDef, info objectio.BlockInfo, columns []string) error {
+	t.Helper()
+	ctx := context.Background()
+	source := &singlePersistedBlockSource{info: info}
+	r, err := NewReader(ctx, mp, nil, fs, table, timestamp.Timestamp{}, nil, source, 0, engine.FilterHint{})
+	require.NoError(t, err)
+	closed := false
+	t.Cleanup(func() {
+		if !closed {
+			_ = r.Close()
+		}
+	})
+	out := batch.NewWithSize(len(columns))
+	t.Cleanup(func() { out.Clean(mp) })
+	for i := range out.Vecs {
+		out.Vecs[i] = vector.NewVec(types.T_int32.ToType())
+	}
+	_, err = r.Read(ctx, columns, nil, mp, out)
+	if err == nil {
+		require.Equal(t, 2, out.RowCount())
+		require.Equal(t, []int32{11, 22}, vector.MustFixedColWithTypeCheck[int32](out.Vecs[0]))
+		if len(columns) == 2 {
+			require.Equal(t, 2, out.Vecs[1].Length())
+			require.True(t, out.Vecs[1].IsNull(0))
+			require.True(t, out.Vecs[1].IsNull(1))
+		}
+	}
+	if atomic.LoadInt32(&source.closeCount) == 0 {
+		require.NoError(t, r.Close())
+	}
+	closed = true
+	require.Equal(t, int32(1), atomic.LoadInt32(&source.closeCount))
+	out.Clean(mp)
+	return err
+}
+
+func TestR3RealClassificationAndReader(t *testing.T) {
+	require.True(t, activeM0ReadLocationProofEnabled)
+	t.Run("same_object_valid_then_version_mismatch", func(t *testing.T) {
+		fs, mp := r3Env(t)
+		info := r3WriteBlock(t, fs, mp, false, false)
+		valid := r3Table(1)
+		proven, proof, err := proveM0ReadLocation(context.Background(), valid, info.MetaLocation(), fs)
+		require.NoError(t, err)
+		require.True(t, proven)
+		require.Equal(t, uint32(3), proof.WrittenSize)
+		require.Equal(t, uint32(4), proof.SchemaSize)
+		require.NoError(t, r3Read(t, fs, mp, valid, info, []string{"id", "added"}))
+		mismatch := r3Table(0)
+		proven, _, err = proveM0ReadLocation(context.Background(), mismatch, info.MetaLocation(), fs)
+		require.NoError(t, err)
+		require.False(t, proven)
+		err = r3Read(t, fs, mp, mismatch, info, []string{"id", "added"})
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+		t.Logf("R3_FLOW valid=proof+NULL mismatch=not_M0,reader,ObjectIO_reject object=%s", info.MetaLocation().Name().String())
+	})
+	for _, tc := range []struct {
+		name          string
+		badType, hole bool
+	}{
+		{name: "wrong_type", badType: true}, {name: "prefix_hole", hole: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fs, mp := r3Env(t)
+			info := r3WriteBlock(t, fs, mp, tc.badType, tc.hole)
+			proven, _, err := proveM0ReadLocation(context.Background(), r3Table(1), info.MetaLocation(), fs)
+			require.True(t, proven)
+			require.Error(t, err)
+			readErr := r3Read(t, fs, mp, r3Table(1), info, []string{"id", "added"})
+			require.Error(t, readErr)
+			t.Logf("R3_FLOW %s classification=error reader=error", tc.name)
+		})
+	}
+	t.Run("proof_bound_to_object", func(t *testing.T) {
+		fs, mp := r3Env(t)
+		first := r3WriteBlock(t, fs, mp, false, false)
+		second := r3WriteBlock(t, fs, mp, false, false)
+		ok, proof, err := proveM0ReadLocation(context.Background(), r3Table(1), first.MetaLocation(), fs)
+		require.NoError(t, err)
+		require.True(t, ok)
+		obj, err := objectio.NewObjectReaderWithStr(second.MetaLocation().Name().String(), fs)
+		require.NoError(t, err)
+		meta, err := obj.ReadAllMeta(context.Background(), mp)
+		require.NoError(t, err)
+		data := meta.MustDataMeta()
+		ctx := objectio.WithM0ProvenObject(context.Background(), proof)
+		_, err = objectio.ReadOneBlock(ctx, &data, second.MetaLocation().Name().String(), 0, []uint16{3}, []types.Type{types.T_int32.ToType()}, mp, fs, fileservice.SkipAllCache)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+		t.Log("R3_FLOW real_proof_wrong_object=ObjectIO_reject; relation_membership=external_owner")
+	})
+	t.Run("lookalike_source_requires_membership", func(t *testing.T) {
+		fs, mp := r3Env(t)
+		first := r3WriteBlock(t, fs, mp, false, false)
+		foreign := r3WriteBlock(t, fs, mp, false, false)
+		require.NotEqual(t, first.MetaLocation().Name().String(), foreign.MetaLocation().Name().String())
+		proven, _, err := proveM0ReadLocation(context.Background(), r3Table(1), foreign.MetaLocation(), fs)
+		require.NoError(t, err)
+		require.True(t, proven)
+		require.NoError(t, r3Read(t, fs, mp, r3Table(1), foreign, []string{"id", "added"}))
+		t.Log("R3_FLOW synthetic_foreign_source=accepted_by_location_reader; relation_membership_not_exercised")
+	})
+	t.Run("ordinary_present_column", func(t *testing.T) {
+		fs, mp := r3Env(t)
+		info := r3WriteBlock(t, fs, mp, false, false)
+		ordinary := &plan.TableDef{Name: "ordinary", Pkey: &plan.PrimaryKeyDef{Names: []string{"id"}, PkeyColName: "id"}, Cols: []*plan.ColDef{{Name: "id", Seqnum: 0, Primary: true, Typ: plan.Type{Id: int32(types.T_int32)}}}, Name2ColIndex: map[string]int32{"id": 0}}
+		proven, _, err := proveM0ReadLocation(context.Background(), ordinary, info.MetaLocation(), fs)
+		require.NoError(t, err)
+		require.False(t, proven)
+		require.NoError(t, r3Read(t, fs, mp, ordinary, info, []string{"id"}))
+		t.Log("R3_FLOW ordinary=not_M0,present_column_OK")
+	})
+}
