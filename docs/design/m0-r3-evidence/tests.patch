+package objectio
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/matrixorigin/matrixone/pkg/common/mpool"
+	"github.com/matrixorigin/matrixone/pkg/container/batch"
+	"github.com/matrixorigin/matrixone/pkg/container/types"
+	"github.com/matrixorigin/matrixone/pkg/container/vector"
+	"github.com/matrixorigin/matrixone/pkg/defines"
+	"github.com/matrixorigin/matrixone/pkg/fileservice"
+	"github.com/stretchr/testify/require"
+)
+
+func TestR3LocalOrdinaryMissingColumn(t *testing.T) {
+	root, nameFile := os.Getenv("R3_OBJECT_DIR"), os.Getenv("R3_OBJECT_NAME_FILE")
+	require.NotEmpty(t, root)
+	require.NotEmpty(t, nameFile)
+	ctx := context.Background()
+	fs, err := fileservice.NewLocalFS2(ctx, defines.SharedFileServiceName, root, fileservice.DisabledCacheConfig, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { fs.Close(ctx) })
+	mp := mpool.MustNewZero()
+	t.Cleanup(func() {
+		require.Zero(t, mp.CurrNB())
+		mpool.DeleteMPool(mp)
+	})
+
+	if os.Getenv("R3_CREATE") == "1" {
+		bat := batch.NewWithSize(1)
+		t.Cleanup(func() { bat.Clean(mp) })
+		bat.SetVector(0, vector.NewVec(types.T_int32.ToType()))
+		require.NoError(t, vector.AppendFixedList(bat.Vecs[0], []int32{11, 22}, nil, mp))
+		bat.SetRowCount(2)
+		id := NewObjectid()
+		name := BuildObjectNameWithObjectID(&id)
+		writer, e := NewObjectWriter(name, fs, 0, []uint16{0}, nil)
+		require.NoError(t, e)
+		_, e = writer.Write(bat)
+		require.NoError(t, e)
+		_, e = writer.WriteEnd(ctx)
+		require.NoError(t, e)
+		bat.Clean(mp)
+		require.NoError(t, os.WriteFile(nameFile, []byte(name.String()), 0600))
+	}
+	nameData, err := os.ReadFile(nameFile)
+	require.NoError(t, err)
+	name := strings.TrimSpace(string(nameData))
+	raw, err := os.ReadFile(filepath.Join(root, name))
+	require.NoError(t, err)
+	hash := sha256.Sum256(raw)
+	t.Logf("R3_OBJECT name=%s sha256=%s bytes=%d", name, hex.EncodeToString(hash[:]), len(raw))
+	reader, err := NewObjectReaderWithStr(name, fs)
+	require.NoError(t, err)
+	metadata, err := reader.ReadAllMeta(ctx, mp)
+	require.NoError(t, err)
+	meta := metadata.MustDataMeta()
+	require.Equal(t, uint32(2), meta.GetBlockMeta(0).GetRows())
+	io, err := ReadOneBlock(ctx, &meta, name, 0, []uint16{0}, []types.Type{types.T_int32.ToType()}, mp, fs, fileservice.SkipAllCache)
+	require.NoError(t, err)
+	presentAny, err := DecodeCached(io.Entries[0].CachedData)
+	require.NoError(t, err)
+	present := presentAny.(*vector.Vector)
+	require.Equal(t, []int32{11, 22}, vector.MustFixedColWithTypeCheck[int32](present))
+	require.Equal(t, types.T_int32, present.GetType().Oid)
+	ReleaseIOVector(&io)
+
+	io, err = ReadOneBlock(ctx, &meta, name, 0, []uint16{1}, []types.Type{types.T_int32.ToType()}, mp, fs, fileservice.SkipAllCache)
+	if os.Getenv("R3_EXPECT") == "reject" {
+		require.Error(t, err)
+		require.ErrorContains(t, err, "objectio: missing normal column without proof")
+		t.Logf("R3_MISSING result=reject stage=ReadOneBlock")
+	} else {
+		require.NoError(t, err)
+		missingAny, e := DecodeCached(io.Entries[0].CachedData)
+		require.NoError(t, e)
+		missing := missingAny.(*vector.Vector)
+		require.Equal(t, types.T_int32, missing.GetType().Oid)
+		require.Equal(t, 2, missing.Length())
+		require.True(t, missing.IsNull(0))
+		require.True(t, missing.IsNull(1))
+		ReleaseIOVector(&io)
+		t.Logf("R3_MISSING result=null rows=2 type=int32")
+	}
+	rawAfter, err := os.ReadFile(filepath.Join(root, name))
+	require.NoError(t, err)
+	require.Equal(t, hash, sha256.Sum256(rawAfter))
+}
diff --git a/pkg/vm/engine/readutil/r3_local_real_reader_test.go b/pkg/vm/engine/readutil/r3_local_real_reader_test.go
