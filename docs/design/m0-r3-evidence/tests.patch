+++ b/pkg/tests/sqlintegration/r3_create_copy_sql_test.go
@@ -0,0 +1,89 @@
+//go:build mo_m0
+
+package sqlintegration
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/matrixorigin/matrixone/pkg/embed"
+	"github.com/matrixorigin/matrixone/pkg/pb/metadata"
+	"github.com/stretchr/testify/require"
+)
+
+func TestR3CreateCopyCloneRestartIdentity(t *testing.T) {
+	runSQLIntegration(t, func(cluster embed.Cluster) {
+		ctx, cancel := context.WithTimeout(t.Context(), 4*time.Minute)
+		defer cancel()
+		cn, err := cluster.GetCNService(0)
+		require.NoError(t, err)
+		db := openM0SQL(t, cn)
+		defer func() { _ = db.Close() }()
+		const schema = "r3_create_copy_root"
+		const parent = schema + ".customer"
+		const child = schema + ".customer_clone"
+		defer cleanupSQLIntegration(t, cn, "drop database if exists "+schema)
+
+		m0Exec(t, ctx, db, "create database "+schema)
+		m0Exec(t, ctx, db, "create table "+parent+m0RollbackCustomerSchema)
+		m0Exec(t, ctx, db, "insert into "+parent+" values (1,1,1,100,10,1),(2,2,2,200,20,2)")
+		m0Exec(t, ctx, db, "select mo_ctl('dn','flush','"+parent+"')")
+		initialID, initialVersion := m0TableGeneration(t, ctx, db, schema, "customer")
+		initialLayout := m0StoredColumnLayout(t, ctx, db, schema, "customer")
+		initialObjects := m0ObjectHeaderProofs(t, ctx, db, cn, parent)
+		require.NotEmpty(t, initialObjects)
+		require.Equal(t, uint32(0), initialVersion)
+		t.Logf("R3_CREATE id=%d version=%d tn_version=%d layout=%v objects=%v", initialID, initialVersion, m0TNCatalogSchemaVersion(t, ctx, db, parent), initialLayout, initialObjects)
+
+		m0Exec(t, ctx, db, "alter table "+parent+" add column copied int, algorithm=copy")
+		m0Exec(t, ctx, db, "select mo_ctl('dn','flush','"+parent+"')")
+		copyID, copyVersion := m0TableGeneration(t, ctx, db, schema, "customer")
+		copyLayout := m0StoredColumnLayout(t, ctx, db, schema, "customer")
+		copyObjects := m0ObjectHeaderProofs(t, ctx, db, cn, parent)
+		require.NotEmpty(t, copyObjects)
+		require.NotEqual(t, initialID, copyID)
+		require.Equal(t, 2, m0Count(t, ctx, db, "select count(*) from "+parent+" where copied is null"))
+		t.Logf("R3_COPY id=%d version=%d tn_version=%d layout=%v objects=%v", copyID, copyVersion, m0TNCatalogSchemaVersion(t, ctx, db, parent), copyLayout, copyObjects)
+
+		m0Exec(t, ctx, db, "create table "+child+" clone "+parent)
+		childID, childVersion := m0TableGeneration(t, ctx, db, schema, "customer_clone")
+		childLayout := m0StoredColumnLayout(t, ctx, db, schema, "customer_clone")
+		childObjects := m0ObjectHeaderProofs(t, ctx, db, cn, child)
+		require.NotEqual(t, copyID, childID)
+		require.Equal(t, copyVersion, childVersion)
+		require.Equal(t, copyLayout, childLayout)
+		require.Equal(t, copyObjects, childObjects)
+		t.Logf("R3_CLONE id=%d version=%d tn_version=%d layout=%v objects=%v", childID, childVersion, m0TNCatalogSchemaVersion(t, ctx, db, child), childLayout, childObjects)
+
+		m0Exec(t, ctx, db, "select mo_ctl('dn','globalcheckpoint','')")
+		tn := m0ServiceOfType(t, cluster, metadata.ServiceType_TN)
+		require.NoError(t, db.Close())
+		require.NoError(t, cn.Close())
+		require.NoError(t, tn.Close())
+		require.NoError(t, tn.Start())
+		require.NoError(t, cn.Start())
+		db = openM0SQL(t, cn)
+		parentIDAfter, parentVersionAfter := m0TableGeneration(t, ctx, db, schema, "customer")
+		childIDAfter, childVersionAfter := m0TableGeneration(t, ctx, db, schema, "customer_clone")
+		require.Equal(t, copyID, parentIDAfter)
+		require.Equal(t, copyVersion, parentVersionAfter)
+		require.Equal(t, childID, childIDAfter)
+		require.Equal(t, childVersion, childVersionAfter)
+		require.Equal(t, copyLayout, m0StoredColumnLayout(t, ctx, db, schema, "customer"))
+		require.Equal(t, childLayout, m0StoredColumnLayout(t, ctx, db, schema, "customer_clone"))
+		require.Equal(t, copyObjects, m0ObjectHeaderProofs(t, ctx, db, cn, parent))
+		require.Equal(t, childObjects, m0ObjectHeaderProofs(t, ctx, db, cn, child))
+		require.Equal(t, 2, m0Count(t, ctx, db, "select count(*) from "+child+" where copied is null"))
+		t.Logf("R3_RESTART parent_id=%d parent_version=%d parent_tn_version=%d child_id=%d child_version=%d child_tn_version=%d", parentIDAfter, parentVersionAfter, m0TNCatalogSchemaVersion(t, ctx, db, parent), childIDAfter, childVersionAfter, m0TNCatalogSchemaVersion(t, ctx, db, child))
+
+		m0Exec(t, ctx, db, "alter table "+child+" add column after_clone int")
+		childIDFinal, childVersionFinal := m0TableGeneration(t, ctx, db, schema, "customer_clone")
+		require.Equal(t, childID, childIDFinal)
+		require.Equal(t, childVersion+1, childVersionFinal)
+		require.Equal(t, childObjects, m0ObjectHeaderProofs(t, ctx, db, cn, child))
+		require.Equal(t, 2, m0Count(t, ctx, db, "select count(*) from "+child+" where copied is null and after_clone is null"))
+		require.Equal(t, 0, m0Count(t, ctx, db, "select count(*) from information_schema.columns where table_schema='"+schema+"' and table_name='customer' and column_name='after_clone'"))
+		t.Logf("R3_APPEND id=%d version=%d tn_version=%d layout=%v", childIDFinal, childVersionFinal, m0TNCatalogSchemaVersion(t, ctx, db, child), m0StoredColumnLayout(t, ctx, db, schema, "customer_clone"))
+	})
+}
