+//go:build integration && viewmetadatabench
+
+package frontend_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/matrixorigin/matrixone/pkg/cnservice"
+	"github.com/matrixorigin/matrixone/pkg/container/vector"
+	"github.com/matrixorigin/matrixone/pkg/embed"
+	"github.com/matrixorigin/matrixone/pkg/util/executor"
+	"github.com/stretchr/testify/require"
+)
+
+// 历史生产源码不变；同口径私有 statement adapter 的小控制，不测 wall-clock 门槛。
+func TestViewMetadataS6B0Adapter(t *testing.T) {
+	runNativeViewSchemaCluster(t, func(cn embed.ServiceOperator, svc cnservice.Service) {
+		ctx, cancel := context.WithTimeout(viewMetadataBenchContext(), 2*time.Minute)
+		defer cancel()
+		shape := viewMetadataBenchShape{name: "contract", roots: 2, depth: 2, columns: 2, unrelated: 1}
+		database, names := setupViewMetadataBench(t, svc, shape)
+		mode := viewMetadataBenchModes[0]
+		result, err := svc.GetSQLExecutor().Exec(ctx,
+			"select viewdef from mo_catalog.mo_tables where account_id=0 and reldatabase='information_schema' and lower(relname)='columns'", executor.Options{})
+		require.NoError(t, err)
+		func() {
+			defer result.Close()
+			rows := 0
+			result.ReadRows(func(n int, columns []*vector.Vector) bool {
+				require.Len(t, columns, 1)
+				for i := 0; i < n; i++ {
+					require.Contains(t, strings.ToLower(columns[0].GetStringAt(i)), "mo_view_columns")
+				}
+				rows += n
+				return true
+			})
+			require.Equal(t, 1, rows)
+		}()
+		read := func(ctx context.Context, selected []string, widened bool) viewMetadataBenchSample {
+			return readViewMetadataBench(ctx, cn, svc, database, selected, 2, mode, false, false, false, widened)
+		}
+		t.Run("ordinary table", func(t *testing.T) {
+			require.NoError(t, read(ctx, []string{"source"}, false).err)
+		})
+		t.Run("complete view results", func(t *testing.T) {
+			require.NoError(t, read(ctx, names, false).err)
+		})
+		t.Run("concurrent statements", func(t *testing.T) {
+			start := make(chan struct{})
+			done := make(chan error, 2)
+			for range 2 {
+				go func() { <-start; done <- read(ctx, names, false).err }()
+			}
+			close(start)
+			// 在任何断言前 join 两个 worker，失败也不遗留活动读者。
+			first, second := <-done, <-done
+			require.NoError(t, first)
+			require.NoError(t, second)
+		})
+		t.Run("pre cancelled", func(t *testing.T) {
+			cancelled, cancel := context.WithCancel(ctx)
+			cancel()
+			require.ErrorIs(t, read(cancelled, names, false).err, context.Canceled)
+		})
+		t.Run("oracle rejects missing rows", func(t *testing.T) {
+			require.ErrorContains(t, read(ctx, []string{"missing"}, false).err, "metadata rows 0, want 2")
+		})
+		require.NoError(t, viewMetadataBenchExec(ctx, svc, database, "alter table source modify column c0000 bigint"))
+		t.Run("first read after DDL", func(t *testing.T) {
+			require.NoError(t, read(ctx, names, true).err)
+			require.NoError(t, read(ctx, []string{"source"}, true).err)
+		})
+	})
+}
