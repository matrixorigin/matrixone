    "ProbeSources": {
      "candidate_probe.go": "package compile\n\nimport (\n \"os\"\n \"path/filepath\"\n \"testing\"\n \"github.com/matrixorigin/matrixone/pkg/container/types\"\n \"github.com/matrixorigin/matrixone/pkg/defines\"\n \"github.com/matrixorigin/matrixone/pkg/pb/pipeline\"\n planpb \"github.com/matrixorigin/matrixone/pkg/pb/plan\"\n \"github.com/matrixorigin/matrixone/pkg/pb/query\"\n \"github.com/matrixorigin/matrixone/pkg/sql/colexec/projection\"\n plan2 \"github.com/matrixorigin/matrixone/pkg/sql/plan\"\n \"github.com/matrixorigin/matrixone/pkg/sql/plan/function\"\n \"github.com/matrixorigin/matrixone/pkg/vm/engine\"\n \"github.com/stretchr/testify/require\"\n)\nfunc TestLoomSetKeyWireExport(t *testing.T) {\n c,_:=expressionProtocolTestCompile(t)\n require.Equal(t,int64(122),defines.MORPCLatestVersion)\n for _,typ:=range []types.T{types.T_float32,types.T_float64} {\n  arg:=plan2.GetColExpr(typ.ToType().PlanType(),0,0)\n  key,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"set_operation_float_key\",[]*planpb.Expr{arg});require.NoError(t,err)\n  id,_:=function.DecodeOverloadID(key.GetF().Func.Obj);require.Equal(t,int32(601),id)\n  control,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"abs\",[]*planpb.Expr{arg});require.NoError(t,err)\n  division,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"div\",[]*planpb.Expr{plan2.GetColExpr(types.New(types.T_decimal64,10,3).PlanType(),0,0),plan2.GetColExpr(types.T_uint64.ToType().PlanType(),0,1)});require.NoError(t,err)\n  p:=&pipeline.Pipeline{InstructionList:[]*pipeline.Instruction{{ProjectList:[]*planpb.Expr{key,control,division}}}}\n  data,err:=p.Marshal();require.NoError(t,err)\n  require.NoError(t,os.WriteFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),typ.String()+\".wire\"),data,0600))\n  t.Logf(\"candidate bound %s overload=%d bytes=%d\",typ,key.GetF().Func.Obj,len(data))\n }\n}\nfunc TestLoomObservedMainWorkerExclusion(t *testing.T) {\n data,err:=os.ReadFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),\"main-response.wire\"));require.NoError(t,err)\n var response query.Response;require.NoError(t,response.Unmarshal(data));require.Equal(t,int64(121),response.GetProtocolVersion.Version)\n for _,typ:=range []types.T{types.T_float32,types.T_float64} {\n  t.Run(typ.String(),func(t *testing.T){\n   c,client:=expressionProtocolTestCompile(t)\n   data,err:=os.ReadFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),typ.String()+\".wire\"));require.NoError(t,err)\n   var p pipeline.Pipeline;require.NoError(t,p.Unmarshal(data));expr:=p.InstructionList[0].ProjectList[0]\n   client.customResponse=true;client.response=&response\n   c.execType=plan2.ExecTypeAP_MULTICN;c.cnList=engine.Nodes{{Id:\"old-worker\",Addr:\"remote:6001\",Mcpu:4}}\n   require.NoError(t,c.constrainRemoteExpressionWorkers(&planpb.Query{Nodes:[]*planpb.Node{{PhysicalEqualityKeyList:[]*planpb.Expr{expr}}},Steps:[]int32{0}}))\n   require.Equal(t,plan2.ExecTypeAP_ONECN,c.execType)\n   op:=projection.NewArgument();defer op.Release();op.ProjectList=[]*planpb.Expr{expr}\n   scope:=&Scope{Magic:Remote,Proc:c.proc,NodeInfo:engine.Node{Id:\"old-worker\",Addr:\"remote:6001\"},RootOp:op}\n   encoded,err:=encodeRemoteScope(scope,c.proc);require.ErrorContains(t,err,\"version 122\");require.Nil(t,encoded)\n   require.Positive(t,client.calls);require.Equal(t,client.calls,client.releases)\n   t.Logf(\"actual official response version=%d placement=coordinator sendErr=%v\",response.GetProtocolVersion.Version,err)\n  })\n }\n}\n",
      "official_probe.go": "package compile\nimport (\n \"os\"\n \"path/filepath\"\n \"testing\"\n \"github.com/matrixorigin/matrixone/pkg/container/types\"\n \"github.com/matrixorigin/matrixone/pkg/defines\"\n \"github.com/matrixorigin/matrixone/pkg/pb/pipeline\"\n \"github.com/matrixorigin/matrixone/pkg/sql/colexec\"\n \"github.com/matrixorigin/matrixone/pkg/sql/plan/function\"\n \"github.com/stretchr/testify/require\"\n)\nfunc TestLoomOfficialMain121MissingSetKey(t *testing.T){\n require.Equal(t,int64(121),defines.MORPCLatestVersion)\n c,_:=expressionProtocolTestCompile(t)\n for _,typ:=range []types.T{types.T_float32,types.T_float64}{\n  data,err:=os.ReadFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),typ.String()+\".wire\"));require.NoError(t,err)\n  var p pipeline.Pipeline;require.NoError(t,p.Unmarshal(data))\n  key,control:=p.InstructionList[0].ProjectList[0],p.InstructionList[0].ProjectList[1]\n  _,exists:=function.GetFunctionByIdWithoutError(key.GetF().Func.Obj);require.False(t,exists)\n  require.NoError(t,validateRemoteExpressionPipelineProtocol(c.proc,&p))\n  native,err:=colexec.NewExpressionExecutor(c.proc,control);require.NoError(t,err);native.Free()\n  divNative,divErr:=colexec.NewExpressionExecutor(c.proc,p.InstructionList[0].ProjectList[2]);require.NoError(t,divErr);divNative.Free()\n  native,err=colexec.NewExpressionExecutor(c.proc,key);require.Nil(t,native);require.ErrorContains(t,err,\"function overload id not found\")\n  t.Logf(\"official version=%d type=%s wireAdmission=accepted function601=false ordinaryControl=constructed keyErr=%v\",defines.MORPCLatestVersion,typ,err)\n }\n}\n",
      "query_probe.go": "package queryservice\nimport (\n \"context\"\n \"os\"\n \"path/filepath\"\n \"testing\"\n moruntime \"github.com/matrixorigin/matrixone/pkg/common/runtime\"\n \"github.com/matrixorigin/matrixone/pkg/defines\"\n \"github.com/matrixorigin/matrixone/pkg/pb/query\"\n \"github.com/stretchr/testify/require\"\n)\nfunc TestLoomOfficialProtocolResponse(t *testing.T){\n require.Equal(t,int64(121),defines.MORPCLatestVersion)\n const sid=\"loom-main121-probe\"\n moruntime.SetupServiceBasedRuntime(sid,moruntime.DefaultRuntime())\n s:=&queryService{serviceID:sid};resp:=&query.Response{}\n require.NoError(t,s.handleGetProtocolVersion()(context.Background(),&query.Request{GetProtocolVersion:&query.GetProtocolVersionRequest{}},resp,nil))\n require.Equal(t,int64(121),resp.GetProtocolVersion.Version)\n data,err:=resp.Marshal();require.NoError(t,err);require.NoError(t,os.WriteFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),\"main-response.wire\"),data,0600))\n t.Logf(\"official real handleGetProtocolVersion response=%d bytes=%d\",resp.GetProtocolVersion.Version,len(data))\n}\n"
