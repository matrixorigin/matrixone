        "candidate_probe.go": "package compile\n\nimport (\n \"os\"\n \"path/filepath\"\n \"testing\"\n \"github.com/matrixorigin/matrixone/pkg/container/types\"\n \"github.com/matrixorigin/matrixone/pkg/defines\"\n \"github.com/matrixorigin/matrixone/pkg/pb/pipeline\"\n planpb \"github.com/matrixorigin/matrixone/pkg/pb/plan\"\n \"github.com/matrixorigin/matrixone/pkg/pb/query\"\n \"github.com/matrixorigin/matrixone/pkg/sql/colexec/projection\"\n plan2 \"github.com/matrixorigin/matrixone/pkg/sql/plan\"\n \"github.com/matrixorigin/matrixone/pkg/sql/plan/function\"\n \"github.com/matrixorigin/matrixone/pkg/vm/engine\"\n \"github.com/stretchr/testify/require\"\n)\nfunc TestLoomSetKeyWireExport(t *testing.T) {\n c,_:=expressionProtocolTestCompile(t)\n require.Equal(t,int64(124),defines.MORPCLatestVersion)\n for _,typ:=range []types.T{types.T_float32,types.T_float64} {\n  arg:=plan2.GetColExpr(typ.ToType().PlanType(),0,0)\n  key,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"set_operation_float_key\",[]*planpb.Expr{arg});require.NoError(t,err)\n  id,_:=function.DecodeOverloadID(key.GetF().Func.Obj);require.Equal(t,int32(601),id)\n  control,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"abs\",[]*planpb.Expr{arg});require.NoError(t,err)\n  division,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"div\",[]*planpb.Expr{plan2.GetColExpr(types.New(types.T_decimal64,10,3).PlanType(),0,0),plan2.GetColExpr(types.T_uint64.ToType().PlanType(),0,1)});require.NoError(t,err)\n  temporal,err:=plan2.BindFuncExprImplByPlanExpr(c.proc.Ctx,\"timestamp\",[]*planpb.Expr{plan2.GetColExpr(types.T_datetime.ToTypeWithScale(3).PlanType(),0,3)});require.NoError(t,err)\n  p:=&pipeline.Pipeline{InstructionList:[]*pipeline.Instruction{{ProjectList:[]*planpb.Expr{key,control,division,temporal}}}}\n  data,err:=p.Marshal();require.NoError(t,err)\n  require.NoError(t,os.WriteFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),typ.String()+\".wire\"),data,0600))\n  t.Logf(\"candidate bound %s overload=%d bytes=%d\",typ,key.GetF().Func.Obj,len(data))\n }\n}\nfunc TestLoomObservedMainWorkerExclusion(t *testing.T) {\n data,err:=os.ReadFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),\"main-response.wire\"));require.NoError(t,err)\n var response query.Response;require.NoError(t,response.Unmarshal(data));require.Equal(t,int64(123),response.GetProtocolVersion.Version)\n for _,typ:=range []types.T{types.T_float32,types.T_float64} {\n  t.Run(typ.String(),func(t *testing.T){\n   c,client:=expressionProtocolTestCompile(t)\n   data,err:=os.ReadFile(filepath.Join(os.Getenv(\"MO_LOOM_PROBE_DIR\"),typ.String()+\".wire\"));require.NoError(t,err)\n   var p pipeline.Pipeline;require.NoError(t,p.Unmarshal(data));expr:=p.InstructionList[0].ProjectList[0]\n   client.customResponse=true;client.response=&response\n   c.execType=plan2.ExecTypeAP_MULTICN;c.cnList=engine.Nodes{{Id:\"old-worker\",Addr:\"remote:6001\",Mcpu:4}}\n   require.NoError(t,c.constrainRemoteExpressionWorkers(&planpb.Query{Nodes:[]*planpb.Node{{PhysicalEqualityKeyList:[]*planpb.Expr{expr}}},Steps:[]int32{0}}))\n   require.Equal(t,plan2.ExecTypeAP_ONECN,c.execType)\n   op:=projection.NewArgument();defer op.Release();op.ProjectList=[]*planpb.Expr{expr}\n   scope:=&Scope{Magic:Remote,Proc:c.proc,NodeInfo:engine.Node{Id:\"old-worker\",Addr:\"remote:6001\"},RootOp:op}\n   encoded,err:=encodeRemoteScope(scope,c.proc);require.ErrorContains(t,err,\"version 124\");require.Nil(t,encoded)\n   require.Positive(t,client.calls);require.Equal(t,client.calls,client.releases)\n   t.Logf(\"actual official response version=%d placement=coordinator sendErr=%v\",response.GetProtocolVersion.Version,err)\n  })\n }\n}\n",
