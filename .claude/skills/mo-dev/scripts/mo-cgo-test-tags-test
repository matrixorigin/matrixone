# Checks that MO_CL_CUDA=1 always reaches `go test` with the gpu build tag, in whichever
# form the caller wrote their own -tags.
#
# This exists because the wrapper used to SKIP `-tags gpu` whenever the caller passed any
# -tags of their own, on the reasoning that go test keeps only the last -tags. The effect
# was a false green:
#
#     MO_CL_CUDA=1 mo-cgo-test -tags typecheck ./pkg/vectorindex/metric/
#
# ran with `-tags typecheck`, so every //go:build gpu file and test was excluded from a run
# whose whole purpose was GPU validation, and it passed.
#
# Runs with no GPU, no CUDA toolkit and no built libmo. Getting that right takes more than
# stubbing `go`: the wrapper resolves its repository from its OWN location and refuses to
# run unless cgo/libmo.so and thirdparties/install/include exist there, and it does so
# BEFORE it would invoke the stub. Pointed at the real checkout this test therefore passed
# only on machines that happened to have built libmo, and failed every case with
# "<no -tags at all>" in a clean worktree -- reporting a wrapper that never ran as a wrapper
# that dropped the tag.
#
# So the test builds a throwaway git repository, copies the REAL wrapper into it (never a
# reimplementation of it), and creates empty stand-ins for the two prerequisites. The
# wrapper under test is the shipped one; only its surroundings are fake. Every invocation
# is checked for a zero exit before its stdout is parsed, so a prerequisite or setup fault
# can never again be misreported as a tag-merging fault.
#
# Usage: sh .agents/skills/mo-dev/scripts/mo-cgo-test-tags-test

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
wrapper="$script_dir/mo-cgo-test"

if [ ! -f "$wrapper" ]; then
    echo "cannot find the wrapper under test: $wrapper" >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin"

# --- the fake repository -----------------------------------------------------------
# The wrapper derives repo_root from `git -C <its own dir> rev-parse --show-toplevel`, so
# the copy has to live inside a real git repository for its paths to resolve.
fake="$work/repo"
mkdir -p "$fake/.agents/skills/mo-dev/scripts" "$fake/cgo" \
         "$fake/thirdparties/install/include" "$fake/thirdparties/install/lib"
git -C "$fake" init --quiet
# Deliberately not an ELF file. The wrapper only tests these for existence, and a
# non-ELF stand-in also keeps `readelf -d` from reporting a CUDA dependency, which is what
# lets the MO_CL_CUDA-unset case below assert rather than skip.
: > "$fake/cgo/libmo.so"
fake_wrapper="$fake/.agents/skills/mo-dev/scripts/mo-cgo-test"
cp "$wrapper" "$fake_wrapper"
chmod +x "$fake_wrapper"

cat > "$work/bin/go" <<'STUB'
#!/bin/sh
while [ $# -gt 0 ]; do
  case "$1" in
    -C) shift 2 ;;
    env)
      case "$2" in
        GOOS|GOHOSTOS) echo linux ;;
        GOARCH|GOHOSTARCH) echo amd64 ;;
        CGO_ENABLED) echo 1 ;;
        *) echo "" ;;
      esac
      exit 0 ;;
    list) echo "-lmo -lstdc++"; exit 0 ;;
    test) shift; echo "GO_TEST_ARGS: $*"; exit 0 ;;
    *) shift ;;
  esac
done
STUB
chmod +x "$work/bin/go"

failures=0

# run_wrapper runs the real wrapper inside the fake repo. It prints the wrapper's combined
# output and returns its exit status; callers must check that status before parsing.
run_wrapper() {
    env MO_CL_CUDA="$MO_CL_CUDA_SETTING" CONDA_PREFIX="$work" PATH="$work/bin:$PATH" \
        sh "$fake_wrapper" "$@" 2>&1
}

MO_CL_CUDA_SETTING=1

# --- preflight ---------------------------------------------------------------------
# Prove the harness itself works before drawing conclusions from it. Without this, any
# setup fault reads as seven tag failures.
set +e
preflight=$(run_wrapper ./pkg/x/); preflight_status=$?
set -e
if [ "$preflight_status" -ne 0 ]; then
    printf 'harness broken: the wrapper exited %d in the fake repo\n' "$preflight_status" >&2
    printf '%s\n' "$preflight" >&2
    exit 1
fi
case "$preflight" in
    *GO_TEST_ARGS:*) ;;
    *)
        echo "harness broken: the stubbed go was never reached" >&2
        printf '%s\n' "$preflight" >&2
        exit 1 ;;
esac
printf 'ok   harness: wrapper runs with no built libmo\n'

# tags_of prints the -tags/--tags flag (and its value) the wrapper would hand go test.
tags_of() {
    printf '%s' "$1" |
        grep -oE 'GO_TEST_ARGS:.*' |
        grep -oE '\-{1,2}tags[= ][^ ]+' |
        head -1
}

check() {
    want=$1
    shift
    set +e
    out=$(run_wrapper "$@"); status=$?
    set -e
    if [ "$status" -ne 0 ]; then
        printf 'FAIL %-38s -> wrapper exited %d: %s\n' "$*" "$status" \
            "$(printf '%s' "$out" | head -1)"
        failures=$((failures + 1))
        return
    fi
    got=$(tags_of "$out" || true)
    if [ "$got" = "$want" ]; then
        printf 'ok   %-38s -> %s\n' "$*" "$got"
    else
        printf 'FAIL %-38s -> %s (want %s)\n' "$*" "${got:-<no -tags at all>}" "$want"
        failures=$((failures + 1))
    fi
}

check "-tags gpu"             ./pkg/x/
check "-tags typecheck,gpu"   -tags typecheck ./pkg/x/
check "-tags=typecheck,gpu"   -tags=typecheck ./pkg/x/
check "--tags=a,b,gpu"        --tags=a,b ./pkg/x/
check "-tags gpu"             -tags gpu ./pkg/x/
check "-tags=foo,gpu"         -tags=foo,gpu ./pkg/x/
check "-tags typecheck,gpu"   -count=1 -tags typecheck -race ./pkg/x/

# The caller's other flags and the package list must survive the rewrite untouched.
set +e
full=$(run_wrapper -count=1 -tags typecheck -race ./pkg/x/); full_status=$?
set -e
if [ "$full_status" -ne 0 ]; then
    printf 'FAIL argv check: wrapper exited %d\n' "$full_status"
    failures=$((failures + 1))
else
    full=$(printf '%s' "$full" | grep -oE 'GO_TEST_ARGS:.*')
    for expect in '-count=1' '-race' './pkg/x/' '-tags typecheck,gpu'; do
        case "$full" in
            *"$expect"*) printf 'ok   argv keeps %s\n' "$expect" ;;
            *) printf 'FAIL argv lost %s\n' "$expect"; failures=$((failures + 1)) ;;
        esac
    done
fi

# Without MO_CL_CUDA the wrapper must not inject gpu at all. The fake libmo is not a CUDA
# binary, so unlike a real CUDA-built checkout this case asserts instead of skipping.
MO_CL_CUDA_SETTING=
set +e
out=$(run_wrapper -tags typecheck ./pkg/x/); status=$?
set -e
if [ "$status" -ne 0 ]; then
    printf 'FAIL MO_CL_CUDA unset: wrapper exited %d: %s\n' "$status" \
        "$(printf '%s' "$out" | head -1)"
    failures=$((failures + 1))
else
    got=$(tags_of "$out" || true)
    if [ "$got" = "-tags typecheck" ]; then
        printf 'ok   MO_CL_CUDA unset leaves tags alone -> %s\n' "$got"
    else
        printf 'FAIL MO_CL_CUDA unset -> %s (want -tags typecheck)\n' "${got:-<none>}"
        failures=$((failures + 1))
    fi
fi

if [ "$failures" -ne 0 ]; then
    printf '\n%d check(s) failed\n' "$failures"
    exit 1
fi
printf '\nall checks passed\n'
