3  ¦  8.0
with knn as (
select id, l2_distance(v,'[1,1,1,1]') as d from t_cagra
order by l2_distance(v,'[1,1,1,1]') limit 3
) select id, d from knn order by d desc;
➤ id[-5,64,0]  ¦  d[8,9,0]  𝄀
3  ¦  8.0  𝄀
2  ¦  4.0  𝄀
