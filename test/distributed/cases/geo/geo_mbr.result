drop table if exists mbr_t;
create table mbr_t(id int, g geometry);
insert into mbr_t values
(1, st_geomfromtext('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))')),
(2, st_geomfromtext('POLYGON((2 2, 4 2, 4 4, 2 4, 2 2))')),
(3, st_geomfromtext('POLYGON((10 0, 20 0, 20 10, 10 10, 10 0))')),
(4, st_geomfromtext('POLYGON((20 20, 30 20, 30 30, 20 30, 20 20))')),
(5, st_geomfromtext('POLYGON((5 5, 15 5, 15 15, 5 15, 5 5))')),
(6, st_geomfromtext('POINT(5 5)')),
(7, st_geomfromtext('POINT(0 5)')),
(8, st_geomfromtext('LINESTRING(2 0, 8 0)')),
(9, st_geomfromtext('LINESTRING(2 5, 8 5)'));
select mbrcontains(a.g, b.g) as contains_, mbrwithin(b.g, a.g) as within_,
mbrcovers(a.g, b.g) as covers_, mbrcoveredby(b.g, a.g) as coveredby_
from mbr_t a, mbr_t b where a.id = 1 and b.id = 2;
contains_    within_    covers_    coveredby_
1    1    1    1
select mbrequals(a.g, b.g) as eq_self, mbrequals(a.g, c.g) as eq_other
from mbr_t a, mbr_t b, mbr_t c where a.id = 1 and b.id = 1 and c.id = 2;
eq_self    eq_other
1    0
select mbrdisjoint(a.g, b.g) as disjoint_far, mbrintersects(a.g, c.g) as intersects_inner
from mbr_t a, mbr_t b, mbr_t c where a.id = 1 and b.id = 4 and c.id = 2;
disjoint_far    intersects_inner
1    1
select mbrtouches(a.g, b.g) as touch_edge, mbrtouches(a.g, c.g) as touch_cross
from mbr_t a, mbr_t b, mbr_t c where a.id = 1 and b.id = 3 and c.id = 5;
touch_edge    touch_cross
1    0
select mbroverlaps(a.g, b.g) as ov_cross, mbroverlaps(a.g, c.g) as ov_inner, mbroverlaps(a.g, d.g) as ov_edge
from mbr_t a, mbr_t b, mbr_t c, mbr_t d where a.id = 1 and b.id = 5 and c.id = 2 and d.id = 3;
ov_cross    ov_inner    ov_edge
1    0    0
select mbrtouches(a.g, b.g) as equal_point_touches,
mbrwithin(a.g, b.g) as equal_point_within,
mbrcontains(a.g, b.g) as equal_point_contains,
mbrcoveredby(a.g, b.g) as equal_point_coveredby,
mbrcovers(a.g, b.g) as equal_point_covers
from mbr_t a, mbr_t b where a.id = 6 and b.id = 6;
equal_point_touches    equal_point_within    equal_point_contains    equal_point_coveredby    equal_point_covers
0    1    1    1    1
select mbrtouches(a.g, b.g) as inside_point_touches,
mbrwithin(b.g, a.g) as inside_point_within,
mbrcontains(a.g, b.g) as inside_point_contains,
mbrcoveredby(b.g, a.g) as inside_point_coveredby,
mbrcovers(a.g, b.g) as inside_point_covers
from mbr_t a, mbr_t b where a.id = 1 and b.id = 6;
inside_point_touches    inside_point_within    inside_point_contains    inside_point_coveredby    inside_point_covers
0    1    1    1    1
select mbrtouches(a.g, b.g) as boundary_point_touches,
mbrwithin(b.g, a.g) as boundary_point_within,
mbrcontains(a.g, b.g) as boundary_point_contains,
mbrcoveredby(b.g, a.g) as boundary_point_coveredby,
mbrcovers(a.g, b.g) as boundary_point_covers
from mbr_t a, mbr_t b where a.id = 1 and b.id = 7;
boundary_point_touches    boundary_point_within    boundary_point_contains    boundary_point_coveredby    boundary_point_covers
1    0    0    1    1
select mbrtouches(a.g, b.g) as edge_line_touches,
mbrwithin(b.g, a.g) as edge_line_within,
mbrcontains(a.g, b.g) as edge_line_contains,
mbrcoveredby(b.g, a.g) as edge_line_coveredby,
mbrcovers(a.g, b.g) as edge_line_covers
from mbr_t a, mbr_t b where a.id = 1 and b.id = 8;
edge_line_touches    edge_line_within    edge_line_contains    edge_line_coveredby    edge_line_covers
1    0    0    1    1
select mbrtouches(a.g, b.g) as inside_line_touches,
mbrwithin(b.g, a.g) as inside_line_within,
mbrcontains(a.g, b.g) as inside_line_contains,
mbrcoveredby(b.g, a.g) as inside_line_coveredby,
mbrcovers(a.g, b.g) as inside_line_covers
from mbr_t a, mbr_t b where a.id = 1 and b.id = 9;
inside_line_touches    inside_line_within    inside_line_contains    inside_line_coveredby    inside_line_covers
0    1    1    1    1
select mbrtouches(st_geomfromtext('POINT(0 0)'), st_geomfromtext('POINT(0 0)')) as equal_points_touch,
mbrtouches(st_geomfromtext('POINT(2 2)'), st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))')) as interior_point_touch,
mbrtouches(st_geomfromtext('POINT(0 2)'), st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))')) as boundary_point_touch,
mbrwithin(st_geomfromtext('POINT(0 2)'), st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))')) as boundary_point_within,
mbrcontains(st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))'), st_geomfromtext('POINT(0 2)')) as boundary_point_contains,
mbrcoveredby(st_geomfromtext('POINT(0 2)'), st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))')) as boundary_point_coveredby,
mbrcovers(st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))'), st_geomfromtext('POINT(0 2)')) as boundary_point_covers;
equal_points_touch    interior_point_touch    boundary_point_touch    boundary_point_within    boundary_point_contains    boundary_point_coveredby    boundary_point_covers
0    0    1    0    0    1    1
drop table mbr_t;
