select st_area(st_symdifference(st_geomfromtext('POLYGON((0 0, 4 0, 4 4, 0 4, 0 0))'), st_geomfromtext('POLYGON((2 2, 6 2, 6 6, 2 6, 2 2))'))) as xor_area;
