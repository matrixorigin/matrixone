drop table if exists gj_t;
create table gj_t(id int, g geometry);
insert into gj_t values (1, st_geomfromgeojson('{"type":"Point","coordinates":[10,20]}'));
select id, st_astext(g) from gj_t;
id    st_astext(g)
1    POINT(10 20)
drop table gj_t;
