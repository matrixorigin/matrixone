prepare cte_window from 'with recursive c(n) as (select 1 union all select n + 1 from c where n < 5 limit ? offset ?) select n from c order by n';
set @cte_limit = 2;
set @cte_offset = 1;
execute cte_window using @cte_limit, @cte_offset;
➤ n[-5,64,0]  𝄀
2  𝄀
3
set @cte_limit = 0;
execute cte_window using @cte_limit, @cte_offset;
➤ n[-5,64,0]
set @cte_limit = 1;
set @cte_offset = 3;
execute cte_window using @cte_limit, @cte_offset;
