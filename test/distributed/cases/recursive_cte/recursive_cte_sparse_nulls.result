with recursive filtered_tree as (
select id, name, father_id, level from industry_domain
where is_root = 1 and name like '%汽车%'
union all
select d.id, d.name, d.father_id, d.level from industry_domain d
inner join filtered_tree ft on d.father_id = ft.id
where ft.level < 3 and d.name is not null
)
select id, name, father_id, level from filtered_tree order by id limit 12;
