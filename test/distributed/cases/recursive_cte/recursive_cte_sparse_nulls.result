with recursive filtered_tree as (
select id, name, father_id, level from industry_domain
where is_root = 1 and name like '%汽车%'
union all
select d.id, d.name, d.father_id, d.level from industry_domain d
inner join filtered_tree ft on d.father_id = ft.id
where ft.level < 3 and d.name is not null
)
select count(*) as full_tree_rows from filtered_tree;
➤ full_tree_rows[-5,64,0]  𝄀
43
insert into industry_domain
select result, concat('sibling', result - 2000), 1, 0, 1
from generate_series(2000,2029,1) g;
with recursive filtered_tree as (
select id, name, father_id, level from industry_domain
where is_root = 1 and name like '%汽车%'
union all
select d.id, d.name, d.father_id, d.level from industry_domain d
inner join filtered_tree ft on d.father_id = ft.id
where ft.level < 3 and d.name is not null
)
select count(*) as wide_tree_rows, sum(father_id is null) as roots from filtered_tree;
➤ wide_tree_rows[-5,64,0]  ¦  roots[-5,64,0]  𝄀
