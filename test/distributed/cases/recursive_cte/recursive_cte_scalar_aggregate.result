WITH RECURSIVE multiple_groups(n, row_count) AS (
SELECT 1, 0
UNION ALL
SELECT n + 1, (SELECT COUNT(*) FROM limits_29135 GROUP BY limit_n)
FROM multiple_groups WHERE n < 2
)
SELECT n, row_count FROM multiple_groups;
