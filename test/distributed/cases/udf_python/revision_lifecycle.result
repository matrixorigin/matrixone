drop database if exists udf_python_revision_bvt;
create database udf_python_revision_bvt;
use udf_python_revision_bvt;
create function python_bvt_revision (x int) returns int language python as 'def python_bvt_revision(ctx, x): return None if x is None else x + 1' handler 'python_bvt_revision';
create table revision_values (id int, value int);
insert into revision_values values (1, 1), (2, null);
select id, python_bvt_revision(value) as result from revision_values order by id;
