➤ id[4,32,0]  ¦  cat[4,32,0]  𝄀
299999  ¦  0
begin;
insert all into t_narrow (id, cat) values (id + 1000000, cat) into t_plain (id, cat, val, pad) values (id + 1000000, cat, val, pad) select id, cat, val, pad from src;
select count(*) from t_plain;
➤ count(*)[-5,64,0]  𝄀
