drop database if exists issue_28680_ignore_conversion;
create database issue_28680_ignore_conversion;
use issue_28680_ignore_conversion;
set sql_mode='STRICT_TRANS_TABLES';
create table conversion_target(
id int primary key,
i tinyint,
u int unsigned,
d decimal(10,2),
dt date,
dtt datetime,
ts timestamp
);
insert ignore into conversion_target
values (1, 'abc', 'abc', 'abc', '2024-02-30',
'2024-02-30 25:00:00', '2024-02-30 25:00:00');
show warnings;
