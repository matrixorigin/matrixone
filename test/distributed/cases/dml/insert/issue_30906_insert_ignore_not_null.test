-- @suite
-- @case
-- @desc: INSERT IGNORE adjusts NULLs in NOT NULL columns to the implicit
--        type default and reports ER_BAD_NULL_ERROR warnings (issue #30906)
-- @label:bvt

drop database if exists issue_30906_insert_ignore_not_null;
create database issue_30906_insert_ignore_not_null;
use issue_30906_insert_ignore_not_null;

-- The reported single-row rejection must succeed and store the implicit
-- default of the column type, with warning 1048 per adjusted cell.
create table ig_issue(u int not null, nn int not null);
insert ignore into ig_issue(u, nn) values(2, null);
show warnings;
select * from ig_issue order by u;

-- The reported multi-row batch abort: one bad row must not kill the batch.
-- Every row is kept; the NULL cell alone is adjusted (MySQL 8.0.44 verified:
-- rows 10/11/12 all insert, nn=0 for the bad one).
insert ignore into ig_issue(u, nn) values(10, 10), (11, null), (12, 12);
show warnings;
select * from ig_issue order by u;

-- An all-NULL batch still writes the implicit defaults.
insert ignore into ig_issue(u, nn) values(null, null);
show warnings;
select * from ig_issue order by u;

-- Ordinary INSERT keeps the strict-mode failure.
insert into ig_issue(u, nn) values(40, null);
select * from ig_issue order by u;

-- Implicit defaults follow the column TYPE, not any declared DEFAULT.
create table ig_types(
    i int not null,
    di int not null default 7,
    s varchar(8) not null,
    de decimal(5,2) not null,
    d date not null,
    dt datetime not null,
    ts timestamp not null,
    j json not null,
    e enum('a','b') not null
);
insert ignore into ig_types(i, di, s, de, d, dt, ts, j, e)
values(null, null, null, null, null, null, null, null, null);
show warnings;
select i, di, s, de, d, dt, ts, j, e from ig_types;

-- Mixed validity: valid cells keep their values, NULL cells are adjusted.
insert ignore into ig_types(i, di, s, de, d, dt, ts, j, e) values
(1, null, 'two', null, '2024-02-03', null, '2024-02-03 04:05:06', '{"k":2}', null);
show warnings;
select i, di, s, de, d, dt, ts, e from ig_types order by i;

-- AUTO_INCREMENT NULL keeps allocating instead of writing zero.
create table ig_auto(id int not null auto_increment primary key, v int not null);
insert ignore into ig_auto(v) values(1), (2);
show warnings;
insert ignore into ig_auto values(null, null);
show warnings;
select * from ig_auto order by id;

-- NOT NULL adjustment composes with the row-level rules IGNORE already
-- honours: duplicate keys are skipped, NULL cells are adjusted in place.
create table ig_mixed(
    id int primary key,
    u int unique,
    nn int not null,
    c int,
    constraint ig_c check(c > 0)
);
insert into ig_mixed values(1, 10, 1, 1);
insert ignore into ig_mixed values
(1, 11, 1, 1),      -- duplicate primary key: row skipped
(2, 10, null, 2),   -- duplicate unique key: row skipped
(3, 30, null, 3),   -- NULL in NOT NULL: row kept, nn adjusted to 0
(4, 40, 4, 4),
(5, 50, 5, 5);
show warnings;
select * from ig_mixed order by id;

-- A CHECK violation and a NULL cell in one row: the row is still rejected by
-- the CHECK predicate after the NULL adjustment.
insert ignore into ig_mixed values(6, 60, null, -1);
show warnings;
select * from ig_mixed order by id;

-- INSERT IGNORE ... SELECT keeps the same semantics.
create table ig_src(x int, y int);
insert into ig_src values(1, 1), (2, null), (3, 3), (4, null);
create table ig_from_select(a int not null, b int not null);
insert ignore into ig_from_select select x, y from ig_src;
show warnings;
select * from ig_from_select order by a;

-- A NULL in a non-autoincrement PRIMARY KEY column skips the row instead of
-- writing several adjusted zero keys: the duplicate pipeline matches the
-- original values, so rows are dropped and reported with 1048. MySQL keeps
-- one implicit-default row plus 1062 skips here; that divergence is a
-- documented limitation of this fix.
create table ig_pk(id int primary key, nn int not null, v int);
insert ignore into ig_pk values (1, 10, 100);
insert ignore into ig_pk values (null, 20, 200), (2, null, 300), (null, null, 400);
show warnings;
select * from ig_pk order by id, nn;
-- Constant NULL keys from INSERT ... SELECT are skipped the same way.
insert ignore into ig_pk select null, 50, 500;
show warnings;
select * from ig_pk order by id, nn;
-- The strict statement keeps its fatal constraint violation.
insert into ig_pk values(null, 1, 1);
select * from ig_pk order by id, nn;

-- A NULL in a NOT NULL secondary unique column is adjusted before the index
-- write, so the duplicate machinery applies to the adjusted value
-- (MySQL 8.0.44 verified: one implicit-default row wins and the duplicates
-- are skipped with 1062).
create table ig_uknn(c int unique not null, d int);
insert ignore into ig_uknn values (null, 1), (null, 2), (5, 3), (5, 4);
show warnings;
select * from ig_uknn order by c;

-- A NULL in a NOT NULL child foreign-key column must not bypass the foreign
-- key: under IGNORE the parent-existence check sees the implicit-default
-- value the row would actually store, so a row whose adjusted key has no
-- parent is skipped exactly like an explicit FK violation (MySQL 8.0.44
-- verified: only the valid row survives, zero orphans).
create table fk_par(id int primary key);
create table fk_ch(id int primary key, pid int not null, constraint fk_pid foreign key (pid) references fk_par(id));
insert into fk_par values (7);
-- Explicit FK violation: row is skipped, statement continues.
insert ignore into fk_ch values (3, 99);
show warnings;
select * from fk_ch order by id;
-- NULL pid adjusts to 0 while parent 0 is absent: row skipped, valid rows kept.
insert ignore into fk_ch values (1, null), (2, 7);
show warnings;
select * from fk_ch order by id;
select count(*) as orphans from fk_ch left join fk_par on fk_ch.pid = fk_par.id where fk_par.id is null;
-- When parent 0 exists, the adjusted row is kept with the 1048 warning.
insert into fk_par values (0);
insert ignore into fk_ch values (4, null);
show warnings;
select * from fk_ch order by id;
drop table fk_ch;
-- A NULL in a nullable FK child column still stores NULL (MATCH SIMPLE).
create table fk_nullable(id int primary key, pid int, constraint fk_pid2 foreign key (pid) references fk_par(id));
insert ignore into fk_nullable values (1, null), (2, 7);
show warnings;
select * from fk_nullable order by id;
drop table fk_nullable;
-- UUID FK child column: the NULL cell is filled as the zero uuid on the write
-- side, and since no plan constant exists for that filled value the existence
-- check keeps the raw column, so the NULL row is still skipped rather than
-- stored as an orphan; explicit values stay fully enforced.
create table fk_uuid_par(id uuid primary key);
create table fk_uuid_ch(id int primary key, pid uuid not null, constraint fk_uuid foreign key (pid) references fk_uuid_par(id));
insert ignore into fk_uuid_ch values (1, null);
show warnings;
select count(*) as uuid_rows from fk_uuid_ch;
insert ignore into fk_uuid_ch values (2, '123e4567-e89b-12d3-a456-426614174001');
select count(*) as uuid_rows from fk_uuid_ch;
insert into fk_uuid_par values ('123e4567-e89b-12d3-a456-426614174000');
insert ignore into fk_uuid_ch values (3, '123e4567-e89b-12d3-a456-426614174000');
select * from fk_uuid_ch order by id;
drop table fk_uuid_ch;
drop table fk_uuid_par;
drop table fk_par;

-- GEOMETRY has no implicit default: the empty byte payload is not a readable
-- geometry, so INSERT IGNORE keeps the NOT NULL rejection instead of storing
-- a value the geometry functions cannot read (MySQL 8.0.44 verified: it
-- rejects with 3673; this engine keeps its constraint violation; in both
-- cases zero rows are stored).
create table ig_geo(id int, g geometry not null);
insert ignore into ig_geo values (1, null);
show warnings;
select id, st_astext(g) from ig_geo;
insert into ig_geo values (2, null);
select count(*) as geo_rows from ig_geo;
insert ignore into ig_geo values (2, st_geomfromtext('point(1 1)'));
select id, st_astext(g) from ig_geo;

-- review r4 (F1): a simple explicit primary key no longer skips the pre-insert
-- adjustment: NULL cells are filled before unique-key arbitration and index
-- encoding, so the adjusted key takes part in the unique check (MySQL 8.0.44:
-- one row kept with 1048 + 1062; the index and the table row agree afterwards).
create table r4_uq(id int primary key, a int not null, b int, unique key r4u(a, b));
insert ignore into r4_uq values (1, null, 7), (2, 0, 7);
show warnings;
select * from r4_uq order by id;
insert ignore into r4_uq values (5, 0, 7);
show warnings;
select * from r4_uq order by id;

-- review r4 (F2): the adjustment also runs before the CHECK filter, so the
-- adjusted zero row is rejected as a CHECK violation while the valid rows
-- remain (MySQL 8.0.44: only (2,5) is stored; warnings 1048 + 3819 + 3819).
create table r4_chk(id int primary key, a int not null check(a > 0));
insert ignore into r4_chk values (1, null), (2, 5), (3, -1);
show warnings;
select * from r4_chk order by id;

-- review r4 (F3): stored and virtual generated columns recompute from the
-- adjusted base value instead of the pre-adjustment NULL (MySQL 8.0.44:
-- (0,1),(4,5) for both).
create table r4_gc_s(a int not null, b int generated always as (a + 1) stored);
insert ignore into r4_gc_s(a) values (null), (4);
show warnings;
select * from r4_gc_s order by a;
create table r4_gc_v(a int not null, b int generated always as (a + 1) virtual);
insert ignore into r4_gc_v(a) values (null), (4);
show warnings;
select * from r4_gc_v order by a;

-- review r4 (F6): a NOT NULL foreign-key child candidate publishes its 1048
-- warning before the foreign-key filter drops the parentless row; the row
-- itself is still skipped, so no orphan is stored.
create table r4_fk_par(id int primary key);
create table r4_fk_ch(id int primary key, pid int not null, constraint r4_fk foreign key (pid) references r4_fk_par(id));
insert into r4_fk_par values (7);
insert ignore into r4_fk_ch values (1, null), (2, 7);
show warnings;
select * from r4_fk_ch order by id;
select count(*) as orphans from r4_fk_ch left join r4_fk_par on r4_fk_ch.pid = r4_fk_par.id where r4_fk_par.id is null;
-- The adjusted value is validated against the parent: when the implicit default
-- value itself exists in the parent the row is kept with its 1048 warning.
insert into r4_fk_par values (0);
insert ignore into r4_fk_ch values (3, null);
show warnings;
select * from r4_fk_ch order by id;
drop table r4_fk_ch;
drop table r4_fk_par;

-- review r4 (F5): a UUID child column is validated against its actual filled
-- zero value: the row is skipped while no parent holds it and kept once the
-- parent contains the zero uuid (previously the row was dropped silently in
-- both cases).
create table r4_uuid_par(id uuid primary key);
create table r4_uuid_ch(id int primary key, pid uuid not null, constraint r4_uuid_fk foreign key (pid) references r4_uuid_par(id));
insert ignore into r4_uuid_ch values (1, null);
show warnings;
select count(*) as uuid_rows from r4_uuid_ch;
insert into r4_uuid_par values ('00000000-0000-0000-0000-000000000000');
insert ignore into r4_uuid_ch values (2, null);
show warnings;
select id, pid from r4_uuid_ch order by id;
drop table r4_uuid_ch;
drop table r4_uuid_par;

-- review r4: the NULL primary key keeps its pinned drop semantics: such rows
-- never store several adjusted zero keys in one statement.
create table r4_pk(id int primary key, nn int not null, v int);
insert ignore into r4_pk values (null, 20, 200), (2, null, 300), (null, null, 400);
show warnings;
select * from r4_pk order by id;

-- review r6 (F1): the NULL primary-key drop resolves the key by name, so a
-- key declared in a non-first column position still drops its NULL-key rows;
-- no implicit-default duplicate primary keys are written (the pinned drop
-- divergence: both NULL-key rows are dropped with their 1048 warnings).
create table r6_f1t(a int, id int primary key);
insert ignore into r6_f1t values (10, null), (20, null);
show warnings;
select a, id from r6_f1t order by a, id;
create table r6_f1c(a int, id int primary key);
insert into r6_f1c values (1, 0);
insert ignore into r6_f1c values (10, null), (20, null);
show warnings;
select a, id from r6_f1c order by a, id;
create table r6_f1k(id int primary key, a int);
insert ignore into r6_f1k values (null, 10), (null, 20);
show warnings;
select id, a from r6_f1k order by id, a;

-- review r6 (F2): the IGNORE fill applies to INSERT statements only, so a
-- UPDATE IGNORE that produces a NULL for a NOT NULL column keeps the strict
-- constraint rejection (the row is not silently rewritten to the implicit
-- default); valid UPDATE IGNORE statements still update normally.
create table r6_f2u(id int primary key, a int not null check(a > 0), src int);
insert into r6_f2u values (1, 7, null);
update ignore r6_f2u set a = src;
update r6_f2u set a = src;
select id, a, src from r6_f2u order by id;
update ignore r6_f2u set a = 8;
select id, a, src from r6_f2u order by id;
create table r6_f2g(id int primary key, a int not null, g int generated always as (a + 1) stored, src int);
insert into r6_f2g(id, a, src) values (1, 7, null);
update ignore r6_f2g set a = src;
select id, a, g, src from r6_f2g order by id;
update ignore r6_f2g set a = 8;
select id, a, g, src from r6_f2g order by id;

-- review r6 (F3): generated columns over DATE/DATETIME/TIMESTAMP bases
-- compute from the stored zero sentinel, so the derived value agrees with the
-- stored value (MySQL 8.0.44: the filled zero date stores '0000-00-00' and
-- year('0000-00-00') is 0).
create table r6_f3d(id int, d date not null, y int generated always as (year(d)) stored, yv int generated always as (year(d)) virtual);
insert ignore into r6_f3d(id, d) values (1, null);
show warnings;
select id, d, y, yv from r6_f3d;
create table r6_f3t(id int, dt datetime not null, yd int generated always as (year(dt)) stored, ts timestamp not null, ys int generated always as (year(ts)) stored);
insert ignore into r6_f3t(id, dt, ts) values (1, null, null);
show warnings;
select id, dt, yd, ts, ys from r6_f3t;

-- review r6 (F4): generated columns over JSON and UUID bases compute from the
-- filled values (the JSON null document and the zero uuid) instead of the
-- pre-adjustment NULL (MySQL 8.0.44 fills the same values and derives from
-- them).
create table r6_f4j(id int, j json not null, gj varchar(32) generated always as (cast(j as char(32))) stored);
insert ignore into r6_f4j(id, j) values (1, null);
show warnings;
select id, j, gj from r6_f4j;
create table r6_f4u(id int, u uuid not null, gu char(36) generated always as (cast(u as char(36))) stored);
insert ignore into r6_f4u(id, u) values (1, null);
show warnings;
select id, u, gu from r6_f4u;

-- review r6 (F5): the NULL primary-key drop runs in PRE_INSERT, before the
-- CHECK, unique and foreign-key filters, so those consumers never arbiter a
-- NULL key: the valid row wins its unique slot, and every dropped row still
-- publishes its primary-key warning.
create table r6_f5a(id int primary key, u int not null unique);
insert ignore into r6_f5a values (null, 5), (1, 5);
show warnings;
select id, u from r6_f5a order by id;
create table r6_f5b(id int primary key, v int, constraint r6_c5b check(v > 0));
insert ignore into r6_f5b values (null, 0);
show warnings;
select id, v from r6_f5b order by id;
create table r6_f5p(id int primary key);
create table r6_f5c(id int primary key, pid int not null, constraint r6_fk5 foreign key (pid) references r6_f5p(id));
insert ignore into r6_f5c values (null, 42);
show warnings;
select id, pid from r6_f5c order by id;
select count(*) as r6_orphans from r6_f5c left join r6_f5p on r6_f5c.pid = r6_f5p.id where r6_f5p.id is null;
drop table r6_f5c;
drop table r6_f5p;


-- r7_f1: an INSERT IGNORE ... SELECT whose select list repeats one source
-- column feeds two destinations from one physical vector; every destination
-- must own its independent cell image before the adjustment runs.
create table r7_src(x int);
insert into r7_src values(10), (null), (12);

-- nullable sibling keeps the source's NULL, not the adjusted cell's value.
create table r7_f1a(a int not null, b int);
insert ignore into r7_f1a(a, b) select x, x from r7_src;
show warnings;
select 'f1a' as mark, a, b from r7_f1a order by a, b;

-- two NOT NULL destinations each publish their own per-column warning.
create table r7_f1b(a int not null, b int not null);
insert ignore into r7_f1b(a, b) select x, x from r7_src;
show warnings;
select 'f1b' as mark, a, b from r7_f1b order by a, b;

-- strict INSERT of the same repeated-source shape keeps the hard error.
create table r7_f1s(a int not null, b int);
insert into r7_f1s(a, b) select x, x from r7_src;
show warnings;
select 'f1s' as mark, a, b from r7_f1s order by a, b;

-- r7_f2: a NULL single-column primary key ahead of surviving rows whose
-- aliased source columns share one vector: the dropped row must not corrupt
-- the compaction and the survivors keep their values in both destinations.
create table r7_f2_pp(id int primary key, a int, b int);
create table r7_f2_src(id int, x int);
insert into r7_f2_src values(null, 9), (1, 10), (2, 20);
insert ignore into r7_f2_pp(id, a, b) select id, x, x from r7_f2_src;
show warnings;
select 'f2pk' as mark, id, a, b from r7_f2_pp order by id;

-- r8: dependent row expressions read the fill-adjusted NOT NULL values
-- (review round 8; stored values and warning sets verified against
-- MySQL 8.0.44).

-- a generated chain: g computes NULL from the filled a and is itself filled
-- and warned, so the dependent h must read the adjusted g: the row stores
-- (0, 0, 1) with warnings 1048 for a and g, not (0, 0, NULL).
create table r8_t(a int not null, g int not null generated always as (nullif(a,0)) stored, h int generated always as (g+1) stored);
insert ignore into r8_t(a) values(null);
show warnings;
select 'r8_t' as mark, a, g, h from r8_t;
insert into r8_t(a) values(5);
select 'r8_t_valid' as mark, a, g, h from r8_t order by a;

-- strict INSERT of the same shape keeps the hard error.
create table r8_ts(a int not null, g int not null generated always as (nullif(a,0)) stored, h int generated always as (g+1) stored);
insert into r8_ts(a) values(null);

-- a column default over the filled base: the default expression must see
-- the adjusted value, storing (0, 1) with the single 1048 for a.
create table r8_d(a int not null, b int default (a+1));
insert ignore into r8_d(a) values(null);
show warnings;
select 'r8_d' as mark, a, b from r8_d;
insert into r8_d(a) values(5);
select 'r8_d_valid' as mark, a, b from r8_d order by a;

-- the dependent default's own column can be NOT NULL: the same rule
-- applies and no spurious second warning is published.
create table r8_dnn(a int not null, b int not null default (a+1));
insert ignore into r8_dnn(a) values(null);
show warnings;
select 'r8_dnn' as mark, a, b from r8_dnn;

-- strict INSERT of the dependent-default shape keeps the hard error.
create table r8_ds(a int not null, b int default (a+1));
insert into r8_ds(a) values(null);

-- a forward-declared default (b before a): with the base supplied the
-- default reads the adjusted cell; omitting the base keeps the pre-existing
-- rejection for an omitted NOT NULL column without a default.
create table r8_fwd(b int default (a+1), a int not null, c int);
insert ignore into r8_fwd(a) values(null);
show warnings;
select 'r8_fwd' as mark, a, b, c from r8_fwd;
insert ignore into r8_fwd(c) values(1);

-- r9: two normalization gaps the round-8 rewrite left open (review round 9;
-- stored values and warning sets verified against MySQL 8.0.44).

-- a NOT NULL generated column computes NULL while no supplied NOT NULL column
-- exists (the omitted constant-default primary key needs no node by itself):
-- the pre-insert adjustment still runs, so the CHECK filter sees the adjusted
-- row and skips it with 3819 after publishing the 1048 fill warning.
create table r9_pk(id int default 1 primary key, a int, g int not null generated always as (a+1) stored, check (g>0));
insert ignore into r9_pk(a) values(null);
show warnings;
select 'r9_pk' as mark, id, a, g from r9_pk;
create table r9_pkv(id int default 1 primary key, a int, g int not null generated always as (a+1) stored, check (g>0));
insert ignore into r9_pkv(a) values(5);
show warnings;
select 'r9_pkv' as mark, id, a, g from r9_pkv;
insert into r9_pk(a) values(null);
show warnings;
select 'r9_pk_strict' as mark, id, a, g from r9_pk;

-- the pk-less twin already reached the adjustment through the hidden fake
-- primary key; its stored image and warning set stay identical.
create table r9_t(a int, g int not null generated always as (a+1) stored, check (g>0));
insert ignore into r9_t(a) values(null);
show warnings;
select 'r9_t' as mark, a, g from r9_t;
insert ignore into r9_t(a) values(5);
show warnings;
select 'r9_t_valid' as mark, a, g from r9_t;
insert into r9_t(a) values(null);
show warnings;
select 'r9_t_strict' as mark, a, g from r9_t order by a;

-- an omitted dynamic NOT NULL default deriving NULL publishes its 1048
-- warning; there is no silent write-side fill.
create table r9_dn(id int default 1 primary key, a int, b int not null default (a+1));
insert ignore into r9_dn(a) values(null);
show warnings;
select 'r9_dn' as mark, id, a, b from r9_dn;
insert ignore into r9_dn(a) values(5);
show warnings;
select 'r9_dn_valid' as mark, id, a, b from r9_dn order by id;

-- the computed NULL feeds the unique consumer with the adjusted value.
create table r9_uk(a int, g int not null generated always as (a+1) stored, unique key uk_g (g));
insert ignore into r9_uk(a) values(null),(null);
show warnings;
select 'r9_uk' as mark, a, g from r9_uk;
insert ignore into r9_uk(a) values(4);
show warnings;
select 'r9_uk_valid' as mark, a, g from r9_uk;

-- an explicit DEFAULT item reads the adjusted supplied cell: the row stores
-- (0, 1) with the single 1048 for a, not (0, NULL); with a NOT NULL
-- dependent column no spurious second warning is published; a literal row
-- keeps its own value; the strict shape keeps the hard error.
create table r9_d(a int not null, b int default (a+1));
insert ignore into r9_d(a,b) values(null, default);
show warnings;
select 'r9_d' as mark, a, b from r9_d;
insert ignore into r9_d(a,b) values(null, default),(null, 0);
show warnings;
select 'r9_d_mixed' as mark, a, b from r9_d;
insert ignore into r9_d(a,b) values(5, default);
show warnings;
select 'r9_d_valid' as mark, a, b from r9_d;
create table r9_ds(a int not null, b int default (a+1));
insert into r9_ds(a,b) values(null, default);
show warnings;
select 'r9_ds' as mark, a, b from r9_ds;
create table r9_dnn(a int not null, b int not null default (a+1));
insert ignore into r9_dnn(a,b) values(null, default);
show warnings;
select 'r9_dnn' as mark, a, b from r9_dnn;

-- a DEFAULT item whose dependency is an omitted expression-defaulted column:
-- the dependency closure materializes the adjusted default and the dependent
-- reads it, storing (0, 0, 1) with only the 1048 for a (no spurious 1048
-- for c and no NULL b).
create table r9_cl(a int not null, c int not null default (a*2), b int default (c+1));
insert ignore into r9_cl(a,b) values(null, default);
show warnings;
select 'r9_cl' as mark, a, c, b from r9_cl;

-- all-default rows and the empty VALUES () shape keep constant-default
-- references raw and store the default-derived image unchanged.
create table r9_ad(a int not null default 7, b int default (a+1));
insert ignore into r9_ad values (default, default);
show warnings;
select 'r9_ad' as mark, a, b from r9_ad;
insert ignore into r9_ad values ();
show warnings;
select 'r9_ad_empty' as mark, a, b from r9_ad;

-- r10 review finding 1: DATALINK keeps no implicit default under IGNORE (the
-- geometry contract). The empty byte string the string-family fill would
-- store has no URL scheme load_file can resolve, so the ignored NULL cell
-- keeps the constraint violation and the statement stores nothing; the
-- strict shape and the mixed batch abort identically, and a valid datalink
-- still stores and compares equal.
create table r10_dl(a int, d datalink not null);
insert ignore into r10_dl values (1, null);
show warnings;
select 'r10_dl_null' as mark, a from r10_dl;
insert ignore into r10_dl values (2, 'file://$resources/load_data/time_date_1.csv');
show warnings;
select 'r10_dl_valid' as mark, a, d = cast('file://$resources/load_data/time_date_1.csv' as datalink) as d_eq from r10_dl;
insert ignore into r10_dl values (3, null), (4, 'file://$resources/load_data/time_date_1.csv');
show warnings;
select 'r10_dl_mixed' as mark, a from r10_dl;
insert into r10_dl values (5, null);
select 'r10_dl_strict' as mark, a from r10_dl;
drop table r10_dl;

-- r10 review finding 2: the legacy LOAD builder (a self-referencing foreign
-- key makes the modern bind hand the statement to buildLoad) materializes
-- omitted dependent defaults before the PRE_INSERT fill adjusts the batch,
-- so under IGNORE the dependent read must see the adjusted cell: one 1048
-- for the supplied NULL into a, and the chained dependents computed from it
-- (b=1 for the filled a=0; the chain stores (0, 0, 1)), with no spurious
-- second 1048 for a NOT NULL dependent and no NULL dependent cell.
create table r10_ld_sfk(id int primary key auto_increment, a int not null, b int default (a+1), pid int, constraint sfk_ld foreign key (pid) references r10_ld_sfk(id));
load data inline format='csv', data='1\n\\N\n2' ignore into table r10_ld_sfk fields terminated by ',' (a);
show warnings;
select 'r10_ld_sfk' as mark, id, a, b, pid from r10_ld_sfk order by a;
drop table r10_ld_sfk;

create table r10_ldn_sfk(id int primary key auto_increment, a int not null, b int not null default (a+1), pid int, constraint sfk_ldn foreign key (pid) references r10_ldn_sfk(id));
load data inline format='csv', data='1\n\\N\n2' ignore into table r10_ldn_sfk fields terminated by ',' (a);
show warnings;
select 'r10_ldn_sfk' as mark, id, a, b, pid from r10_ldn_sfk order by a;
drop table r10_ldn_sfk;

create table r10_lcl_sfk(id int primary key auto_increment, a int not null, c int not null default (a*2), b int default (c+1), pid int, constraint sfk_lcl foreign key (pid) references r10_lcl_sfk(id));
load data inline format='csv', data='1\n\\N\n2' ignore into table r10_lcl_sfk fields terminated by ',' (a);
show warnings;
select 'r10_lcl_sfk' as mark, id, a, c, b, pid from r10_lcl_sfk order by a;
drop table r10_lcl_sfk;

-- the strict legacy LOAD keeps the hard NOT NULL rejection: nothing stores.
create table r10_lds_sfk(id int primary key auto_increment, a int not null, b int default (a+1), pid int, constraint sfk_lds foreign key (pid) references r10_lds_sfk(id));
load data inline format='csv', data='1\n\\N\n2' into table r10_lds_sfk fields terminated by ',' (a);
show warnings;
select 'r10_lds_sfk' as mark, id, a, b, pid from r10_lds_sfk order by a;
drop table r10_lds_sfk;

-- valid-input legacy LOAD control: no NULL field, chained values stored.
create table r10_ldv_sfk(id int primary key auto_increment, a int not null, b int default (a+1), pid int, constraint sfk_ldv foreign key (pid) references r10_ldv_sfk(id));
load data inline format='csv', data='5\n6\n7' ignore into table r10_ldv_sfk fields terminated by ',' (a);
show warnings;
select 'r10_ldv_sfk' as mark, id, a, b, pid from r10_ldv_sfk order by a;
drop table r10_ldv_sfk;

-- modern-path control (no self reference): the dependent read keeps the
-- established modern wrap (b computed from the adjusted a).
create table r10_ld_mod(a int not null, b int default (a+1));
load data inline format='csv', data='1\n\\N\n2' ignore into table r10_ld_mod fields terminated by ',' (a);
show warnings;
select 'r10_ld_mod' as mark, a, b from r10_ld_mod order by a;
drop table r10_ld_mod;

-- r14 review finding: unique-key members filled by the IGNORE adjustment
-- keep their uniqueness maintenance. The stale acknowledged-NULL skip
-- treated an omitted NOT NULL column whose DEFAULT folds to NULL
-- (abs(null)) as permanently NULL: two rows of one INSERT IGNORE both
-- filled u to 0 but skipped arbitration and the unique-index writes, so
-- both stored, a strict duplicate insert of the filled value then
-- succeeded, and a competing IGNORE insert stored too. The skip decision
-- now follows the adjusted value: the filled cell participates in
-- uniqueness like any never-NULL column - the in-batch loser row is
-- skipped (one row survives, one 1048 per filled cell plus one 1062);
-- the surviving entry is enforced across statements (the strict
-- duplicate insert fails with 1062, the competing IGNORE insert stores
-- nothing and keeps warning); the nullable-default, strict,
-- composite-NULL-member and varchar-family controls keep their
-- established behavior.
create table r14_uknd(id int primary key, u bigint not null default (abs(null)), unique key uk_r14(u));
insert ignore into r14_uknd(id) values (1),(2);
show warnings;
select 'r14_uknd' as mark, id, u from r14_uknd order by id;
insert into r14_uknd values (99, 0);
insert ignore into r14_uknd(id) values (3);
show warnings;
select 'r14_uknd_after' as mark, id, u from r14_uknd order by id;
drop table r14_uknd;

create table r14_nulld(id int primary key, u bigint default (abs(null)), unique key ukn_r14(u));
insert ignore into r14_nulld(id) values (1),(2);
show warnings;
select 'r14_nulld' as mark, id, u from r14_nulld order by id;
drop table r14_nulld;

create table r14_strictd(id int primary key, u bigint not null default (abs(null)), unique key uks_r14(u));
insert into r14_strictd(id) values (1);
show warnings;
select 'r14_strictd' as mark, id from r14_strictd;
drop table r14_strictd;

create table r14_cmpd(id int primary key, u bigint not null default (abs(null)), v bigint default (abs(null)), unique key uk_uv_r14(u,v));
insert ignore into r14_cmpd(id) values (1),(2);
show warnings;
insert ignore into r14_cmpd(id) values (5);
show warnings;
select 'r14_cmpd' as mark, id, u, v from r14_cmpd order by id;
drop table r14_cmpd;

create table r14_vcnd(id int primary key, u varchar(32) not null default (nullif('a','a')), unique key ukt_r14(u));
insert ignore into r14_vcnd(id) values (1),(2);
show warnings;
select 'r14_vcnd' as mark, id, u from r14_vcnd order by id;
drop table r14_vcnd;

-- r15 review finding: the byte-string fill follows plain assignment. A
-- plain assignment right-pads any shorter value with 0x00 to BINARY(n)'s
-- declared width, so the adjusted cell of BINARY(2) stores 0000 with the
-- same HEX/LENGTH as the ordinary empty-string assignment, while
-- VARBINARY(4) keeps the empty payload (LENGTH 0).
create table r15_bin(id int primary key, b binary(2) not null, vb varbinary(4) not null);
insert ignore into r15_bin(id, b, vb) values(1, null, null);
show warnings;
insert into r15_bin values(2, '', '');
select 'r15_bin' as mark, id, hex(b) as b_hex, length(b) as b_len,
hex(vb) as vb_hex, length(vb) as vb_len from r15_bin order by id;
drop table r15_bin;

-- r15 review finding: a NOT NULL column whose omitted DEFAULT folds to a
-- constant NULL projects a broadcast with no backing storage on LOAD legs.
-- Under LOAD ... ignore every logical row keeps its row and stores the
-- implicit default of the column type (u adjusts to 0 with warning 1048 per
-- row) instead of the load failing the statement; the declared '' default
-- of BINARY(2) stores its padded assignment like any ordinary insert.
create table r15_ld(id int primary key, u bigint not null default (abs(null)), b binary(2) not null default (''));
load data inline format='csv', data='1\n2' ignore into table r15_ld fields terminated by ',' (id);
show warnings;
select 'r15_ld' as mark, id, u, hex(b) as b_hex, length(b) as b_len from r15_ld order by id;
insert into r15_ld values(3, 1, '');
select 'r15_ld_after' as mark, id, u, hex(b) as b_hex, length(b) as b_len from r15_ld order by id;
drop table r15_ld;

drop database issue_30906_insert_ignore_not_null;
