insert first
when lo < 15 then into narrow (id, val, tag) values (id + 2000, lo, 'small')
else into narrow (id, val, tag) values (id + 2000, hi, 'big')
select id, lo, hi from wide;
select * from narrow where id > 2000 order by id;
