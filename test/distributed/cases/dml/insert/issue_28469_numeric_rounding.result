DROP DATABASE IF EXISTS issue_28469;
CREATE DATABASE issue_28469;
USE issue_28469;
CREATE TABLE t_rounding (
id INT PRIMARY KEY,
value_int INT,
value_bigint BIGINT
);
INSERT INTO t_rounding VALUES
(1, 2.5, 2.5),
