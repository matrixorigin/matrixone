DROP DATABASE IF EXISTS issue_28469;
CREATE DATABASE issue_28469;
USE issue_28469;
SET sql_mode = 'STRICT_TRANS_TABLES';
CREATE TABLE t_rounding (
id INT PRIMARY KEY,
value_int INT,
value_bigint BIGINT
);
