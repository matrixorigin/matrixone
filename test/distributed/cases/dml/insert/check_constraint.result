drop database if exists check_constraint_test;
create database check_constraint_test;
use check_constraint_test;
create table t(
a int,
b varchar(10),
constraint positive_a check(a > 0),
constraint short_b check(length(b) < 5)
);
insert into t values (1, 'ok'), (null, null);
insert into t values (-1, 'bad');
constraint violation: Check constraint 'positive_a' is violated
insert into t values (2, 'too long');
constraint violation: Check constraint 'short_b' is violated
select * from t order by a, b;
a    b
NULL    NULL
1    ok
insert ignore into t values (-1, 'bad'), (3, 'yes');
select * from t order by a, b;
a    b
NULL    NULL
1    ok
3    yes
insert into t select * from (values row(4, 'four'), row(-2, 'bad')) as src;
constraint violation: Check constraint 'positive_a' is violated
select * from t order by a, b;
a    b
NULL    NULL
1    ok
3    yes
create table ctas_check(
a int constraint ctas_positive_a check(a > 0)
) as select 5 as a;
insert into ctas_check values (-1);
constraint violation: Check constraint 'ctas_positive_a' is violated
select * from ctas_check;
a
5
create table no_key_odku(
a int check(a > 0),
b varchar(10)
);
insert into no_key_odku(a, b) values (-1, 'bad')
on duplicate key update b = 'updated';
constraint violation: Check constraint '__mo_chk_1' is violated
select * from no_key_odku;
a    b
create table replace_check(
id int primary key,
v int constraint positive_v check(v > 0)
);
insert into replace_check values (1, 10);
replace into replace_check values (1, -1);
constraint violation: Check constraint 'positive_v' is violated
select * from replace_check order by id;
id    v
1    10
replace into replace_check values (2, -2);
constraint violation: Check constraint 'positive_v' is violated
select * from replace_check order by id;
id    v
1    10
replace into replace_check values (1, 20);
replace into replace_check values (2, null);
select * from replace_check order by id;
id    v
1    20
2    NULL
create table insert_ignore_check_composite_unique(
a int not null,
b int not null,
c int not null,
primary key(a, b),
unique key uk(a, b, c),
constraint positive_c check(c > 0)
);
insert ignore into insert_ignore_check_composite_unique values (1, 2, 3), (4, 5, -1);
select * from insert_ignore_check_composite_unique order by a, b, c;
a    b    c
1    2    3
create table update_check(
id int primary key,
a int,
b int,
constraint update_bounds check(a <= b)
);
insert into update_check values (1, 0, 0), (2, 0, 3), (3, 0, 1);
update update_check set a = 2 where id in (1, 2);
constraint violation: Check constraint 'update_bounds' is violated
select * from update_check order by id;
id    a    b
1    0    0
2    0    3
3    0    1
update ignore update_check u set u.a = 2 where u.id in (1, 2);
update ignore update_check set a = 3 order by id limit 1;
select * from update_check order by id;
id    a    b
1    0    0
2    2    3
3    0    1
update update_check set a = 1, b = 1 where id = 1;
update update_check set a = null where id = 3;
select * from update_check order by id;
id    a    b
1    1    1
2    2    3
3    NULL    1
create table update_peer(id int primary key, v int check(v >= 0));
insert into update_peer values (1, 0), (99, 0);
update update_peer p left join update_check u on u.id = p.id
set u.a = 100, u.b = 0 where p.id = 99;
update update_peer p join update_check u on u.id = p.id
set p.v = 7, u.a = 100;
constraint violation: Check constraint 'update_bounds' is violated
select * from update_peer order by id;
id    v
1    0
99    0
update ignore update_peer p join update_check u on u.id = p.id
set p.v = 7, u.a = 100;
select * from update_peer order by id;
id    v
1    7
99    0
select * from update_check order by id;
id    a    b
1    1    1
2    2    3
3    NULL    1
create table update_generated(
id int primary key,
x int,
g int generated always as (x * 2) stored,
constraint generated_value_limit check(g < 4)
);
insert into update_generated(id, x) values (1, 1);
update ignore update_generated set x = 2 where id = 1;
select * from update_generated;
id    x    g
1    1    2
insert into update_check values (2, 0, 0) on duplicate key update a = 4;
constraint violation: Check constraint 'update_bounds' is violated
select * from update_check where id = 2;
id    a    b
2    2    3
insert into update_check values (2, 100, 0) on duplicate key update a = 3;
select * from update_check where id = 2;
id    a    b
2    3    3
set foreign_key_checks = 1;
create table fk_check_parent(id int primary key);
create table fk_check_child(
id int primary key, pid int, upper_bound int,
key idx_fk_check_pid(pid),
constraint ck_cascade_bound check(pid < upper_bound),
constraint fk_check_cascade foreign key(pid) references fk_check_parent(id) on update cascade
);
insert into fk_check_parent values (1), (2);
insert into fk_check_child values (10, 1, 5), (20, 2, 10);
update fk_check_parent set id = case id when 1 then 6 else 4 end;
constraint violation: Check constraint 'ck_cascade_bound' is violated
select * from fk_check_parent order by id;
id
1
2
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 4, 6) order by id;
id    pid    upper_bound
10    1    5
20    2    10
update ignore fk_check_parent set id = 6 where id = 1;
constraint violation: Check constraint 'ck_cascade_bound' is violated
update fk_check_parent p join update_peer u on p.id = u.id set p.id = 6;
constraint violation: Check constraint 'ck_cascade_bound' is violated
select * from fk_check_parent order by id;
id
1
2
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 4, 6) order by id;
id    pid    upper_bound
10    1    5
20    2    10
update fk_check_parent set id = 4 where id = 2;
update fk_check_parent p join update_peer u on p.id = u.id set p.id = 3;
select * from fk_check_parent order by id;
id
3
4
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 3, 4, 6) order by id;
id    pid    upper_bound
10    3    5
20    4    10
create table fk_null_parent(id int primary key, v int);
create table fk_null_child(
id int primary key, pid int, allow_null int,
constraint ck_cascade_null check(pid is not null or allow_null = 1),
constraint fk_check_null foreign key(pid) references fk_null_parent(id) on update set null on delete set null
);
insert into fk_null_parent values (1, 10), (2, 20), (3, 30);
insert into fk_null_child values (10, 1, 0), (20, 2, 1), (30, 3, 1);
update fk_null_parent set id = 11 where id = 1;
constraint violation: Check constraint 'ck_cascade_null' is violated
delete from fk_null_parent where id = 1;
constraint violation: Check constraint 'ck_cascade_null' is violated
replace into fk_null_parent values (1, 99);
constraint violation: Check constraint 'ck_cascade_null' is violated
select * from fk_null_parent order by id;
id    v
1    10
2    20
3    30
select * from fk_null_child order by id;
id    pid    allow_null
10    1    0
20    2    1
30    3    1
update fk_null_parent set id = 12 where id = 2;
delete from fk_null_parent where id = 3;
select * from fk_null_parent order by id;
id    v
1    10
12    20
select * from fk_null_child order by id;
id    pid    allow_null
10    1    0
20    NULL    1
30    NULL    1
drop database check_constraint_test;
