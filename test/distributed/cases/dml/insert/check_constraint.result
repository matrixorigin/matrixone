drop database if exists check_constraint_test;
create database check_constraint_test;
use check_constraint_test;
create table t(
a int,
b varchar(10),
constraint positive_a check(a > 0),
constraint short_b check(length(b) < 5)
);
insert into t values (1, 'ok'), (null, null);
insert into t values (-1, 'bad');
constraint violation: Check constraint 'positive_a' is violated
insert into t values (2, 'too long');
constraint violation: Check constraint 'short_b' is violated
select * from t order by a, b;
a    b
NULL    NULL
1    ok
insert ignore into t values (-1, 'bad'), (3, 'yes');
select * from t order by a, b;
a    b
NULL    NULL
1    ok
3    yes
insert into t select * from (values row(4, 'four'), row(-2, 'bad')) as src;
constraint violation: Check constraint 'positive_a' is violated
select * from t order by a, b;
a    b
NULL    NULL
1    ok
3    yes
create table ctas_check(
a int constraint ctas_positive_a check(a > 0)
) as select 5 as a;
insert into ctas_check values (-1);
constraint violation: Check constraint 'ctas_positive_a' is violated
select * from ctas_check;
a
5
create table no_key_odku(
a int check(a > 0),
b varchar(10)
);
insert into no_key_odku(a, b) values (-1, 'bad')
on duplicate key update b = 'updated';
constraint violation: Check constraint '__mo_chk_1' is violated
select * from no_key_odku;
a    b
create table replace_check(
id int primary key,
v int constraint positive_v check(v > 0)
);
insert into replace_check values (1, 10);
replace into replace_check values (1, -1);
constraint violation: Check constraint 'positive_v' is violated
select * from replace_check order by id;
id    v
1    10
replace into replace_check values (2, -2);
constraint violation: Check constraint 'positive_v' is violated
select * from replace_check order by id;
id    v
1    10
replace into replace_check values (1, 20);
replace into replace_check values (2, null);
select * from replace_check order by id;
id    v
1    20
2    NULL
create table insert_ignore_check_composite_unique(
a int not null,
b int not null,
c int not null,
primary key(a, b),
unique key uk(a, b, c),
constraint positive_c check(c > 0)
);
insert ignore into insert_ignore_check_composite_unique values (1, 2, 3), (4, 5, -1);
select * from insert_ignore_check_composite_unique order by a, b, c;
a    b    c
1    2    3
create table update_check(
id int primary key,
a int,
b int,
constraint update_bounds check(a <= b)
);
insert into update_check values (1, 0, 0), (2, 0, 3), (3, 0, 1);
update update_check set a = 2 where id in (1, 2);
constraint violation: Check constraint 'update_bounds' is violated
select * from update_check order by id;
id    a    b
1    0    0
2    0    3
3    0    1
update ignore update_check u set u.a = 2 where u.id in (1, 2);
update ignore update_check set a = 3 order by id limit 1;
select * from update_check order by id;
id    a    b
1    0    0
2    2    3
3    0    1
update update_check set a = 1, b = 1 where id = 1;
update update_check set a = null where id = 3;
select * from update_check order by id;
id    a    b
1    1    1
2    2    3
3    NULL    1
create table update_peer(id int primary key, v int check(v >= 0));
insert into update_peer values (1, 0), (99, 0);
update update_peer p left join update_check u on u.id = p.id
set u.a = 100, u.b = 0 where p.id = 99;
update update_peer p join update_check u on u.id = p.id
set p.v = 7, u.a = 100;
constraint violation: Check constraint 'update_bounds' is violated
select * from update_peer order by id;
id    v
1    0
99    0
update ignore update_peer p join update_check u on u.id = p.id
set p.v = 7, u.a = 100;
select * from update_peer order by id;
id    v
1    7
99    0
select * from update_check order by id;
id    a    b
1    1    1
2    2    3
3    NULL    1
create table update_generated(
id int primary key,
x int,
g int generated always as (x * 2) stored,
constraint generated_value_limit check(g < 4)
);
insert into update_generated(id, x) values (1, 1);
update ignore update_generated set x = 2 where id = 1;
select * from update_generated;
id    x    g
1    1    2
insert into update_check values (2, 0, 0) on duplicate key update a = 4;
constraint violation: Check constraint 'update_bounds' is violated
select * from update_check where id = 2;
id    a    b
2    2    3
insert into update_check values (2, 100, 0) on duplicate key update a = 3;
select * from update_check where id = 2;
id    a    b
2    3    3
set foreign_key_checks = 1;
create table fk_check_parent(id int primary key);
create table fk_check_child(
id int primary key, pid int, upper_bound int,
key idx_fk_check_pid(pid),
constraint ck_cascade_bound check(pid < upper_bound),
constraint fk_check_cascade foreign key(pid) references fk_check_parent(id) on update cascade
);
insert into fk_check_parent values (1), (2);
insert into fk_check_child values (10, 1, 5), (20, 2, 10);
update fk_check_parent set id = case id when 1 then 6 else 4 end;
constraint violation: Check constraint 'ck_cascade_bound' is violated
select * from fk_check_parent order by id;
id
1
2
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 4, 6) order by id;
id    pid    upper_bound
10    1    5
20    2    10
update ignore fk_check_parent set id = 6 where id = 1;
constraint violation: Check constraint 'ck_cascade_bound' is violated
update fk_check_parent p join update_peer u on p.id = u.id set p.id = 6;
constraint violation: Check constraint 'ck_cascade_bound' is violated
select * from fk_check_parent order by id;
id
1
2
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 4, 6) order by id;
id    pid    upper_bound
10    1    5
20    2    10
update fk_check_parent set id = 4 where id = 2;
update fk_check_parent p join update_peer u on p.id = u.id set p.id = 3;
select * from fk_check_parent order by id;
id
3
4
select * from fk_check_child force index(idx_fk_check_pid) where pid in (1, 2, 3, 4, 6) order by id;
id    pid    upper_bound
10    3    5
20    4    10
create table fk_null_parent(id int primary key, v int);
create table fk_null_child(
id int primary key, pid int, allow_null int,
constraint ck_cascade_null check(pid is not null or allow_null = 1),
constraint fk_check_null foreign key(pid) references fk_null_parent(id) on update set null on delete set null
);
insert into fk_null_parent values (1, 10), (2, 20), (3, 30);
insert into fk_null_child values (10, 1, 0), (20, 2, 1), (30, 3, 1);
update fk_null_parent set id = 11 where id = 1;
constraint violation: Check constraint 'ck_cascade_null' is violated
delete from fk_null_parent where id = 1;
constraint violation: Check constraint 'ck_cascade_null' is violated
replace into fk_null_parent values (1, 99);
constraint violation: Check constraint 'ck_cascade_null' is violated
select * from fk_null_parent order by id;
id    v
1    10
2    20
3    30
select * from fk_null_child order by id;
id    pid    allow_null
10    1    0
20    2    1
30    3    1
update fk_null_parent set id = 12 where id = 2;
delete from fk_null_parent where id = 3;
select * from fk_null_parent order by id;
id    v
1    10
12    20
select * from fk_null_child order by id;
id    pid    allow_null
10    1    0
20    NULL    1
30    NULL    1
create table fk_generated_parent(id int primary key, v int);
create table fk_generated_child(
id int primary key, pid int, fallback int,
g int generated always as (ifnull(pid, fallback)) stored,
doubled int generated always as (g * 2) stored,
constraint ck_generated_cascade check(doubled > 0 and doubled < 16),
foreign key(pid) references fk_generated_parent(id) on delete set null on update cascade
);
insert into fk_generated_parent values (1, 10), (2, 20), (3, 30), (4, 40);
insert into fk_generated_child(id, pid, fallback) values (10, 1, 0), (20, 2, 5), (30, 3, 7);
delete from fk_generated_parent where id in (1, 2);
constraint violation: Check constraint 'ck_generated_cascade' is violated
replace into fk_generated_parent values (1, 99);
constraint violation: Check constraint 'ck_generated_cascade' is violated
update fk_generated_parent p join update_peer u on p.id = u.id set p.id = 8;
constraint violation: Check constraint 'ck_generated_cascade' is violated
select * from fk_generated_parent order by id;
id    v
1    10
2    20
3    30
4    40
select id, pid, g, doubled from fk_generated_child order by id;
id    pid    g    doubled
10    1    1    2
20    2    2    4
30    3    3    6
replace into fk_generated_parent values (3, 99);
create index idx_generated on fk_generated_child(doubled);
replace into fk_generated_parent values (1, 99);
not supported: REPLACE foreign key action changing an indexed generated column
replace into fk_generated_parent values (4, 99);
delete from fk_generated_parent where id in (2, 4);
update fk_generated_parent p join update_peer u on p.id = u.id set p.id = 6;
select * from fk_generated_parent order by id;
id    v
3    99
6    10
select id, pid, g, doubled from fk_generated_child force index(idx_generated)
where doubled in (2, 4, 6, 10, 12, 14) order by id;
id    pid    g    doubled
10    6    6    12
20    NULL    5    10
30    NULL    7    14
create table fk_combined_parent(id int primary key, v int);
create table fk_combined_child(
id int primary key, a int, b int,
g int generated always as (ifnull(a, 0) + ifnull(b, 0)) stored,
constraint ck_combined_generated check(g > 0),
foreign key(a) references fk_combined_parent(id) on delete set null,
foreign key(b) references fk_combined_parent(id) on delete set null
);
insert into fk_combined_parent values (1, 10), (2, 20);
insert into fk_combined_child(id, a, b) values (10, 1, 2);
replace into fk_combined_parent values (1, 100), (2, 200);
constraint violation: Check constraint 'ck_combined_generated' is violated
select * from fk_combined_parent order by id;
id    v
1    10
2    20
replace into fk_combined_parent values (1, 100);
select * from fk_combined_parent order by id;
id    v
1    100
2    20
select * from fk_combined_child;
id    a    b    g
10    NULL    2    2
create table fk_stable_parent(id int primary key);
create table fk_stable_reference(id int primary key);
create table fk_stable_child(
id int primary key, pid int, fallback int,
g int generated always as (ifnull(pid, fallback)) stored,
foreign key(pid) references fk_stable_parent(id) on delete set null,
foreign key(g) references fk_stable_reference(id)
);
insert into fk_stable_parent values (1), (2);
insert into fk_stable_reference values (1), (2);
insert into fk_stable_child(id, pid, fallback) values (10, 1, 1), (20, 2, 99);
delete from fk_stable_parent where id in (1, 2);
not supported: foreign key action changing generated column 'g' constrained by another foreign key
select id from fk_stable_parent order by id;
id
1
2
select id, pid, g from fk_stable_child order by id;
id    pid    g
10    1    1
20    2    2
delete from fk_stable_parent where id = 1;
select id from fk_stable_parent order by id;
id
2
select id, pid, g from fk_stable_child order by id;
id    pid    g
10    NULL    1
20    2    2
create table fk_stable_index_parent(id int primary key, v int);
create table fk_stable_index_child(
id int primary key, pid int,
g int generated always as (if(id = 30, null, ifnull(pid, 1))) stored,
derived int generated always as (ifnull(pid, 0) + ifnull(g, 0)) stored,
key idx_stable_generated(g),
foreign key(pid) references fk_stable_index_parent(id) on delete set null
);
insert into fk_stable_index_parent values (1, 10), (2, 20), (3, 30);
insert into fk_stable_index_child(id, pid) values (10, 1), (20, 2), (30, 3);
replace into fk_stable_index_parent values (1, 100), (2, 200);
not supported: REPLACE foreign key action changing an indexed generated column
select * from fk_stable_index_parent order by id;
id    v
1    10
2    20
3    30
select id, pid, g, derived from fk_stable_index_child order by id;
id    pid    g    derived
10    1    1    2
20    2    2    4
30    3    NULL    3
replace into fk_stable_index_parent values (1, 100), (3, 300);
select * from fk_stable_index_parent order by id;
id    v
1    100
2    20
3    300
select id, pid, g, derived from fk_stable_index_child force index(idx_stable_generated)
where g in (1, 2) order by id;
id    pid    g    derived
10    NULL    1    1
20    2    2    4
select id, pid, g, derived from fk_stable_index_child where g is null;
id    pid    g    derived
30    NULL    NULL    0
alter table fk_stable_index_child drop column derived;
insert into fk_stable_index_child(id, pid) values (11, 1);
replace into fk_stable_index_parent values (1, 101);
select id, pid, g from fk_stable_index_child force index(idx_stable_generated)
where g = 1 order by id;
id    pid    g
10    NULL    1
11    NULL    1
create table fk_null_chain_parent(id int primary key);
create table fk_null_chain_child(
id int primary key, pid int,
g int generated always as (pid) stored,
unique key ug(g),
foreign key(pid) references fk_null_chain_parent(id) on delete set null
);
create table fk_null_chain_leaf(
id int primary key, ref int,
foreign key(ref) references fk_null_chain_child(g) on update restrict
);
insert into fk_null_chain_parent values (1), (2);
insert into fk_null_chain_child(id, pid) values (10, 1), (20, 2);
insert into fk_null_chain_leaf values (100, 1);
delete from fk_null_chain_parent where id in (1, 2);
internal error: Cannot delete or update a parent row: a foreign key constraint fails
select id from fk_null_chain_parent order by id;
id
1
2
select id, pid, g from fk_null_chain_child order by id;
id    pid    g
10    1    1
20    2    2
select id, ref from fk_null_chain_leaf;
id    ref
100    1
delete from fk_null_chain_parent where id = 2;
select id, pid, g from fk_null_chain_child order by id;
id    pid    g
10    1    1
20    NULL    NULL
create table fk_outgoing_null_parent(id int primary key);
create table fk_outgoing_null_ref(id int primary key);
create table fk_outgoing_null_child(
id int primary key, pid int,
g int generated always as (pid) stored,
key idx_outgoing_g(g),
foreign key(pid) references fk_outgoing_null_parent(id) on delete set null,
foreign key(g) references fk_outgoing_null_ref(id)
);
insert into fk_outgoing_null_parent values (1);
insert into fk_outgoing_null_ref values (1);
insert into fk_outgoing_null_child(id, pid) values (10, 1);
delete from fk_outgoing_null_parent where id = 1;
select id from fk_outgoing_null_parent;
id
select id, pid, g from fk_outgoing_null_child;
id    pid    g
10    NULL    NULL
select id from fk_outgoing_null_child force index(idx_outgoing_g) where g = 1;
id
create table fk_outgoing_tuple_parent(id int primary key);
create table fk_outgoing_tuple_ref(a int, b int, primary key(a, b));
create table fk_outgoing_tuple_child(
id int primary key, pid int, b int,
g int generated always as (ifnull(pid, 99)) stored,
foreign key(pid) references fk_outgoing_tuple_parent(id) on delete set null,
foreign key(g, b) references fk_outgoing_tuple_ref(a, b)
);
insert into fk_outgoing_tuple_parent values (1);
insert into fk_outgoing_tuple_child(id, pid, b) values (10, 1, null);
delete from fk_outgoing_tuple_parent where id = 1;
select id, pid, g, b from fk_outgoing_tuple_child;
id    pid    g    b
10    NULL    99    NULL
create table fk_zero_parent(id int primary key);
create table fk_zero_ref(g double, tenant int, primary key(g, tenant));
create table fk_zero_child(
id int primary key, pid int, tenant int,
g double generated always as (if(pid is null, cast('-0' as double), cast('0' as double))) stored,
key idx_zero_g(g),
foreign key(pid) references fk_zero_parent(id) on delete set null,
foreign key(g, tenant) references fk_zero_ref(g, tenant)
);
insert into fk_zero_parent values (1), (2);
insert into fk_zero_ref values (0, 3);
insert into fk_zero_child(id, pid, tenant) values (10, 1, 3), (20, 2, 3);
replace into fk_zero_parent values (1);
not supported: REPLACE foreign key action changing an indexed generated column
select id, pid from fk_zero_child order by id;
id    pid
10    1
20    2
delete from fk_zero_parent where id = 1;
select id, pid, cast(serial_full(g) = serial_full(cast('-0' as double)) as unsigned) as negative_zero
from fk_zero_child force index(idx_zero_g) where g = 0 order by id;
id    pid    negative_zero
10    NULL    1
20    2    0
drop database check_constraint_test;
