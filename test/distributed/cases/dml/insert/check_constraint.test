drop database if exists check_constraint_test;
create database check_constraint_test;
use check_constraint_test;

create table t(
    a int,
    b varchar(10),
    constraint positive_a check(a > 0),
    constraint short_b check(length(b) < 5)
);

insert into t values (1, 'ok'), (null, null);
insert into t values (-1, 'bad');
insert into t values (2, 'too long');
select * from t order by a, b;

insert ignore into t values (-1, 'bad'), (3, 'yes');
select * from t order by a, b;

insert into t select * from (values row(4, 'four'), row(-2, 'bad')) as src;
select * from t order by a, b;

create table ctas_check(
    a int constraint ctas_positive_a check(a > 0)
) as select 5 as a;
insert into ctas_check values (-1);
select * from ctas_check;

create table no_key_odku(
    a int check(a > 0),
    b varchar(10)
);
insert into no_key_odku(a, b) values (-1, 'bad')
    on duplicate key update b = 'updated';
select * from no_key_odku;

create table replace_check(
    id int primary key,
    v int constraint positive_v check(v > 0)
);
insert into replace_check values (1, 10);
replace into replace_check values (1, -1);
select * from replace_check order by id;
replace into replace_check values (2, -2);
select * from replace_check order by id;
replace into replace_check values (1, 20);
replace into replace_check values (2, null);
select * from replace_check order by id;

create table update_check(
    id int primary key,
    v int,
    constraint positive_update_v check(v > 0)
);
insert into update_check values (1, 10), (2, 20);
update update_check set v = -1 where id = 1;
select * from update_check order by id;
update update_check set v = v + 1 where id = 1;
select * from update_check order by id;
update update_check
set v = case id when 1 then 15 else -1 end;
select * from update_check order by id;
update update_check as u set u.v = u.v + 1 where u.id = 1;
select * from update_check order by id;
update ignore update_check set v = -1 where id in (1, 2);
select * from update_check order by id;

create table update_ignore_generated(
    id int primary key,
    x int,
    g int generated always as (x * 2) stored,
    constraint generated_value_limit check(g < 4)
);
insert into update_ignore_generated(id, x) values (1, 1);
update ignore update_ignore_generated set x = 2 where id = 1;
select id, x, g from update_ignore_generated order by id;

insert into update_check values (1, -5)
    on duplicate key update v = values(v);
select * from update_check order by id;
insert into update_check values (1, -5)
    on duplicate key update v = 30;
select * from update_check order by id;

create table update_source(id int primary key);
insert into update_source values (1), (99);
update update_check u join update_source s on u.id = s.id
    set u.v = -1;
select * from update_check order by id;

create table absent_update_target(
    id int primary key,
    v int,
    constraint never_valid check(false)
);
update update_source s left join absent_update_target a on s.id = a.id
    set a.v = 1;
select count(*) from absent_update_target;

drop database check_constraint_test;
