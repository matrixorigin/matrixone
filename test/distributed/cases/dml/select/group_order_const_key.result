drop database if exists const_key_db;
create database const_key_db;
use const_key_db;
create table t_const_key(id int primary key, g int);
insert into t_const_key values (1,1),(2,1),(3,2),(4,null);
create table e_const_key like t_const_key;
select count(*), sum(id) from t_const_key group by 'fixed';
