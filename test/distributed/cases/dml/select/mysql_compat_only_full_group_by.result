create table issue_27983_binary_key(
k varbinary(8) not null,
payload varchar(20),
unique key uk_binary(k)
);
insert into issue_27983_binary_key values
('A','upper'),('a','lower'),('A ','space');
select k,payload,count(*) as n
from issue_27983_binary_key
group by k
order by hex(k);
