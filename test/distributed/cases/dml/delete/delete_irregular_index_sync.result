prepare del_t from 'delete from t where id = ?';
set @del_id = 9;
execute del_t using @del_id;
deallocate prepare del_t;
execute check_t;
➤ idx[12,3,0]  ¦  orphan[-5,64,0]  ¦  missing[-5,64,0]  𝄀
ft  ¦  0  ¦  0  𝄀
ivf  ¦  0  ¦  0  𝄀
ms  ¦  0  ¦  0
delete from t where true;
execute check_t;
➤ idx[12,3,0]  ¦  orphan[-5,64,0]  ¦  missing[-5,64,0]  𝄀
ft  ¦  0  ¦  0  𝄀
ivf  ¦  0  ¦  0  𝄀
ms  ¦  0  ¦  0
select count(*) from t;
➤ count(*)[-5,64,0]  𝄀
0
insert into t values (11, 1, 'apple again', 'a11', 'b11', '[1,1,1]');
execute check_t;
➤ idx[12,3,0]  ¦  orphan[-5,64,0]  ¦  missing[-5,64,0]  𝄀
ft  ¦  0  ¦  0  𝄀
ivf  ¦  0  ¦  0  𝄀
ms  ¦  0  ¦  0
select count(*) from t where match(body) against('apple');
➤ count(*)[-5,64,0]  𝄀
1
select id from t order by l2_distance(v, '[1,1,1]') limit 1;
➤ id[-5,64,0]  𝄀
11
deallocate prepare check_t;
create table pk_ft (id bigint primary key, body text, fulltext ft(body));
insert into pk_ft values (1, 'alpha'), (2, 'beta');
update pk_ft set id = 5 where id = 1;
unsupported DML: update primary key on a table with a synchronous full-text/vector index
select id from pk_ft order by id;
➤ id[-5,64,0]  𝄀
1  𝄀
2
create table pk_ivf (id bigint primary key, v vecf32(3));
create index ix using ivfflat on pk_ivf(v) lists = 1 op_type 'vector_l2_ops';
insert into pk_ivf values (1, '[1,1,1]'), (2, '[2,2,2]');
update pk_ivf set id = 5 where id = 1;
unsupported DML: update primary key on a table with a synchronous full-text/vector index
select id from pk_ivf order by id;
➤ id[-5,64,0]  𝄀
1  𝄀
2
create table pk_ms (id bigint primary key, a varchar(10), b varchar(10));
create index ms using master on pk_ms(a, b);
insert into pk_ms values (1, 'x1', 'y1'), (2, 'x2', 'y2');
set @pk_ms = (select index_table_name from mo_catalog.mo_indexes
where name = 'ms' and algo = 'master'
and table_id in (select rel_id from mo_catalog.mo_tables where reldatabase = database() and relname = 'pk_ms')
limit 1);
set @check_ms_sql = concat(
'select (select count(*) from `', database(), '`.`', @pk_ms, '` where __mo_index_pri_col not in (select id from pk_ms)) as orphan, ',
'(select count(*) from pk_ms where id not in (select __mo_index_pri_col from `', database(), '`.`', @pk_ms, '`)) as missing'
);
prepare check_ms from @check_ms_sql;
update pk_ms set id = 5 where id = 1;
execute check_ms;
➤ orphan[-5,64,0]  ¦  missing[-5,64,0]  𝄀
0  ¦  0
update pk_ms set id = 7 - id;
execute check_ms;
➤ orphan[-5,64,0]  ¦  missing[-5,64,0]  𝄀
0  ¦  0
select id from pk_ms where a = 'x1' and b = 'y1';
➤ id[-5,64,0]  𝄀
2
deallocate prepare check_ms;
create table ck (k1 varchar(10), k2 int, body text, a varchar(10), b varchar(10), primary key (k1, k2));
insert into ck values ('p', 1, 'apple one', 'x1', 'y1'), ('p', 2, 'apple two', 'x2', 'y2'), ('q', 1, 'banana', 'x3', 'y3');
create fulltext index ft_ck on ck(body);
create index ms_ck using master on ck(a, b);
set @ck_ft = (select index_table_name from mo_catalog.mo_indexes
where name = 'ft_ck' and algo = 'fulltext'
and table_id in (select rel_id from mo_catalog.mo_tables where reldatabase = database() and relname = 'ck')
limit 1);
set @ck_ms = (select index_table_name from mo_catalog.mo_indexes
where name = 'ms_ck' and algo = 'master'
and table_id in (select rel_id from mo_catalog.mo_tables where reldatabase = database() and relname = 'ck')
limit 1);
set @check_ck_sql = concat(
'select (select count(distinct doc_id) from `', database(), '`.`', @ck_ft, '` where doc_id not in (select serial(k1, k2) from ck)) as ft_orphan, ',
'(select count(*) from `', database(), '`.`', @ck_ms, '` where __mo_index_pri_col not in (select serial(k1, k2) from ck)) as ms_orphan, ',
'(select count(*) from ck) as live'
);
prepare check_ck from @check_ck_sql;
execute check_ck;
➤ ft_orphan[-5,64,0]  ¦  ms_orphan[-5,64,0]  ¦  live[-5,64,0]  𝄀
0  ¦  0  ¦  3
delete from ck where k1 = 'p' and k2 = 1;
execute check_ck;
➤ ft_orphan[-5,64,0]  ¦  ms_orphan[-5,64,0]  ¦  live[-5,64,0]  𝄀
0  ¦  0  ¦  2
delete from ck where k1 = 'q';
execute check_ck;
➤ ft_orphan[-5,64,0]  ¦  ms_orphan[-5,64,0]  ¦  live[-5,64,0]  𝄀
0  ¦  0  ¦  1
select count(*) from ck where match(body) against('apple');
➤ count(*)[-5,64,0]  𝄀
1
deallocate prepare check_ck;
set probe_limit = @saved_probe_limit;
set experimental_fulltext_index = 0;
set experimental_ivf_index = 0;
drop database dml_irregular_sync;
