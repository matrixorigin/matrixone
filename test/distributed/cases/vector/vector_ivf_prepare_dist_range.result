prepare null_lower from 'select id from t where l2_distance(v,''[1,1,1]'') > ? order by l2_distance(v,''[1,1,1]'') limit 2';
set @d=5;
execute null_lower using @d;
➤ id[4,32,0]  𝄀
3  𝄀
