with ranked as (
select id, cosine_distance(v, '[1e-20,1e-20,1e-20]') as d
from h_src
order by cosine_distance(v, '[1e-20,1e-20,1e-20]'), id
limit 4
)
select id, round(d, 6) as d from ranked order by d, id limit 2 offset 1;
➤ id[-5,64,0]  ¦  d[8,53,31]  𝄀
