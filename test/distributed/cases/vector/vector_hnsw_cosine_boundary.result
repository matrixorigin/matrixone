with ranked as (
select id, cosine_distance(v, '[1e-20,1e-20,1e-20]') as d
from h_src
order by cosine_distance(v, '[1e-20,1e-20,1e-20]'), id
limit 3
)
select r.id, round(r.d, 6) as d, l.name
from ranked r join h_labels l on r.id = l.id
order by r.d, r.id;
