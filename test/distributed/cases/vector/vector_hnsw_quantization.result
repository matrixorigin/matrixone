create index i_bad using hnsw on t_ci8(v) quantization 'float16';
not supported: HNSW QUANTIZATION 'float16' (2 bytes/element) cannot upcast base column VECINT8 (1 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
alter table t_f16 alter reindex i_f16 hnsw quantization 'bf16';
not supported: ALTER REINDEX option "quantization" on a hnsw index
alter table t_f16 alter reindex i_f16 hnsw ef_search = 64;
show create table t_f16;
