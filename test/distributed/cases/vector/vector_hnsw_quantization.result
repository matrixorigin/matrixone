create index i_bad using hnsw on t_ref(v) op_type 'vector_cosine_ops' quantization 'int8';
not supported: hnsw quantization "int8" is only supported with L2 (op_type 'vector_l2_ops'); the int8/uint8 affine quantizer does not preserve inner-product / cosine geometry
create index i_bad using hnsw on t_ref(v) op_type 'vector_ip_ops' quantization 'uint8';
not supported: hnsw quantization "uint8" is only supported with L2 (op_type 'vector_l2_ops'); the int8/uint8 affine quantizer does not preserve inner-product / cosine geometry
