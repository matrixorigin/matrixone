create index i_bad using hnsw on t_ref(v) op_type 'vector_cosine_ops' quantization 'int8';
not supported: hnsw quantization "int8" is only supported with L2 (op_type 'vector_l2_ops'); the int8/uint8 affine quantizer does not preserve inner-product / cosine geometry
create index i_bad using hnsw on t_ref(v) op_type 'vector_ip_ops' quantization 'uint8';
not supported: hnsw quantization "uint8" is only supported with L2 (op_type 'vector_l2_ops'); the int8/uint8 affine quantizer does not preserve inner-product / cosine geometry
create index i_bad using hnsw on t_ref(v) op_type 'vector_l2_ops' quantization 'int4';
not supported: hnsw quantization "int4" (supported: float32, float16, bf16, float64, int8, uint8)
create index i_bad using hnsw on t_ref(v) op_type 'vector_l2_ops' quantization 'float64';
not supported: HNSW QUANTIZATION 'float64' (8 bytes/element) cannot upcast base column VECF32 (4 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
create table t_f64(id bigint primary key, v vecf64(4));
insert into t_f64 select id, cast(v as vecf64(4)) from t_ref;
create index i_f64 using hnsw on t_f64(v) op_type 'vector_l2_ops' quantization 'float32';
show create table t_f64;
➤ Table[12,5,0]  ¦  Create Table[12,180,0]  𝄀
t_f64  ¦  CREATE TABLE `t_f64` (
  `id` bigint NOT NULL,
  `v` vecf64(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_f64` USING hnsw (`v`) op_type 'vector_l2_ops'  quantization 'float32' 
)
select id from t_f64 order by l2_distance(v,'[2,2,2,2]') limit 3;
➤ id[-5,64,0]  𝄀
2  𝄀
1  𝄀
