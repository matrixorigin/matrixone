create index i_bad using hnsw on t_ref(v) op_type 'vector_l2_ops' quantization 'float64';
not supported: HNSW QUANTIZATION 'float64' (8 bytes/element) cannot upcast base column VECF32 (4 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
create index i_bad using hnsw on t_cf16(v) quantization 'float32';
not supported: HNSW QUANTIZATION 'float32' (4 bytes/element) cannot upcast base column VECF16 (2 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
create index i_bad using hnsw on t_ci8(v) quantization 'float16';
not supported: HNSW QUANTIZATION 'float16' (2 bytes/element) cannot upcast base column VECINT8 (1 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
create index i_bad using hnsw on t_cu8(v) quantization 'bf16';
not supported: HNSW QUANTIZATION 'bf16' (2 bytes/element) cannot upcast base column VECUINT8 (1 bytes/element); use a quantization of equal or smaller width, or omit it to keep the base type
