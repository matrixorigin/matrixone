prepare s1 from 'select id from ivf_cos order by cosine_distance(v,?) limit 3';
set @q='[1,0]';
execute s1 using @q;
➤ id[-5,64,0]  𝄀
100  𝄀
99  𝄀
98
set @q='[0,1]';
execute s1 using @q;
➤ id[-5,64,0]  𝄀
1  𝄀
2  𝄀
3
set @q='[0,1,2]';
execute s1 using @q;
invalid input: expected vector dimension 2 != actual dimension 3.
deallocate prepare s1;
