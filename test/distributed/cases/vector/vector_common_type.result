prepare s1 from 'select coalesce(?, bf16) v from x order by id';
set @v = '[2,2,2,2]';
execute s1 using @v;
➤ v[12,4,0]  𝄀
[2, 2, 2, 2]  𝄀
[2, 2, 2, 2]
prepare s2 from 'select v from (select 1 o, bf16 v from x where id = 1 union all select 2, i8 from y where id = 1) t order by o';
execute s2;
➤ v[12,4,0]  𝄀
[1, 3, 0, 6]  𝄀
[6, 2, 1, 0]
