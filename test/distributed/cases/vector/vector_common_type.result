drop database if exists vec_common_type;
create database vec_common_type;
use vec_common_type;
create table x (id int primary key, f32 vecf32(4), f64 vecf64(4), bf16 vecbf16(4), f16 vecf16(4), i8 vecint8(4), u8 vecuint8(4), f8 vecf8(4), f4 vecf4(4));
create table y (id int primary key, f32 vecf32(4), f64 vecf64(4), bf16 vecbf16(4), f16 vecf16(4), i8 vecint8(4), u8 vecuint8(4), f8 vecf8(4), f4 vecf4(4));
insert into x values (1, '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]', '[1,3,0,6]'), (2, null, null, null, null, null, null, null, null);
insert into y values (1, '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]'), (2, '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]', '[6,2,1,0]');
create table r_f32 as select x.id, case when x.id = 1 then x.f32 else y.f32 end case_f32, ifnull(x.f32, y.f32) ifnull_f32, if(x.id = 1, x.f32, y.f32) if_f32, coalesce(x.f32, y.f32) coalesce_f32, nullif(x.f32, y.f32) nullif_f32, greatest(x.f32, y.f32) greatest_f32, least(x.f32, y.f32) least_f32, x.f32 = y.f32 eq_f32, x.f32 <> y.f32 ne_f32, x.f32 < y.f32 lt_f32, x.f32 between y.f32 and y.f32 between_f32, x.f32 <=> y.f32 nullsafe_f32, x.f32 in (y.f32) in_f32, case when x.id = 1 then x.f32 else y.f64 end case_f64, ifnull(x.f32, y.f64) ifnull_f64, if(x.id = 1, x.f32, y.f64) if_f64, coalesce(x.f32, y.f64) coalesce_f64, nullif(x.f32, y.f64) nullif_f64, greatest(x.f32, y.f64) greatest_f64, least(x.f32, y.f64) least_f64, x.f32 = y.f64 eq_f64, x.f32 <> y.f64 ne_f64, x.f32 < y.f64 lt_f64, x.f32 between y.f64 and y.f64 between_f64, x.f32 <=> y.f64 nullsafe_f64, x.f32 in (y.f64) in_f64, case when x.id = 1 then x.f32 else y.bf16 end case_bf16, ifnull(x.f32, y.bf16) ifnull_bf16, if(x.id = 1, x.f32, y.bf16) if_bf16, coalesce(x.f32, y.bf16) coalesce_bf16, nullif(x.f32, y.bf16) nullif_bf16, greatest(x.f32, y.bf16) greatest_bf16, least(x.f32, y.bf16) least_bf16, x.f32 = y.bf16 eq_bf16, x.f32 <> y.bf16 ne_bf16, x.f32 < y.bf16 lt_bf16, x.f32 between y.bf16 and y.bf16 between_bf16, x.f32 <=> y.bf16 nullsafe_bf16, x.f32 in (y.bf16) in_bf16, case when x.id = 1 then x.f32 else y.f16 end case_f16, ifnull(x.f32, y.f16) ifnull_f16, if(x.id = 1, x.f32, y.f16) if_f16, coalesce(x.f32, y.f16) coalesce_f16, nullif(x.f32, y.f16) nullif_f16, greatest(x.f32, y.f16) greatest_f16, least(x.f32, y.f16) least_f16, x.f32 = y.f16 eq_f16, x.f32 <> y.f16 ne_f16, x.f32 < y.f16 lt_f16, x.f32 between y.f16 and y.f16 between_f16, x.f32 <=> y.f16 nullsafe_f16, x.f32 in (y.f16) in_f16, case when x.id = 1 then x.f32 else y.i8 end case_i8, ifnull(x.f32, y.i8) ifnull_i8, if(x.id = 1, x.f32, y.i8) if_i8, coalesce(x.f32, y.i8) coalesce_i8, nullif(x.f32, y.i8) nullif_i8, greatest(x.f32, y.i8) greatest_i8, least(x.f32, y.i8) least_i8, x.f32 = y.i8 eq_i8, x.f32 <> y.i8 ne_i8, x.f32 < y.i8 lt_i8, x.f32 between y.i8 and y.i8 between_i8, x.f32 <=> y.i8 nullsafe_i8, x.f32 in (y.i8) in_i8, case when x.id = 1 then x.f32 else y.u8 end case_u8, ifnull(x.f32, y.u8) ifnull_u8, if(x.id = 1, x.f32, y.u8) if_u8, coalesce(x.f32, y.u8) coalesce_u8, nullif(x.f32, y.u8) nullif_u8, greatest(x.f32, y.u8) greatest_u8, least(x.f32, y.u8) least_u8, x.f32 = y.u8 eq_u8, x.f32 <> y.u8 ne_u8, x.f32 < y.u8 lt_u8, x.f32 between y.u8 and y.u8 between_u8, x.f32 <=> y.u8 nullsafe_u8, x.f32 in (y.u8) in_u8, case when x.id = 1 then x.f32 else y.f8 end case_f8, ifnull(x.f32, y.f8) ifnull_f8, if(x.id = 1, x.f32, y.f8) if_f8, coalesce(x.f32, y.f8) coalesce_f8, nullif(x.f32, y.f8) nullif_f8, greatest(x.f32, y.f8) greatest_f8, least(x.f32, y.f8) least_f8, x.f32 = y.f8 eq_f8, x.f32 <> y.f8 ne_f8, x.f32 < y.f8 lt_f8, x.f32 between y.f8 and y.f8 between_f8, x.f32 <=> y.f8 nullsafe_f8, x.f32 in (y.f8) in_f8, case when x.id = 1 then x.f32 else y.f4 end case_f4, ifnull(x.f32, y.f4) ifnull_f4, if(x.id = 1, x.f32, y.f4) if_f4, coalesce(x.f32, y.f4) coalesce_f4, nullif(x.f32, y.f4) nullif_f4, greatest(x.f32, y.f4) greatest_f4, least(x.f32, y.f4) least_f4, x.f32 = y.f4 eq_f4, x.f32 <> y.f4 ne_f4, x.f32 < y.f4 lt_f4, x.f32 between y.f4 and y.f4 between_f4, x.f32 <=> y.f4 nullsafe_f4, x.f32 in (y.f4) in_f4, case when x.id = 1 then x.f32 else '[0,0,0,0]' end case_str, case when x.id <> 1 then '[0,0,0,0]' else x.f32 end case_str_rev, ifnull(x.f32, '[0,0,0,0]') ifnull_str, if(x.id = 1, x.f32, '[0,0,0,0]') if_str, coalesce(x.f32, '[0,0,0,0]') coalesce_str, greatest(x.f32, '[0,0,0,0]') greatest_str, least(x.f32, '[0,0,0,0]') least_str, nullif(x.f32, '[1,3,0,6]') nullif_str from x join y on x.id = y.id;
