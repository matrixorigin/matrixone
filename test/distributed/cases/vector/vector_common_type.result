select x.id, case when x.id = 1 then x.bf16 when x.id = 2 then y.f16 else y.i8 end v from x join y on x.id = y.id order by x.id;
➤ id[4,32,0]  ¦  v[12,4,0]  𝄀
1  ¦  [1, 3, 0, 6]  𝄀
2  ¦  [6, 2, 1, 0]
select x.id, case when x.id = 1 then x.u8 when x.id = 2 then y.f64 else '[9,9,9,9]' end v from x join y on x.id = y.id order by x.id;
➤ id[4,32,0]  ¦  v[12,4,0]  𝄀
1  ¦  [1, 3, 0, 6]  𝄀
