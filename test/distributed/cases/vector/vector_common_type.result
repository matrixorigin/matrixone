create table u_f4 as select 1 o, f4 v_f32, f4 v_f64, f4 v_bf16, f4 v_f16, f4 v_i8, f4 v_u8, f4 v_f8, f4 v_f4, f4 v_str from x where id = 1 union all select 2, f32, f64, bf16, f16, i8, u8, f8, f4, '[0,0,0,0]' from y where id = 1;
