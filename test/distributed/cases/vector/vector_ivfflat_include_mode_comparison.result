  ->  Sort  𝄀
        Sort Key: #[0,3] INTERNAL  𝄀
        Limit: 3  𝄀
        ->  Join  𝄀
              Join Type: INNER  𝄀
              Join Cond: (phase9_main.id = #[1,0])  𝄀
              ->  Table Scan on vector_ivfflat_include_phase9.phase9_main  𝄀
                    Filter Cond: (phase9_main.category >= 20)  𝄀
              ->  Vector Index Scan on idx_ivf_include_phase9 [l2_distance]  𝄀
                    Vector Index: idx_ivf_include_phase9, Metric: l2_distance, Candidate Limit: 3, NProbe: 8
explain select id, title, category
from phase9_main
where category >= 20
order by l2_distance(embedding, "[1,2,3]")
limit 3 by rank with option 'mode=pre';
