-- @regex("Vector Index Scan on", true)
➤ AP QUERY PLAN ON MULTICN(8 core)[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: #[0,1] INTERNAL  𝄀
        Limit: 3  𝄀
        ->  Join  𝄀
              Join Type: INNER  𝄀
              Join Cond: (t_ft_ivfflat.id = #[1,0])  𝄀
              ->  Join  𝄀
                    Join Type: INNER  𝄀
                    Join Cond: (t_ft_ivfflat.id = mo_fulltext_alias_0.doc_id)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on hybrid_ft_vec.t_ft_ivfflat  𝄀
                          Runtime Filter Probe: t_ft_ivfflat.id  𝄀
                    ->  Fulltext Index Scan on f  𝄀
                          Fulltext Index: f  𝄀
              ->  Vector Index Scan on vi [l2_distance]  𝄀
                    Vector Index: vi, Metric: l2_distance, Candidate Limit: 3, NProbe: 5
select id from t_ft_ivfflat where match(body) against('needle') order by l2_distance(v,'[0,0,0]') limit 3;
