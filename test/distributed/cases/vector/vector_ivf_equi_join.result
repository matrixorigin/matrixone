drop database if exists vector_ivf_equi_join;
create database vector_ivf_equi_join;
use vector_ivf_equi_join;
set @saved_experimental_ivf_index = @@experimental_ivf_index;
set experimental_ivf_index = 1;
set @probe_limit = 1;
create table chunks (
id varchar(32) primary key,
v vecf32(2) not null,
document_id varchar(32),
category varchar(32)
);
insert into chunks values
('c0', '[0,0]', 'u', 'x'),
('c1', '[0.01,0]', 'u', 'x'),
('c2', '[0.1,0]', 'd1', 'x'),
('c3', '[0.2,0]', 'd2', 'z'),
('c4', '[0.3,0]', 'd1', 'y'),
('c5', '[0.6,0]', 'd3', 'outside'),
('c6', '[0.15,0]', null, 'null'),
('c7', '[0.4,0]', 'd4', 'new');
create index chunks_ivf using ivfflat on chunks(v) lists = 1 op_type 'vector_l2_ops';
create table documents (row_id int primary key, document_id varchar(32), label varchar(32));
insert into documents values (1,'d1','x'),(2,'d1','y'),(3,'d2','z'),(4,'d3','outside'),(5,null,'null');
create table unique_documents (document_id varchar(32) primary key, label varchar(32));
insert into unique_documents values ('d1','x'),('d2','z'),('d3','outside');
explain select a.id from chunks a join documents b on a.document_id=b.document_id
order by l2_distance(a.v,'[0,0]') limit 3;
-- @regex("Vector Index Scan", true)
➤ AP QUERY PLAN ON ONE CN(10 core)[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: l2_distance(chunks.v, ) INTERNAL  𝄀
        Limit: 3  𝄀
        ->  Join  𝄀
              Join Type: INNER  𝄀
              Join Cond: (b.document_id = chunks.document_id)  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on vector_ivf_equi_join.documents  𝄀
                    Runtime Filter Probe: b.document_id  𝄀
              ->  Sort  𝄀
                    Sort Key: #[0,3] ASC  𝄀
                    Limit: 3  𝄀
                    ->  Join  𝄀
                          Join Type: INNER  𝄀
                          Join Cond: (chunks.id = #[1,0])  𝄀
                          Runtime Filter Build: #[-1,0]  𝄀
                          ->  Table Scan on vector_ivf_equi_join.chunks  𝄀
                                Runtime Filter Probe: chunks.id  𝄀
                          ->  Join  𝄀
                                Join Type: SEMI  𝄀
                                Join Cond: (#[0,0] = chunks.id)  𝄀
                                Runtime Filter Build: #[14,0]  𝄀
                                ->  Vector Index Scan on chunks_ivf [l2_distance]  𝄀
                                      Runtime Filter Probe: #[12,0]  𝄀
                                      Vector Index: chunks_ivf, Metric: l2_distance, Candidate Limit: 3, NProbe: 5  𝄀
                                ->  Join  𝄀
                                      Join Type: SEMI  𝄀
                                      Join Cond: (chunks.document_id = documents.document_id)  𝄀
                                      Runtime Filter Build: #[-1,0]  𝄀
                                      ->  Table Scan on vector_ivf_equi_join.chunks  𝄀
                                            Runtime Filter Probe: chunks.document_id  𝄀
                                      ->  Table Scan on vector_ivf_equi_join.documents
explain select a.id from chunks a join documents b on a.document_id=b.document_id
order by l2_distance(a.v,'[0,0]') limit 3 by rank with option 'mode=pre';
