3  ¦  8.0
with knn as (
select id, l2_distance(v,'[1,1,1,1]') as d from t_ref
order by l2_distance(v,'[1,1,1,1]') limit 3
) select id, d from knn order by d;
➤ id[-5,64,0]  ¦  d[8,53,31]  𝄀
1  ¦  0.0  𝄀
2  ¦  4.0  𝄀
3  ¦  8.0
with knn as (
select id, l2_distance(v,'[1,1,1,1]') as d from t_hnsw
order by l2_distance(v,'[1,1,1,1]') limit 3
) select id, d from knn order by d desc;
➤ id[-5,64,0]  ¦  d[8,9,0]  𝄀
3  ¦  8.0  𝄀
2  ¦  4.0  𝄀
1  ¦  0.0
with knn as (
select id, tag, l2_distance(v,'[1,1,1,1]') as d from t_hnsw
order by l2_distance(v,'[1,1,1,1]') limit 3
) select id, tag from knn order by tag desc;
➤ id[-5,64,0]  ¦  tag[4,32,0]  𝄀
3  ¦  30  𝄀
2  ¦  20  𝄀
1  ¦  10
explain with knn as (
select id, l2_distance(v,'[1,1,1,1]') as d from t_hnsw
order by l2_distance(v,'[1,1,1,1]') limit 3
) select k.id, m.name from knn k left join meta m on k.id = m.id;
-- @regex("Table Function on hnsw_search", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Join  𝄀
        Join Type: RIGHT  𝄀
        Join Cond: (m.id = t_hnsw.id)  𝄀
        Runtime Filter Build: #[-1,0]  𝄀
        ->  Table Scan on hnsw_topk_consumers.meta [ForceOneCN]  𝄀
              Runtime Filter Probe: m.id  𝄀
        ->  Sort  𝄀
              Sort Key: mo_hnsw_alias_0.score INTERNAL  𝄀
              Limit: 3  𝄀
              ->  Join  𝄀
                    Join Type: INNER  𝄀
                    Join Cond: (t_hnsw.id = mo_hnsw_alias_0.pkid)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on hnsw_topk_consumers.t_hnsw [ForceOneCN]  𝄀
                          Runtime Filter Probe: t_hnsw.id  𝄀
                    ->  Table Function on hnsw_search  𝄀
                          Limit: 3
with knn as (
select id, l2_distance(v,'[1,1,1,1]') as d from t_hnsw
order by l2_distance(v,'[1,1,1,1]') limit 3
) select k.id, k.d, m.name from knn k left join meta m on k.id = m.id order by k.d;
