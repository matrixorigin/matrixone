create table ivf_semi_chunks (
id varchar(64) primary key,
document_id varchar(64) not null,
embedding vecf32(2)
);
insert into ivf_semi_chunks values
('v01', 'ineligible', '[0.0,0.0]'),
('v02', 'ineligible', '[0.1,0.1]'),
('v03', 'ineligible', '[0.2,0.2]'),
('v04', 'eligible',   '[1.0,1.0]'),
('v05', 'eligible',   '[2.0,2.0]');
create table ivf_semi_filters (document_id varchar(64));
insert into ivf_semi_filters values ('eligible'), ('eligible'), (null);
create index idx_semi using ivfflat on ivf_semi_chunks(embedding) lists=1 op_type 'vector_l2_ops';
select c.id from ivf_semi_chunks c
where c.document_id in (select f.document_id from ivf_semi_filters f)
and l2_distance(c.embedding, '[0.0,0.0]') <= 10
order by l2_distance(c.embedding, '[0.0,0.0]')
limit 1 by rank with option 'mode=pre';
id
v04
set probe_limit = 1;
create table ivf_semi_varchar_chunks (
id varchar(64) primary key,
document_id varchar(64) not null,
embedding vecf32(2)
);
insert into ivf_semi_varchar_chunks values
('a', 'eligible', '[1.0,1.0]');
insert into ivf_semi_varchar_chunks
select concat('f', result), 'eligible', '[2.0,2.0]'
from generate_series(1, 100) g;
insert into ivf_semi_varchar_chunks values
(concat('a', char(0)), 'ineligible', '[0.0,0.0]');
create table ivf_semi_varchar_filters (document_id varchar(64));
insert into ivf_semi_varchar_filters values ('eligible'), ('eligible'), (null);
select hex(c.id) as id_hex from ivf_semi_varchar_chunks c
where c.document_id in (select f.document_id from ivf_semi_varchar_filters f)
and l2_distance(c.embedding, '[0.0,0.0]') <= 10
order by l2_distance(c.embedding, '[0.0,0.0]')
limit 1 by rank with option 'mode=pre';
id_hex
61
create index idx_semi_varchar using ivfflat on ivf_semi_varchar_chunks(embedding) lists=1 op_type 'vector_l2_ops';
select hex(c.id) as id_hex from ivf_semi_varchar_chunks c
where c.document_id in (select f.document_id from ivf_semi_varchar_filters f)
and l2_distance(c.embedding, '[0.0,0.0]') <= 10
order by l2_distance(c.embedding, '[0.0,0.0]')
limit 1 by rank with option 'mode=pre';
id_hex
61
create table ivf_chunk_domain(id int primary key, grp int, v vecf32(2));
insert into ivf_chunk_domain
select result, if(result=1,0,1),
cast(case when result=1 then '[0,0]' when result=8194 then '[1,0]' else '[100,0]' end as vecf32(2))
from generate_series(1,8194) g;
create index chunk_idx using ivfflat on ivf_chunk_domain(v) lists=1 op_type 'vector_l2_ops';
select id from ivf_chunk_domain where grp=1
order by l2_distance(v,'[0,0]') limit 1 by rank with option 'mode=pre';
id
8194
select id from ivf_chunk_domain where grp=1
order by l2_distance(v,'[0,0]') limit 1 by rank with option 'mode=force';
id
8194
select count(*) from (select id from ivf_chunk_domain where grp=2
order by l2_distance(v,'[0,0]') limit 1 by rank with option 'mode=pre') x;
count(*)
0
select count(*) from ivf_chunk_domain a join ivf_chunk_domain b on a.id=b.id where a.grp=1;
count(*)
8193
drop table ivf_chunk_domain;
set ivf_preload_entries = 0;
set probe_limit = 5;
set experimental_fulltext_index = 1;
create table persisted_match(id bigint primary key, body text, category varchar(8), v vecf32(3));
insert into persisted_match values (1,'alpha matrix one','A','[0,0,0]'),(2,'alpha vector search','A','[0.1,0,0]'),(3,'beta storage engine','B','[0.2,0,0]'),(4,'alpha transaction','B','[0.3,0,0]'),(5,'alpha analytics','C','[0.4,0,0]');
create fulltext index body_idx on persisted_match(body) with parser ngram;
create index vec_idx using ivfflat on persisted_match(v) lists=2 op_type 'vector_l2_ops';
select id from persisted_match where match(body) against('+alpha' in boolean mode) order by id;
