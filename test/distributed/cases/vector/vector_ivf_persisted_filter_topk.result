set experimental_ivf_index = @saved_ivf_index;
set probe_limit = @saved_probe_limit;
select @@experimental_ivf_index = @saved_ivf_index as ivf_index_restored,
@@probe_limit = @saved_probe_limit as probe_limit_restored;
