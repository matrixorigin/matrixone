0  ¦  1  ¦  3  ¦  -1.0  𝄀
1  ¦  0  ¦  2  ¦  -1.0  𝄀
1  ¦  1  ¦  3  ¦  -1.0
prepare s from 'select vector_matmul(?, id, b, ?) from t';
set @p = 1;
set @q = '[[0,1,0,0]]';
execute s using @p, @q;
