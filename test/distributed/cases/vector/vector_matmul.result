create table u (k uuid primary key, a vecf8(2));
insert into u values ('6ba7b810-9dad-11d1-80b4-00c04fd430c8', '[1,2]'), ('6ba7b811-9dad-11d1-80b4-00c04fd430c8', '[2,1]');
select vector_matmul(2, k, a, '[[1,0],[0,1]]') from u;
