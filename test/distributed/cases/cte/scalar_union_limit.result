create table inserted like metrics;
insert into inserted
select * from (
with grouped as (select period,sum(amount) as total from measurements group by period),
totals as (select max(total) as mx,min(total) as mn from grouped)
select 1 as rn,'max' as metric,mx as amount from totals
union all select 2,'min',mn from totals
) u limit 2;
select * from inserted order by rn;
➤ rn[-5,64,0]  ¦  metric[12,-1,0]  ¦  amount[3,44,8]  𝄀
1  ¦  max  ¦  60.00000000  𝄀
2  ¦  min  ¦  30.00000000
with source as (select amount,guard_value from measurements),
totals as (select sum(amount) as good,max(abs(guard_value)) as bad from source)
select good from totals union all select good from totals limit 2;
➤ good[3,38,2]  𝄀
90.00  𝄀
90.00
with source as (select amount,guard_value from measurements),
totals as (select sum(amount) as good,max(abs(guard_value)) as bad from source)
select u.good from (
select good,bad as unused from totals
union all select good,bad from totals
) u limit 2;
➤ good[3,38,2]  𝄀
90.00  𝄀
90.00
with source as (select amount,guard_value from measurements),
totals as (select sum(amount) as good,max(abs(guard_value)) as bad from source)
select if(false,bad,good) from totals union all select good from totals limit 2;
