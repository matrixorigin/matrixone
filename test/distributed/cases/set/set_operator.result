drop table if exists t1;
drop table if exists t2;
create table t1 (a smallint, b bigint, c int);
insert into t1 values (1,2,3);
insert into t1 values (1,2,3);
insert into t1 values (3,4,5);
insert into t1 values (4,5,6);
insert into t1 values (4,5,6);
insert into t1 values (1,1,2);
create table t2 (a smallint, b bigint, c int);
insert into t2 values (1,2,3);
insert into t2 values (3,4,5);
insert into t2 values (1,2,1);
select * from t1 minus select * from t2;
a	b	c
1	1	2
4	5	6
select * from t1 intersect select * from t2;
a	b	c
1	2	3
3	4	5
select a, b from t1 minus select b, c from t2;
a	b
3	4
1	1
1	2
select a, b from t1 intersect select b, c from t2;
a	b
4	5
drop table if exists except_all_left;
drop table if exists except_all_right;
create table except_all_left(v int);
create table except_all_right(v int);
insert into except_all_left values (1),(1),(2),(2),(null),(null);
insert into except_all_right values (1),(1),(1),(3),(null);
select v, count(*) from (
select v from except_all_left
except all
select v from except_all_right
) q group by v order by v is null, v;
v	count(*)
2	2
NULL	1
select v, count(*) from (
select v from except_all_left
minus all
select v from except_all_right
) q group by v order by v is null, v;
v	count(*)
2	2
NULL	1
drop table except_all_left;
drop table except_all_right;
set max_allowed_packet = cast('2048' as unsigned);
show variables where variable_name = 'max_allowed_packet';
Variable_name    Value
max_allowed_packet    2048
set @val = cast('2022-10-10' as date);
select @val;
@val
2022-10-10
