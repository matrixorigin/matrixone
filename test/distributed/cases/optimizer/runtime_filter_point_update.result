drop database if exists rf_point_qa;
create database rf_point_qa;
use rf_point_qa;
create table t (id int primary key, state int, other int, index idx_state(state), index idx_pair(state,other));
insert into t values (1,null,1),(2,4,2),(3,4,3);
prepare p from 'update t set state=? where id=?';
set @s1=9;
set @i1=1;
set @s2=null;
set @i2=2;
set @s3=7;
set @i3=null;
begin;
execute p using @s1,@i1;
select id,state from t force index(idx_state) where state=9 order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
1  ¦  9
select id,state from t force index(idx_pair) where state=9 and other=1 order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
1  ¦  9
execute p using @s2,@i2;
select id,state from t where id=2;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
2  ¦  null
execute p using @s3,@i3;
select count(*) from t where state=7;
➤ count(*)[-5,64,0]  𝄀
0
rollback;
select id,state from t order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
1  ¦  null  𝄀
2  ¦  4  𝄀
3  ¦  4
select id,state from t force index(idx_pair) where state=4 and other=2 order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
2  ¦  4
deallocate prepare p;
update t set id=4,state=8 where id=3;
select id,state from t force index(idx_state) where state=8 order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
4  ¦  8
select id,state from t force index(idx_pair) where state=8 and other=3 order by id;
➤ id[4,32,0]  ¦  state[4,32,0]  𝄀
4  ¦  8
select count(*) from t where id=3;
➤ count(*)[-5,64,0]  𝄀
0
drop database rf_point_qa;
