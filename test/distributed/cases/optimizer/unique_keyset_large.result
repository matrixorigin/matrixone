}

set @idx=(select distinct index_table_name from mo_catalog.mo_indexes where name='uq_gate' and table_id=(select rel_id from mo_catalog.mo_tables where reldatabase='unique_keyset_large' and relname='gate'));
select mo_ctl('dn','flush',concat('unique_keyset_large.',@idx));
➤ mo_ctl(dn, flush, concat(unique_keyset_large., @idx))[12,-1,0]  𝄀
{
  "method": "Flush",
  "result": [
    {
      "returnStr": "OK"
    }
  ]
}

analyze table gate;
-- @regex(".*", true)
➤ approx_count_distinct(id)[-5,64,0]  ¦  approx_count_distinct(a)[-5,64,0]  ¦  approx_count_distinct(b)[-5,64,0]  ¦  approx_count_distinct(payload)[-5,64,0]  𝄀
59601  ¦  1  ¦  2  ¦  59601
explain verbose select payload from gate;
-- @regex("Table Scan.*cost=60000[.]00", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project[1] (cost=60000.00 outcnt=60000.00 selectivity=1.0000 dop=0 blockNum=9 rowsize=100.00)  𝄀
  Output: gate.payload  𝄀
  ->  Table Scan[0] on unique_keyset_large.gate (cost=60000.00 outcnt=60000.00 selectivity=1.0000 dop=0 blockNum=9 rowsize=16.15)  𝄀
        Output: gate.payload  𝄀
        Table: 'gate' (0:'payload') shuffle: range(id)
explain select payload from gate where a=1 and b in (1,2);
-- @regex("Index Table Scan.*uq_gate", true)
-- @regex("__mo_index_idx_col in", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Join  𝄀
        Join Type: INDEX  𝄀
        Join Cond: (gate.id = __mo_index_pri_col)  𝄀
        Runtime Filter Build: #[-1,0]  𝄀
        ->  Table Scan on unique_keyset_large.gate [ForceOneCN]  𝄀
              Filter Cond: (gate.a = 1), gate.b in ([1 2])  𝄀
              Block Filter Cond: (gate.a = 1)  𝄀
              Runtime Filter Probe: gate.id  𝄀
        ->  Index Table Scan on gate.uq_gate [ForceOneCN]  𝄀
              Filter Cond: __mo_index_idx_col in ([:\x15\x01:\x15\x01 :\x15\x01:\x15\x02])  𝄀
              Block Filter Cond: __mo_index_idx_col in ([:\x15\x01:\x15\x01 :\x15\x01:\x15\x02])
select payload from gate where a=1 and b in (1,2) order by payload;
➤ payload[4,32,0]  𝄀
59999  𝄀
60000
select payload from gate ignore index(uq_gate,uq_gate_ba,uq_gate_ab2) where a=1 and b in (1,2) order by payload;
➤ payload[4,32,0]  𝄀
59999  𝄀
60000
select payload from gate where a=1 and b in (1,null) order by payload;
➤ payload[4,32,0]  𝄀
59999
select payload from gate ignore index(uq_gate,uq_gate_ba,uq_gate_ab2) where a=1 and b in (1,null) order by payload;
➤ payload[4,32,0]  𝄀
59999
create table nulkeys (id int primary key, a int not null, b varchar(16) not null, payload int, unique key uq_ab(a,b));
insert into nulkeys values (1,1,'a',10),(2,1,concat('a',char(0)),20),(3,1,concat('a',char(0),'b'),30),(4,1,'z',40);
explain select id,hex(b),payload from nulkeys where a=1 and b in ('a','z','a');
-- @regex("Index Table Scan.*uq_ab", true)
-- @regex("__mo_index_idx_col in", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Join  𝄀
        Join Type: INDEX  𝄀
        Join Cond: (nulkeys.id = __mo_index_pri_col)  𝄀
        Runtime Filter Build: #[-1,0]  𝄀
        ->  Table Scan on unique_keyset_large.nulkeys [ForceOneCN]  𝄀
              Filter Cond: (nulkeys.a = 1), nulkeys.b in ([a z])  𝄀
              Block Filter Cond: (nulkeys.a = 1)  𝄀
              Runtime Filter Probe: nulkeys.id  𝄀
        ->  Index Table Scan on nulkeys.uq_ab [ForceOneCN]  𝄀
              Filter Cond: __mo_index_idx_col in ([:\x15\x01F\x01a\x00 :\x15\x01F\x01z\x00])  𝄀
              Block Filter Cond: __mo_index_idx_col in ([:\x15\x01F\x01a\x00 :\x15\x01F\x01z\x00])
select id,hex(b),payload from nulkeys where a=1 and b in ('a','z','a') order by id;
➤ id[4,32,0]  ¦  hex(b)[12,-1,0]  ¦  payload[4,32,0]  𝄀
1  ¦  61  ¦  10  𝄀
4  ¦  7A  ¦  40
select id,hex(b),payload from nulkeys ignore index(uq_ab) where a=1 and b in ('a','z','a') order by id;
➤ id[4,32,0]  ¦  hex(b)[12,-1,0]  ¦  payload[4,32,0]  𝄀
1  ¦  61  ¦  10  𝄀
4  ¦  7A  ¦  40
