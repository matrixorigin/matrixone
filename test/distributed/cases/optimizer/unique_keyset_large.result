60000
prepare keyset_rank_stmt from 'select payload from gate where a=? and b in (2,1,2) order by payload';
set @rank_a=1;
execute keyset_rank_stmt using @rank_a;
➤ payload[4,32,0]  𝄀
59999  𝄀
60000
deallocate prepare keyset_rank_stmt;
drop database unique_keyset_large;
