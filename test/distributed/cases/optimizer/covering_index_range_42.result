explain select count(distinct b) from t force index(ix_b) where b>=5 and b<7;
-- @regex("Index Table Scan.*ix_b", true)
-- @regex("prefix_in_range", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Aggregate  𝄀
        Aggregate Functions: count(#[0,0])  𝄀
        ->  Aggregate  𝄀
              Group Key: serial_extract(__mo_index_idx_col, 0, INT))  𝄀
              ->  Index Table Scan on t.ix_b  𝄀
                    Filter Cond: prefix_in_range(__mo_index_idx_col), (serial_extract(__mo_index_idx_col, 0, INT)) < 7)  𝄀
                    Block Filter Cond: prefix_in_range(__mo_index_idx_col)
select count(distinct b) from t force index(ix_b) where b>=5 and b<7;
➤ count(distinct b)[-5,64,0]  𝄀
2
select count(distinct b) from control where b>=5 and b<7;
➤ count(distinct b)[-5,64,0]  𝄀
