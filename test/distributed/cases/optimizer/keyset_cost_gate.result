drop database if exists keyset_cost_gate;
create database keyset_cost_gate;
use keyset_cost_gate;
create table gate (id int primary key, a int not null, b int not null, payload int, unique key uq_ab(a,b));
insert into gate select result,1,result,result from generate_series(1,1000) g;
select mo_ctl('dn','flush','keyset_cost_gate.gate');
➤ mo_ctl(dn, flush, keyset_cost_gate.gate)[12,-1,0]  𝄀
{
  "method": "Flush",
  "result": [
    {
      "returnStr": "OK"
    }
  ]
}

analyze table gate;
