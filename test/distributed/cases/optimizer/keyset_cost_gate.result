deallocate prepare keyset_cost_param;
create table duplicate_keys (id int primary key, a int, b varchar(20), payload int, key ix_ab(a,b));
insert into duplicate_keys values (1,1,'alpha',10),(2,1,'alpha',20),(3,1,'beta',30),(4,2,'alpha',40);
explain select payload from duplicate_keys force index(ix_ab) where a=1 and b in ('alpha','beta');
-- @regex("Index Table Scan.*ix_ab", true)
-- @regex("prefix_in", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Join  𝄀
        Join Type: INDEX  𝄀
        Join Cond: (duplicate_keys.id = __mo_index_pri_col)  𝄀
        Runtime Filter Build: #[-1,0]  𝄀
        ->  Table Scan on keyset_cost_gate.duplicate_keys [ForceOneCN]  𝄀
              Filter Cond: (duplicate_keys.a = 1), duplicate_keys.b in ([alpha beta])  𝄀
              Block Filter Cond: (duplicate_keys.a = 1)  𝄀
              Runtime Filter Probe: duplicate_keys.id  𝄀
        ->  Index Table Scan on duplicate_keys.ix_ab [ForceOneCN]  𝄀
              Filter Cond: prefix_in(__mo_index_idx_col)  𝄀
              Block Filter Cond: prefix_in(__mo_index_idx_col)
select count(*),sum(payload) from duplicate_keys force index(ix_ab) where a=1 and b in ('alpha','beta');
