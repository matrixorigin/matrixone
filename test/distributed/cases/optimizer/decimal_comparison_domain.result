set @saved_time_zone=@@time_zone;
set time_zone='+08:00';
create table temporal_domain(id int primary key,d datetime(6),ts timestamp(6));
insert into temporal_domain values
(1,'2024-01-02 00:00:00','2024-01-02 00:00:00'),
(2,'2024-01-02 00:00:00','2024-01-01 16:00:00'),
(3,null,null),(4,null,'2024-01-02 00:00:00'),
(5,'2024-01-02 00:00:00',null);
select id,d<=>ts,ts<=>d,d=ts,ts=d from temporal_domain order by id;
