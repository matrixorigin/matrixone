create table decimal_domain_scan(id int primary key, k int, x decimal(10,2));
create index idx_domain_x on decimal_domain_scan(x);
create index idx_domain_kx on decimal_domain_scan(k,x);
insert into decimal_domain_scan values
(1,1,99.99),(2,1,199.99),(3,1,299.99),(4,1,null),
(5,2,199.99),(6,1,-1.25),(7,1,1.25),(8,1,2.00);
explain select count(*) from decimal_domain_scan where x between 99.990000 and 299.990000;
-- @regex("Index Table Scan.*idx_domain_x", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Aggregate  𝄀
        Aggregate Functions: starcount(1)  𝄀
        ->  Index Table Scan on decimal_domain_scan.idx_domain_x  𝄀
              Filter Cond: (__mo_index_idx_col >= 'D\x80\x00\x00\x00\x00\x00'\x0f'), (serial_extract(__mo_index_idx_col, 0, DECIMAL64(10, 2))) <= 299.990000)  𝄀
              Block Filter Cond: (__mo_index_idx_col >= 'D\x80\x00\x00\x00\x00\x00'\x0f')
select count(*) from decimal_domain_scan where x between 99.990000 and 299.990000;
➤ count(*)[-5,64,0]  𝄀
4
