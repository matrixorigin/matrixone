drop database if exists force_index_order;
create database force_index_order;
use force_index_order;
create table t (id int primary key, a int, b int, payload int, key ix_ab(a,b));
insert into t values (1,1,1,30),(2,1,1,10),(3,1,2,20),(4,2,2,40);
explain select id,payload from t force index(ix_ab)
where a=1 and b in (1,2) order by payload,id;
-- @regex("Index Table Scan.*ix_ab", true)
-- @regex("prefix_in", true)
-- @regex("Sort", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: t.payload INTERNAL, t.id INTERNAL  𝄀
        ->  Join  𝄀
              Join Type: INDEX  𝄀
              Join Cond: (t.id = __mo_index_pri_col)  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on force_index_order.t [ForceOneCN]  𝄀
                    Filter Cond: (t.a = 1), t.b in ([1 2])  𝄀
                    Block Filter Cond: (t.a = 1)  𝄀
                    Runtime Filter Probe: t.id  𝄀
              ->  Index Table Scan on t.ix_ab [ForceOneCN]  𝄀
                    Filter Cond: prefix_in(__mo_index_idx_col)  𝄀
                    Block Filter Cond: prefix_in(__mo_index_idx_col)
select id,payload from t force index(ix_ab)
where a=1 and b in (1,2) order by payload,id;
➤ id[4,32,0]  ¦  payload[4,32,0]  𝄀
2  ¦  10  𝄀
3  ¦  20  𝄀
1  ¦  30
select id,payload from t ignore index(ix_ab)
where a=1 and b in (1,2) order by payload,id;
➤ id[4,32,0]  ¦  payload[4,32,0]  𝄀
2  ¦  10  𝄀
3  ¦  20  𝄀
1  ¦  30
explain select id,a,b from t force index(ix_ab) order by a,b,id limit 2;
-- @regex("Index Table Scan.*ix_ab", true)
-- @regex("Index Reader Param", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: serial_extract(__mo_index_idx_col, 0, INT)) INTERNAL, serial_extract(__mo_index_idx_col, 1, INT)) INTERNAL, __mo_index_pri_col INTERNAL  𝄀
        Limit: 2  𝄀
        ->  Index Table Scan on t.ix_ab  𝄀
              Sort Key: __mo_index_idx_col INTERNAL  𝄀
              Index Reader Param:  Sort Key: __mo_index_idx_col INTERNAL  Limit: 2
select id,a,b from t force index(ix_ab) order by a,b,id limit 2;
➤ id[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
1  ¦  1  ¦  1  𝄀
2  ¦  1  ¦  1
select id,a,b from t ignore index(ix_ab) order by a,b,id limit 2;
➤ id[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
1  ¦  1  ¦  1  𝄀
2  ¦  1  ¦  1
explain select id,a,b from t force index(ix_ab) order by a desc,b asc,id limit 2;
-- @regex("Index Table Scan.*ix_ab", true)
-- @regex("Index Reader Param", false)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: serial_extract(__mo_index_idx_col, 0, INT)) DESC, serial_extract(__mo_index_idx_col, 1, INT)) ASC, __mo_index_pri_col INTERNAL  𝄀
        Limit: 2  𝄀
        ->  Index Table Scan on t.ix_ab
select id,a,b from t force index(ix_ab) order by a desc,b asc,id limit 2;
➤ id[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
4  ¦  2  ¦  2  𝄀
1  ¦  1  ¦  1
select id,a,b from t ignore index(ix_ab) order by a desc,b asc,id limit 2;
➤ id[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
4  ¦  2  ¦  2  𝄀
1  ¦  1  ¦  1
explain select id,payload from t force index(primary,ix_ab) ignore index(primary)
where a=1 and b in (1,2) order by payload,id;
-- @regex("Index Table Scan.*ix_ab", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: t.payload INTERNAL, t.id INTERNAL  𝄀
        ->  Join  𝄀
              Join Type: INDEX  𝄀
              Join Cond: (t.id = __mo_index_pri_col)  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on force_index_order.t [ForceOneCN]  𝄀
                    Filter Cond: (t.a = 1), t.b in ([1 2])  𝄀
                    Block Filter Cond: (t.a = 1)  𝄀
                    Runtime Filter Probe: t.id  𝄀
              ->  Index Table Scan on t.ix_ab [ForceOneCN]  𝄀
                    Filter Cond: prefix_in(__mo_index_idx_col)  𝄀
                    Block Filter Cond: prefix_in(__mo_index_idx_col)
explain select id,payload from t force index for order by(ix_ab)
where a=1 order by b desc,id desc limit 2;
-- @regex("Index Table Scan.*ix_ab", true)
-- @regex("Sort", true)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: t.b DESC, t.id DESC  𝄀
        Limit: 2  𝄀
        Send Message: [tag 2 , type MsgTopValue]  𝄀
        ->  Join  𝄀
              Join Type: INDEX  𝄀
              Join Cond: (t.id = __mo_index_pri_col)  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on force_index_order.t [ForceOneCN]  𝄀
                    Sort Key: t.b DESC  𝄀
                    Filter Cond: (t.a = 1)  𝄀
                    Block Filter Cond: (t.a = 1)  𝄀
                    Runtime Filter Probe: t.id  𝄀
                    Recv Message: [tag 2 , type MsgTopValue]  𝄀
              ->  Index Table Scan on t.ix_ab [ForceOneCN]  𝄀
                    Sort Key: __mo_index_idx_col DESC
