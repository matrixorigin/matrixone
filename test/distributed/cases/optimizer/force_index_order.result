explain select j.id,j.a,j.payload from prefix_j j force index(ix_join_pref)
join prefix_u u on j.a=u.a order by j.payload,j.id;
-- @regex("Index Table Scan.*ix_join_pref", true)
-- @regex("Runtime Filter Probe: __mo_index_idx_col Match Prefix", false)
➤ TP QUERY PLAN[12,0,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: j.payload INTERNAL, j.id INTERNAL  𝄀
        ->  Join  𝄀
              Join Type: INNER   hashOnPK  𝄀
              Join Cond: (j.a = u.a)  𝄀
              ->  Join  𝄀
                    Join Type: INDEX  𝄀
                    Join Cond: (j.id = __mo_index_pri_col)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on force_index_order.prefix_j [ForceOneCN]  𝄀
                          Runtime Filter Probe: j.id  𝄀
                    ->  Index Table Scan on prefix_j.ix_join_pref [ForceOneCN]  𝄀
              ->  Table Scan on force_index_order.prefix_u
select j.id,j.a,j.payload from prefix_j j force index(ix_join_pref)
join prefix_u u on j.a=u.a order by j.payload,j.id;
➤ id[4,32,0]  ¦  a[12,-1,0]  ¦  payload[4,32,0]  𝄀
1  ¦  abcdef  ¦  10  𝄀
2  ¦  abcdxy  ¦  20
select j.id,j.a,j.payload from prefix_j j ignore index(ix_join_pref)
join prefix_u u on j.a=u.a order by j.payload,j.id;
