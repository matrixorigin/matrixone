drop database if exists pk_filter_nested_boolean;
create database pk_filter_nested_boolean;
use pk_filter_nested_boolean;
create table v (a varchar(20) primary key);
insert into v values (''), ('a'), ('b'), ('c'), ('z'), ('zz');
set @upper = 'z';
set @equal = 'a';
set @lower = 'm';
prepare atomic_first from 'select a from v where a <= ? and (a = ? or a > ?) order by a';
execute atomic_first using @upper, @equal, @lower;
➤ a[12,20,0]  𝄀
a  𝄀
z
deallocate prepare atomic_first;
prepare container_first from 'select a from v where (a = ? or a > ?) and a <= ? order by a';
execute container_first using @equal, @lower, @upper;
➤ a[12,20,0]  𝄀
a  𝄀
z
deallocate prepare container_first;
create table t001 (id int primary key);
create table t002 (id int primary key);
create table t003 (id int primary key);
create table t004 (id int primary key);
create table t005 (id int primary key);
set @schema_name = 'pk_filter_nested_boolean';
set @n1 = 't001';
set @n2 = 't002';
set @n3 = 't003';
set @n4 = 't004';
set @n5 = 't005';
prepare nested_or from 'select table_name from information_schema.tables where table_schema = ? and table_name in (?,?,?,?,?) order by table_name';
execute nested_or using @schema_name, @n1, @n2, @n3, @n4, @n5;
➤ table_name[12,5000,0]  𝄀
t001  𝄀
t002  𝄀
t003  𝄀
t004  𝄀
t005
deallocate prepare nested_or;
create table column_probe (
    admission_token char(32) not null,
    owner_token char(32) not null,
    owner_generation bigint not null,
    owner_lease_expires_at datetime(6) not null,
    usage_status varchar(32) not null,
    provider_delivery_state varchar(32) not null
);
prepare columns_literal from 'select column_name from information_schema.columns where table_schema = ''pk_filter_nested_boolean'' and table_name = ''column_probe'' and column_name in (''admission_token'',''owner_token'',''owner_generation'',''owner_lease_expires_at'',''usage_status'',''provider_delivery_state'') order by ordinal_position';
execute columns_literal;
➤ column_name[12,256,0]  𝄀
admission_token  𝄀
owner_token  𝄀
owner_generation  𝄀
owner_lease_expires_at  𝄀
usage_status  𝄀
provider_delivery_state
deallocate prepare columns_literal;
set @column_table_name = 'column_probe';
prepare columns_bind_only from 'select column_name from information_schema.columns where table_schema = ? and table_name = ? order by ordinal_position';
execute columns_bind_only using @schema_name, @column_table_name;
➤ column_name[12,256,0]  𝄀
admission_token  𝄀
owner_token  𝄀
owner_generation  𝄀
owner_lease_expires_at  𝄀
usage_status  𝄀
provider_delivery_state
deallocate prepare columns_bind_only;
prepare columns_bind_with_literal_in from 'select column_name from information_schema.columns where table_schema = ? and table_name = ? and column_name in (''admission_token'',''owner_token'',''owner_generation'',''owner_lease_expires_at'',''usage_status'',''provider_delivery_state'') order by ordinal_position';
execute columns_bind_with_literal_in using @schema_name, @column_table_name;
➤ column_name[12,256,0]  𝄀
admission_token  𝄀
owner_token  𝄀
owner_generation  𝄀
owner_lease_expires_at  𝄀
usage_status  𝄀
provider_delivery_state
deallocate prepare columns_bind_with_literal_in;
drop database pk_filter_nested_boolean;
