deallocate prepare prefix_between_stmt;
create table prefix_range_unique (
id int primary key,
s varchar(32),
unique key uq_s(s(3))
);
insert into prefix_range_unique values
(1, 'abbZ'),
(2, 'abcY'),
(3, 'abdA'),
(4, 'abe');
explain select id from prefix_range_unique force index(uq_s)
where s between 'abcX' and 'abdA';
