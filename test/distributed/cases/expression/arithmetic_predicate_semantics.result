mo_ctl(dn, flush, arithmetic_predicate_semantics.ov)
ignored
select v from ov where v+1=9223372036854775807;
Data truncation: data out of range: data type int64, (9223372036854775807 + 1)
set optimizer_hints='blockFilter=2';
select v from ov where v+1=9223372036854775807;
Data truncation: data out of range: data type int64, (9223372036854775807 + 1)
