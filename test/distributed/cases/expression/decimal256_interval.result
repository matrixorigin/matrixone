select date_add(cast('2026-01-01 00:00:00' as datetime(6)),
    interval 1.25000000000000000000000000000000000000 second);
➤ date_add(cast(2026-01-01 00:00:00 as datetime(6)), INTERVAL 1.25000000000000000000000000000000000000 second)[12,-1,0]  𝄀
2026-01-01 00:00:01.250000
select date_sub(cast('2026-01-01 00:00:00' as datetime(6)),
    interval 1.25000000000000000000000000000000000000 second);
➤ date_sub(cast(2026-01-01 00:00:00 as datetime(6)), INTERVAL 1.25000000000000000000000000000000000000 second)[12,-1,0]  𝄀
