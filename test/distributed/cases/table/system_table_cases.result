USE mo_catalog;
SHOW CREATE TABLE mo_columns;
➤ Table[12,-1,0]  ¦  Create Table[12,-1,0]  𝄀
mo_columns  ¦  CREATE TABLE `mo_columns` (
  `att_uniq_name` varchar(256) DEFAULT NULL,
  `account_id` int unsigned DEFAULT NULL,
  `att_database_id` bigint unsigned DEFAULT NULL,
  `att_database` varchar(256) DEFAULT NULL,
  `att_relname_id` bigint unsigned DEFAULT NULL,
  `att_relname` varchar(256) DEFAULT NULL,
  `attname` varchar(256) DEFAULT NULL,
  `atttyp` varchar(256) DEFAULT NULL,
  `attnum` int DEFAULT NULL,
  `att_length` int DEFAULT NULL,
  `attnotnull` tinyint DEFAULT NULL,
  `atthasdef` tinyint DEFAULT NULL,
  `att_default` varchar(2048) DEFAULT NULL,
  `attisdropped` tinyint DEFAULT NULL,
  `att_constraint_type` char(1) DEFAULT NULL,
  `att_is_unsigned` tinyint DEFAULT NULL,
  `att_is_auto_increment` tinyint DEFAULT NULL,
  `att_comment` varchar(2048) DEFAULT NULL,
  `att_is_hidden` tinyint DEFAULT NULL,
  `attr_has_update` tinyint DEFAULT NULL,
  `attr_update` varchar(2048) DEFAULT NULL,
  `attr_is_clusterby` tinyint DEFAULT NULL,
  `attr_seqnum` smallint unsigned DEFAULT NULL,
  `attr_enum` varchar(65535) DEFAULT NULL,
  `attr_has_generated` tinyint DEFAULT NULL,
  `attr_generated` varchar(2048) DEFAULT NULL,
  PRIMARY KEY (`account_id`,`att_database`,`att_relname`,`attname`)
)
SHOW CREATE TABLE mo_database;
➤ Table[12,-1,0]  ¦  Create Table[12,-1,0]  𝄀
mo_database  ¦  CREATE TABLE `mo_database` (
  `dat_id` bigint unsigned DEFAULT NULL,
  `datname` varchar(5000) DEFAULT NULL,
  `dat_catalog_name` varchar(5000) DEFAULT NULL,
  `dat_createsql` varchar(5000) DEFAULT NULL,
  `owner` int unsigned DEFAULT NULL,
  `creator` int unsigned DEFAULT NULL,
  `created_time` timestamp NULL DEFAULT NULL,
  `account_id` int unsigned DEFAULT NULL,
  `dat_type` varchar(32) DEFAULT NULL,
  PRIMARY KEY (`account_id`,`datname`)
)
SHOW CREATE TABLE mo_tables;
➤ Table[12,-1,0]  ¦  Create Table[12,-1,0]  𝄀
mo_tables  ¦  CREATE TABLE `mo_tables` (
  `rel_id` bigint unsigned DEFAULT NULL,
  `relname` varchar(5000) DEFAULT NULL,
  `reldatabase` varchar(5000) DEFAULT NULL,
  `reldatabase_id` bigint unsigned DEFAULT NULL,
  `relpersistence` varchar(5000) DEFAULT NULL,
  `relkind` varchar(5000) DEFAULT NULL,
  `rel_comment` varchar(5000) DEFAULT NULL,
  `rel_createsql` text DEFAULT NULL,
  `created_time` timestamp NULL DEFAULT NULL,
  `creator` int unsigned DEFAULT NULL,
  `owner` int unsigned DEFAULT NULL,
  `account_id` int unsigned DEFAULT NULL,
  `partitioned` tinyint DEFAULT NULL,
  `partition_info` blob DEFAULT NULL,
  `viewdef` varchar(5000) DEFAULT NULL,
  `constraint` varchar(5000) DEFAULT NULL,
  `rel_version` int unsigned DEFAULT NULL,
  `catalog_version` int unsigned DEFAULT NULL,
  `rel_logical_id` bigint unsigned DEFAULT NULL,
  PRIMARY KEY (`account_id`,`reldatabase`,`relname`),
  UNIQUE KEY `idx_rel_logical_id` (`rel_logical_id`)
)
