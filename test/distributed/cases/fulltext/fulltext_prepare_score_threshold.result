drop database if exists ft_score_param;
create database ft_score_param;
use ft_score_param;
create table docs(id bigint primary key, body text not null);
insert into docs values
(1,'fox zeta zeta'),
(2,'fox fox zeta'),
(3,'fox fox fox'),
(4,'alpha alpha');
create fulltext index ft on docs(body);
