prepare boolean_stmt from 'select id from docs where match(body, alt) against(? in boolean mode) > ? or tag = ? order by id';
set @term = 'alpha';
set @threshold = 0;
set @tag = 1;
execute boolean_stmt using @term, @threshold, @tag;
