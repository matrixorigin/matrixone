explain select id from docs where match(body) against('+needle +anchor' in boolean mode)
and not exists (select 1 from q where name='missing') order by id;
-- @regex("fulltext_index_scan", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: docs.id INTERNAL  𝄀
        ->  Join  𝄀
              Join Type: ANTI  𝄀
              Join Cond: true  𝄀
              ->  Join  𝄀
                    Join Type: INNER  𝄀
                    Join Cond: (docs.id = mo_fulltext_alias_0.doc_id)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on ft_subq.docs  𝄀
                          Runtime Filter Probe: docs.id  𝄀
                    ->  Table Function on fulltext_index_scan  𝄀
              ->  Project  𝄀
                    ->  Table Scan on ft_subq.q  𝄀
                          Filter Cond: (q.name = 'missing')
select id from docs where match(body) against('+needle +anchor' in boolean mode)
and not exists (select 1 from q where name='missing') order by id;
