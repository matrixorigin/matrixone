drop database if exists ft2_json_probe;
create database ft2_json_probe;
use ft2_json_probe;
set experimental_fulltext2_index = 1;
create table t (id int primary key, j json);
create table t_plain (id int primary key, j json);
insert into t values
(1, '{"a":{"foo":"bar"},"n":10}'),
(2, '{"a":{"foo":"baz"},"n":20}'),
(3, '{"foo":"bar","n":30}'),
(4, '{"other":"bar","n":40}'),
(5, '{"foo":"qux","n":25.5}'),
(6, '{"foo":"3.14","n":-7}'),
(7, '{"foo":3.14,"n":0}'),
(8, '{"tags":["bar","zed"],"n":100}'),
(9, '{"foo":null,"n":null}'),
(10, '{"deep":{"deeper":{"foo":"bar"}},"n":5}');
insert into t_plain select * from t;
create fulltext2 index ftj on t(j) with parser json;
show create table t;
➤ Table[12,1,0]  ¦  Create Table[12,127,0]  𝄀
t  ¦  CREATE TABLE `t` (
  `id` int NOT NULL,
  `j` json DEFAULT NULL,
  PRIMARY KEY (`id`),
 FULLTEXT2 `ftj`(`j`) WITH PARSER json
)
