set experimental_fulltext2_index = 1;
drop database if exists ft2_showcreate;
create database ft2_showcreate;
use ft2_showcreate;
create table t1 (id bigint primary key, body text);
create fulltext2 index ft on t1(body) max_index_capacity 2;
show create table t1;
➤ Table[12,2,0]  ¦  Create Table[12,161,0]  𝄀
t1  ¦  CREATE TABLE `t1` (
  `id` bigint NOT NULL,
  `body` text DEFAULT NULL,
  PRIMARY KEY (`id`),
 FULLTEXT2 `ft`(`body`) WITH PARSER ngram max_index_capacity = 2 
)
create table t2 (id bigint primary key, body text);
create fulltext2 index ft on t2(body) auto_update = true second 5;
show create table t2;
➤ Table[12,2,0]  ¦  Create Table[12,169,0]  𝄀
t2  ¦  CREATE TABLE `t2` (
  `id` bigint NOT NULL,
  `body` text DEFAULT NULL,
  PRIMARY KEY (`id`),
 FULLTEXT2 `ft`(`body`) WITH PARSER ngram auto_update = true  second = 5 
)
create table t3 (id bigint primary key, body text);
create fulltext2 index ft on t3(body) auto_update = true day 1 hour 2;
show create table t3;
➤ Table[12,2,0]  ¦  Create Table[12,176,0]  𝄀
t3  ¦  CREATE TABLE `t3` (
  `id` bigint NOT NULL,
  `body` text DEFAULT NULL,
  PRIMARY KEY (`id`),
 FULLTEXT2 `ft`(`body`) WITH PARSER ngram auto_update = true  day = 1  hour = 2 
)
create table t4 (
id bigint NOT NULL,
body text DEFAULT NULL,
PRIMARY KEY (id),
FULLTEXT2 ft(body) WITH PARSER ngram auto_update = true second = 5
);
show create table t4;
➤ Table[12,2,0]  ¦  Create Table[12,169,0]  𝄀
t4  ¦  CREATE TABLE `t4` (
  `id` bigint NOT NULL,
  `body` text DEFAULT NULL,
  PRIMARY KEY (`id`),
 FULLTEXT2 `ft`(`body`) WITH PARSER ngram auto_update = true  second = 5 
)
drop database ft2_showcreate;
