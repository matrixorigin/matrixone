set experimental_fulltext2_index = 1;
drop database if exists ft2_window;
create database ft2_window;
use ft2_window;
create table docs (id bigint primary key, body text, v vecf32(3), fulltext2 ft(body) with parser ngram);
insert into docs values
(1,'alpha','[0,0,0]'),(2,'beta','[0.1,0,0]'),(3,'alpha','[0.2,0,0]'),(4,'alpha','[0.3,0,0]');
alter table docs alter reindex ft fulltext2 force_sync;
select id from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  𝄀
1  𝄀
3  𝄀
4
select id, row_number() over (order by l2_distance(v,'[0,0,0]'), id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  𝄀
3  ¦  2  𝄀
4  ¦  3
explain select id, row_number() over (order by l2_distance(v,'[0,0,0]'), id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
-- @regex("fulltext2_search", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: docs.id INTERNAL  𝄀
        ->  Window  𝄀
              Window Function: row_number(); Order By: l2_distance(docs.v, cast('[0,0,0]' AS VECF32)), docs.id  𝄀
              ->  Join  𝄀
                    Join Type: INNER  𝄀
                    Join Cond: (docs.id = mo_fulltext_alias_0.__mo_ft_doc_id)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on ft2_window.docs  𝄀
                          Runtime Filter Probe: docs.id  𝄀
                    ->  Table Function on fulltext2_search
select id, row_number() over (order by match(body) against('alpha' in boolean mode) desc, id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  𝄀
3  ¦  2  𝄀
4  ¦  3
select id, row_number() over (partition by body order by id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  𝄀
3  ¦  2  𝄀
4  ¦  3
explain select id, row_number() over (partition by body order by id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
-- @regex("fulltext2_search", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: docs.id INTERNAL  𝄀
        ->  Window  𝄀
              Window Function: row_number(); Partition By: docs.body; Order By: docs.id  𝄀
              ->  Partition  𝄀
                    Sort Key: docs.body INTERNAL  𝄀
                    ->  Join  𝄀
                          Join Type: INNER  𝄀
                          Join Cond: (docs.id = mo_fulltext_alias_0.__mo_ft_doc_id)  𝄀
                          Runtime Filter Build: #[-1,0]  𝄀
                          ->  Table Scan on ft2_window.docs  𝄀
                                Runtime Filter Probe: docs.id  𝄀
                          ->  Table Function on fulltext2_search
select id, (match(body) against('alpha' in boolean mode) > 0) as hit,
row_number() over (order by id) as rn
from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  ¦  hit[-7,1,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  ¦  1  𝄀
3  ¦  1  ¦  2  𝄀
4  ¦  1  ¦  3
select id, row_number() over (order by id) as rn
from docs where match(body) against('alpha' in boolean mode)
order by match(body) against('alpha' in boolean mode) desc, id;
➤ id[-5,64,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  𝄀
3  ¦  2  𝄀
4  ¦  3
select id,
row_number() over (order by match(body) against('alpha' in boolean mode) desc, id) as r1,
rank() over (order by match(body) against('alpha' in boolean mode) desc, id) as r2
from docs where match(body) against('alpha' in boolean mode) order by id;
➤ id[-5,64,0]  ¦  r1[-5,64,0]  ¦  r2[-5,64,0]  𝄀
1  ¦  1  ¦  1  𝄀
3  ¦  2  ¦  2  𝄀
4  ¦  3  ¦  3
select id, rn from (
select id, match(body) against('alpha' in boolean mode) as score,
row_number() over (order by id) as rn
from docs where match(body) against('alpha' in boolean mode)
) q where rn = 1 or score > 0 order by id;
➤ id[-5,64,0]  ¦  rn[-5,64,0]  𝄀
1  ¦  1  𝄀
3  ¦  2  𝄀
4  ¦  3
explain select id, rn from (
select id, match(body) against('alpha' in boolean mode) as score,
row_number() over (order by id) as rn
from docs where match(body) against('alpha' in boolean mode)
) q where rn = 1 or score > 0 order by id;
-- @regex("fulltext2_search", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: docs.id INTERNAL  𝄀
        ->  Window  𝄀
              Window Function: row_number(); Order By: docs.id  𝄀
              Filter Cond: ((row_number() over (order by docs.id range unbounded preceding) = 1) or (mo_fulltext_alias_0.__mo_ft_score > 0))  𝄀
              ->  Join  𝄀
                    Join Type: INNER  𝄀
                    Join Cond: (docs.id = mo_fulltext_alias_0.__mo_ft_doc_id)  𝄀
                    Runtime Filter Build: #[-1,0]  𝄀
                    ->  Table Scan on ft2_window.docs  𝄀
                          Runtime Filter Probe: docs.id  𝄀
                    ->  Table Function on fulltext2_search
drop database ft2_window;
