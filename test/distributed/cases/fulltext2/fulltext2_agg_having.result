1  ¦  0.03942354  𝄀
2  ¦  0.03211998  𝄀
4  ¦  0.03211998  𝄀
6  ¦  0.047146868
select id, max(match(body) against('alpha')) as score
from docs group by id, body having max(match(body) against('alpha')) > 0 order by id;
➤ id[4,32,0]  ¦  score[7,23,31]  𝄀
