explain select d.id from docs d where match(d.body) against('+needle +anchor' in boolean mode)
and exists (select 1 from q where q.n < d.id) order by d.id;
-- @regex("fulltext2_search", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: d.id INTERNAL  𝄀
        ->  Filter  𝄀
              Filter Cond: (#[0,1] IS TRUE)  𝄀
              ->  Join  𝄀
                    Join Type: MARK  𝄀
                    Join Cond: ((q.n < cast(d.id AS INT)) IS TRUE)  𝄀
                    ->  Join  𝄀
                          Join Type: INNER  𝄀
                          Join Cond: (d.id = mo_fulltext_alias_0.__mo_ft_doc_id)  𝄀
                          Runtime Filter Build: #[-1,0]  𝄀
                          ->  Table Scan on ft2_subq.docs  𝄀
                                Runtime Filter Probe: d.id  𝄀
                          ->  Table Function on fulltext2_search  𝄀
                    ->  Project  𝄀
                          ->  Table Scan on ft2_subq.q
select d.id from docs d where match(d.body) against('+needle +anchor' in boolean mode)
and exists (select 1 from q where q.n < d.id) order by d.id;
