create table history_t (a int);
insert into history_t values (11);
create view history_v as select * from history_t;
create snapshot pr27011_view_history for account;
create or replace view history_v as select 22 as a;
select * from history_v;
create or replace view history_v as select * from history_v {snapshot = 'pr27011_view_history'};
select * from history_v;

create or replace view history_v as select 22 as a;
alter view history_v as select * from history_v {snapshot = 'pr27011_view_history'};
select * from history_v;

create or replace view history_v as select 22 as a;
set @pr27011_snapshot_ts = (select cast_nano_to_timestamp(ts) from mo_catalog.mo_snapshots where sname = 'pr27011_view_history');
set @pr27011_replace_by_ts = concat('create or replace view history_v as select * from history_v {timestamp = ''', @pr27011_snapshot_ts, '''}');
prepare pr27011_replace_stmt from @pr27011_replace_by_ts;
execute pr27011_replace_stmt;
deallocate prepare pr27011_replace_stmt;
select * from history_v;

create or replace view history_v as select 22 as a;
create or replace view history_v as select * from history_v {timestamp = 9223372036854775807};
select * from history_v;
create or replace view history_v as select * from history_v {MO_TS = '9223372036854775807-0'};
select * from history_v;
create or replace view history_v as select * from history_v {as of timestamp '2262-04-11 23:47:16'};
select * from history_v;

drop view history_v;
drop table history_t;
drop snapshot pr27011_view_history;
drop table t1;
drop view v1;
