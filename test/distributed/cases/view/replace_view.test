drop table if exists t1;
drop snapshot if exists pr27011_view_history;
create table t1 (a int, b int);
insert into t1 values (1, 11), (2, 22), (3, 33);
insert into t2 values (1, "aa"), (2, "bb");
create view v1 as select * from t1;
select * from v1;
select * from v1 where a > 1;
create view v1 as select * from t1 where a > 1;
select * from v1;
create or replace view v1 as select * from t1 where a > 1;
select * from v1;

create view if not exists v1 as select * from v1;
select * from v1;
create or replace view if not exists v1 as select * from t1 where a = 1;
select * from v1;
create or replace view if not exists v1 as select * from v1;
select * from v1;

create or replace view v1 as select * from v1;
select * from v1;

create view v2 as select * from v1;
create or replace view v1 as select * from v2;
select * from v1;
drop view v2;

drop database if exists replace_view_dep;
create database replace_view_dep;
create view replace_view_dep.v3 as select * from replace_view.v1;
create or replace view replace_view.v1 as select * from replace_view_dep.v3;
select * from v1;
drop database replace_view_dep;

create table history_t (a int);
insert into history_t values (11);
create view history_v as select * from history_t;
create snapshot pr27011_view_history for account;
create or replace view history_v as select 22 as a;
select * from history_v;
create or replace view history_v as select * from history_v {snapshot = 'pr27011_view_history'};
select * from history_v;

create or replace view history_v as select 22 as a;
alter view history_v as select * from history_v {snapshot = 'pr27011_view_history'};
select * from history_v;

create or replace view history_v as select 22 as a;
set @pr27011_snapshot_ts = (select cast_nano_to_timestamp(ts) from mo_catalog.mo_snapshots where sname = 'pr27011_view_history');
set @pr27011_replace_by_ts = concat('create or replace view history_v as select * from history_v {timestamp = ''', @pr27011_snapshot_ts, '''}');
prepare pr27011_replace_stmt from @pr27011_replace_by_ts;
execute pr27011_replace_stmt;
deallocate prepare pr27011_replace_stmt;
select * from history_v;

drop view history_v;
drop table history_t;
drop snapshot pr27011_view_history;
drop table t1;
drop view v1;
