SELECT COUNT(*)
FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA = 'information_schema'
AND TABLE_NAME = 'COLLATION_CHARACTER_SET_APPLICABILITY'
AND COLUMN_NAME IN ('COLLATION_NAME', 'CHARACTER_SET_NAME');
➤ count(*)[-5,64,0]  𝄀
