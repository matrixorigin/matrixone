select count(*) from (
select id, count(*) c
from t
group by id
order by c desc
limit 2 offset 1
) q;
➤ count(*)[-5,64,0]  𝄀
2
select count(*) from (
select id, count(*) c
from t
group by id
having count(*) = 1
order by c
limit 10
) q;
➤ count(*)[-5,64,0]  𝄀
4
select count(*) from (
select id, count(*) c
from t
group by id
having count(*) <> 1
order by c
limit 10
) q;
➤ count(*)[-5,64,0]  𝄀
0
select id, count(*) c
from t
group by id
order by c desc, id desc
limit 2;
