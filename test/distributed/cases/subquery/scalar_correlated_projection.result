1  ¦  2  ¦  3  ¦  1  𝄀
11  ¦  22  ¦  33  ¦  11
select t1.*, (select distinct t1.a from t2) as x from t1 order by t1.a;
➤ a[4,32,0]  ¦  b[4,32,0]  ¦  c[4,32,0]  ¦  x[4,32,0]  𝄀
1  ¦  2  ¦  3  ¦  1  𝄀
11  ¦  22  ¦  33  ¦  11
select t1.*, (select t1.a from t2 limit 1) as x from t1 order by t1.a;
➤ a[4,32,0]  ¦  b[4,32,0]  ¦  c[4,32,0]  ¦  x[4,32,0]  𝄀
1  ¦  2  ¦  3  ¦  1  𝄀
11  ¦  22  ¦  33  ¦  11
