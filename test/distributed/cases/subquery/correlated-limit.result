start transaction;
update parent_t p
set p.top_amount = (select c.amount
from child_t c
where c.parent_id = p.corr_key
order by c.amount desc, c.id desc
limit 1 offset 1)
where p.id <= 4;
rollback;
select id, top_amount from parent_t where id <= 4 order by id;
