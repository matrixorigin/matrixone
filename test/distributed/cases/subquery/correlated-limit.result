drop database if exists correlated_limit;
create database correlated_limit;
use correlated_limit;
create table parent_t (
id int primary key,
corr_key int,
top_amount int
);
create table child_t (
id int primary key,
parent_id int,
amount int
);
insert into parent_t values
(1, 1, null),
(2, 2, null),
(3, 3, null),
(4, 4, null),
(5, null, null);
insert into child_t values
(1, 1, 10),
