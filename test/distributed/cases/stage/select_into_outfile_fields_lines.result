select 'alpha' as name into outfile 'stage://outfile_fields_lines_stage/collide.csv'
lines starting by 'n';
invalid input: LINES STARTING BY 'n' occurs in the CSV header: LOAD would import the remainder of the header as data; set HEADER 'false' or choose a prefix that does not occur in the header
