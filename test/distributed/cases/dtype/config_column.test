-- @suite
-- @case
-- @desc: allow CONFIG as an unquoted JSON column name
-- @label:bvt

DROP DATABASE IF EXISTS issue_29900_config;
CREATE DATABASE issue_29900_config;
USE issue_29900_config;
CREATE TABLE config_probe(id INT,config JSON);
INSERT INTO config_probe VALUES (1, '{"source":"mysql-migration"}');
SELECT id, config FROM config_probe;
SELECT column_name, data_type FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 'config_probe'
AND column_name = 'config'
ORDER BY ordinal_position;
DROP DATABASE issue_29900_config;
