-- @suite
-- @case
-- @desc:test for decimal(65,30)
-- @label:bvt

drop table if exists decimal_256_t;
create table decimal_256_t (
    id int primary key,
    d decimal(65,30)
);

show create table decimal_256_t;

insert into decimal_256_t values
    (1, 12345678901234567890123456789012345.123456789012345678901234567890),
    (2, cast(42 as decimal(65,30))),
    (3, cast('-0.000000000000000000000000000001' as decimal(65,30)));

select id, d from decimal_256_t order by id;
select cast('12345678901234567890123456789012345.123456789012345678901234567890' as decimal(65,30));
select cast('1.25' as decimal(65,30)) + '2.50' as plus_with_string;
select
    sum(v) as sum_v,
    avg(v) as avg_v,
    min(v) as min_v,
    max(v) as max_v
from (
    select cast('1.250000000000000000000000000000' as decimal(65,30)) as v
    union all
    select cast('2.500000000000000000000000000000' as decimal(65,30))
    union all
    select cast('-0.750000000000000000000000000000' as decimal(65,30))
) as decimal_256_agg;
select
    abs(cast('-12.3412' as decimal(65,4))) as abs_v,
    sign(cast('-12.3412' as decimal(65,4))) as sign_v,
    ceil(cast('12.3412' as decimal(65,4)), 2) as ceil_v,
    floor(cast('-12.3412' as decimal(65,4)), 2) as floor_v,
    round(cast('12.3412' as decimal(65,4)), 2) as round_v,
    truncate(cast('-12.3412' as decimal(65,4)), 2) as truncate_v;

select
    cast('99999999999999999999999999999999999999999999999999999999999999999' as decimal(65,0)) % cast('0.000000000000000000000000000007' as decimal(65,30)) as mod_scale_up,
    cast('0.000000000000000000000000000007' as decimal(65,30)) % cast('99999999999999999999999999999999999999999999999999999999999999999' as decimal(65,0)) as mod_scale_down;
select
    cast('0.000000000000000000000000000007' as decimal(65,30)) div cast('99999999999999999999999999999999999999999999999999999999999999999' as decimal(65,0)) as zero_div,
    cast('99999999999999999999999999999999999999999999999999999999999999999' as decimal(65,0)) div cast('99999999999999999999999999999999999999999999999999999.999999999999' as decimal(65,12)) as scale_up_fit,
    cast('999999999999999999999999999999.999999999999999999999999999999' as decimal(65,30)) div cast('500000000000000000000000000000' as decimal(65,0)) as truncate_div;

select cast('1' as decimal(65,30)) / cast('0.000000000000000003' as decimal(65,18)) as issue_28774_wide_quotient;

select cast(
    cast('123456789012345' as decimal(38,0)) /
    cast('999999999999999.999999999999999999' as decimal(38,18))
    as decimal(65,6)
) as issue_28775_d128_rounding;

select cast(
    cast('1234567890123450000000000000000000000000' as decimal(65,0)) /
    cast('9999999999999999999999999999999999999999' as decimal(65,0))
    as decimal(65,6)
) as issue_28775_d256_control;

select
    cast(cast('85070591730234615865843651857943' as decimal(65,0)) /
        cast('-170141183460469231731687303715884105728' as decimal(65,0)) as decimal(65,6)) as issue_28774_min_d128_divisor_positive_numerator,
    cast(cast('-85070591730234615865843651857943' as decimal(65,0)) /
        cast('-170141183460469231731687303715884105728' as decimal(65,0)) as decimal(65,6)) as issue_28774_min_d128_divisor_negative_numerator;

drop table decimal_256_t;
