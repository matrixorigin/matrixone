drop view if exists bool_metadata_view;
drop table if exists bool_metadata;
create table bool_metadata(id int primary key, flag bool default null, enabled boolean not null default true, disabled bool default false);
insert into bool_metadata(id,flag) values (1,true),(2,false),(3,null);
