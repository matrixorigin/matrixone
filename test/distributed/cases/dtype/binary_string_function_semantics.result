create table nullif_default_domains (
id int,
txt varchar(16),
forwarded varbinary(64) default (reverse(nullif(coalesce(txt, _binary ''), ''))),
control varbinary(64) default (reverse(coalesce(txt, _binary ''))),
declared varbinary(64) default (reverse(cast(nullif(coalesce(txt, _binary ''), '') as binary(4)))),
case_forwarded varbinary(64) default (reverse(nullif(case when txt is not null then txt else _binary '' end, ''))),
if_length bigint default (char_length(if(txt is not null, txt, _binary '0')))
);
insert into nullif_default_domains (id, txt) values (1, '你a'), (2, ''), (3, null);
select id, hex(forwarded), hex(control), hex(declared), hex(case_forwarded), if_length
from nullif_default_domains order by id;
