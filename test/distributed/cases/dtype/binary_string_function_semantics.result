E4BDA0  ¦  E4  ¦  E4BDA0  ¦  A0  ¦  E5A5BD  ¦  BD
select hex(reverse('你a')), hex(reverse(X'e4bda061')),
hex(lower('ÄA')), hex(lower(X'c38441')),
hex(upper('äa')), hex(upper(X'c3a461'));
➤ hex(reverse(你a))[12,65535,0]  ¦  hex(reverse(0xe4bda061))[12,65535,0]  ¦  hex(lower(ÄA))[12,65535,0]  ¦  hex(lower(0xc38441))[12,65535,0]  ¦  hex(upper(äa))[12,65535,0]  ¦  hex(upper(0xc3a461))[12,65535,0]  𝄀
61E4BDA0  ¦  61A0BDE4  ¦  C3A461  ¦  C38441  ¦  C38441  ¦  C3A461
select hex(insert('你a', 2, 1, X'78')), hex(insert(X'e4bda061', 2, 1, 'x')),
hex(lpad('你a', 3, X'e5a5bd')), hex(lpad(X'e4bda061', 3, '好')),
hex(rpad('你', 2, X'78')), hex(rpad(X'e4bda0', 2, 'x'));
➤ hex(insert(你a, 2, 1, 0x78))[12,65535,0]  ¦  hex(insert(0xe4bda061, 2, 1, x))[12,65535,0]  ¦  hex(lpad(你a, 3, 0xe5a5bd))[12,65535,0]  ¦  hex(lpad(0xe4bda061, 3, 好))[12,65535,0]  ¦  hex(rpad(你, 2, 0x78))[12,65535,0]  ¦  hex(rpad(0xe4bda0, 2, x))[12,65535,0]  𝄀
E4BDA078  ¦  E478A061  ¦  E5A5BDE4BDA061  ¦  E4BDA0  ¦  E4BDA078  ¦  E4BD
select locate(X'bd', '你a'), locate(X'bd', X'e4bda061'),
instr('你a', X'bd'), instr(X'e4bda061', X'bd'),
'你a' like '____', X'e4bda061' like '____';
➤ locate(0xbd, 你a)[-5,64,0]  ¦  locate(0xbd, 0xe4bda061)[-5,64,0]  ¦  instr(你a, 0xbd)[-5,64,0]  ¦  instr(0xe4bda061, 0xbd)[-5,64,0]  ¦  你a like ____[-7,1,0]  ¦  0xe4bda061 like ____[-7,1,0]  𝄀
0  ¦  2  ¦  0  ¦  2  ¦  0  ¦  1
select hex(replace('你a', X'bd', X'78')), hex(replace(X'e4bda061', X'bd', 'x')),
hex(substring_index('a你b你c', X'e4bda0', 1)),
hex(substring_index(X'61e4bda062e4bda063', '你', 1));
➤ hex(replace(你a, 0xbd, 0x78))[12,65535,0]  ¦  hex(replace(0xe4bda061, 0xbd, x))[12,65535,0]  ¦  hex(substring_index(a你b你c, 0xe4bda0, 1))[12,65535,0]  ¦  hex(substring_index(0x61e4bda062e4bda063, 你, 1))[12,65535,0]  𝄀
E478A061  ¦  E478A061  ¦  61  ¦  61
select hex(ltrim(' 你 ')), hex(ltrim(X'20e4bda020')),
hex(rtrim(' 你 ')), hex(rtrim(X'20e4bda020')),
