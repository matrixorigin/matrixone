-- @suite

-- @case
-- @desc: binary-string functions use byte semantics and narrow only proven-binary metadata
-- @label:bvt

--- @metacmp(true)

drop database if exists binary_string_function_semantics;
create database binary_string_function_semantics;
use binary_string_function_semantics;

select length('你a'), char_length('你a'), length(X'e4bda061'), char_length(X'e4bda061'),
       ord('你a'), ord(X'e4bda061');
select hex(left('你a', 1)), hex(left(X'e4bda061', 1)),
       hex(right('a你', 1)), hex(right(X'61e4bda0', 1)),
       hex(substring('你好', 2, 1)), hex(substring(X'e4bda0e5a5bd', 2, 1));
select hex(reverse('你a')), hex(reverse(X'e4bda061')),
       hex(lower('ÄA')), hex(lower(X'c38441')),
       hex(upper('äa')), hex(upper(X'c3a461'));
select hex(insert('你a', 2, 1, X'78')), hex(insert(X'e4bda061', 2, 1, 'x')),
       hex(lpad('你a', 3, X'e5a5bd')), hex(lpad(X'e4bda061', 3, '好')),
       hex(rpad('你', 2, X'78')), hex(rpad(X'e4bda0', 2, 'x'));
select hex(lpad('abc', 5, '')), hex(rpad('abc', 5, '')),
       hex(lpad(X'616263', 5, X'')), hex(rpad(X'616263', 5, X'')),
       hex(lpad('abc', 2, '')), hex(rpad('abc', 2, '')),
       hex(lpad(X'616263', 2, X'')), hex(rpad(X'616263', 2, X''));
select lpad('a', 16777216, '') is null as text_lpad_at_limit,
       lpad('a', 16777217, '') is null as text_lpad_over_limit,
       rpad('a', 16777217, '') is null as text_rpad_over_limit,
       lpad(_binary 'a', 16777217, _binary '') is null as binary_lpad_same_target;
select lpad(repeat('a', 100), 16777217, '') is null as text_lpad_partial_extension,
       rpad(repeat('a', 100), 16777217, '') is null as text_rpad_partial_extension;
select lpad('a', 67108865, '') is null as text_lpad_overflow,
       rpad('a', 67108865, '') is null as text_rpad_overflow,
       lpad(_binary 'a', 67108865, _binary '') is null as binary_lpad_overflow,
       rpad(_binary 'a', 67108865, _binary '') is null as binary_rpad_overflow;
select locate(X'bd', '你a'), locate(X'bd', X'e4bda061'),
       instr('你a', X'bd'), instr(X'e4bda061', X'bd'),
       '你a' like '____', X'e4bda061' like '____';
select hex(replace('你a', X'bd', X'78')), hex(replace(X'e4bda061', X'bd', 'x')),
       hex(substring_index('a你b你c', X'e4bda0', 1)),
       hex(substring_index(X'61e4bda062e4bda063', '你', 1));
select hex(ltrim(' 你 ')), hex(ltrim(X'20e4bda020')),
       hex(rtrim(' 你 ')), hex(rtrim(X'20e4bda020')),
       char_length(repeat('你', 2)), char_length(repeat(X'e4bda0', 2));

select charset('你'), collation('你'), charset(X'e4bda0'), collation(X'e4bda0'),
       charset(null), collation(null), charset(123), collation(123);
select charset(cast(null as char)), collation(cast(null as char)),
       charset(cast(null as binary)), collation(cast(null as binary));

create table domains (
    id int,
    txt varchar(16),
    bin varbinary(16),
    invalid_bytes blob
);
insert into domains values
    (1, '你a', null, X'ffe4bda0'),
    (2, null, X'e4bda061', X'ffe4bda0'),
    (3, '你a', X'e4bda061', X'ffe4bda0');
select id, hex(coalesce(txt, bin)), char_length(coalesce(txt, bin)),
       charset(coalesce(txt, bin)), collation(coalesce(txt, bin))
from domains order by id;
select id, hex(left(coalesce(txt, bin), 1)), hex(reverse(coalesce(txt, bin))),
       char_length(concat(coalesce(txt, bin), 'x'))
from domains order by id;
-- Declaration-based FIELD comparison must not overwrite the selected row domain.
select id, field(left(coalesce(txt, bin), 1), '你', X'e4'),
       hex(left(coalesce(txt, bin), 1)) from domains order by id;
-- Case folding consumes declaration collation, unlike direct character slicing.
select id, hex(upper(coalesce(txt, bin))) from domains order by id;
-- Mergeable projections retain selected row domains, including through COALESCE.
select id, char_length(x), hex(left(x, 1)), hex(reverse(x))
from (select id, coalesce(txt, bin) x from domains) d order by id;
select id, char_length(coalesce(x, '')), hex(left(coalesce(x, ''), 1)),
       hex(reverse(coalesce(x, '')))
from (select id, coalesce(txt, bin) x from domains) d order by id;
-- Materialized declarations are consumed before any further value selection.
select id, char_length(x), hex(left(x, 1)), hex(reverse(x))
from (select id, coalesce(txt, bin) x from domains limit 3) d order by id;
select id, hex(left(coalesce(x, '你a'), 1)), hex(reverse(coalesce(x, '你a')))
from (select id, coalesce(txt, bin) x from domains limit 3) d order by id;
-- Equal-rank binary columns own conditional declarations before another selector.
select id, char_length(coalesce(if(id = 2, bin, txt), '')),
       hex(left(coalesce(if(id = 2, bin, txt), ''), 1)),
       hex(reverse(coalesce(if(id = 2, bin, txt), ''))),
       hex(left(coalesce(case when id = 2 then bin else txt end, ''), 1)),
       hex(reverse(coalesce(case when id = 2 then bin else txt end, '')))
from domains order by id;
select id, hex(left(coalesce(ifnull(txt, bin), ''), 1)),
       hex(reverse(coalesce(ifnull(txt, bin), '')))
from domains order by id;
-- A weaker binary literal must not demote the selected VARCHAR row.
-- Explicit COLLATE still wins in either direction.
select id, char_length(if(txt is not null, txt, _binary '')),
       hex(left(if(txt is not null, txt, _binary ''), 1)),
       hex(reverse(case when txt is not null then txt else _binary '' end)),
       hex(reverse(case when txt is not null then txt else _binary '' collate `binary` end)),
       hex(reverse(case when txt is not null then txt collate utf8mb4_bin else _binary '' end))
from domains order by id;
select id, char_length(coalesce(if(txt is not null, txt, _binary ''), '')),
       hex(reverse(nullif(case when txt is not null then txt else _binary '' end, '')))
from domains order by id;
select id, char_length(if(id = 2, _binary '', coalesce(txt, _binary ''))),
       hex(reverse(case when id = 2 then _binary '' else coalesce(txt, _binary '') end))
from domains order by id;
prepare conditional_text_stmt from
    'select id, hex(reverse(case when ? then txt else _binary '''' end)),
            char_length(if(?, txt, _binary ''''))
     from domains order by id';
set @conditional_text = true;
execute conditional_text_stmt using @conditional_text, @conditional_text;
set @conditional_text = false;
execute conditional_text_stmt using @conditional_text, @conditional_text;
set @conditional_text = true;
execute conditional_text_stmt using @conditional_text, @conditional_text;
deallocate prepare conditional_text_stmt;

-- Variables compete as declarations, not weak literals; rebinding observes their current type.
set @conditional_peer = _binary '';
select id, hex(reverse(case when id = 1 then txt else @conditional_peer end)),
       char_length(case when id = 1 then txt else @conditional_peer end)
from domains where id = 1;
set @conditional_peer = '';
select id, hex(reverse(case when id = 1 then txt else @conditional_peer end)),
       char_length(case when id = 1 then txt else @conditional_peer end)
from domains where id = 1;
set @conditional_peer = null;
-- Allocating TEXT results retain their own declaration; genuine binary LPAD stays binary.
select id, hex(reverse(case when txt is not null then lpad(txt, 3, 'z') else _binary '' end)),
       char_length(case when txt is not null then lpad(txt, 3, 'z') else _binary '' end)
from domains order by id;
select id, hex(reverse(case when id = 3 then lpad(bin, 3, _binary 'z') else _binary '' end)),
       char_length(case when id = 3 then lpad(bin, 3, _binary 'z') else _binary '' end)
from domains where id = 3;
-- Row-selection boundaries consume the CASE declaration, not its temporary binary transport.
select id, hex(reverse(x)), char_length(x)
from (select id, case when txt is not null then txt else _binary '' end x from domains limit 3) d
order by id;
select id, hex(reverse(x)), char_length(x)
from (select id, case when txt is not null then txt else _binary '' end x from domains having x is not null) d
order by id;
select id, hex(reverse(x)), char_length(x)
from (select id, case when txt is not null then lpad(txt, 3, 'z') else _binary '' end x from domains limit 3) d
order by id;
-- PREPARE without result-parameter history uses the same declaration across query blocks.
prepare derived_case_text from
    'select id, hex(reverse(x)), char_length(x)
     from (select id, case when ? then txt else _binary '''' end x from domains limit 3) d order by id';
set @derived_text = true;
execute derived_case_text using @derived_text;
set @derived_text = false;
execute derived_case_text using @derived_text;
set @derived_text = true;
execute derived_case_text using @derived_text;
deallocate prepare derived_case_text;
prepare derived_lpad_text from
    'select id, hex(reverse(x)), char_length(x)
     from (select id, case when ? then lpad(txt, 3, ''z'') else _binary '''' end x
           from domains having x is not null) d order by id';
execute derived_lpad_text using @derived_text;
set @derived_text = false;
execute derived_lpad_text using @derived_text;
set @derived_text = true;
execute derived_lpad_text using @derived_text;
deallocate prepare derived_lpad_text;
set @derived_text = null;
-- An unrelated explicit CAST does not reset retained CASE history on a transport type change.
prepare pinned_cast_history from 'select field(case when ? then ? else null end, ''A'', ''a''), cast(? as signed)';
set @pinned_flag = 1, @pinned_value = null, @pinned_number = '1';
execute pinned_cast_history using @pinned_flag, @pinned_value, @pinned_number;
set @pinned_value = 'a';
execute pinned_cast_history using @pinned_flag, @pinned_value, @pinned_number;
set @pinned_number = 1;
execute pinned_cast_history using @pinned_flag, @pinned_value, @pinned_number;
deallocate prepare pinned_cast_history;
set @pinned_flag = null, @pinned_value = null, @pinned_number = null;

-- A scalar row limit is not a derived-table materialization boundary.
select char_length((select coalesce(txt, bin) from domains where id = 1 limit 1)),
       hex(left((select coalesce(txt, bin) from domains where id = 1 limit 1), 1)),
       hex(reverse((select coalesce(txt, bin) from domains where id = 1 limit 1)));
-- Intrinsic reconciliation remains a declaration boundary inside scalar queries.
select char_length((select distinct coalesce(txt, bin) from domains limit 1)),
       hex(left((select distinct coalesce(txt, bin) from domains limit 1), 1)),
       char_length((select coalesce(txt, bin) x from domains where id = 1 union all select _binary '' order by x desc limit 1)),
       hex(left((select coalesce(txt, bin) x from domains where id = 1 union all select _binary '' order by x desc limit 1), 1)),
       char_length((select first_value(coalesce(txt, bin)) over () from domains limit 1)),
       hex(left((select first_value(coalesce(txt, bin)) over () from domains limit 1), 1));
-- COALESCE must retain the row domain returned by value transformations.
select id, char_length(coalesce(reverse(coalesce(txt, bin)), '')),
       hex(reverse(coalesce(reverse(coalesce(txt, bin)), ''))),
       char_length(coalesce(left(coalesce(txt, bin), 1), '')),
       hex(reverse(coalesce(left(coalesce(txt, bin), 1), ''))),
       char_length(coalesce(repeat(coalesce(txt, bin), 2), '')),
       char_length(coalesce(rpad(coalesce(txt, bin), 3, 'z'), ''))
from domains order by id;
-- This is IF/CASE over COALESCE, not the opposite nesting above.
select id, char_length(if(id = 2, bin, coalesce(txt, bin))),
       hex(left(if(id = 2, bin, coalesce(txt, bin)), 1)),
       hex(reverse(if(id = 2, bin, coalesce(txt, bin)))),
       char_length(case when id = 2 then bin else coalesce(txt, bin) end),
       hex(left(case when id = 2 then bin else coalesce(txt, bin) end, 1)),
       hex(reverse(case when id = 2 then bin else coalesce(txt, bin) end))
from domains order by id;
-- Comparison/search consumes declarations; slicing still uses the selected row.
select id, locate('a', coalesce(txt, bin)), instr(coalesce(txt, bin), 'a'),
       coalesce(txt, bin) like '__', coalesce(txt, bin) like '____',
       char_length(coalesce(txt, bin)), hex(left(coalesce(txt, bin), 1))
from domains order by id;
select id, locate('a', x), instr(x, 'a'), x like '__', x like '____',
       char_length(x), hex(left(x, 1))
from (select id, coalesce(txt, bin) x from domains) d order by id;
-- HAVING remains a declaration boundary even if its filter is constant.
select id, char_length(x), hex(left(x, 1)), hex(reverse(x))
from (select id, coalesce(txt, bin) x from domains having id > 0) d order by id;
select id, char_length(x), hex(left(x, 1)), hex(reverse(x))
from (select id, coalesce(txt, bin) x from domains having true) d order by id;
-- Scalar row selection is transparent, but genuine grouping is not.
select char_length((select coalesce(txt, bin) from domains group by coalesce(txt, bin))),
       hex(left((select coalesce(txt, bin) from domains group by coalesce(txt, bin)), 1)),
       hex(reverse((select coalesce(txt, bin) from domains group by coalesce(txt, bin))));
select char_length((select coalesce(txt, bin) x from domains where id = 1 having x is not null)),
       hex(left((select coalesce(txt, bin) x from domains where id = 1 having x is not null), 1));
-- A unique-key equality can eliminate scalar grouping, unlike one physical row.
create table singleton_domains (id int primary key, txt varchar(16), bin varbinary(16));
insert into singleton_domains values (1, '你a', null);
select char_length((select coalesce(txt, bin) from singleton_domains group by coalesce(txt, bin))),
       hex(left((select coalesce(txt, bin) from singleton_domains group by coalesce(txt, bin)), 1));
select char_length((select coalesce(txt, bin) from singleton_domains where id = 1 group by coalesce(txt, bin))),
       hex(left((select coalesce(txt, bin) from singleton_domains where id = 1 group by coalesce(txt, bin)), 1));
drop table singleton_domains;
-- Consuming a conditional declaration preserves its bounded binary family.
create table declared_conditional_slice as
select id, left(if(d.x is not null, d.x, _binary 'x'), 1) sliced
from (select id, if(id = 2, bin, txt) x from domains) d;
select id, hex(sliced), char_length(sliced) from declared_conditional_slice order by id;
select data_type, character_maximum_length from information_schema.columns
where table_schema = database() and table_name = 'declared_conditional_slice' and column_name = 'sliced';
drop table declared_conditional_slice;
-- NULLIF forwards its first value domain; its comparison is not a CASE result declaration.
select id, char_length(nullif(coalesce(txt, bin), '')),
       hex(left(nullif(coalesce(txt, bin), ''), 1)),
       hex(reverse(nullif(coalesce(txt, bin), '')))
from domains order by id;
select id, char_length(nullif(x, '')), hex(left(nullif(x, ''), 1)),
       hex(reverse(nullif(x, '')))
from (select id, coalesce(txt, bin) x from domains) d order by id;

-- Expression DEFAULT binding preserves NULLIF's first value source without a query builder.
-- CASE/IF also retain stronger VARCHAR row domains in stored defaults.
create table nullif_default_domains (
    id int,
    txt varchar(16),
    forwarded varbinary(64) default (reverse(nullif(coalesce(txt, _binary ''), ''))),
    control varbinary(64) default (reverse(coalesce(txt, _binary ''))),
    declared varbinary(64) default (reverse(cast(nullif(coalesce(txt, _binary ''), '') as binary(4)))),
    case_forwarded varbinary(64) default (reverse(nullif(case when txt is not null then txt else _binary '' end, ''))),
    if_length bigint default (char_length(if(txt is not null, txt, _binary '0')))
);
insert into nullif_default_domains (id, txt) values (1, '你a'), (2, ''), (3, null);
select id, hex(forwarded), hex(control), hex(declared), hex(case_forwarded), if_length
from nullif_default_domains order by id;
drop table nullif_default_domains;

-- BIT_COUNT consumes the binary declaration without changing sibling row-domain consumers.
select id, bit_count(coalesce(txt, bin)) from domains order by id;
select id, bit_count(x), char_length(x), hex(left(x, 1))
from (select id, coalesce(txt, bin) x from domains) d order by id;
select id, bit_count(x)
from (select id, coalesce(txt, bin) x from domains limit 3) d order by id;

select id, hex(left(invalid_bytes, 1)), hex(reverse(invalid_bytes)),
       char_length(invalid_bytes), invalid_bytes like '____'
from domains order by id;

create table concat_ws_domains (
    id int,
    sep varbinary(1),
    first_value varchar(16),
    second_value varchar(16)
);
insert into concat_ws_domains values
    (1, X'2d', '你', null),
    (2, X'2d', '你', 'a');
select id, hex(concat_ws(sep, first_value, second_value)),
       char_length(concat_ws(sep, first_value, second_value)),
       charset(concat_ws(sep, first_value, second_value))
from concat_ws_domains order by id;

create table collation_domains (
    ci varchar(16) collate utf8mb4_general_ci,
    exact varchar(16) collate utf8mb4_bin,
    bytes_value varbinary(16)
);
insert into collation_domains values ('A你', 'A你', X'41e4bda0');
select locate('a', ci), instr(ci, 'a'), locate('a', exact), instr(exact, 'a'),
       locate(X'bd', bytes_value), instr(bytes_value, X'bd')
from collation_domains;
select charset(ci), collation(ci), charset(exact), collation(exact),
       charset(bytes_value), collation(bytes_value)
from collation_domains;

set @binary_value = X'e4bda061';
set @text_value = '你a';
select char_length(@binary_value), hex(left(@binary_value, 1)), ord(@binary_value),
       @binary_value like '____';
select char_length(@text_value), hex(left(@text_value, 1)), ord(@text_value),
       @text_value like '____';
prepare binary_string_stmt from
    'select char_length(?), hex(left(?, 1)), ord(?), ? like ''____'',
            charset(left(?, 1)), collation(left(?, 1))';
execute binary_string_stmt using @binary_value, @binary_value, @binary_value, @binary_value,
                                 @binary_value, @binary_value;
execute binary_string_stmt using @text_value, @text_value, @text_value, @text_value,
                                 @text_value, @text_value;
deallocate prepare binary_string_stmt;

-- A selected text row must remain an explicit text override even when the
-- expression's common static type is binary.
set @selected_text = if(false, X'ff', '你a');
select charset(@selected_text), collation(@selected_text),
       char_length(@selected_text), hex(left(@selected_text, 1));
select if(false, X'ff', '你a') into @selected_text_into;
select charset(@selected_text_into), collation(@selected_text_into),
       char_length(@selected_text_into), hex(left(@selected_text_into, 1));
set @choose_binary = false;
prepare prepared_set_domain from
    'set @prepared_selected_text = if(?, X''ff'', ''你a'')';
execute prepared_set_domain using @choose_binary;
select charset(@prepared_selected_text), collation(@prepared_selected_text),
       char_length(@prepared_selected_text), hex(left(@prepared_selected_text, 1));
deallocate prepare prepared_set_domain;

set @typed_binary_null = cast(null as binary(8));
prepare typed_binary_null_stmt from
    'select charset(?), collation(?), charset(left(?, 1)), collation(left(?, 1))';
execute typed_binary_null_stmt using @typed_binary_null, @typed_binary_null,
                                     @typed_binary_null, @typed_binary_null;
deallocate prepare typed_binary_null_stmt;

-- Exercise SQL EXECUTE parameters in a real MULTICN scan. The assignment type of
-- @binary_value is VARBINARY, while @selected_text has a binary common static
-- type but an explicit text row domain. The remote CN must preserve both axes.
create table remote_prepare_source (id bigint primary key);
insert into remote_prepare_source select result from generate_series(1, 80000) g;
set @flush_result = mo_ctl('dn', 'flush',
                           'binary_string_function_semantics.remote_prepare_source');
set @remote_stats = '{"table_cnt":5000000,"block_number":640,"accurate_object_number":40,"approx_object_number":40,"ndv_map":{"id":5000000}}';
set @patched_stats = (select table_cnt
                      from table_stats('binary_string_function_semantics.remote_prepare_source',
                                       'patch', @remote_stats) g);
-- @regex("(?i)ap query plan on multicn", true)
explain select sum(char_length(@binary_value)), sum(@binary_value like '____')
from remote_prepare_source;
prepare remote_domain_stmt from
    'select sum(char_length(?)), sum(? like ''____'') from remote_prepare_source';
execute remote_domain_stmt using @binary_value, @binary_value;
execute remote_domain_stmt using @selected_text, @selected_text;
deallocate prepare remote_domain_stmt;

-- Bare variables freeze both axes; remote folding must preserve the binary
-- static identity and the selected text row domain after reassignment.
prepare remote_bound_stmt from
    'select min(charset(@selected_text)), sum(char_length(@selected_text)),
            min(hex(left(@selected_text, 1))) from remote_prepare_source';
execute remote_bound_stmt;
set @selected_text = X'e4bda061';
execute remote_bound_stmt;
select charset(@selected_text), char_length(@selected_text), hex(left(@selected_text, 1));
-- A schema change starts a new binding generation using the current assignment.
alter table remote_prepare_source add column binding_generation int;
execute remote_bound_stmt;
deallocate prepare remote_bound_stmt;

-- A valid late wildcard alignment must not be rejected by a performance guard.
select concat(repeat(_binary 'a', 8998), _binary 'bxc')
       like concat(_binary '%', repeat(_binary '_', 5000), _binary 'b_%c')
       as late_binary_like;

-- Equal-frequency anchors with long '_' gaps must not cause candidate-by-segment rescans.
select concat(repeat(_binary 'a', 1000), repeat(_binary 'b', 1001), repeat(_binary 'a', 1000))
       like concat(_binary '%a', repeat(_binary '_', 999), _binary 'a',
                   repeat(_binary '_', 999), _binary 'a%')
       as equal_frequency_binary_like;

create table binary_function_ctas as
select left(bin, 1) as binary_left,
       lower(bin) as binary_lower,
       replace(txt, X'bd', X'78') as text_replace
from domains where id = 3;
select column_name, data_type, character_maximum_length, character_octet_length,
       character_set_name, collation_name
from information_schema.columns
where table_schema = 'binary_string_function_semantics'
  and table_name = 'binary_function_ctas'
order by ordinal_position;
select hex(binary_left), hex(binary_lower), hex(text_replace),
       char_length(binary_left), char_length(binary_lower), char_length(text_replace)
from binary_function_ctas;

-- IF owns its binary declaration before LEFT and both SUBSTRING overloads consume bytes.
select hex(substring(left(if(false, X'ff', '你好'), 2), 2, 1)) as selected_text,
       hex(substring(left(if(false, X'ff', '你好'), 2), 2)) as selected_text_tail,
       hex(substring(left(if(true, X'e4bda0e5a5bd', '你好'), 2), 2, 1)) as selected_binary;

-- A mergeable projection preserves IF's binary result declaration at the outer consumer.
with mixed_domain as (
    select if(false, X'ff', '你好') as value
)
select hex(left(value, 1)), char_length(value)
from mixed_domain;

drop database binary_string_function_semantics;
