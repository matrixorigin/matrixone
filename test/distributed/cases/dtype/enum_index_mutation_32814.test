-- @suite
-- @case
-- @desc: ENUM index keys, mutation row counts, and physical SET values
-- @label:bvt
drop database if exists enum_index_mutation_32814;
create database enum_index_mutation_32814;
use enum_index_mutation_32814;
create table source_enum(id int primary key,e enum('A','a') collate utf8mb4_bin);
create table target_enum(id int primary key,e enum('a','A') collate utf8mb4_bin);
insert into source_enum values(1,'A'),(2,'a');
insert into target_enum select * from source_enum;
select id,e,e+0 from target_enum order by id;
create table inline_index(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int,key ix(e,n));
create table added_index(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int);
insert into inline_index values(1,'A',11),(2,'a',22),(3,'',33);
insert into added_index values(1,'A',11),(2,'a',22),(3,'',33);
alter table added_index add index ix(e,n);
delete from inline_index where id=2;
select row_count() as affected;
delete from added_index where id=2;
select row_count() as affected;
select id,e+0,n from inline_index order by id;
select id,e+0,n from added_index order by id;
update added_index set e='a' where id=1;
select row_count() as affected;
select id,e+0,n from added_index order by id;
create table mixed(id int primary key,e enum('A','a') collate utf8mb4_bin,s set('','a'),n int,key ix(e,s));
insert into mixed values(1,'A',0,10),(2,'a',1,20),(3,'a',2,30),(4,'A',3,40);
update mixed set n=n+1 where id=2 returning id,e+0,s+0,n;
select id,e+0,s+0,n from mixed where id=2;
update mixed set id=20 where id=2;
select row_count() as affected;
delete from mixed where id=20 returning id,e+0,s+0,n;
select id,e+0,s+0,n from mixed order by id;
select id,e+0,s+0 from mixed force index(ix) where e='a' order by id;
select id,e+0,s+0 from mixed ignore index(ix) where e='a' order by id;
create table order_expr(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int,key ix(e,n));
insert into order_expr values(1,'A',11),(2,'a',22),(3,'',33);
delete from order_expr order by length(e) desc,e desc limit 1;
select row_count() as affected;
select id,e+0 from order_expr order by id;
create temporary table temp_index(id int primary key,e enum('A','a') collate utf8mb4_bin,n int);
insert into temp_index values(1,'A',11),(2,'a',22);
alter table temp_index add index ix(e,n);
delete from temp_index where id=2;
select row_count() as affected;
select id,e+0,n from temp_index order by id;
drop temporary table temp_index;
create table join_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
create table join_source(rid int);
insert into join_target values(1,'A',11),(2,'a',22);
insert into join_source values(2),(2);
delete t from join_target t join join_source s on t.id=s.rid;
select row_count() as affected;
select id,e+0 from join_target order by id;
create table prep_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int);
insert into prep_target values(1,'A',11),(2,'a',22);
prepare pd from 'delete from prep_target where id=?';
alter table prep_target add index ix(e,n);
set @idx=2;
execute pd using @idx;
select row_count() as affected;
select id,e+0 from prep_target order by id;
deallocate prepare pd;
create table uniq_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,unique key uq(e));
insert into uniq_target values(1,'A',11),(2,'a',22);
update uniq_target set e='A' where id=2;
select id,e+0,n from uniq_target order by id;
delete from uniq_target where id=2;
select row_count() as affected;
select id,e+0 from uniq_target order by id;
create table unique_alter(id int primary key,e enum('A','a') collate utf8mb4_bin,unique key uq(e));
insert into unique_alter values(1,'A'),(2,'a');
alter table unique_alter modify e enum('A','a') collate utf8mb4_general_ci;
select id,e,e+0 from unique_alter order by id;
show create table unique_alter;
create table downgrade_alter(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into downgrade_alter values(1,'A',10),(2,'a',20);
alter table downgrade_alter modify e enum('A','a');
select id,e,e+0,n from downgrade_alter order by id;
delete from downgrade_alter where id=2;
select row_count() as affected;
select id,e,e+0,n from downgrade_alter order by id;
create table upsert_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into upsert_target values(1,'A',10);
replace into upsert_target values(1,'a',20);
insert into upsert_target values(1,'A',30) on duplicate key update e=values(e),n=values(n);
select id,e+0,n from upsert_target force index(ix) where e='A';
select id,e+0,n from upsert_target ignore index(ix) where e='A';
create table delete_all(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into delete_all values(1,'A',1),(2,'a',2),(3,null,3);
delete from delete_all;
select row_count() as affected;
select count(*) as remaining from delete_all;
create table invalid_prefix(id int primary key,e enum('A','a') collate utf8mb4_bin,key ix(e(1)));
drop database enum_index_mutation_32814;
