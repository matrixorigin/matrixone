-- @suite
-- @case
-- @desc: ENUM index keys, mutation row counts, and physical SET values
-- @label:bvt
drop database if exists enum_index_mutation_32814;
create database enum_index_mutation_32814;
use enum_index_mutation_32814;
create table source_enum(id int primary key,e enum('A','a') collate utf8mb4_bin);
create table target_enum(id int primary key,e enum('a','A') collate utf8mb4_bin);
insert into source_enum values(1,'A'),(2,'a');
insert into target_enum select * from source_enum;
select id,e,e+0 from target_enum order by id;
create table grouped_numeric(id int primary key,e enum('A','a') collate utf8mb4_bin);
insert into grouped_numeric values(1,'a');
select e+0 from grouped_numeric group by e;
drop table grouped_numeric;
create table inline_index(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int,key ix(e,n));
create table added_index(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int);
insert into inline_index values(1,'A',11),(2,'a',22),(3,'',33);
insert into added_index values(1,'A',11),(2,'a',22),(3,'',33);
alter table added_index add index ix(e,n);
delete from inline_index where id=2;
select row_count() as affected;
delete from added_index where id=2;
select row_count() as affected;
select id,e+0,n from inline_index order by id;
select id,e+0,n from added_index order by id;
update added_index set e='a' where id=1;
select row_count() as affected;
select id,e+0,n from added_index order by id;
create table mixed(id int primary key,e enum('A','a') collate utf8mb4_bin,s set('','a'),n int,key ix(e,s));
insert into mixed values(1,'A',0,10),(2,'a',1,20),(3,'a',2,30),(4,'A',3,40);
update mixed set n=n+1 where id=2 returning id,e+0,s+0,n;
select id,e+0,s+0,n from mixed where id=2;
update mixed set id=20 where id=2;
select row_count() as affected;
delete from mixed where id=20 returning id,e+0,s+0,n;
select id,e+0,s+0,n from mixed order by id;
select id,e+0,s+0 from mixed force index(ix) where e='a' order by id;
select id,e+0,s+0 from mixed ignore index(ix) where e='a' order by id;
create table order_expr(id int primary key,e enum('A','a','') collate utf8mb4_bin,n int,key ix(e,n));
insert into order_expr values(1,'A',11),(2,'a',22),(3,'',33);
delete from order_expr order by length(e) desc,e desc limit 1;
select row_count() as affected;
select id,e+0 from order_expr order by id;
create temporary table temp_index(id int primary key,e enum('A','a') collate utf8mb4_bin,n int);
insert into temp_index values(1,'A',11),(2,'a',22);
alter table temp_index add index ix(e,n);
delete from temp_index where id=2;
select row_count() as affected;
select id,e+0,n from temp_index order by id;
drop temporary table temp_index;
create table join_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
create table join_source(rid int);
insert into join_target values(1,'A',11),(2,'a',22);
insert into join_source values(2),(2);
delete t from join_target t join join_source s on t.id=s.rid;
select row_count() as affected;
select id,e+0 from join_target order by id;
create table prep_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int);
insert into prep_target values(1,'A',11),(2,'a',22);
prepare pd from 'delete from prep_target where id=?';
alter table prep_target add index ix(e,n);
set @idx=2;
execute pd using @idx;
select row_count() as affected;
select id,e+0 from prep_target order by id;
deallocate prepare pd;
-- A legacy composite index is rebuilt against the target identity during COPY.
create table legacy_index_alter(id int primary key,e enum('A','a'),n int,key ix(e,n));
insert into legacy_index_alter values(1,1,10),(2,2,20);
alter table legacy_index_alter modify e enum('A','a') collate utf8mb4_general_ci;
select id,e+0,n from legacy_index_alter force index(ix) where e='a' order by id;
select id,e+0,n from legacy_index_alter ignore index(ix) where e='a' order by id;
update legacy_index_alter set id=12,n=21 where id=2;
select row_count() as affected;
select id,e+0,n from legacy_index_alter force index(ix) where e='a' order by id;
select id,e+0,n from legacy_index_alter ignore index(ix) where e='a' order by id;
delete from legacy_index_alter where id=12;
select row_count() as affected;
select id,e+0,n from legacy_index_alter order by id;
create table uniq_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,unique key uq(e));
insert into uniq_target values(1,'A',11),(2,'a',22);
update uniq_target set e='A' where id=2;
select id,e+0,n from uniq_target order by id;
delete from uniq_target where id=2;
select row_count() as affected;
select id,e+0 from uniq_target order by id;
create table unique_alter(id int primary key,e enum('A','a') collate utf8mb4_bin,unique key uq(e));
insert into unique_alter values(1,'A'),(2,'a');
-- Changed domains still remap labels and must roll back real uniqueness collisions.
alter table unique_alter modify e enum('a') collate utf8mb4_general_ci;
select id,e,e+0 from unique_alter order by id;
show create table unique_alter;
-- The unchanged ordered domain keeps its two physical ordinals.
alter table unique_alter modify e enum('A','a') collate utf8mb4_general_ci;
select id,e,e+0 from unique_alter order by id;
show create table unique_alter;
insert into unique_alter values(3,1);
insert into unique_alter values(4,2);
update unique_alter set id=12 where id=2;
select row_count() as affected;
delete from unique_alter where id=12;
select row_count() as affected;
select id,e,e+0 from unique_alter order by id;
create table downgrade_alter(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into downgrade_alter values(1,'A',10),(2,'a',20);
alter table downgrade_alter modify e enum('A','a');
select id,e,e+0,n from downgrade_alter order by id;
delete from downgrade_alter where id=2;
select row_count() as affected;
select id,e,e+0,n from downgrade_alter order by id;
create table rename_downgrade_alter(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into rename_downgrade_alter values(1,'A',10),(2,'a',20);
alter table rename_downgrade_alter change column e f enum('A','a');
select id,e,e+0,n from rename_downgrade_alter order by id;
delete from rename_downgrade_alter where id=2;
select row_count() as affected;
select id,e,e+0,n from rename_downgrade_alter order by id;
create table rename_reuse_downgrade(id int primary key,e enum('A','a') collate utf8mb4_bin,q varchar(8),n int,key ix(e,n));
insert into rename_reuse_downgrade values(1,'A','q1',10),(2,'a','q2',20);
alter table rename_reuse_downgrade change column e f enum('A','a'), change column q e varchar(8);
select id,e,e+0,q,n from rename_reuse_downgrade order by id;
delete from rename_reuse_downgrade where id=2;
select row_count() as affected;
select id,e,e+0,q,n from rename_reuse_downgrade order by id;
create table upsert_target(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into upsert_target values(1,'A',10);
replace into upsert_target values(1,'a',20);
insert into upsert_target values(1,'A',30) on duplicate key update e=values(e),n=values(n);
select id,e+0,n from upsert_target force index(ix) where e='A';
select id,e+0,n from upsert_target ignore index(ix) where e='A';
create table delete_all(id int primary key,e enum('A','a') collate utf8mb4_bin,n int,key ix(e,n));
insert into delete_all values(1,'A',1),(2,'a',2),(3,null,3);
delete from delete_all;
select row_count() as affected;
select count(*) as remaining from delete_all;
create table invalid_prefix(id int primary key,e enum('A','a') collate utf8mb4_bin,key ix(e(1)));
-- COPY preserves two same-domain generated columns independently, including
-- NULL, the empty member and physical error ordinal zero.
create table generated_pair(id int primary key,v int,
 a enum('A','a','') generated always as (if(v is null,null,if(v=-1,0,if(v=0,3,if(v=2,2,1))))) stored,
 b enum('A','a','') generated always as (if(v is null,null,if(v=-1,0,if(v=0,3,if(v=2,1,2))))) virtual,
 key ix(a,v));
insert into generated_pair(id,v) values(1,1),(2,2),(3,0),(5,null);
insert ignore into generated_pair(id,v) values(4,-1);
alter table generated_pair change a aa enum('A','a','') collate utf8mb4_general_ci, change b bb enum('A','a','') collate utf8mb4_general_ci;
select id,hex(cast(aa as char)),aa+0,hex(cast(bb as char)),bb+0 from generated_pair order by id;
select id,aa+0,v from generated_pair force index(ix) where aa='a' order by id;
select id,aa+0,v from generated_pair ignore index(ix) where aa='a' order by id;
update generated_pair set v=99 where id=2;
select id,v,aa+0,bb+0 from generated_pair where id=2;
create table generated_unique(id int primary key,v int,e enum('A','a') generated always as (if(v=2,2,1)) stored,unique key uq(e));
insert into generated_unique(id,v) values(1,1),(2,2);
alter table generated_unique modify e enum('A','a') collate utf8mb4_general_ci;
update generated_unique set e=1 where id=2;
select id,e+0 from generated_unique order by id;
create table generated_null(id int primary key,v int,e enum('A','a') generated always as (if(v is null,null,1)) stored,key ix(e));
insert into generated_null(id,v) values(1,null),(2,1);
alter table generated_null modify e enum('A','a') collate utf8mb4_general_ci not null;
show create table generated_null;
select id,v,e+0,e is null from generated_null order by id;
-- Replacement tables renumber columns; PRE_INSERT must preserve ENUM slots.
create table reorder_enum(id int primary key,e enum('A','a'),n int);
insert into reorder_enum values(1,1,10),(2,2,20);
alter table reorder_enum modify e enum('A','a') collate utf8mb4_general_ci first;
alter table reorder_enum modify e enum('A','a') collate utf8mb4_bin after n;
select id,hex(cast(e as char)),e+0,n from reorder_enum order by id;
create table auto_enum(id bigint auto_increment primary key,e enum('A','a'));
insert into auto_enum(e) values(1),(2);
alter table auto_enum modify e enum('A','a') collate utf8mb4_general_ci;
select id,hex(cast(e as char)),e+0 from auto_enum order by id;
create table compound_enum(id int,v int,e enum('A','a'),primary key(id,v));
insert into compound_enum values(1,1,1),(2,2,2);
alter table compound_enum modify e enum('A','a') collate utf8mb4_general_ci;
select id,v,hex(cast(e as char)),e+0 from compound_enum order by id;
-- Changing an indexed FULLTEXT column materializes the new-row image in a sink.
create table fulltext_enum(id int primary key,e enum('A','a'),body varchar(128));
create fulltext index ft on fulltext_enum(body);
insert into fulltext_enum values(1,1,'alpha beta'),(2,2,'beta gamma');
alter table fulltext_enum modify e enum('A','a') collate utf8mb4_general_ci, modify body varchar(256);
select id,hex(cast(e as char)),e+0,body from fulltext_enum order by id;
show create table fulltext_enum;
drop database enum_index_mutation_32814;
