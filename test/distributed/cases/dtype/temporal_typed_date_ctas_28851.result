set sql_mode = '';
create table extract_source (d date not null, s varchar(30) not null, n bigint not null);
insert into extract_source values ('0000-00-00', 'bad', 3652425), ('2024-01-07', '2024-01-07', 739257);
create table extracted as select d,
extract(week from d) as ew, extract(year from s) as ey, year(s) as sy,
month(s) as sm, quarter(s) as sq, day(s) as sd,
week(d) as w, weekofyear(d) as wy, weekday(d) as wd, yearweek(d) as yw,
dayofweek(d) as dw, dayofyear(d) as dy, dayname(d) as dn, monthname(d) as mn,
from_days(n) as fd, year(d) as typed_y
from extract_source;
select column_name, is_nullable from information_schema.columns
