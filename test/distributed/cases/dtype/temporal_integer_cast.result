select cast(cast('9999-12-31 23:59:59.999999' as datetime(6)) as signed) as dt_max,
cast(cast('838:59:59.999999' as time(6)) as signed) as tm_max,
cast(cast('-838:59:59.999999' as time(6)) as signed) as tm_min;
