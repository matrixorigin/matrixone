-11  ¦  0  ¦  1  ¦  1  𝄀
-10  ¦  1  ¦  0  ¦  1  𝄀
-9  ¦  0  ¦  1  ¦  0
drop view decimal_suffix_v;
drop table decimal_suffix_t;
drop table if exists decimal_scale_alignment_t;
create table decimal_scale_alignment_t (id int primary key, x int);
insert into decimal_scale_alignment_t values (1,1),(2,2),(3,NULL);
select id,
(cast(x as decimal(20,0)) + cast('3e-38' as decimal(65,38))) = cast(case id when 1 then '1.00000000000000000000000000000000000003' when 2 then '2.00000000000000000000000000000000000003' end as decimal(65,38)) as add_left,
(cast('3e-38' as decimal(65,38)) + cast(x as decimal(20,0))) = cast(case id when 1 then '1.00000000000000000000000000000000000003' when 2 then '2.00000000000000000000000000000000000003' end as decimal(65,38)) as add_right,
(cast(x as decimal(20,0)) - cast('3e-38' as decimal(65,38))) = cast(case id when 1 then '0.99999999999999999999999999999999999997' when 2 then '1.99999999999999999999999999999999999997' end as decimal(65,38)) as sub_left,
(cast('3e-38' as decimal(65,38)) - cast(x as decimal(20,0))) = cast(case id when 1 then '-0.99999999999999999999999999999999999997' when 2 then '-1.99999999999999999999999999999999999997' end as decimal(65,38)) as sub_right,
(cast(x as decimal(20,0)) % cast('3e-38' as decimal(65,38))) = cast(case id when 1 then '0.00000000000000000000000000000000000001' when 2 then '0.00000000000000000000000000000000000002' end as decimal(65,38)) as mod_left,
(cast('3e-38' as decimal(65,38)) % cast(x as decimal(20,0))) = cast(case id when 1 then '0.00000000000000000000000000000000000003' when 2 then '0.00000000000000000000000000000000000003' end as decimal(65,38)) as mod_right
from decimal_scale_alignment_t order by id;
