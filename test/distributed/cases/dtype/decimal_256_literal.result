(cast(x as decimal(20,0)) + cast('3e-39' as decimal(65,39))) = cast(case id when 1 then '1.000000000000000000000000000000000000003' when 2 then '2.000000000000000000000000000000000000003' end as decimal(65,39)) as add_left,
(cast('3e-39' as decimal(65,39)) + cast(x as decimal(20,0))) = cast(case id when 1 then '1.000000000000000000000000000000000000003' when 2 then '2.000000000000000000000000000000000000003' end as decimal(65,39)) as add_right,
(cast(x as decimal(20,0)) - cast('3e-39' as decimal(65,39))) = cast(case id when 1 then '0.999999999999999999999999999999999999997' when 2 then '1.999999999999999999999999999999999999997' end as decimal(65,39)) as sub_left,
(cast('3e-39' as decimal(65,39)) - cast(x as decimal(20,0))) = cast(case id when 1 then '-0.999999999999999999999999999999999999997' when 2 then '-1.999999999999999999999999999999999999997' end as decimal(65,39)) as sub_right,
(cast(x as decimal(20,0)) % cast('3e-39' as decimal(65,39))) = cast(case id when 1 then '0.000000000000000000000000000000000000001' when 2 then '0.000000000000000000000000000000000000002' end as decimal(65,39)) as mod_left,
