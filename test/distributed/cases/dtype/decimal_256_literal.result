drop view if exists decimal_suffix_v;
drop table if exists decimal_suffix_t;
create table decimal_suffix_t (d decimal(30,0) not null);
insert into decimal_suffix_t values (-1234567890123456790), (-1234567890123456789), (-11), (-10), (-9);
select d, d in (-1234567890123456789.0, -10.0) as in_match,
d not in (-1234567890123456789.0, -10.0) as not_in_match,
d between -1234567890123456789.6 and -10.0 as between_match
from decimal_suffix_t order by d;
➤ d[3,30,0]  ¦  in_match[-7,1,0]  ¦  not_in_match[-7,1,0]  ¦  between_match[-7,1,0]  𝄀
-1234567890123456790  ¦  0  ¦  1  ¦  0  𝄀
-1234567890123456789  ¦  1  ¦  0  ¦  1  𝄀
-11  ¦  0  ¦  1  ¦  1  𝄀
-10  ¦  1  ¦  0  ¦  1  𝄀
-9  ¦  0  ¦  1  ¦  0
create view decimal_suffix_v as
select d, d in (-1234567890123456789.0, -10.0) as in_match,
d not in (-1234567890123456789.0, -10.0) as not_in_match,
d between -1234567890123456789.6 and -10.0 as between_match
from decimal_suffix_t;
select * from decimal_suffix_v order by d;
➤ d[3,30,0]  ¦  in_match[-7,1,0]  ¦  not_in_match[-7,1,0]  ¦  between_match[-7,1,0]  𝄀
