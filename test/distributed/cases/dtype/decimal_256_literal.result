select cast('-99999999999999999999999999999999999999' as decimal(65,0)) *
0.2871438217498217489217843728134214212143;
Data truncation: data out of range: data type DECIMAL, invalid input: Decimal256 Mul overflow: -99999999999999999999999999999999999999*0.2871438217498217489217843728134214212143

drop table decimal_256_unquoted_literal_t;
