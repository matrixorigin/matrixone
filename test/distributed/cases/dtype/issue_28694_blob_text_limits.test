--- @metacmp(false)
-- @suite

-- @case
-- @desc:enforce MySQL BLOB/TEXT family byte limits across DML and metadata
-- @label:bvt
drop database if exists issue_28694_blob_text_limits;
create database issue_28694_blob_text_limits;
use issue_28694_blob_text_limits;
set @issue_28694_old_sql_mode = @@session.sql_mode;
create table limits (
    id int primary key,
    tinyblob_col tinyblob,
    text_col text,
    blob_col blob
);

set session sql_mode = 'STRICT_TRANS_TABLES';
-- @regex("(?i)data truncation:.*to BLOB type.*src length 256.*dest length 255", true)
insert into limits (id, tinyblob_col) values (1, repeat('a', 256));
-- @regex("(?i)data truncation:.*to TEXT type.*src length 65536.*dest length 65535", true)
insert into limits (id, text_col) values (2, repeat('b', 65536));
-- @regex("(?i)data truncation:.*to BLOB type.*src length 65536.*dest length 65535", true)
insert into limits (id, blob_col) values (3, repeat('c', 65536));
select count(*) as strict_rows from limits;

insert into limits values (20, 'ok', 'ok', 'ok');
-- @regex("(?i)data truncation:.*to BLOB type.*src length 256.*dest length 255", true)
update limits
set tinyblob_col = repeat('d', 256), text_col = repeat('e', 65536), blob_col = repeat('f', 65536)
where id = 20;
-- @regex("(?i)data truncation:.*to BLOB type.*src length 256.*dest length 255", true)
insert into limits (id, tinyblob_col, text_col, blob_col)
values (20, 'ok', 'ok', 'ok')
on duplicate key update
    tinyblob_col = repeat('g', 256), text_col = repeat('h', 65536), blob_col = repeat('i', 65536);
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits where id = 20;

set @issue_28694_id = 21;
set @issue_28694_tinyblob = repeat('j', 256);
set @issue_28694_text = repeat('k', 65536);
set @issue_28694_blob = repeat('l', 65536);
prepare issue_28694_strict_insert from 'insert into limits values (?, ?, ?, ?)';
-- @regex("(?i)data truncation:.*to BLOB type.*src length 256.*dest length 255", true)
execute issue_28694_strict_insert using @issue_28694_id, @issue_28694_tinyblob, @issue_28694_text, @issue_28694_blob;
select count(*) as strict_prepared_rows from limits where id = 21;
deallocate prepare issue_28694_strict_insert;

-- @regex("(?i)data truncation:.*to BLOB type.*src length 256.*dest length 255", true)
create table ctas_tiny (id int, value tinyblob) as
select id, repeat('m', 256) as value from limits where id = 20;
select count(*) as strict_ctas_tables
from information_schema.tables
where table_schema = database() and table_name = 'ctas_tiny';

set session sql_mode = '';
insert into limits values (11, repeat('a', 256), repeat('b', 65536), repeat('c', 65536));
select @@warning_count;
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits where id = 11;

update limits
set tinyblob_col = repeat('d', 256), text_col = repeat('e', 65536), blob_col = repeat('f', 65536)
where id = 11;
select @@warning_count;
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits where id = 11;

insert into limits (id, tinyblob_col, text_col, blob_col)
values (11, 'ok', 'ok', 'ok')
on duplicate key update
    tinyblob_col = repeat('g', 256), text_col = repeat('h', 65536), blob_col = repeat('i', 65536);
select @@warning_count;
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits where id = 11;

set @issue_28694_id = 14;
set @issue_28694_tinyblob = repeat('j', 256);
set @issue_28694_text = repeat('k', 65536);
set @issue_28694_blob = repeat('l', 65536);
prepare issue_28694_insert from 'insert into limits values (?, ?, ?, ?)';
execute issue_28694_insert using @issue_28694_id, @issue_28694_tinyblob, @issue_28694_text, @issue_28694_blob;
select @@warning_count;
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits where id = 14;
deallocate prepare issue_28694_insert;

create table limits_copy as select * from limits;
select id, octet_length(tinyblob_col), octet_length(text_col), octet_length(blob_col)
from limits_copy where id in (11, 14) order by id;

select
    sum(case when lower(data_type) = 'tinyblob' and lower(column_type) = 'tinyblob' and character_maximum_length = 255 and character_octet_length = 255 then 1 else 0 end) as tinyblob_metadata,
    sum(case when lower(data_type) = 'text' and lower(column_type) = 'text' and character_maximum_length = 65535 and character_octet_length = 65535 then 1 else 0 end) as text_metadata,
    sum(case when lower(data_type) = 'blob' and lower(column_type) = 'blob' and character_maximum_length = 65535 and character_octet_length = 65535 then 1 else 0 end) as blob_metadata
from information_schema.columns
where table_schema = database() and table_name = 'limits';

set session sql_mode = @issue_28694_old_sql_mode;
drop database issue_28694_blob_text_limits;
