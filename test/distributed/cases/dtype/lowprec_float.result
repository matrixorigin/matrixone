DROP TABLE IF EXISTS t2;
CREATE TABLE t2 (id INT PRIMARY KEY, a bf16, c float8);
INSERT INTO t2 SELECT id, a, c FROM t WHERE a IS NOT NULL;
SELECT id, a, c FROM t2 ORDER BY id;
