1  ¦  1.5  ¦  1.5  ¦  1.5  ¦  1.5  𝄀
2  ¦  -2.0  ¦  -2.0  ¦  -2.0  ¦  -2.0  𝄀
3  ¦  0.0  ¦  0.0  ¦  0.0  ¦  0.0  𝄀
4  ¦  null  ¦  null  ¦  null  ¦  null
DROP TABLE IF EXISTS r;
CREATE TABLE r (id INT PRIMARY KEY, v float4);
INSERT INTO r VALUES (1, 0.5), (2, 1), (3, 1.5), (4, 2), (5, 3), (6, 4), (7, 6), (8, -6);
SELECT id, v FROM r ORDER BY id;
