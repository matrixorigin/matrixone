CREATE TABLE m2 (k INT, a float16, b float8, c float4, d bf16);
INSERT INTO m2 VALUES (1, 3.5, 3.5, 3, 3.5);
UPDATE m1 JOIN m2 ON m1.id = m2.k SET m1.a = m2.a, m1.b = m2.b, m1.c = m2.c, m1.d = m2.d;
