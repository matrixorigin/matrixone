drop database if exists enum_collation_assignment;
create database enum_collation_assignment;
use enum_collation_assignment;
set @saved_mode=@@sql_mode;
set sql_mode='STRICT_TRANS_TABLES';
create table src(id int, e enum('A','a','x') collate utf8mb4_bin);
create table dst(id int, e enum('x','a','A') collate utf8mb4_bin);
insert into src values (1,1),(2,2),(3,3);
insert into dst select id,e from src;
select id,hex(cast(e as char)),e+0 from dst order by id;
➤ id[4,32,0]  ¦  hex(cast(e as varchar))[12,-1,0]  ¦  e + 0[-5,64,0]  𝄀
1  ¦  41  ¦  3  𝄀
2  ¦  61  ¦  2  𝄀
3  ¦  78  ¦  1
create table distinct_dst(e enum('x','a','A') collate utf8mb4_bin);
insert into distinct_dst select distinct e from src;
select hex(cast(e as char)),e+0 from distinct_dst order by e+0;
➤ hex(cast(e as varchar))[12,-1,0]  ¦  e + 0[-5,64,0]  𝄀
78  ¦  1  𝄀
61  ¦  2  𝄀
41  ¦  3
create table same_src(e enum('A','a') collate utf8mb4_bin);
create table same_dst(e enum('A','a') collate utf8mb4_general_ci);
insert into same_src values ('a');
insert into same_dst select e from same_src;
select hex(cast(e as char)),e+0 from same_dst;
➤ hex(cast(e as varchar))[12,-1,0]  ¦  e + 0[-5,64,0]  𝄀
41  ¦  1
create table assignment(id int primary key,e enum('a','A') collate utf8mb4_bin);
prepare p from 'insert into assignment values (?,?)';
set @id=1,@value='A';
execute p using @id,@value;
deallocate prepare p;
update assignment set e='a' where id=1;
select hex(cast(e as char)),e+0 from assignment;
➤ hex(cast(e as varchar))[12,-1,0]  ¦  e + 0[-5,64,0]  𝄀
61  ¦  1
update assignment set e='Z' where id=1;
internal error: convert to MySQL enum failed: item Z is not in enum [a A]
select hex(cast(e as char)),e+0 from assignment;
