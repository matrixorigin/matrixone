DROP TABLE IF EXISTS t_int_div;
CREATE TABLE t_int_div (
i8 TINYINT,
i16 SMALLINT,
i32 INT,
i64 BIGINT,
u8 TINYINT UNSIGNED,
u64 BIGINT UNSIGNED,
b BOOL,
bt BIT(8),
d DATE,
y YEAR,
tm TIME(6),
dt DATETIME(6),
ts TIMESTAMP(6),
n_null INT
);
