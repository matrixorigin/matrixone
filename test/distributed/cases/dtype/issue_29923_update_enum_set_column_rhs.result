drop table if exists t29923_src;
drop table if exists t29923_dst;
create table t29923_dst(id int primary key, e enum('red','blue','green'), s set('a','b','c'), note varchar(10));
create table t29923_src(id int primary key, e enum('red','blue','green'), s set('a','b','c'));
insert into t29923_dst values (1, 'red', 'a', 'keep');
insert into t29923_dst values (2, 'blue', 'b', 'upd');
insert ignore into t29923_dst values (3, 'nope', 'x', 'err');
insert into t29923_src values (1, 'green', 'c'), (2, 'red', 'a'), (3, 'blue', 'b');
update t29923_dst set e = (select e from t29923_src where t29923_src.id = t29923_dst.id),
s = (select s from t29923_src where t29923_src.id = t29923_dst.id)
where id = 1;
select id, e, cast(e as unsigned), s, note from t29923_dst order by id;
➤ id[4,32,0]  ¦  e[12,65535,0]  ¦  cast(e as unsigned)[-5,64,0]  ¦  s[12,65535,0]  ¦  note[12,10,0]  𝄀
1  ¦  green  ¦  3  ¦  c  ¦  keep  𝄀
2  ¦  blue  ¦  2  ¦  b  ¦  upd  𝄀
3  ¦    ¦  0  ¦    ¦  err
update t29923_dst d join t29923_src s on d.id = s.id
set d.e = s.e, d.s = s.s
where d.id = 2;
select id, e, cast(e as unsigned), s, note from t29923_dst order by id;
➤ id[4,32,0]  ¦  e[12,65535,0]  ¦  cast(e as unsigned)[-5,64,0]  ¦  s[12,65535,0]  ¦  note[12,10,0]  𝄀
1  ¦  green  ¦  3  ¦  c  ¦  keep  𝄀
2  ¦  red  ¦  1  ¦  a  ¦  upd  𝄀
3  ¦    ¦  0  ¦    ¦  err
update t29923_dst d join t29923_src s on d.id = s.id
set d.e = s.e, d.s = s.s
where d.id = 3;
select id, e, cast(e as unsigned), s, note from t29923_dst order by id;
➤ id[4,32,0]  ¦  e[12,65535,0]  ¦  cast(e as unsigned)[-5,64,0]  ¦  s[12,65535,0]  ¦  note[12,10,0]  𝄀
1  ¦  green  ¦  3  ¦  c  ¦  keep  𝄀
2  ¦  red  ¦  1  ¦  a  ¦  upd  𝄀
3  ¦  blue  ¦  2  ¦  b  ¦  err
delete from t29923_dst where id = 3;
insert ignore into t29923_dst values (3, 'nope', 'x', 'err');
update t29923_dst d join t29923_src s on d.id = s.id
set d.e = s.e
where d.note = 'upd';
select id, e, cast(e as unsigned), note from t29923_dst order by id;
➤ id[4,32,0]  ¦  e[12,65535,0]  ¦  cast(e as unsigned)[-5,64,0]  ¦  note[12,10,0]  𝄀
1  ¦  green  ¦  3  ¦  keep  𝄀
2  ¦  red  ¦  1  ¦  upd  𝄀
3  ¦    ¦  0  ¦  err
drop table if exists t29923_dup;
create table t29923_dup(id int primary key, owner int, note int);
insert into t29923_dup values(1,3,0),(2,3,0);
update t29923_dst d join t29923_dup s on d.id=s.owner
set d.e=d.e, s.note=s.note+1;
select id,e,cast(e as unsigned),note from t29923_dst order by id;
➤ id[4,32,0]  ¦  e[12,65535,0]  ¦  cast(e as unsigned)[-5,64,0]  ¦  note[12,10,0]  𝄀
1  ¦  green  ¦  3  ¦  keep  𝄀
2  ¦  red  ¦  1  ¦  upd  𝄀
3  ¦    ¦  0  ¦  err
select id,note from t29923_dup order by id;
➤ id[4,32,0]  ¦  note[4,32,0]  𝄀
1  ¦  1  𝄀
2  ¦  1
drop table t29923_dup;
drop table t29923_src;
drop table t29923_dst;
drop table if exists t29923_identity_peer;
drop table if exists t29923_identity_src;
drop table if exists t29923_identity_dst;
create table t29923_identity_src(id int primary key,e enum('','red'),s set('','a'));
create table t29923_identity_dst(id int primary key,e enum('','red'),s set('','a'));
create table t29923_identity_peer(id int primary key);
insert ignore into t29923_identity_src values(1,'invalid',0);
insert into t29923_identity_src values(2,'',1),(3,NULL,NULL);
insert into t29923_identity_dst values(1,'red','a'),(2,'red','a'),(3,'red','a'),(4,'red','a');
insert into t29923_identity_peer values(1),(2),(3),(4);
update t29923_identity_dst d join
(select a.id,a.e,a.s from t29923_identity_src a join t29923_identity_peer p on a.id=p.id) x
on d.id=x.id set d.e=x.e,d.s=x.s;
select id,cast(e as unsigned) e_idx,cast(s as unsigned) s_bits from t29923_identity_dst order by id;
➤ id[4,32,0]  ¦  e_idx[-5,64,0]  ¦  s_bits[-5,64,0]  𝄀
1  ¦  0  ¦  0  𝄀
2  ¦  1  ¦  1  𝄀
3  ¦  null  ¦  null  𝄀
4  ¦  2  ¦  2
update t29923_identity_dst d join
(select p.id,a.e,a.s from t29923_identity_peer p left join t29923_identity_src a on a.id=p.id) x
on d.id=x.id set d.e=x.e,d.s=x.s;
select id,cast(e as unsigned) e_idx,cast(s as unsigned) s_bits from t29923_identity_dst order by id;
➤ id[4,32,0]  ¦  e_idx[-5,64,0]  ¦  s_bits[-5,64,0]  𝄀
1  ¦  0  ¦  0  𝄀
2  ¦  1  ¦  1  𝄀
3  ¦  null  ¦  null  𝄀
4  ¦  null  ¦  null
drop table t29923_identity_peer;
drop table t29923_identity_src;
drop table t29923_identity_dst;
