4  ¦  null  ¦  null  𝄀
5  ¦  null  ¦  null  𝄀
6  ¦  50  ¦  50
select id,
nth_value(v, 2) from first over (
partition by g order by ordv, id
rows between unbounded preceding and unbounded following
) explicit_nth,
nth_value(v, 2) over (
partition by g order by ordv, id
rows between unbounded preceding and unbounded following
) default_nth
from t order by id;
