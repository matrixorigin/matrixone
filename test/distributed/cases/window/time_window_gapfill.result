create table hf_scale_boundaries(
id int,
ts0 datetime,
ts3 datetime(3),
ts6 datetime(6)
);
insert into hf_scale_boundaries values
(1, '2026-08-12 10:00:00', '2026-08-12 10:00:00.123', '2026-08-12 10:00:00.123456');
select 'dt0' as scale_case, _wstart, _wend, timestampdiff(microsecond, _wstart, _wend) as width_us
from hf_scale_boundaries
where id = 1
group by id interval(ts0, 1, microsecond)
order by _wstart;
➤ scale_case[12,3,0]  ¦  _wstart[93,64,6]  ¦  _wend[93,64,6]  ¦  width_us[-5,64,0]  𝄀
dt0  ¦  2026-08-12 10:00:00  ¦  2026-08-12 10:00:00.000001000  ¦  1
select 'dt3' as scale_case, _wstart, _wend, timestampdiff(microsecond, _wstart, _wend) as width_us
from hf_scale_boundaries
where id = 1
group by id interval(ts3, 1, microsecond)
order by _wstart;
➤ scale_case[12,3,0]  ¦  _wstart[93,64,6]  ¦  _wend[93,64,6]  ¦  width_us[-5,64,0]  𝄀
dt3  ¦  2026-08-12 10:00:00.123000000  ¦  2026-08-12 10:00:00.123001000  ¦  1
select 'dt6' as scale_case, _wstart, _wend, timestampdiff(microsecond, _wstart, _wend) as width_us
from hf_scale_boundaries
where id = 1
group by id interval(ts6, 1, microsecond)
order by _wstart;
➤ scale_case[12,3,0]  ¦  _wstart[93,64,6]  ¦  _wend[93,64,6]  ¦  width_us[-5,64,0]  𝄀
