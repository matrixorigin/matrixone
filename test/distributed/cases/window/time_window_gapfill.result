p3  ¦  2026-01-02 00:01:00  ¦  30
select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(next)
order by pump, _wstart;
➤ pump[12,-1,0]  ¦  _wstart[93,64,0]  ¦  value_sum[3,38,0]  𝄀
p1  ¦  2026-01-01 10:00:00  ¦  1  𝄀
p1  ¦  2026-01-01 10:01:00  ¦  3  𝄀
p1  ¦  2026-01-01 10:02:00  ¦  3  𝄀
