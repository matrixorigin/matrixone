create table hf_scale_materialized as
select _wstart, _wend, count(*) as row_count
from hf_scale_boundaries
where id = 1
group by id interval(ts0, 1, microsecond);
select column_name, column_type
from information_schema.columns
where table_schema = database() and table_name = 'hf_scale_materialized'
and column_name in ('_wstart', '_wend')
order by ordinal_position;
➤ column_name[12,-1,0]  ¦  column_type[12,-1,0]  𝄀
_wstart  ¦  DATETIME(6)  𝄀
_wend  ¦  DATETIME(6)
drop table hf_scale_materialized;
drop table hf_scale_boundaries;
drop table hf_readings;
set time_zone = 'SYSTEM';
create table bounded_readings(device varchar(8), event_ts datetime, value int);
