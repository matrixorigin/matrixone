1  ¦  null  ¦  null  𝄀
2  ¦  2.0  ¦  1  𝄀
3  ¦  4.0  ¦  2  𝄀
4  ¦  4.0  ¦  2  𝄀
5  ¦  null  ¦  null  𝄀
6  ¦  -1.0  ¦  1
select a.id, a.v,
case when a.v is null then null
else 1+sum(case when b.v<a.v then 1 else 0 end) end as control_rank
from local_rank_src a join local_rank_src b
on b.id between a.id-2 and a.id
group by a.id, a.v
order by a.id;
