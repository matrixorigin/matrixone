drop database if exists mysql_compat_window_nth_value_arg;
create database mysql_compat_window_nth_value_arg;
use mysql_compat_window_nth_value_arg;
create table t (id int primary key, grp varchar(8), txt text);
insert into t values
(1,'A','alpha'),(2,'A','beta'),(3,'A','gamma'),
(4,'B','delta'),(5,'B','epsilon');
select nth_value(txt, id - 1) over (
partition by grp order by id
rows between unbounded preceding and unbounded following
) nth_txt
from t;
Incorrect arguments to nth_value
select nth_value(txt, 0) over (
partition by grp order by id
rows between unbounded preceding and unbounded following
) nth_txt
from t;
Incorrect arguments to nth_value
select id, nth_value(id, 1 + 1) over (
partition by grp order by id
rows between unbounded preceding and unbounded following
) nth_id
from t order by grp, id;
➤ id[4,32,0]  ¦  nth_id[4,32,0]  𝄀
1  ¦  2  𝄀
2  ¦  2  𝄀
3  ¦  2  𝄀
4  ¦  5  𝄀
5  ¦  5
select id, nth_value(id, bit_count('3 ')) over (partition by grp order by id rows between unbounded preceding and unbounded following) nth_id from t order by grp, id;
➤ id[4,32,0]  ¦  nth_id[4,32,0]  𝄀
1  ¦  2  𝄀
2  ¦  2  𝄀
3  ¦  2  𝄀
4  ¦  5  𝄀
5  ¦  5
show count(*) warnings;
➤ @@session.warning_count[-5,0,0]  𝄀
0
select nth_value(1, bit_count('3 ')) over (order by 1) is null as missing_second;
➤ missing_second[-7,1,0]  𝄀
1
select nth_value(id, bit_count('3x')) over (order by id) from t;
Incorrect arguments to nth_value
select bit_count('3x') as bits;
➤ bits[-5,64,0]  𝄀
2
show count(*) warnings;
➤ @@session.warning_count[-5,0,0]  𝄀
1
prepare nth_param from 'select id, nth_value(id, ?) over (
partition by grp order by id
rows between unbounded preceding and unbounded following
) nth_id from t order by grp, id';
set @nth_offset = 2;
execute nth_param using @nth_offset;
➤ id[4,32,0]  ¦  nth_id[4,32,0]  𝄀
1  ¦  2  𝄀
2  ¦  2  𝄀
3  ¦  2  𝄀
4  ¦  5  𝄀
5  ¦  5
set @nth_offset = 0;
execute nth_param using @nth_offset;
Incorrect arguments to nth_value
set @nth_offset = -1;
execute nth_param using @nth_offset;
Incorrect arguments to nth_value
set @nth_offset = null;
execute nth_param using @nth_offset;
Incorrect arguments to nth_value
set @nth_offset = 2.5;
execute nth_param using @nth_offset;
Incorrect arguments to nth_value
set @nth_offset = '2';
execute nth_param using @nth_offset;
Incorrect arguments to nth_value
set @nth_offset = 1;
execute nth_param using @nth_offset;
➤ id[4,32,0]  ¦  nth_id[4,32,0]  𝄀
1  ¦  1  𝄀
2  ¦  1  𝄀
3  ¦  1  𝄀
4  ¦  4  𝄀
5  ¦  4
deallocate prepare nth_param;
drop database mysql_compat_window_nth_value_arg;
