id  ¦  int  ¦  NO  ¦    ¦  null  ¦    ¦    𝄀
lg  ¦  varchar(12)  ¦  YES  ¦    ¦  null  ¦    ¦  
select * from wcopy order by id;
➤ id[4,32,0]  ¦  lg[12,12,0]  𝄀
1  ¦  long default  𝄀
2  ¦  a  𝄀
3  ¦  b
create view wv as
select id, lag(v, 1, 0.5) over (order by id) as lv from wdefault;
show columns from wv;
➤ Field[1,0,0]  ¦  Type[1,0,0]  ¦  Null[1,0,0]  ¦  Key[1,0,0]  ¦  Default[1,0,0]  ¦  Extra[1,0,0]  ¦  Comment[1,0,0]  𝄀
id  ¦  int  ¦  NO  ¦    ¦  null  ¦    ¦    𝄀
lv  ¦  decimal(11,1)  ¦  YES  ¦    ¦  null  ¦    ¦  
