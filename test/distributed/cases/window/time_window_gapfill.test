drop database if exists time_window_gapfill_bvt;
create database time_window_gapfill_bvt;
use time_window_gapfill_bvt;

create table readings(pump varchar(8), ts datetime, value int);
insert into readings values
    ('p1', '2026-01-01 10:00:00', 1),
    ('p1', '2026-01-01 10:02:00', 3),
    ('p2', '2026-01-01 11:00:00', 7),
    ('p3', '2026-01-01 23:59:00', 10),
    ('p3', '2026-01-02 00:01:00', 30);

select pump, _wstart, _wend, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition)
order by pump, _wstart;

select pump, _wstart, coalesce(count(*), 0) as reading_count
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(null)
order by pump, _wstart;

select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(value, 99)
order by pump, _wstart;

select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(prev)
order by pump, _wstart;

select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(next)
order by pump, _wstart;

select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) gapfill(partition) fill(linear)
order by pump, _wstart;

# A maximal run of k missing buckets is divided into k+1 equal steps. All rows
# use one logical series key; no table-partition capability is involved.
create table linear_readings(series_id int, ts datetime, value int);
insert into linear_readings values
    (1, '2026-03-01 00:00:00', 100),
    (1, '2026-03-01 00:03:00', 130),
    (1, '2026-03-01 00:04:00', 140);

select _wstart, sum(value) as value_sum
from linear_readings
group by series_id interval(ts, 1, minute) gapfill(partition) fill(linear)
order by _wstart;

drop table linear_readings;

# Decimal256 is a planner-reachable LINEAR aggregate type. Exercise it through
# the SQL boundary so one-gap and multi-gap execution cannot diverge by type.
create table linear_decimal256(series_id int, ts datetime, value decimal(65,0));
insert into linear_decimal256 values
    (1, '2026-03-02 00:00:00', 100),
    (1, '2026-03-02 00:03:00', 130);

select _wstart, max(value) as value_max
from linear_decimal256
group by series_id interval(ts, 1, minute) gapfill(partition) fill(linear)
order by _wstart;

drop table linear_decimal256;

# Existing FILL(NULL) must not generate absent buckets.
select pump, _wstart, sum(value) as value_sum
from readings
group by pump interval(ts, 1, minute) fill(null)
order by pump, _wstart;

# Regression for #26786: a post-flush GAPFILL generation must not repeat the
# boundary window. Keep the assertion aggregated so the case does not emit
# thousands of detail rows.
create table boundary_readings(pump varchar(8), ts datetime, value int);
insert into boundary_readings values
    ('p8193', '2026-01-01 00:00:00', 1),
    ('p8193', '2026-01-06 16:33:00', 2),
    ('p8194', '2026-02-01 00:00:00', 3),
    ('p8194', '2026-02-06 16:34:00', 4);

select pump, count(*) as row_count, count(distinct _wstart) as distinct_windows
from (
    select pump, _wstart, sum(value) as value_sum
    from boundary_readings
    group by pump interval(ts, 1, minute) gapfill(partition)
) as windows
group by pump
order by pump;

select pump, count(*) as row_count, count(distinct _wstart) as distinct_windows
from (
    select pump, _wstart, sum(value) as value_sum
    from boundary_readings
    group by pump interval(ts, 1, minute) gapfill(partition) fill(next)
) as windows
group by pump
order by pump;

drop table boundary_readings;

set time_zone = '+08:00';

create table boundary_type_dt(k int, event_ts datetime, value int);
insert into boundary_type_dt values (1, '2026-01-01 00:00:01', 1);

select _wstart, count(*) as c
from boundary_type_dt
group by k interval(event_ts, 1, minute);

select min(ws), max(ws)
from (
    select _wstart as ws, count(*) as c
    from boundary_type_dt
    group by k interval(event_ts, 1, minute)
) as x;

create table boundary_type_rollup_dt as
select _wstart as ws, count(*) as c
from boundary_type_dt
group by k interval(event_ts, 1, minute);

select column_name, data_type, column_type
from information_schema.columns
where table_schema = database() and table_name = 'boundary_type_rollup_dt'
and column_name in ('ws', 'c')
order by ordinal_position;

select ws from boundary_type_rollup_dt;

create table boundary_type_date(k int, event_d date, value int);
insert into boundary_type_date values (1, '2026-01-01', 1);

select _wstart, _wend, count(*) as c
from boundary_type_date
group by k interval(event_d, 1, minute);

select min(ws), max(ws)
from (
    select _wstart as ws, count(*) as c
    from boundary_type_date
    group by k interval(event_d, 1, minute)
) as x;

create table boundary_type_rollup_date as
select _wstart as ws, _wend as we, count(*) as c
from boundary_type_date
group by k interval(event_d, 1, minute);

select column_name, data_type, column_type
from information_schema.columns
where table_schema = database() and table_name = 'boundary_type_rollup_date'
and column_name in ('ws', 'we', 'c')
order by ordinal_position;

select ws, we from boundary_type_rollup_date;

create table boundary_type_ts(k int, event_ts timestamp, value int);
insert into boundary_type_ts values (1, '2026-01-01 00:00:01', 1);

create table boundary_type_rollup_ts as
select _wstart as ws, count(*) as c
from boundary_type_ts
group by k interval(event_ts, 1, minute);

select column_name, data_type, column_type
from information_schema.columns
where table_schema = database() and table_name = 'boundary_type_rollup_ts'
and column_name in ('ws', 'c')
order by ordinal_position;

set time_zone = '+00:00';

drop database time_window_gapfill_bvt;
