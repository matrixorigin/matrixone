create table generated_source(a int, b int, doc json);
insert into generated_source values
(1, 2, '{"sku":"A"}'),
(3, 4, '{"sku":"B"}');
create table generated_stored(
a int,
b int,
g int generated always as (a + b) stored,
index ix_g(g)
) as select a, b from generated_source;
select g, a, b from generated_stored order by a;
➤ g[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
3  ¦  1  ¦  2  𝄀
7  ¦  3  ¦  4
create table generated_virtual(
a int,
b int,
g int generated always as (a * b) virtual
) as select a, b from generated_source where a > 1;
select g, a, b from generated_virtual order by a;
➤ g[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
12  ¦  3  ¦  4
create table generated_json(
a int,
b int,
doc json,
sku varchar(10) generated always as
(json_unquote(json_extract(doc, '$.sku'))) stored,
index ix_sku(sku)
) as select a, b, doc from generated_source;
select sku, a, b from generated_json order by a;
➤ sku[12,10,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
A  ¦  1  ¦  2  𝄀
B  ¦  3  ¦  4
create table generated_empty(
a int,
b int,
g int generated always as (a + b) stored
) as select a, b from generated_source where 1 = 0;
select count(*) from generated_empty;
➤ count(*)[-5,64,0]  𝄀
0
create table default_extra(extra int default 9, a int, b int)
as select a, b from generated_source;
select extra, a, b from default_extra order by a;
➤ extra[4,32,0]  ¦  a[4,32,0]  ¦  b[4,32,0]  𝄀
9  ¦  1  ¦  2  𝄀
9  ¦  3  ¦  4
create table generated_explicit(
a int,
b int,
g int generated always as (a + b) stored
) as select a, b, a + b as g from generated_source;
