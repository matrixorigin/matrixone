not supported: renaming PRIMARY index
alter table t rename index ua to `PRIMARY`;
not supported: renaming PRIMARY index
alter table t rename index ua to unused, add column x int;
not supported: RENAME INDEX combined with other ALTER operations
alter table t rename index ua to unused, algorithm=inplace;
invalid input: ALGORITHM=INPLACE is not supported. Reason: this operation requires ALGORITHM=COPY. Try ALGORITHM=COPY.
alter table t rename index ua to unused, lock=none;
invalid input: LOCK=NONE is not supported. Reason: COPY algorithm requires an exclusive lock. Try LOCK=SHARED.
alter table t rename index ua to ua, algorithm=copy;
select * from t order by id;
