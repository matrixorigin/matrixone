t_standalone  ¦  CREATE TABLE `t_standalone` (
  `lead` int DEFAULT 7,
  `id` int NOT NULL,
  `g` point NOT NULL,
  PRIMARY KEY (`id`),
  SPATIAL KEY `idx_g` (`g`)
)
create table t_empty(id int primary key, g point not null, key idx_g using rtree(g));
alter table t_empty algorithm=copy, add column lead int default 7 first;
