-- @suite
-- @case
-- @desc: pushed-scan result correctness for BlockIO tombstone visibility boundaries (#33159)
-- @label:bvt

-- Predicate pushdown reaches TAE BlockIO; this checks row visibility, not plan choice.

drop database if exists issue_33159_exact_scan;
create database issue_33159_exact_scan;
use issue_33159_exact_scan;

-- A full-block update leaves no visible row in the persisted old block.
create table full_update(id int primary key, bucket int);
insert into full_update select result, 42 from generate_series(1, 8192) g;
set @flush_result = (select mo_ctl('dn', 'flush', 'issue_33159_exact_scan.full_update'));
update full_update set bucket = 99;
select count(*) from full_update where bucket = 42;
select count(*) from full_update where bucket = 99;
select count(*) from full_update where bucket + 0 = 42;
select id, bucket from full_update where bucket = 42 order by id limit 5;

-- Partial tombstones are the nearest control: only 128 old rows are hidden.
create table partial_update(id int primary key, bucket int);
insert into partial_update select result, 42 from generate_series(1, 8192) g;
set @flush_result = (select mo_ctl('dn', 'flush', 'issue_33159_exact_scan.partial_update'));
update partial_update set bucket = 99 where id <= 128;
select count(*) from partial_update where bucket = 42;
select count(*) from partial_update where bucket = 99;

-- The first block is fully tombstoned while the second block remains live.
-- Exact scanning must skip the first block and still read the second one.
create table mixed_blocks(id int primary key, bucket int);
insert into mixed_blocks select result, 42 from generate_series(1, 16384) g;
set @flush_result = (select mo_ctl('dn', 'flush', 'issue_33159_exact_scan.mixed_blocks'));
update mixed_blocks set bucket = 99 where id <= 8192;
select count(*) from mixed_blocks where bucket = 42;
select count(*) from mixed_blocks where bucket = 99;

-- DELETE also creates tombstones; its visible result is the zero-row control.
create table full_delete(id int primary key, bucket int);
insert into full_delete select result, 42 from generate_series(1, 8192) g;
set @flush_result = (select mo_ctl('dn', 'flush', 'issue_33159_exact_scan.full_delete'));
delete from full_delete;
select count(*) from full_delete where bucket = 42;

drop database issue_33159_exact_scan;
