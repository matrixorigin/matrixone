select id, match(body) against('needle') > 0 as positive from rk where match(body) against('needle') order by match(body) against('needle') desc;
➤ id[-5,64,0]  ¦  positive[-6,8,0]  𝄀
11  ¦  1  𝄀
12  ¦  1  𝄀
