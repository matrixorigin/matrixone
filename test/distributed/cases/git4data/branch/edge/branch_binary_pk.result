data branch create table byte_pick from byte_base;
update byte_branch set v = v + 1;
data branch pick byte_branch into byte_pick keys(1, 2, 3, 4);
data branch diff byte_branch against byte_pick output count;
➤ COUNT(*)[-5,0,0]  𝄀
0
