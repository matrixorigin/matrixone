data branch create table pick_prepare from pick_base;
prepare p from 'data branch pick pick_src into pick_prepare keys(?)';
set @pick_key='2';
execute p using @pick_key;
select e+0,v from pick_prepare order by e+0;
➤ e + 0[-5,64,0]  ¦  v[4,32,0]  𝄀
