-- @suite
-- @setup
drop snapshot if exists issue32480_rebase_bf;
drop snapshot if exists issue32480_rebase_bu;
drop snapshot if exists issue32480_rebase_fh;
drop snapshot if exists issue32480_rebase_uh;
drop database if exists issue32480_rebase_result;
drop database if exists issue32480_rebase_feature;
drop database if exists issue32480_rebase_upstream;

-- @case
-- @desc:public database rebase replays independent feature and upstream changes
-- @label:bvt
create database issue32480_rebase_upstream;
create table issue32480_rebase_upstream.t(id int primary key, v int);
insert into issue32480_rebase_upstream.t values (1, 10);
create snapshot issue32480_rebase_bu for database issue32480_rebase_upstream;
data branch create database issue32480_rebase_feature from issue32480_rebase_upstream{snapshot='issue32480_rebase_bu'};
create snapshot issue32480_rebase_bf for database issue32480_rebase_feature;
update issue32480_rebase_feature.t set v = 11 where id = 1;
insert into issue32480_rebase_feature.t values (3, 30);
insert into issue32480_rebase_upstream.t values (2, 20);
create snapshot issue32480_rebase_fh for database issue32480_rebase_feature;
create snapshot issue32480_rebase_uh for database issue32480_rebase_upstream;
-- @ignore:1,3
data branch rebase database issue32480_rebase_result from issue32480_rebase_feature{snapshot='issue32480_rebase_fh'} against issue32480_rebase_upstream{snapshot='issue32480_rebase_uh'} between issue32480_rebase_feature{snapshot='issue32480_rebase_bf'} and issue32480_rebase_upstream{snapshot='issue32480_rebase_bu'} when conflict fail;
select id, v from issue32480_rebase_result.t order by id;
drop snapshot issue32480_rebase_bf;
drop snapshot issue32480_rebase_bu;
drop snapshot issue32480_rebase_fh;
drop snapshot issue32480_rebase_uh;
drop database issue32480_rebase_result;
drop database issue32480_rebase_feature;
drop database issue32480_rebase_upstream;
