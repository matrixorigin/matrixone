delete from m1;
insert into m1 values (1,'x');
insert into m2 values (5,'postmerge');
data branch pick m2 into m1 keys (5);
select k, v from m1 order by k;
➤ k[4,32,0]  ¦  v[12,10,0]  𝄀
1  ¦  x  𝄀
