drop account if exists lifecycle_bvt_acc;
create account lifecycle_bvt_acc admin_name = 'admin' identified by '111';
select mo_feature_registry_upsert(
'lifecycle',
'TAE object Lifecycle',
'{"archive_stages":[]}',
false
);
➤ mo_feature_registry_upsert(lifecycle, TAE object Lifecycle, {"archive_stages":[]}, false)[12,-1,0]  𝄀
{
  "now": {
    "feature_code": "LIFECYCLE",
    "description": "TAE object Lifecycle",
    "scope_spec": {
      "archive_stages": []
    },
    "enabled": false
  },
  "old": {
    "feature_code": "LIFECYCLE",
    "description": "TAE object lifecycle retirement",
    "scope_spec": {
      "archive_stages": []
    },
    "enabled": false
  }
}

drop database if exists lifecycle_bvt;
create database lifecycle_bvt;
use lifecycle_bvt;
create table events(
id bigint primary key,
created_at timestamp not null,
payload varchar(32)
);
alter table events set lifecycle (
column created_at,
expire after interval 7 day,
action delete
);
not supported: TAE object Lifecycle retirement is disabled by the cluster release gate
select mo_feature_registry_upsert(
'lifecycle',
'TAE object Lifecycle',
'{"archive_stages":[]}',
true
);
➤ mo_feature_registry_upsert(lifecycle, TAE object Lifecycle, {"archive_stages":[]}, true)[12,-1,0]  𝄀
