show lifecycle restores limit 1;
➤ restore_id[12,0,0]  ¦  scope[12,0,0]  ¦  dataset_count[-5,0,0]  ¦  source_logical_table_id[-5,0,0]  ¦  range_start[12,0,0]  ¦  range_end[12,0,0]  ¦  target_database_id[-5,0,0]  ¦  target_name[12,0,0]  ¦  state[12,0,0]  ¦  next_chunk_ordinal[-5,0,0]  ¦  total_chunk_count[-5,0,0]  ¦  restored_rows[-5,0,0]  ¦  deadline[12,0,0]  ¦  last_error[12,0,0]  ¦  updated_at[12,0,0]
create table indexed_events(
id bigint primary key,
created_at timestamp not null,
key idx_created_at(created_at)
);
alter table indexed_events set lifecycle (
column created_at,
expire after interval 7 day,
action delete
);
not supported: Lifecycle on tables with secondary indexes
