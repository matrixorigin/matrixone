drop table if exists issue_28885_hll_nan_equivalence;
create table issue_28885_hll_nan_equivalence(v double);
insert into issue_28885_hll_nan_equivalence values
(bit_cast(unhex('000000000000f87f') as double)),
(bit_cast(unhex('010000000000f87f') as double)),
(bit_cast(unhex('0000000000000080') as double)),
(0.0),
(1.0);
select count(distinct v) as exact_count,
approx_count_distinct(v) as approx_count,
hll_cardinality(hll_add_agg(v)) as hll_count
from issue_28885_hll_nan_equivalence;
