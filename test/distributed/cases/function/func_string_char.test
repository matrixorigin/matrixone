# Basic test case from requirements
SELECT CHAR(65, 66, 67) AS result1;

# Additional test cases
SELECT CHAR(65) AS single_char;
SELECT CHAR(72, 101, 108, 108, 111) AS hello;
SELECT CHAR(48, 49, 50) AS digits;
SELECT CHAR(72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100) AS hello_world;

# Edge cases
SELECT CHAR(0) AS null_char;
SELECT CHAR(32) AS space;
SELECT CHAR(65, 66, 67, 68, 69) AS abcde;

# NULL handling (MySQL skips NULL arguments)
SELECT CHAR(65, 66, NULL) AS with_null;
SELECT CHAR(NULL, 66, 67) AS null_first;
SELECT CHAR(65, NULL, 67) AS null_middle;
SELECT CHAR(NULL, NULL) AS all_null;

# Non-integer arguments (MySQL coerces to integer)
SELECT HEX(CHAR(77, 77.3, '77.3')) AS char_noninteger;
SELECT HEX(CHAR(NULL, 65, 66)) AS char_skip_null;
SELECT CHAR(65.9, 66.1) AS float_arg;
SELECT CHAR('65', '66') AS string_arg;

# Multi-byte expansion (MySQL: CHAR(256) → 0x0100)
SELECT HEX(CHAR(256)) AS char_256;
SELECT HEX(CHAR(65536)) AS char_65536;
SELECT HEX(CHAR(-1)) AS char_neg1;
SELECT HEX(CHAR('256')) AS char_str256;
SELECT CHAR(NULL) AS single_null;

# String arguments with leading numeric prefix (MySQL parses leading digits)
SELECT HEX(CHAR('65xyz')) AS char_prefix_num;
SELECT HEX(CHAR('9007199254740993')) AS char_large_int_str;
SELECT HEX(CHAR('77abc')) AS char_mixed_str;

# Binary hex/bit literals (MySQL interprets raw bytes as big-endian integer)
SELECT HEX(CHAR(0x41)) AS char_hex_lit;
SELECT HEX(CHAR(0x0100)) AS char_hex_multi;
SELECT HEX(CHAR(b'01000001')) AS char_bit_lit;

# Different integer types (should be cast to int64)
SELECT CHAR(CAST(65 AS INT), CAST(66 AS INT)) AS int_type;
SELECT CHAR(CAST(65 AS BIGINT), CAST(66 AS BIGINT)) AS bigint_type;

# Table usage
CREATE TABLE t1(a INT, b INT, c INT);
INSERT INTO t1 VALUES (65, 66, 67), (72, 101, 108), (48, 49, 50);
SELECT a, b, c, CHAR(a, b, c) AS char_result FROM t1;
DROP TABLE t1;

# WHERE clause
CREATE TABLE t1(a INT, b INT, c INT);
INSERT INTO t1 VALUES (65, 66, 67), (72, 101, 108), (48, 49, 50);
SELECT * FROM t1 WHERE CHAR(a, b, c) = 'ABC';
DROP TABLE t1;

# Nullable column NULL path (MySQL skips NULL per row)
CREATE TABLE t2(a INT, b INT);
INSERT INTO t2 VALUES (65, 66), (NULL, 67), (68, NULL), (NULL, NULL);
SELECT a, b, CHAR(a, b) AS char_nullable FROM t2;
DROP TABLE t2;

# Prepared numeric context and BOOL compatibility (issues #28454 and #28456).
# Reuse one SQL PREPARE plan across DECIMAL, string-backed numeric and BOOL
# values; direct string CHAR must keep its prefix-truncation contract.
PREPARE p_char_issue_28454 FROM 'SELECT HEX(CHAR(?)) AS char_value';
SET @char_value_issue_28454 = 65.5;
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = 64.5;
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = '65.5';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = TRUE;
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = 'abc';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = '9007199254740993';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = '65.5xyz';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = 64.5e0;
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = 65.5e0;
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = '64.5e0';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
SET @char_value_issue_28454 = '65.5e1';
EXECUTE p_char_issue_28454 USING @char_value_issue_28454;
DEALLOCATE PREPARE p_char_issue_28454;

SELECT HEX(CHAR(TRUE)) AS direct_bool;
SELECT HEX(CHAR(FALSE)) AS direct_false;
SELECT HEX(CHAR(1 = 1)) AS direct_bool_expression_true;
SELECT HEX(CHAR(1 = 0)) AS direct_bool_expression_false;
SELECT HEX(CHAR('65.5')) AS direct_string;
SELECT HEX(CHAR(64.5e0)) AS direct_double_even_low;
SELECT HEX(CHAR(65.5e0)) AS direct_double_even_high;
SELECT HEX(CHAR(-64.5e0)) AS direct_double_even_negative;

DROP TABLE IF EXISTS char_bool_28456;
CREATE TABLE char_bool_28456(id INT PRIMARY KEY, b BOOLEAN);
INSERT INTO char_bool_28456 VALUES (1, TRUE), (2, FALSE), (3, NULL);
SELECT id, HEX(CHAR(b)) AS bool_column FROM char_bool_28456 ORDER BY id;
SET @char_bool_issue_28456 = TRUE;
SELECT HEX(CHAR(@char_bool_issue_28456)) AS bool_user_variable;
DROP TABLE char_bool_28456;
