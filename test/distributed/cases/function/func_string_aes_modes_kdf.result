SELECT HEX(AES_DECRYPT(UNHEX('97a7843feae0450b9443a1fe8f0c43ebb4e57d59cc0c60e7b380'), '0123456789abcdef01234567', '0123456789abcdefignored')) AS plaintext;
plaintext
4D61747269784F6E652041455300FF73747265616D2D6D6F6465
SELECT LENGTH(AES_ENCRYPT('', 'key', '0123456789abcdef')) AS empty_length;
empty_length
0
