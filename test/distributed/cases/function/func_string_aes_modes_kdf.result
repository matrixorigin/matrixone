SET block_encryption_mode = 'aes-256-ofb';
SELECT HEX(AES_ENCRYPT(UNHEX('4d61747269784f6e652041455300ff73747265616d2d6d6f6465'), '0123456789abcdef0123456789abcdef', '0123456789abcdef')) AS ofb;
