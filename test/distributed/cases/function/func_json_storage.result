drop database if exists json_storage_28034_db;
create database json_storage_28034_db;
use json_storage_28034_db;
drop table if exists json_storage_28034;
create table json_storage_28034 (id int primary key, j json, s varchar(128));
insert into json_storage_28034 values
(1, 'null', 'null'),
(2, 'true', 'true'),
(3, '"x"', '"x"'),
(4, '[]', '[]'),
(5, '{}', '{}'),
(6, '[1,2,3]', '[1,2,3]'),
(7, '{"a":1}', '{"a":1}'),
(8, null, null);
select id, json_storage_size(j), json_storage_size(s), json_storage_free(j), json_storage_free(s)
from json_storage_28034 order by id;
id	json_storage_size(j)	json_storage_size(s)	json_storage_free(j)	json_storage_free(s)
