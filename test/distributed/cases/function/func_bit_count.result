DROP TABLE IF EXISTS t_bit_count_special;
CREATE TABLE t_bit_count_special(id INT PRIMARY KEY, e ENUM('zero','one','two','three','8'), s SET('a','b','c','d'));
INSERT INTO t_bit_count_special VALUES (1,'one','a,c'),(2,'two','b,d'),(3,'three',''),(4,NULL,NULL),(5,'8','a,b,d'),(6,'zero','d'),(7,'zero','a');
SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(e+0) AS enum_numeric_bits, BIT_COUNT(s) AS set_bits, BIT_COUNT(s+0) AS set_numeric_bits FROM t_bit_count_special ORDER BY id;
id    enum_bits    enum_numeric_bits    set_bits    set_numeric_bits
1    1    1    2    2
2    2    2    2    2
3    1    1    0    0
4    null    null    null    null
5    2    2    3    3
6    1    1    1    1
7    1    1    1    1
SELECT id FROM t_bit_count_special WHERE BIT_COUNT(s)=2 ORDER BY id;
id
1
2
SELECT id, BIT_COUNT(CAST(e AS CHAR)) AS cast_bits, BIT_COUNT(CONCAT(e,'')) AS concat_bits, BIT_COUNT(CAST(s AS CHAR)) AS set_text_bits FROM t_bit_count_special WHERE id IN (5,6) ORDER BY id;
id    cast_bits    concat_bits    set_text_bits
5    1    1    0
6    0    0    0
SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(s) AS set_bits FROM (SELECT id,e,s FROM t_bit_count_special) d ORDER BY id;
id    enum_bits    set_bits
1    1    2
2    2    2
3    1    0
4    null    null
5    2    3
6    1    1
7    1    1
SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(s) AS set_bits FROM (SELECT id,e,s FROM t_bit_count_special ORDER BY id LIMIT 2) d ORDER BY id;
id    enum_bits    set_bits
1    1    2
2    2    2
SELECT s, BIT_COUNT(s) AS bits FROM t_bit_count_special GROUP BY s HAVING BIT_COUNT(s)=2 ORDER BY s;
s    bits
a,c    2
b,d    2
DROP TABLE IF EXISTS t_bit_count_materialized;
CREATE TABLE t_bit_count_materialized AS SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(s) AS set_bits FROM t_bit_count_special;
SELECT * FROM t_bit_count_materialized ORDER BY id;
id    enum_bits    set_bits
1    1    2
2    2    2
3    1    0
4    null    null
5    2    3
6    1    1
7    1    1
DROP TABLE t_bit_count_materialized;
PREPARE bit_count_special FROM 'SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(s) AS set_bits FROM t_bit_count_special WHERE id >= ? ORDER BY id';
SET @bit_count_min_id = 5;
EXECUTE bit_count_special USING @bit_count_min_id;
id    enum_bits    set_bits
5    2    3
6    1    1
7    1    1
DEALLOCATE PREPARE bit_count_special;
DROP TABLE t_bit_count_special;
