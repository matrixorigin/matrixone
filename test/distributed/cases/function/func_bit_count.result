SET @bit_count_saved_mode = @@session.sql_mode;
SET @bit_count_saved_zone = @@session.time_zone;
SET SESSION sql_mode = '';
SET SESSION time_zone = '+00:00';
DROP TABLE IF EXISTS t_bit_count_join_right;
DROP TABLE IF EXISTS t_bit_count_join_left;
CREATE TABLE t_bit_count_join_left (id INT PRIMARY KEY, flag INT, d DOUBLE);
CREATE TABLE t_bit_count_join_right (
id INT PRIMARY KEY, ts TIMESTAMP NOT NULL,
g VARCHAR(8) AS (IF(DATE(ts)='2024-03-01','match','other')) VIRTUAL
);
INSERT INTO t_bit_count_join_left VALUES (1,NULL,3.9),(2,1,3.9);
INSERT INTO t_bit_count_join_right(id,ts) VALUES (1,'2024-03-01 12:00:00'),(2,'2024-03-01 12:00:00');
SELECT COUNT(*) AS groups_seen,
COUNT(CASE WHEN (flag IS NULL AND ga='match' AND gb IS NULL AND n=2)
OR (flag=1 AND ga IS NULL AND gb='match' AND n=1) THEN 1 END) AS coherent_groups
FROM (
SELECT l.flag, a.g AS ga, b.g AS gb, BIT_COUNT(IF(l.flag=1,l.d,CAST(l.d AS DOUBLE))) AS n
FROM t_bit_count_join_left l
LEFT JOIN t_bit_count_join_right a ON l.id=a.id AND l.flag IS NULL
LEFT JOIN t_bit_count_join_right b ON l.id=b.id AND l.flag=1
GROUP BY IF(l.flag=1,l.d,CAST(l.d AS DOUBLE))
HAVING (l.flag IS NULL AND a.g='match' AND b.g IS NULL) OR (l.flag=1 AND a.g IS NULL AND b.g='match')
) s;
➤ groups_seen[-5,64,0]  ¦  coherent_groups[-5,64,0]  𝄀
1  ¦  1
