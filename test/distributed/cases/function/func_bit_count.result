SELECT 'true filter', BIT_COUNT(x) AS bits, z FROM (
SELECT CAST(o.d AS DOUBLE) AS x, o.id IN (SELECT 1 WHERE 1=1) AS z
FROM t_bit_count_float o WHERE o.id = 1
) s;
