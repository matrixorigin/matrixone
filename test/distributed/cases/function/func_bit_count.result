DROP TABLE IF EXISTS t_bit_count;
CREATE TABLE t_bit_count(
id INT,
i BIGINT,
u BIGINT UNSIGNED,
s VARCHAR(10),
b VARBINARY(4)
);
INSERT INTO t_bit_count VALUES
(1, 64, 64, '64', X'40'),
(2, -1, 255, '-1', X'FF'),
(3, NULL, NULL, NULL, NULL),
(4, 64, 64, '64', _binary 0x40);
SELECT id, BIT_COUNT(i), BIT_COUNT(u), BIT_COUNT(s), BIT_COUNT(b) FROM t_bit_count ORDER BY id;
➤ id[4,32,0]  ¦  BIT_COUNT(i)[-5,64,0]  ¦  BIT_COUNT(u)[-5,64,0]  ¦  BIT_COUNT(s)[-5,64,0]  ¦  BIT_COUNT(b)[-5,64,0]  𝄀
1  ¦  1  ¦  1  ¦  1  ¦  1  𝄀
2  ¦  64  ¦  8  ¦  64  ¦  8  𝄀
3  ¦  null  ¦  null  ¦  null  ¦  null  𝄀
4  ¦  1  ¦  1  ¦  1  ¦  1
SELECT id FROM t_bit_count WHERE BIT_COUNT(b) = 1 ORDER BY id;
➤ id[4,32,0]  𝄀
1  𝄀
4
DROP TABLE t_bit_count;
SELECT BIT_COUNT('abc') AS nonnumeric,
BIT_COUNT('12x') AS numeric_prefix,
BIT_COUNT('1.9') AS decimal_prefix,
BIT_COUNT('-12x') AS negative_prefix,
BIT_COUNT('+x') AS sign_without_digits;
nonnumeric    numeric_prefix    decimal_prefix    negative_prefix    sign_without_digits
0    2    1    61    0
DROP TABLE IF EXISTS t_bit_count_coercion;
CREATE TABLE t_bit_count_coercion(id INT PRIMARY KEY, v VARCHAR(20));
INSERT INTO t_bit_count_coercion VALUES (1, 'abc'), (2, '12x'), (3, ''), (4, NULL);
SELECT id, BIT_COUNT(v) AS bits FROM t_bit_count_coercion ORDER BY id;
id    bits
1    0
2    2
3    0
4    null
DROP TABLE t_bit_count_coercion;
PREPARE bit_count_marker FROM 'SELECT BIT_COUNT(?)';
SET @bit_count_value = '64';
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
7
SET @bit_count_value = 64;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
1
SET @bit_count_value = 64.5;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
2
SET @bit_count_value = CAST('64' AS BINARY);
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
1
SET @bit_count_value = NULL;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
null
DEALLOCATE PREPARE bit_count_marker;
DROP TABLE IF EXISTS t_bit_count_special;
CREATE TABLE t_bit_count_special(id INT PRIMARY KEY, e ENUM('zero','one','two','three','8'), s SET('a','b','c','d'));
INSERT INTO t_bit_count_special VALUES (1,'one','a,c'),(2,'two','b,d'),(3,'three',''),(4,NULL,NULL),(5,'8','a,b,d'),(6,'zero','d'),(7,'zero','a');
SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(e+0) AS enum_numeric_bits, BIT_COUNT(s) AS set_bits, BIT_COUNT(s+0) AS set_numeric_bits FROM t_bit_count_special ORDER BY id;
id    enum_bits    enum_numeric_bits    set_bits    set_numeric_bits
1    1    1    2    2
2    2    2    2    2
3    1    1    0    0
4    null    null    null    null
5    2    2    3    3
6    1    1    1    1
7    1    1    1    1
SELECT id FROM t_bit_count_special WHERE BIT_COUNT(s)=2 ORDER BY id;
id
1
2
SELECT id, BIT_COUNT(CAST(e AS CHAR)) AS cast_bits, BIT_COUNT(CONCAT(e,'')) AS concat_bits, BIT_COUNT(CAST(s AS CHAR)) AS set_text_bits FROM t_bit_count_special WHERE id IN (5,6) ORDER BY id;
id    cast_bits    concat_bits    set_text_bits
5    1    1    0
6    0    0    0
SELECT id, BIT_COUNT(e) AS enum_bits, BIT_COUNT(s) AS set_bits FROM (SELECT id,e,s FROM t_bit_count_special) d ORDER BY id;
id    enum_bits    set_bits
1    1    2
2    2    2
3    1    0
4    null    null
