DROP TABLE t_bit_count_coercion;
PREPARE bit_count_marker FROM 'SELECT BIT_COUNT(?)';
SET @bit_count_value = '64';
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
7
SET @bit_count_value = 64;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
1
SET @bit_count_value = 64.5;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
2
SET @bit_count_value = CAST('64' AS BINARY);
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
1
SET @bit_count_value = NULL;
EXECUTE bit_count_marker USING @bit_count_value;
bit_count(?)
null
DEALLOCATE PREPARE bit_count_marker;
PREPARE bit_count_signed_marker FROM 'SELECT BIT_COUNT(?)';
SET @bit_count_value = '64';
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
7
SET @bit_count_value = 64;
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
1
SET @bit_count_value = '1e2';
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
3
SHOW WARNINGS;
➤ Level[12,0,0]  ¦  Code[5,0,0]  ¦  Message[12,0,0]
SET @bit_count_value = '2.5';
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
2
SHOW WARNINGS;
➤ Level[12,0,0]  ¦  Code[5,0,0]  ¦  Message[12,0,0]
SET @bit_count_value = '1.9x';
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
1
SHOW WARNINGS;
➤ Level[12,0,0]  ¦  Code[5,0,0]  ¦  Message[12,0,0]  𝄀
Warning  ¦  1292  ¦  Truncated incorrect INTEGER value: '1.9x'
SET @bit_count_value = 'abc';
EXECUTE bit_count_signed_marker USING @bit_count_value;
➤ BIT_COUNT(?)[-5,64,0]  𝄀
