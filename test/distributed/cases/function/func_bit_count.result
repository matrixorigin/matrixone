SELECT 'unreachable branch', BIT_COUNT(x) AS bits, z FROM (
SELECT CAST(o.d AS DOUBLE) AS x,
o.id IN (SELECT 1 WHERE LENGTH(LPAD('a',CASE WHEN 1=1 THEN 4 ELSE CAST(-1 AS UNSIGNED) END,'b'))=4) AS z
FROM t_bit_count_float o WHERE o.id = 1
) s;
