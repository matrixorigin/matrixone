drop database if exists merge_settings_commit;
create database merge_settings_commit;
create table merge_settings_commit.t1(a int primary key);
insert into mo_catalog.mo_merge_settings (account_id, tid, version, settings, extra_info)
select 0, t.rel_id, 0,
json_set((select settings from mo_catalog.mo_merge_settings where account_id = 0 and tid = 0), '$."l0-max-count-start"', 32), ''
from mo_catalog.mo_tables t
where t.reldatabase = 'merge_settings_commit' and t.relname = 't1';
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.t1'), 'LayerZeroOpts{S: 32') > 0 as applied;
