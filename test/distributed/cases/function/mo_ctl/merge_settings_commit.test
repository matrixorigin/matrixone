drop database if exists merge_settings_commit;
create database merge_settings_commit;
-- Keep the fixture independent of the optional account-wide default row.
create table merge_settings_commit.settings_template(settings json not null);
insert into merge_settings_commit.settings_template values
('{"vacuum-top-k":10,"vacuum-score-start":60,"vacuum-score-end":10,"vacuum-score-decay-duration":"30m0s","l0-max-count-start":32,"l0-max-count-end":1,"l0-max-count-decay-duration":"1h0m0s","l0-max-count-decay-control":[0.7,0,0.1,1],"ln-start-lv":1,"ln-end-lv":7,"ln-min-point-depth-per-cluster":3,"tombstone-l1-size":"8MiB","tombstone-l1-count":4,"tombstone-l2-count":2}');
create table merge_settings_commit.t1(a int primary key);

insert into mo_catalog.mo_merge_settings (account_id, tid, version, settings, extra_info)
select 0, t.rel_id, 0,
       json_set((select settings from merge_settings_commit.settings_template), '$."l0-max-count-start"', 32), ''
from mo_catalog.mo_tables t
where t.reldatabase = 'merge_settings_commit' and t.relname = 't1';
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.t1'), 'LayerZeroOpts{S: 32') > 0 as applied;

begin;
create table merge_settings_commit.t2(a int primary key);
insert into mo_catalog.mo_merge_settings (account_id, tid, version, settings, extra_info)
select 0, t.rel_id, 0,
       json_set((select settings from merge_settings_commit.settings_template), '$."l0-max-count-start"', 44), ''
from mo_catalog.mo_tables t
where t.reldatabase = 'merge_settings_commit' and t.relname = 't2';
commit;
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.t2'), 'LayerZeroOpts{S: 44') > 0 as applied;

update mo_catalog.mo_merge_settings
set settings = json_set(settings, '$."l0-max-count-start"', 55)
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 't2');
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.t2'), 'LayerZeroOpts{S: 55') > 0 as applied;

delete from mo_catalog.mo_merge_settings
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 't2');
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.t2'), 'base trigger:') = 0 as cleared;

create table merge_settings_commit.abort_t(a int primary key);
set @issue29403_saved_session_isolation = @@session.transaction_isolation;
set session transaction_isolation = 'REPEATABLE-READ';
begin;
select count(*) as existing from mo_catalog.mo_merge_settings
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 'abort_t');
-- @session:id=1{
insert into mo_catalog.mo_merge_settings (account_id, tid, version, settings, extra_info)
select 0, t.rel_id, 0,
       json_set((select settings from merge_settings_commit.settings_template), '$."l0-max-count-start"', 77), ''
from mo_catalog.mo_tables t
where t.reldatabase = 'merge_settings_commit' and t.relname = 'abort_t';
-- @session}
insert into mo_catalog.mo_merge_settings (account_id, tid, version, settings, extra_info)
select 0, t.rel_id, 0,
       json_set((select settings from merge_settings_commit.settings_template), '$."l0-max-count-start"', 32), ''
from mo_catalog.mo_tables t
where t.reldatabase = 'merge_settings_commit' and t.relname = 'abort_t';
commit;
select json_extract(settings, '$."l0-max-count-start"') = 77 as catalog_kept_newer
from mo_catalog.mo_merge_settings
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 'abort_t');
select instr(mo_ctl('dn', 'inspect', 'merge show -t merge_settings_commit.abort_t'), 'LayerZeroOpts{S: 77') > 0 as scheduler_kept_newer;
delete from mo_catalog.mo_merge_settings
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 'abort_t');
delete from mo_catalog.mo_merge_settings
where tid = (select rel_id from mo_catalog.mo_tables
             where reldatabase = 'merge_settings_commit' and relname = 't1');
select count(*) as remaining from mo_catalog.mo_merge_settings s
join mo_catalog.mo_tables t on s.tid = t.rel_id
where t.reldatabase = 'merge_settings_commit';

set session transaction_isolation = @issue29403_saved_session_isolation;
drop database merge_settings_commit;
