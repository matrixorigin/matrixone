select count(*) as ctas_null_count from out_if where b is null;
➤ ctas_null_count[-5,64,0]  𝄀
1
prepare s from 'select length(if(id=0, null, cast(v as binary))) from src where id = ?';
set @a = 1;
execute s using @a;
