create table out_if as select if(id=0, null, cast(v as binary)) as b from src;
select length(b) as ctas_len, hex(b) as ctas_hex from out_if order by length(b), hex(b);
➤ ctas_len[-5,64,0]  ¦  ctas_hex[-1,16383,0]  𝄀
