-- @suite

-- @case
-- @desc: UNCOMPRESS returns NULL and emits bounded MySQL-compatible warnings for rejected inputs.
-- @label:bvt

-- Invalid UNCOMPRESS input remains NULL and reports the MySQL diagnostic.
-- Keep each SHOW WARNINGS adjacent to the expression whose diagnostics it checks.
SELECT UNCOMPRESS(x'00000000') IS NULL AS corrupt_input_is_null;
SHOW WARNINGS;

SELECT UNCOMPRESS(x'03000000789c00') IS NULL AS truncated_input_is_null;
SHOW WARNINGS;

SELECT UNCOMPRESS(x'ffffffff00') IS NULL AS oversized_input_is_null;
SHOW WARNINGS;

-- The zlib stream expands beyond its advertised output capacity: MySQL maps
-- Z_BUF_ERROR to warning 1258 and still returns NULL.
SELECT UNCOMPRESS(x'02000000789c4b4c4a0600024d0127') IS NULL AS output_capacity_is_null;
SHOW WARNINGS;

-- Verify row-wise evaluation and controls through a BLOB column. NULL, empty,
-- and valid zlib values do not warn; each rejected row contributes one warning.
DROP DATABASE IF EXISTS uncompress_warnings_28458;
CREATE DATABASE uncompress_warnings_28458;
CREATE TABLE uncompress_warnings_28458.cases(id INT PRIMARY KEY, compressed BLOB);
INSERT INTO uncompress_warnings_28458.cases VALUES
(1, x'00000000'),
(2, COMPRESS('ok')),
(3, NULL),
(4, COMPRESS('')),
(5, x'00000000');
SELECT id, UNCOMPRESS(compressed) IS NULL AS is_null
FROM uncompress_warnings_28458.cases ORDER BY id;
SHOW WARNINGS;
DROP DATABASE uncompress_warnings_28458;
SELECT COUNT(*) AS leftover_tables FROM information_schema.tables
WHERE table_schema = 'uncompress_warnings_28458';

-- UNCOMPRESSED_LENGTH keeps returning zero for short invalid inputs, but now
-- exposes one MySQL-compatible warning for each evaluated non-empty value.
SELECT UNCOMPRESSED_LENGTH(x'00') AS one_byte,
UNCOMPRESSED_LENGTH(x'000000') AS three_bytes,
UNCOMPRESSED_LENGTH(x'01000000') AS four_bytes;
SHOW COUNT(*) WARNINGS;
SHOW WARNINGS;

-- Empty, NULL, and valid compressed values remain warning-free.
SELECT UNCOMPRESSED_LENGTH(x'') AS empty_input,
UNCOMPRESSED_LENGTH(NULL) AS null_input,
UNCOMPRESSED_LENGTH(COMPRESS('abc')) AS valid_input;
SHOW COUNT(*) WARNINGS;

-- Warning-producing calls must execute for every prepared execution and every
-- selected row; constant folding must not consume or undercount diagnostics.
SET @short_compressed = x'00';
PREPARE short_length FROM 'SELECT UNCOMPRESSED_LENGTH(?) AS n';
EXECUTE short_length USING @short_compressed;
SHOW COUNT(*) WARNINGS;
EXECUTE short_length USING @short_compressed;
SHOW COUNT(*) WARNINGS;
DEALLOCATE PREPARE short_length;

DROP DATABASE IF EXISTS uncompress_length_warning_rows;
CREATE DATABASE uncompress_length_warning_rows;
CREATE TABLE uncompress_length_warning_rows.warning_rows(id INT PRIMARY KEY);
INSERT INTO uncompress_length_warning_rows.warning_rows VALUES (1), (2), (3);
PREPARE row_lengths FROM 'SELECT id, UNCOMPRESSED_LENGTH(?) AS n FROM uncompress_length_warning_rows.warning_rows ORDER BY id';
EXECUTE row_lengths USING @short_compressed;
SHOW COUNT(*) WARNINGS;
DEALLOCATE PREPARE row_lengths;
DROP DATABASE uncompress_length_warning_rows;
SELECT COUNT(*) AS leftover_tables FROM information_schema.tables
WHERE table_schema = 'uncompress_length_warning_rows';

-- An unselected branch must not emit the warning.
SELECT IF(FALSE, UNCOMPRESSED_LENGTH(x'00'), 7) AS chosen;
SHOW COUNT(*) WARNINGS;

-- Function-level warning accumulators inherit max_error_count and the shared
-- statement budget. The offset probe distinguishes a capacity above the
-- historical 1024-record fallback from a count-only warning total.
SET SESSION max_error_count = 2048;
SELECT SUM(UNCOMPRESSED_LENGTH(x'00')) AS warning_rows FROM generate_series(1, 1100) g;
SHOW COUNT(*) WARNINGS;
SHOW WARNINGS LIMIT 1024, 1;
SET SESSION max_error_count = 0;
SELECT SUM(UNCOMPRESSED_LENGTH(x'00')) AS warning_rows FROM generate_series(1, 3) g;
SHOW COUNT(*) WARNINGS;
SHOW WARNINGS;
SET SESSION max_error_count = 1024;
