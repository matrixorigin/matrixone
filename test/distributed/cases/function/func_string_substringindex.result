SELECT SUBSTRING_INDEX('a,b,c,d', ',', CAST(1.5 AS DECIMAL(4,1)));
substring_index(a,b,c,d, ,, cast(1.5 as decimal(4, 1)))
a,b
SELECT SUBSTRING_INDEX('a,b,c,d', ',', CAST(-1.5 AS DECIMAL(4,1)));
substring_index(a,b,c,d, ,, cast(-1.5 as decimal(4, 1)))
c,d
SELECT SUBSTRING_INDEX('a,b,c,d', ',', CAST(0.4999999999999999999999999999999999999 AS DECIMAL(38,37)));
