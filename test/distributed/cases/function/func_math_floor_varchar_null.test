# issue#28486: FLOOR must preserve NULL VARCHAR rows without parsing their payload.
drop database if exists floor_varchar_null_28486;
create database floor_varchar_null_28486;
use floor_varchar_null_28486;

# Typed NULL constant.
select floor(cast(null as char)) as typed_null;

# NULL at the first, middle, and last positions must retain row correspondence.
create table src(id int primary key, s varchar(20));
insert into src values (1,null),(2,'1.9'),(3,null),(4,'-1.1'),(5,null);
select id, floor(s) as floor_s from src order by id;

# CASE supplies a selection mask to FLOOR: only the NULL rows are evaluated.
select id, case when id in (1,3,5) then floor(s) else 99 end as selected_floor from src order by id;

# The all-NULL input vector retains one NULL result per source row.
select id, floor(s) as all_null from src where s is null order by id;

# SQL PREPARE binds a typed NULL through the character overload.
prepare floor_varchar_null_stmt from 'select floor(cast(? as char)) as prepared_null';
set @floor_varchar_null_arg = null;
execute floor_varchar_null_stmt using @floor_varchar_null_arg;
deallocate prepare floor_varchar_null_stmt;

# CTAS must retain NULL values and create the complete target table.
create table floor_varchar_null_copy as select id, floor(s) as v from src;
select id, v from floor_varchar_null_copy order by id;

drop database floor_varchar_null_28486;
