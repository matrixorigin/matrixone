drop table if exists t_qew_bvt;
create table t_qew_bvt(id int, gid int, v double, w double);
insert into t_qew_bvt values
(1, 1, cast(null as double), 1.0),
(2, 1, 2.0, 2.0),
(3, 1, 4.0, 1.0),
(4, 1, 4.0, 3.0),
(5, 1, cast(null as double), 1.0),
(6, 1, -1.0, 2.0);
select quantileExactWeighted(v, w, 0.5) as weighted_p50
from t_qew_bvt;
➤ weighted_p50[8,53,31]  𝄀
2.0
select percentile_cont(0.5) within group (order by v) as unweighted_control
from t_qew_bvt;
➤ unweighted_control[8,53,31]  𝄀
3.0
insert into t_qew_bvt values
(7, 2, 10.0, 1.0),
(8, 2, 20.0, 3.0),
(9, 2, 30.0, 1.0),
(10, 2, cast(null as double), 5.0),
(11, 3, 5.0, cast(null as double));
select gid, quantileExactWeighted(v, w, 0.5) as wp50
from t_qew_bvt
group by gid order by gid;
➤ gid[4,32,0]  ¦  wp50[8,53,31]  𝄀
1  ¦  2.0  𝄀
2  ¦  20.0  𝄀
3  ¦  null
select id, gid, quantileExactWeighted(v, w, 0.5) over (partition by gid) as wpart
from t_qew_bvt order by id;
➤ id[4,32,0]  ¦  gid[4,32,0]  ¦  wpart[8,53,31]  𝄀
1  ¦  1  ¦  2.0  𝄀
2  ¦  1  ¦  2.0  𝄀
3  ¦  1  ¦  2.0  𝄀
4  ¦  1  ¦  2.0  𝄀
5  ¦  1  ¦  2.0  𝄀
6  ¦  1  ¦  2.0  𝄀
7  ¦  2  ¦  20.0  𝄀
8  ¦  2  ¦  20.0  𝄀
9  ¦  2  ¦  20.0  𝄀
10  ¦  2  ¦  20.0  𝄀
11  ¦  3  ¦  null
drop table if exists t_qew_ties_bvt;
create table t_qew_ties_bvt(v double, w double);
insert into t_qew_ties_bvt values (5.0, 2.0), (5.0, 3.0), (9.0, 1.0);
select quantileExactWeighted(v, w, 0.5) as tie_p50 from t_qew_ties_bvt;
➤ tie_p50[8,53,31]  𝄀
5.0
select quantileExactWeighted(v, w, 0.9) as tie_p90 from t_qew_ties_bvt;
➤ tie_p90[8,53,31]  𝄀
9.0
drop table if exists t_qew_zero_bvt;
create table t_qew_zero_bvt(v double, w double);
insert into t_qew_zero_bvt values (1.0, 1.0), (9.0, 0.0);
select quantileExactWeighted(v, w, 1) as p100 from t_qew_zero_bvt;
➤ p100[8,53,31]  𝄀
1.0
drop table if exists t_qew_massless_bvt;
create table t_qew_massless_bvt(v double, w double);
insert into t_qew_massless_bvt values (0.0, 0.0), (5.0, 1.0);
select quantileExactWeighted(v, w, 0) as p0,
quantileExactWeighted(v, w, 0.5) as p50,
quantileExactWeighted(v, w, 1) as p100
from t_qew_massless_bvt;
➤ p0[8,53,31]  ¦  p50[8,53,31]  ¦  p100[8,53,31]  𝄀
0.0  ¦  5.0  ¦  5.0
