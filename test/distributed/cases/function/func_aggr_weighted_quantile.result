➤ distinct_p50[8,53,31]  𝄀
5.0
drop table if exists t_qew_typed_bvt;
create table t_qew_typed_bvt(
v bigint,
wu bigint unsigned,
wd decimal(20, 0) unsigned);
insert into t_qew_typed_bvt values
(1, 9007199254740993, 1),
(2, 9007199254740992, 2);
select quantileExactWeighted(v, wu, 0.5) as uint64_p50 from t_qew_typed_bvt;
➤ uint64_p50[-5,64,0]  𝄀
1
select quantileExactWeighted(v, wd, 0.5) as decimal_p50 from t_qew_typed_bvt;
➤ decimal_p50[-5,64,0]  𝄀
2
select quantileExactWeighted(v, 2, 0.5) as literal_uint_p50 from t_qew_typed_bvt;
➤ literal_uint_p50[-5,64,0]  𝄀
1
select quantileExactWeighted(id, w, 0.5) as value_is_int from t_qew_bvt;
➤ value_is_int[4,32,0]  𝄀
6
drop table if exists t_qew_frame_bvt;
create table t_qew_frame_bvt(id int, v double, w double);
insert into t_qew_frame_bvt values
(1, 1.0, 1.0), (2, 3.0, 1.0), (3, 5.0, 1.0), (4, 2.0, 1.0), (5, 9.0, 1.0);
select id,
quantileExactWeighted(v, w, 0.5) over (
order by id rows between 1 preceding and current row) as roll2
from t_qew_frame_bvt order by id;
➤ id[4,32,0]  ¦  roll2[8,53,31]  𝄀
1  ¦  1.0  𝄀
2  ¦  1.0  𝄀
3  ¦  3.0  𝄀
4  ¦  2.0  𝄀
5  ¦  2.0
select quantileExactWeighted(v, w, 1.5) as level_out_of_range from t_qew_bvt;
invalid input: percentile argument of quantileexactweighted must be finite and in [0,1], got 1.5
select quantileExactWeighted(v, w, -0.5) as level_negative from t_qew_bvt;
invalid input: percentile argument of quantileexactweighted must be finite and in [0,1], got -0.5
select quantileExactWeighted(v, 2.5, 0.5) as weight_fractional from t_qew_bvt;
invalid input: quantileExactWeighted: weight must be an integral value
select quantileExactWeighted(v, -1.0, 0.5) as weight_negative from t_qew_bvt;
invalid input: quantileExactWeighted: weight must be a non-negative integer
drop table if exists t_qew_dec256_bvt;
create table t_qew_dec256_bvt(v bigint, w decimal(65, 0));
select quantileExactWeighted(v, w, 0.5) as decimal256_weight from t_qew_dec256_bvt;
invalid argument aggregate function quantileexactweighted, bad value [BIGINT DECIMAL256 DECIMAL64]
drop table if exists t_qew_dec256_bvt;
prepare qew_level_p from
'select quantileExactWeighted(v, w, ?) as prepared_p from t_qew_bvt where gid = 1';
set @qew_level = 0.25;
execute qew_level_p using @qew_level;
➤ prepared_p[8,53,31]  𝄀
-1.0
set @qew_level = 0.75;
execute qew_level_p using @qew_level;
➤ prepared_p[8,53,31]  𝄀
4.0
deallocate prepare qew_level_p;
