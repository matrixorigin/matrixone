SELECT FORMAT_BYTES(CAST(1024 AS DECIMAL(20,2))) AS decimal_bytes, FORMAT_PICO_TIME(CAST(3501 AS DECIMAL(20,2))) AS decimal_time, FORMAT_BYTES('1024') AS text_bytes, FORMAT_PICO_TIME('1e9') AS text_time;
➤ decimal_bytes[12,65535,0]  ¦  decimal_time[12,65535,0]  ¦  text_bytes[12,65535,0]  ¦  text_time[12,65535,0]  𝄀
