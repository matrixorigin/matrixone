create table inet_ntoa_dml_contract (ip varchar(31));
prepare inet_ntoa_dml_insert from
'insert into inet_ntoa_dml_contract values (inet_ntoa(?))';
set @inet_insert_value = cast(1.6 as json);
execute inet_ntoa_dml_insert using @inet_insert_value;
set @inet_insert_value = '1.6';
execute inet_ntoa_dml_insert using @inet_insert_value;
