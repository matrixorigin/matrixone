drop database if exists expression_result_contracts;
create database expression_result_contracts;
use expression_result_contracts;
create table source (
txt varchar(512),
b varbinary(128),
t0 time(0),
t6 time(6),
dt0 datetime(0),
dt6 datetime(6),
ip varchar(32)
);
insert into source values
('abcdefghi', _binary 'abc', '00:00:00', '00:00:00.123456',
'2024-01-02 03:04:05', '2024-01-02 03:04:05.123456', '1.6'),
('short', _binary 'z', NULL, '00:00:01.654321',
NULL, '2024-01-02 03:04:06.654321', '1.6');
create table contract_ctas as
select to_base64(b) as b64,
substring(txt, 1, 7) as sub7,
left(txt, 7) as left7,
right(txt, 7) as right7,
coalesce(t0, t6) as coalesce_time,
ifnull(t0, t6) as ifnull_time,
if(dt0 is null, dt6, dt0) as if_datetime,
case when t0 is null then t6 else t0 end as case_time,
nullif(t0, t6) as nullif_time,
inet_ntoa(ip) as ip_text,
is_ipv4(ip) as ip_flag
from source;
select column_name, column_type, is_nullable
from information_schema.columns
where table_schema = database() and table_name = 'contract_ctas'
order by ordinal_position;
➤ column_name[12,256,0]  ¦  column_type[12,65535,0]  ¦  is_nullable[12,3,0]  𝄀
b64  ¦  VARCHAR(174)  ¦  YES  𝄀
sub7  ¦  VARCHAR(7)  ¦  YES  𝄀
left7  ¦  VARCHAR(7)  ¦  YES  𝄀
right7  ¦  VARCHAR(7)  ¦  YES  𝄀
coalesce_time  ¦  TIME(6)  ¦  YES  𝄀
ifnull_time  ¦  TIME(6)  ¦  YES  𝄀
if_datetime  ¦  DATETIME(6)  ¦  YES  𝄀
case_time  ¦  TIME(6)  ¦  YES  𝄀
nullif_time  ¦  TIME(0)  ¦  YES  𝄀
ip_text  ¦  VARCHAR(31)  ¦  YES  𝄀
ip_flag  ¦  INT  ¦  YES
select b64, sub7, left7, right7, coalesce_time, ifnull_time,
if_datetime, case_time, nullif_time, ip_text, ip_flag
from contract_ctas;
➤ b64[12,174,0]  ¦  sub7[12,7,0]  ¦  left7[12,7,0]  ¦  right7[12,7,0]  ¦  coalesce_time[92,17,0]  ¦  ifnull_time[92,17,0]  ¦  if_datetime[93,26,0]  ¦  case_time[92,17,0]  ¦  nullif_time[92,10,0]  ¦  ip_text[12,31,0]  ¦  ip_flag[4,32,0]  𝄀
YWJj  ¦  abcdefg  ¦  abcdefg  ¦  cdefghi  ¦  00:00:00  ¦  00:00:00  ¦  2024-01-02 03:04:05  ¦  00:00:00  ¦  00:00:00  ¦  0.0.0.1  ¦  0  𝄀
eg==  ¦  short  ¦  short  ¦  short  ¦  00:00:01.654321000  ¦  00:00:01.654321000  ¦  2024-01-02 03:04:06.654321000  ¦  00:00:01.654321000  ¦  null  ¦  0.0.0.1  ¦  0
create index idx_contract_b64 on contract_ctas (b64);
select count(*) as indexed_bounded_result
from mo_catalog.mo_indexes as i
join mo_catalog.mo_tables as t on i.table_id = t.rel_id
where t.reldatabase = database() and t.relname = 'contract_ctas'
and i.name = 'idx_contract_b64' and i.column_name = 'b64';
➤ indexed_bounded_result[-5,64,0]  𝄀
1
create view contract_view as
select to_base64(b) as b64,
substring(txt, 1, 7) as sub7,
left(txt, 7) as left7,
right(txt, 7) as right7,
coalesce(t0, t6) as coalesce_time,
ifnull(t0, t6) as ifnull_time,
if(dt0 is null, dt6, dt0) as if_datetime,
case when t0 is null then t6 else t0 end as case_time,
nullif(t0, t6) as nullif_time,
inet_ntoa(ip) as ip_text,
is_ipv4(ip) as ip_flag
from source;
select column_name, column_type, is_nullable
from information_schema.columns
where table_schema = database() and table_name = 'contract_view'
order by ordinal_position;
