create view slice_view as
select id, substring(txt, 1, 3) as sub3, substr(txt, 2, 3) as substr3,
mid(txt, 2, 3) as mid3, left(txt, 3) as left3, right(txt, 3) as right3,
substring(txt, 1, 100) as sub100,
nullif(t6, t0) as nt6, nullif(t0, t6) as nt0,
nullif(dt6, dt0) as nd6, nullif(dt0, dt6) as nd0
from slice_source;
create table slice_ctas as select * from slice_view;
