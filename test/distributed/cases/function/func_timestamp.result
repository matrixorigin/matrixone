2024-01-15 02:30:00.000456000  ¦  2024-01-15 12:30:00.123000000  ¦  2024-01-15 12:30:00.123456000
select timestamp(d, d) as date_date, timestamp(d, dt3) as date_datetime, timestamp(d, ts3) as date_timestamp from timestamp_pair_src;
