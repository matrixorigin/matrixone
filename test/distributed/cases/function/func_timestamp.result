create table timestamp_pair_ctas as select timestamp(d, t6) as pair_value, timestamp('2024-01-15', '12:30:00') as literal_fsp0, timestamp('2024-01-15', '12:30:00.1') as literal_fsp1, timestamp('2024-01-15', '12:30:00.123456') as literal_fsp6 from timestamp_pair_src;
