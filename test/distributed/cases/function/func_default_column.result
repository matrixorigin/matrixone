CREATE TABLE default_column_input (
id INT AUTO_INCREMENT PRIMARY KEY,
a INT DEFAULT 7,
b INT,
c INT NOT NULL,
d INT DEFAULT (2+3),
e TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
f TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
g INT AS (a+1),
h VARCHAR(5) NOT NULL DEFAULT 'xyz',
j DATE NOT NULL DEFAULT '2020-01-01',
k BINARY(3) DEFAULT 'a',
p INT DEFAULT (7),
q INT DEFAULT (NULL)
);
