drop table if exists bitmappanic;
create table bitmappanic (col2 int);
insert into bitmappanic values(0),(65536),(131072);
select
bitmap_bucket_number(col2) bucket,
BITMAP_COUNT(bitmap_construct_agg(bitmap_bit_position(col2))) bmp
from bitmappanic
group by bucket;
➤ bucket[-5,64,0]  ¦  bmp[-5,64,0]  𝄀
0  ¦  1  𝄀
2  ¦  1  𝄀
4  ¦  1
select
BITMAP_COUNT(bitmap_construct_agg(BITMAP_BUCKET_NUMBER(col2))) bmp
from bitmappanic;
➤ bmp[-5,64,0]  𝄀
3
insert into bitmappanic values (65537), (65538);
select col2, bitmap_count(bitmap_construct_agg(bitmap_bit_position(col2)) over (
partition by bitmap_bucket_number(col2) order by col2 rows between 1 preceding and current row)) as cnt
from bitmappanic order by col2;
➤ col2[4,32,0]  ¦  cnt[-5,64,0]  𝄀
0  ¦  1  𝄀
65536  ¦  1  𝄀
65537  ¦  2  𝄀
65538  ¦  2  𝄀
131072  ¦  1
select col2, hex(bitmap_construct_agg(bitmap_bit_position(col2)) over ()) as whole_bitmap
from bitmappanic order by col2;
➤ col2[4,32,0]  ¦  whole_bitmap[-1,16383,0]  𝄀
0  ¦  3A300000010000000000020010000000000001000200  𝄀
65536  ¦  3A300000010000000000020010000000000001000200  𝄀
65537  ¦  3A300000010000000000020010000000000001000200  𝄀
65538  ¦  3A300000010000000000020010000000000001000200  𝄀
131072  ¦  3A300000010000000000020010000000000001000200
drop table if EXISTS bitmappanic;
drop table if exists bitmap_window_union_input;
drop table if exists bitmap_window_union_seed;
create table bitmap_window_union_seed (p int, id int, bit int);
insert into bitmap_window_union_seed values (1,1,1),(1,1,2),(1,2,2),(1,2,3),(1,3,4),(1,3,5),(1,3,6),(2,4,8),(2,5,8),(2,5,9);
create table bitmap_window_union_input as select p, id, bitmap_construct_agg(cast(bit as unsigned)) as bm from bitmap_window_union_seed group by p, id;
select p, id,
hex(bitmap_or_agg(bm) over ()) as whole_union,
hex(bitmap_or_agg(bm) over (partition by p)) as partition_union,
hex(bitmap_or_agg(bm) over (partition by p order by id rows between 1 preceding and current row)) as sliding_union
from bitmap_window_union_input order by p, id;
➤ p[4,32,0]  ¦  id[4,32,0]  ¦  whole_union[-1,16383,0]  ¦  partition_union[-1,16383,0]  ¦  sliding_union[-1,16383,0]  𝄀
1  ¦  1  ¦  3A30000001000000000007001000000001000200030004000500060008000900  ¦  3A300000010000000000050010000000010002000300040005000600  ¦  3A30000001000000000001001000000001000200  𝄀
1  ¦  2  ¦  3A30000001000000000007001000000001000200030004000500060008000900  ¦  3A300000010000000000050010000000010002000300040005000600  ¦  3A300000010000000000020010000000010002000300  𝄀
1  ¦  3  ¦  3A30000001000000000007001000000001000200030004000500060008000900  ¦  3A300000010000000000050010000000010002000300040005000600  ¦  3A30000001000000000004001000000002000300040005000600  𝄀
2  ¦  4  ¦  3A30000001000000000007001000000001000200030004000500060008000900  ¦  3A30000001000000000001001000000008000900  ¦  3A3000000100000000000000100000000800  𝄀
2  ¦  5  ¦  3A30000001000000000007001000000001000200030004000500060008000900  ¦  3A30000001000000000001001000000008000900  ¦  3A30000001000000000001001000000008000900
drop table bitmap_window_union_input;
drop table bitmap_window_union_seed;
