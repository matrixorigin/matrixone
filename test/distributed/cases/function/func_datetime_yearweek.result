(6, '2008-01-01', '2008-01-01 00:00:00', '2008-01-01 00:00:00', '2008-01-01', NULL);
SELECT id,
WEEK(d, mode) AS week_by_date,
WEEK(dt, mode) AS week_by_datetime,
YEARWEEK(d, mode) AS yearweek_by_date,
YEARWEEK(dt, mode) AS yearweek_by_datetime,
YEARWEEK(ts, mode) AS yearweek_by_timestamp,
YEARWEEK(s, mode) AS yearweek_by_string
FROM temporal_week_modes
ORDER BY id;
