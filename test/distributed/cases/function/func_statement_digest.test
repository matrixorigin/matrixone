DROP TABLE IF EXISTS statement_digest_metadata;
CREATE TABLE statement_digest_metadata AS SELECT STATEMENT_DIGEST('SELECT 1') AS digest, STATEMENT_DIGEST_TEXT('SELECT 1') AS normalized;
SHOW COLUMNS FROM statement_digest_metadata;
SELECT digest, normalized FROM statement_digest_metadata;
DROP TABLE statement_digest_metadata;
DROP TABLE statement_digest_input;
