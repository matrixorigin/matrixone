-- @suite
-- @case
-- @desc: MySQL 8.4 statement token digests, vector inputs and execution-time SQL modes
SET @digest_saved_sql_mode = @@sql_mode;
SET sql_mode = '';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1'), STATEMENT_DIGEST('SELECT 1');
SELECT STATEMENT_DIGEST('SELECT 2') = 'd1b44b0c19af710b5a679907e284acd2ddc285201794bc69a2389d77baedddae';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1,2,3'), STATEMENT_DIGEST('SELECT 1,2,3');
SELECT STATEMENT_DIGEST_TEXT('SELECT a IN (1,2)'), STATEMENT_DIGEST('SELECT a IN (1,2)');
SELECT STATEMENT_DIGEST_TEXT('INSERT INTO t VALUES (1,2),(3,4)');
SELECT STATEMENT_DIGEST_TEXT('SELECT NULL IS NULL'), STATEMENT_DIGEST('SELECT NULL IS NULL');
SELECT STATEMENT_DIGEST_TEXT('SELECT TRUE,FALSE');
SELECT STATEMENT_DIGEST_TEXT('SELECT `a``b`, `中文` FROM `t`');
SELECT STATEMENT_DIGEST_TEXT('SELECT /* ordinary */ 1 + 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*!80000 1 + */ 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*!99999 1 + */ 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ MAX_EXECUTION_TIME(1000) */ 1'), STATEMENT_DIGEST('SELECT /*+ MAX_EXECUTION_TIME(1000) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ MAX_EXECUTION_TIME(?) */ 1'), STATEMENT_DIGEST('SELECT /*+ MAX_EXECUTION_TIME(?) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT count (1)'), STATEMENT_DIGEST_TEXT('SELECT count(1)');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1; /* tail */');
SELECT STATEMENT_DIGEST_TEXT('/* comment */'), STATEMENT_DIGEST('/* comment */');
SELECT STATEMENT_DIGEST_TEXT(NULL), STATEMENT_DIGEST(NULL);
SELECT STATEMENT_DIGEST('');
SELECT STATEMENT_DIGEST_TEXT('SELECT ?');
SELECT STATEMENT_DIGEST('SELECT 1; SELECT 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT');
SELECT STATEMENT_DIGEST('CREATE TABLE t(a INT PRIMARY KEY DEFAULT NULL)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AUTO_INCREMENT DEFAULT 1)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a INT NOT NULL DEFAULT NULL');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT AUTO_INCREMENT DEFAULT 1');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE COLUMN b a INT AS (1) DEFAULT NULL');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (1) DEFAULT 1)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a INT AS (1) NOT NULL');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a TIMESTAMP AS (1) ON UPDATE CURRENT_TIMESTAMP)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a INT AS (1) COLUMN_FORMAT FIXED');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT AS (1) STORAGE MEMORY');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE COLUMN b a INT AS (1) STORAGE DEFAULT');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT COLUMN_FORMAT FIXED STORAGE MEMORY)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT CURRENT_TIMESTAMP)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a DATE ON UPDATE CURRENT_TIMESTAMP');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a DATETIME(3) DEFAULT CURRENT_TIMESTAMP(6)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE COLUMN b a DATETIME(3) ON UPDATE CURRENT_TIMESTAMP');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME(3) DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (CURRENT_TIMESTAMP))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a DATETIME ON UPDATE NOW()');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT REFERENCES parent(id)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE COLUMN b a INT REFERENCES parent(id)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a INT REFERENCES parent(id)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AUTO_INCREMENT DEFAULT NULL)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT NULL, PRIMARY KEY(a))');
SELECT STATEMENT_DIGEST();
SELECT STATEMENT_DIGEST_TEXT('SELECT 1', 'SELECT 2');

DROP TABLE IF EXISTS statement_digest_input;
CREATE TABLE statement_digest_input(id INT PRIMARY KEY, sql_text VARCHAR(100));
INSERT INTO statement_digest_input VALUES(1,'SELECT 1'),(2,'SELECT NULL IS NULL'),(3,NULL);
SELECT id, STATEMENT_DIGEST_TEXT(sql_text), STATEMENT_DIGEST(sql_text) FROM statement_digest_input ORDER BY id;
INSERT INTO statement_digest_input VALUES
(4,'SELECT ''_latin1'''),(5,'SELECT t._latin1 FROM t'),
(6,'SELECT n"a"'),(7,'SELECT n''a'''),
(8,'SELECT 123ABC'),(9,'SELECT 1e2abc'),
(10,'SELECT @@session.`sql_mode`'),
(11,'SELECT /*+ QB_NAME(1abc) */ 1'),(12,'SELECT /*+ QB_NAME(1e2) */ 1'),
(13,'SELECT /*+ QB_NAME(16K) */ 1'),(14,'SELECT /*+ */ 1'),
(15,'SELECT @@session."sql_mode"'),(16,'SELECT /*!50000 '' a'' */'),
(17,'SELECT /*+ QB_NAME(1k) */ 1'),(18,'SELECT /*+ QB_NAME(1.) */ 1'),
(19,'SELECT /*+ QB_NAME(1K) */ 1'),(20,'SELECT /*+ QB_NAME(1.0) */ 1');
SELECT id, STATEMENT_DIGEST_TEXT(sql_text), STATEMENT_DIGEST(sql_text) FROM statement_digest_input WHERE id>=4 ORDER BY id;
DELETE FROM statement_digest_input WHERE id>=4;
SELECT STATEMENT_DIGEST_TEXT('DROP TABLE statement_digest_input');
SELECT COUNT(*) FROM statement_digest_input;
SELECT STATEMENT_DIGEST_TEXT(CAST('SELECT 1' AS BINARY(8))), STATEMENT_DIGEST(CAST('SELECT 1' AS CHAR(8)));

PREPARE digest_parameter FROM 'SELECT STATEMENT_DIGEST(?), STATEMENT_DIGEST_TEXT(?)';
SET @digest_sql = 'SELECT 1';
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
SET @digest_sql = 'SELECT 1,2';
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
SET @digest_sql = NULL;
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
DEALLOCATE PREPARE digest_parameter;

PREPARE digest_mode FROM 'SELECT STATEMENT_DIGEST_TEXT(''SELECT "a"'')';
EXECUTE digest_mode;
SET sql_mode = 'ANSI_QUOTES';
EXECUTE digest_mode;
SET sql_mode = '';
EXECUTE digest_mode;
DEALLOCATE PREPARE digest_mode;
SET sql_mode = 'PIPES_AS_CONCAT';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 || 2'), STATEMENT_DIGEST('SELECT 1 || 2');
SET sql_mode = '';
-- DEFAULT literal collation is a column attribute, not an arbitrary expression.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a VARCHAR(10) DEFAULT ''a'' COLLATE utf8mb4_bin)'), STATEMENT_DIGEST('CREATE TABLE t(a VARCHAR(10) DEFAULT ''a'' COLLATE utf8mb4_bin)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT DEFAULT -1 COLLATE utf8mb4_bin');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT CURRENT_TIMESTAMP COLLATE utf8mb4_bin)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (@x))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ADD COLUMN a VARCHAR(100) DEFAULT (@@sql_mode)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT AS (ABS(@x))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE COLUMN b a INT AS ((@x:=1))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a VARCHAR(10) DEFAULT ''@x'' COLLATE utf8mb4_bin)');
SELECT STATEMENT_DIGEST_TEXT('SELECT @x,@@session.sql_mode');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (@x)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT CURRENT_TIMESTAMP');
-- Native temporal defaults keep lexical identity across spaces, comments, and quotes.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT NOW ())');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT NOW/**/())');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT `current_timestamp`())');
SET sql_mode = 'IGNORE_SPACE';
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT NOW ())'), STATEMENT_DIGEST('CREATE TABLE t(a DATETIME DEFAULT NOW ())');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME ON UPDATE NOW/**/())');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a DATETIME DEFAULT CURRENT_TIMESTAMP/**/())');
SELECT STATEMENT_DIGEST_TEXT('SELECT count (1)');
SET sql_mode = '';
-- SET DEFAULT accepts signed literals or a grouped expression, not bare operators.
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT 1+2');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ~1');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT -1');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (1+2)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((SELECT 1))');
-- Value-generator restrictions depend on the definition context and function family.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (CURRENT_DATE))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (UNIX_TIMESTAMP(''2020-01-01'')))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (CONNECTION_ID()))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (CURRENT_DATE))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SYSDATE()))');
-- Windows defer specification expressions, but not function arguments or outer siblings.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(1) OVER (PARTITION BY @x)))'), STATEMENT_DIGEST('CREATE TABLE t(a INT AS (SUM(1) OVER (PARTITION BY @x)))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (SUM(1) OVER (ORDER BY (SELECT 1))))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(1) OVER (ORDER BY 1 RANGE BETWEEN INTERVAL @x DAY PRECEDING AND CURRENT ROW)))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(@x) OVER (PARTITION BY 1)))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(1) OVER (PARTITION BY @x)+@y))');
-- Explicit column collation must be unique across all attribute AST shapes.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a VARCHAR(10) COLLATE utf8mb4_bin DEFAULT ''a'' COLLATE utf8mb4_bin)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT COLLATE utf8mb4_bin DEFAULT -1 COLLATE utf8mb4_bin');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a VARCHAR(10) COLLATE utf8mb4_bin DEFAULT (''a'' COLLATE utf8mb4_bin))');
-- Parentheses do not change a SET DEFAULT temporal literal into an expression.
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (DATE ''2020-01-01'')');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((TIME ''12:34:56''))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (TIMESTAMP ''2020-01-01 12:34:56'')');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (CAST(DATE ''2020-01-01'' AS CHAR))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a VARCHAR(100) DEFAULT (DATE ''2020-01-01''))');
-- Query ORDER/LIMIT belong to the entire query, not to the DEFAULT grouping pair.
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((SELECT 1) ORDER BY 1)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((SELECT 1) LIMIT 1)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (((SELECT 1) ORDER BY 1 LIMIT 1))');
-- NAME_CONST remains legal outside column pre-validation, including deferred windows.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (NAME_CONST(''n'',1)))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY COLUMN a INT AS (NAME_CONST(''n'',1))');
SELECT STATEMENT_DIGEST_TEXT('SELECT NAME_CONST(''n'',1)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(1) OVER(PARTITION BY NAME_CONST(''n'',1))))');
-- Bare CURRENT_ROLE is an identifier; its zero-argument call is a function.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (CURRENT_ROLE))'), STATEMENT_DIGEST('CREATE TABLE t(a INT AS (CURRENT_ROLE))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (CURRENT_ROLE()))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT (CURRENT_ROLE()))');
SELECT STATEMENT_DIGEST_TEXT('SELECT CURRENT_ROLE');
-- Locks share one query block through grouping, but not derived/CTE query bodies.
SELECT STATEMENT_DIGEST_TEXT('(SELECT n_nationkey FROM nation FOR SHARE) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('(SELECT n_nationkey FROM nation FOR SHARE) FOR UPDATE NOWAIT');
SELECT STATEMENT_DIGEST_TEXT('((SELECT n_nationkey FROM nation)) FOR UPDATE NOWAIT');
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 FOR SHARE) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) ((SELECT * FROM c FOR SHARE) FOR UPDATE)');
-- Unary plus is transparent to a temporal literal, unlike CAST or arithmetic.
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (+DATE ''2020-01-01'')');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((+(TIME ''12:34:56'')))');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (+ +TIMESTAMP ''2020-01-01 12:34:56'')');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT (+CAST(DATE ''2020-01-01'' AS CHAR))');
-- These IO statements are data passed to digest; none of them is executed.
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t ALTER COLUMN a SET DEFAULT ((SELECT 1 INTO OUTFILE ''/tmp/claude_no_execute''))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AS (SUM(1) OVER(ORDER BY (SELECT 1 INTO OUTFILE ''/tmp/claude_no_execute''))))');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 INTO OUTFILE ''/tmp/claude_no_execute''');
-- Wrapper context rejects post-FROM INTO without rejecting pre-FROM INTO.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (SELECT * FROM c INTO @x)');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (SELECT * INTO @x FROM c)');
SELECT STATEMENT_DIGEST_TEXT('(SELECT * FROM nation INTO @x)');
-- EXPLAIN skips execution locking validation, including ANALYZE.
SELECT STATEMENT_DIGEST_TEXT('EXPLAIN (SELECT a FROM t FOR SHARE) FOR UPDATE'), STATEMENT_DIGEST('EXPLAIN (SELECT a FROM t FOR SHARE) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('EXPLAIN ANALYZE (SELECT a FROM t FOR SHARE) FOR UPDATE');
-- Outer locks follow the last set operand, never a preceding or derived block.
SELECT STATEMENT_DIGEST_TEXT('(SELECT * FROM t UNION (SELECT * FROM u FOR SHARE)) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('((SELECT * FROM t FOR SHARE) UNION (SELECT * FROM u)) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('(SELECT * FROM t UNION (SELECT * FROM (SELECT * FROM u FOR SHARE) d)) FOR UPDATE');
-- Quoted DUAL is a base table, not the unquoted virtual-table form.
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 FROM `dual` FOR SHARE) FOR UPDATE');
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 FROM dual FOR SHARE) FOR UPDATE');
-- Same-expression WITH replaces its local scope; a derived query inherits it.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) ((SELECT * FROM c FOR SHARE) FOR UPDATE))');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) ((SELECT * FROM d FOR SHARE) FOR UPDATE))');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) SELECT * FROM (WITH d AS (SELECT 2) ((SELECT * FROM c FOR SHARE) FOR UPDATE)) q');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (SELECT * FROM t UNION (SELECT * FROM c FOR SHARE)) FOR UPDATE');
-- Export remains digest input only, with the same original-placement rule as INTO variables.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (SELECT 1 FROM t INTO OUTFILE ''/tmp/claude_no_execute'')');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (SELECT 1 INTO OUTFILE ''/tmp/claude_no_execute'' FROM t)');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 UNION (SELECT 1 FROM t INTO OUTFILE ''/tmp/claude_no_execute'')');
-- CTE bodies are itemized on reference, including transitive references and DML scopes.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (((SELECT * FROM t FOR SHARE) FOR UPDATE)) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (((SELECT * FROM t FOR SHARE) FOR UPDATE)) SELECT * FROM c');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (((SELECT * FROM t FOR SHARE) FOR UPDATE)), d AS (SELECT * FROM c) SELECT * FROM d');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) UPDATE t SET a=((SELECT * FROM c FOR SHARE) FOR UPDATE)');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) DELETE FROM t WHERE a=((SELECT * FROM c FOR SHARE) FOR UPDATE)');
-- A body WITH remains effective for trailing ORDER BY and subsequent set operands.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) SELECT 1) ORDER BY ((SELECT * FROM c FOR SHARE) FOR UPDATE)');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) SELECT 1) ORDER BY ((SELECT * FROM d FOR SHARE) FOR UPDATE)');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) SELECT 1) UNION ((SELECT * FROM c FOR SHARE) FOR UPDATE)');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH d AS (SELECT 2) SELECT 1) UNION ((SELECT * FROM d FOR SHARE) FOR UPDATE)');
-- Deprecated UNION INTO is still legal; only its original position determines rejection.
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 UNION SELECT 2 INTO @x) ORDER BY 1');
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 UNION SELECT 2 INTO OUTFILE ''/tmp/claude_no_execute'') ORDER BY 1');
SELECT STATEMENT_DIGEST_TEXT('(SELECT 1 UNION SELECT a FROM t INTO @x) LIMIT 1');
-- Bare DUAL is the entire FROM form, not a table factor or alias. No export SQL is executed.
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 FROM dual d');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 FROM (dual)');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 FROM (SELECT 1) dual');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 FROM `dual` AS d');
SELECT STATEMENT_DIGEST_TEXT('SELECT * FROM dual.t'), STATEMENT_DIGEST('SELECT * FROM dual.t');
-- WITH name uniqueness is declaration syntax, even without references or lock itemization.
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1), c AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH RECURSIVE c AS (SELECT 1), c AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('EXPLAIN WITH c AS (SELECT 1), c AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH unused AS (WITH c AS (SELECT 1), c AS (SELECT 2) SELECT 1) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT 1) (WITH c AS (SELECT 2) SELECT * FROM c)');
-- DUAL before a dot needs an immediately following unquoted identifier, not just a dot.
SELECT STATEMENT_DIGEST_TEXT('SELECT dual.* FROM t AS `dual`');
SELECT STATEMENT_DIGEST_TEXT('SELECT dual. a FROM t AS `dual`');
SELECT STATEMENT_DIGEST_TEXT('SELECT dual./*gap*/a FROM t AS `dual`');
SELECT STATEMENT_DIGEST_TEXT('SELECT dual.`a` FROM t AS `dual`');
SELECT STATEMENT_DIGEST_TEXT('SELECT `a`.1 FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT `dual`.* FROM t AS `dual`');
SELECT STATEMENT_DIGEST_TEXT('SELECT dual.1 FROM t AS `dual`'), STATEMENT_DIGEST('SELECT dual.1 FROM t AS `dual`');
-- Identifier comparison, display, and keyword qualification have separate contracts.
SELECT STATEMENT_DIGEST_TEXT('WITH ẞ AS (SELECT 1), ß AS (SELECT 2) SELECT 1'), STATEMENT_DIGEST('WITH ẞ AS (SELECT 1), ß AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH `Ⱥ` AS (SELECT 1), `ⱥ` AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH İ AS (SELECT 1), i AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH `ẞ` AS (((SELECT * FROM t FOR SHARE) FOR UPDATE)), `ß` AS (SELECT 1) SELECT * FROM `ẞ`');
SELECT STATEMENT_DIGEST_TEXT('WITH `ẞ` AS (((SELECT * FROM t FOR SHARE) FOR UPDATE)), `ß` AS (SELECT 1) SELECT * FROM `ß`');
SELECT STATEMENT_DIGEST_TEXT('SELECT `abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ab`'), STATEMENT_DIGEST('SELECT `abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ab`');
SELECT STATEMENT_DIGEST_TEXT('SELECT `abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abc`'), STATEMENT_DIGEST('SELECT `abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abc`');
SELECT STATEMENT_DIGEST_TEXT('SELECT `abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abc`,1');
SELECT STATEMENT_DIGEST_TEXT('SELECT `名名名名名名名名名名名名名名名名名名名名名a`'), STATEMENT_DIGEST('SELECT `名名名名名名名名名名名名名名名名名名名名名a`');
SELECT STATEMENT_DIGEST_TEXT('SELECT `名名名名名名名名名名名名名名名名名名名名名ab`'), STATEMENT_DIGEST('SELECT `名名名名名名名名名名名名名名名名名名名名名ab`');
SELECT STATEMENT_DIGEST_TEXT('SELECT sounds.a FROM t'), STATEMENT_DIGEST('SELECT sounds.a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT sounds.* FROM t'), STATEMENT_DIGEST('SELECT sounds.* FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT integer.a FROM t'), STATEMENT_DIGEST('SELECT integer.a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT integer.* FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT integer /*gap*/ .a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT t./*gap*/integer FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT begin.* FROM t'), STATEMENT_DIGEST('SELECT begin.* FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT ıf.a FROM t'), STATEMENT_DIGEST('SELECT ıf.a FROM t');
SET sql_mode = 'IGNORE_SPACE';
SELECT STATEMENT_DIGEST_TEXT('SELECT sum.a FROM t'), STATEMENT_DIGEST('SELECT sum.a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT sum.* FROM t'), STATEMENT_DIGEST('SELECT sum.* FROM t');
-- Table-name itemization, system-charset display, and hint lexical domains are independent.
SET sql_mode = '';
SELECT STATEMENT_DIGEST_TEXT('SELECT * FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT * FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('WITH c AS (SELECT * FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`) SELECT * FROM c');
SELECT STATEMENT_DIGEST_TEXT('EXPLAIN SELECT * FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 AS `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`');
SELECT STATEMENT_DIGEST_TEXT('DELETE `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` FROM t AS `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t (a int REFERENCES `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`(a))');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t (a int, FOREIGN KEY (a) REFERENCES `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`(a))');
SELECT STATEMENT_DIGEST_TEXT('SHOW INDEX FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`');
SELECT STATEMENT_DIGEST_TEXT('SHOW COLUMNS FROM `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`.t FROM db');
SELECT STATEMENT_DIGEST_TEXT('SELECT `😀`,1'), STATEMENT_DIGEST('SELECT `😀`,1');
SELECT STATEMENT_DIGEST_TEXT('SELECT `a😀b`,1'), STATEMENT_DIGEST('SELECT `a😀b`,1');
SELECT STATEMENT_DIGEST_TEXT('SELECT ``'), STATEMENT_DIGEST('SELECT ``');
SELECT STATEMENT_DIGEST_TEXT('WITH `😀` AS (SELECT 1), `😁` AS (SELECT 2) SELECT 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT t. end FROM t'), STATEMENT_DIGEST('SELECT t. end FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT end /*gap*/ . a FROM t'), STATEMENT_DIGEST('SELECT end /*gap*/ . a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT end /*!80411 .a */ FROM t'), STATEMENT_DIGEST('SELECT end /*!80411 .a */ FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT CASE WHEN TRUE THEN 1 ELSE 2 END /*!80411 +t */ .a FROM t'), STATEMENT_DIGEST('SELECT CASE WHEN TRUE THEN 1 ELSE 2 END /*!80411 +t */ .a FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT t. integer FROM t');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ QB_NAME($a$b) */ 1'), STATEMENT_DIGEST('SELECT /*+ QB_NAME($a$b) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ QB_NAME(a😀b) */ 1'), STATEMENT_DIGEST('SELECT /*+ QB_NAME(a😀b) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ QB_NAME(`a😀b`) */ 1'), STATEMENT_DIGEST('SELECT /*+ QB_NAME(`a😀b`) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ QB_NAME(1K名) */ 1'), STATEMENT_DIGEST('SELECT /*+ QB_NAME(1K名) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ INDEX(t@`😀` i) */ 1 FROM t'), STATEMENT_DIGEST('SELECT /*+ INDEX(t@`😀` i) */ 1 FROM t');
SELECT STATEMENT_DIGEST_TEXT(CONCAT('SELECT /*+', CHAR(11), 'QB_NAME(q)', CHAR(12), '*/ 1')), STATEMENT_DIGEST(CONCAT('SELECT /*+', CHAR(11), 'QB_NAME(q)', CHAR(12), '*/ 1'));
SET sql_mode = 'ANSI_QUOTES';
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ QB_NAME("a😀b") */ 1'), STATEMENT_DIGEST('SELECT /*+ QB_NAME("a😀b") */ 1');
SET sql_mode = '';
-- Name roles, reserved type words, and quoted-hint compaction remain independent.
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t (`aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` INT)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t (`aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` INT)');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t MODIFY `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` INT');
SELECT STATEMENT_DIGEST_TEXT('ALTER TABLE t CHANGE `aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa` a INT');
