-- @suite
-- @case
-- @desc: MySQL 8.4 statement token digests, vector inputs and execution-time SQL modes
SET @digest_saved_sql_mode = @@sql_mode;
SET sql_mode = '';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1'), STATEMENT_DIGEST('SELECT 1');
SELECT STATEMENT_DIGEST('SELECT 2') = 'd1b44b0c19af710b5a679907e284acd2ddc285201794bc69a2389d77baedddae';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1,2,3'), STATEMENT_DIGEST('SELECT 1,2,3');
SELECT STATEMENT_DIGEST_TEXT('SELECT a IN (1,2)'), STATEMENT_DIGEST('SELECT a IN (1,2)');
SELECT STATEMENT_DIGEST_TEXT('INSERT INTO t VALUES (1,2),(3,4)');
SELECT STATEMENT_DIGEST_TEXT('SELECT NULL IS NULL'), STATEMENT_DIGEST('SELECT NULL IS NULL');
SELECT STATEMENT_DIGEST_TEXT('SELECT TRUE,FALSE');
SELECT STATEMENT_DIGEST_TEXT('SELECT `a``b`, `中文` FROM `t`');
SELECT STATEMENT_DIGEST_TEXT('SELECT /* ordinary */ 1 + 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*!80000 1 + */ 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*!99999 1 + */ 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ MAX_EXECUTION_TIME(1000) */ 1'), STATEMENT_DIGEST('SELECT /*+ MAX_EXECUTION_TIME(1000) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT /*+ MAX_EXECUTION_TIME(?) */ 1'), STATEMENT_DIGEST('SELECT /*+ MAX_EXECUTION_TIME(?) */ 1');
SELECT STATEMENT_DIGEST_TEXT('SELECT count (1)'), STATEMENT_DIGEST_TEXT('SELECT count(1)');
SELECT STATEMENT_DIGEST_TEXT('SELECT 1; /* tail */');
SELECT STATEMENT_DIGEST_TEXT('/* comment */'), STATEMENT_DIGEST('/* comment */');
SELECT STATEMENT_DIGEST_TEXT(NULL), STATEMENT_DIGEST(NULL);
SELECT STATEMENT_DIGEST('');
SELECT STATEMENT_DIGEST_TEXT('SELECT ?');
SELECT STATEMENT_DIGEST('SELECT 1; SELECT 2');
SELECT STATEMENT_DIGEST_TEXT('SELECT');
SELECT STATEMENT_DIGEST('CREATE TABLE t(a INT PRIMARY KEY DEFAULT NULL)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AUTO_INCREMENT DEFAULT 1)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT AUTO_INCREMENT DEFAULT NULL)');
SELECT STATEMENT_DIGEST_TEXT('CREATE TABLE t(a INT DEFAULT NULL, PRIMARY KEY(a))');
SELECT STATEMENT_DIGEST();
SELECT STATEMENT_DIGEST_TEXT('SELECT 1', 'SELECT 2');

DROP TABLE IF EXISTS statement_digest_input;
CREATE TABLE statement_digest_input(id INT PRIMARY KEY, sql_text VARCHAR(100));
INSERT INTO statement_digest_input VALUES(1,'SELECT 1'),(2,'SELECT NULL IS NULL'),(3,NULL);
SELECT id, STATEMENT_DIGEST_TEXT(sql_text), STATEMENT_DIGEST(sql_text) FROM statement_digest_input ORDER BY id;
INSERT INTO statement_digest_input VALUES
(4,'SELECT ''_latin1'''),(5,'SELECT t._latin1 FROM t'),
(6,'SELECT n"a"'),(7,'SELECT n''a'''),
(8,'SELECT 123ABC'),(9,'SELECT 1e2abc'),
(10,'SELECT @@session.`sql_mode`'),
(11,'SELECT /*+ QB_NAME(1abc) */ 1'),(12,'SELECT /*+ QB_NAME(1e2) */ 1'),
(13,'SELECT /*+ QB_NAME(16K) */ 1'),(14,'SELECT /*+ */ 1');
SELECT id, STATEMENT_DIGEST_TEXT(sql_text), STATEMENT_DIGEST(sql_text) FROM statement_digest_input WHERE id>=4 ORDER BY id;
DELETE FROM statement_digest_input WHERE id>=4;
SELECT STATEMENT_DIGEST_TEXT('DROP TABLE statement_digest_input');
SELECT COUNT(*) FROM statement_digest_input;
SELECT STATEMENT_DIGEST_TEXT(CAST('SELECT 1' AS BINARY(8))), STATEMENT_DIGEST(CAST('SELECT 1' AS CHAR(8)));

PREPARE digest_parameter FROM 'SELECT STATEMENT_DIGEST(?), STATEMENT_DIGEST_TEXT(?)';
SET @digest_sql = 'SELECT 1';
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
SET @digest_sql = 'SELECT 1,2';
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
SET @digest_sql = NULL;
EXECUTE digest_parameter USING @digest_sql, @digest_sql;
DEALLOCATE PREPARE digest_parameter;

PREPARE digest_mode FROM 'SELECT STATEMENT_DIGEST_TEXT(''SELECT "a"'')';
EXECUTE digest_mode;
SET sql_mode = 'ANSI_QUOTES';
EXECUTE digest_mode;
SET sql_mode = '';
EXECUTE digest_mode;
DEALLOCATE PREPARE digest_mode;
SET sql_mode = 'PIPES_AS_CONCAT';
SELECT STATEMENT_DIGEST_TEXT('SELECT 1 || 2'), STATEMENT_DIGEST('SELECT 1 || 2');
SET sql_mode = 'IGNORE_SPACE';
SELECT STATEMENT_DIGEST_TEXT('SELECT count (1)');
SET sql_mode = @digest_saved_sql_mode;

DROP TABLE IF EXISTS statement_digest_metadata;
CREATE TABLE statement_digest_metadata AS SELECT STATEMENT_DIGEST('SELECT 1') AS digest, STATEMENT_DIGEST_TEXT('SELECT 1') AS normalized;
SHOW COLUMNS FROM statement_digest_metadata;
SELECT digest, normalized FROM statement_digest_metadata;
DROP TABLE statement_digest_metadata;
DROP TABLE statement_digest_input;
