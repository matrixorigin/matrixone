drop table if exists t_ordered_set_bvt;
create table t_ordered_set_bvt(g int, v int, sort_key int);
insert into t_ordered_set_bvt values
(1, 10, 2), (1, 20, 1), (1, 20, 5), (1, 30, 3), (1, NULL, 4),
(2, 4, 2), (2, 2, 1), (2, 8, 3),
(3, NULL, 1);
select g,
group_concat(distinct v order by sort_key separator '|') as local_group_concat
from t_ordered_set_bvt
group by g order by g;
➤ g[4,32,0]  ¦  local_group_concat[12,0,0]  𝄀
1  ¦  20|10|30  𝄀
2  ¦  2|4|8  𝄀
3  ¦  null
select g,
group_concat(distinct v) within group (order by sort_key desc) as within_group_concat
from t_ordered_set_bvt
group by g order by g;
➤ g[4,32,0]  ¦  within_group_concat[12,0,0]  𝄀
1  ¦  20,30,10  𝄀
2  ¦  8,4,2  𝄀
3  ¦  null
select g,
group_concat(v) within group (order by sort_key desc) as within_group_concat_all
from t_ordered_set_bvt
group by g order by g;
➤ g[4,32,0]  ¦  within_group_concat_all[12,0,0]  𝄀
1  ¦  20,30,10,20  𝄀
2  ¦  8,4,2  𝄀
3  ¦  null
select percentile_cont(0.25) within group (order by v) as p25_cont,
percentile_disc(0.25) within group (order by v) as p25_disc
from t_ordered_set_bvt;
➤ p25_cont[8,53,31]  ¦  p25_disc[4,32,0]  𝄀
6.0  ¦  4
select g,
percentile_cont(0.5) within group (order by v) as p50_cont,
percentile_disc(0.5) within group (order by v) as p50_disc
from t_ordered_set_bvt
group by g order by g;
➤ g[4,32,0]  ¦  p50_cont[8,53,31]  ¦  p50_disc[4,32,0]  𝄀
1  ¦  20.0  ¦  20  𝄀
2  ¦  4.0  ¦  4  𝄀
3  ¦  null  ¦  null
select percentile_cont(0) within group (order by v) as cont_min,
percentile_cont(1) within group (order by v) as cont_max,
percentile_disc(0) within group (order by v desc) as disc_desc_p0,
percentile_disc(1) within group (order by v desc) as disc_desc_p1
from t_ordered_set_bvt;
➤ cont_min[8,53,31]  ¦  cont_max[8,53,31]  ¦  disc_desc_p0[4,32,0]  ¦  disc_desc_p1[4,32,0]  𝄀
2.0  ¦  30.0  ¦  30  ¦  2
select g,
percentile_cont(0.5) within group (order by v) as null_cont,
percentile_disc(0.5) within group (order by v) as null_disc
from t_ordered_set_bvt
where g = 3
group by g;
➤ g[4,32,0]  ¦  null_cont[8,53,31]  ¦  null_disc[4,32,0]  𝄀
3  ¦  null  ¦  null
drop table if exists t_within_identifier_bvt;
create table t_within_identifier_bvt (id int, within int);
insert into t_within_identifier_bvt values (1, 10), (2, 20);
select within from t_within_identifier_bvt order by id;
➤ within[4,32,0]  𝄀
10  𝄀
20
select word, reserved from information_schema.KEYWORDS where word = 'WITHIN';
➤ WORD[12,-1,0]  ¦  RESERVED[4,32,0]  𝄀
WITHIN  ¦  0
drop table t_within_identifier_bvt;
drop table t_ordered_set_bvt;
