create table hex_numeric_source (
id int,
b bool,
d64 decimal(18,1),
d128 decimal(38,0),
d256 decimal(65,0),
f float,
d double
);
insert into hex_numeric_source values
(1, true, 15.5, 9007199254740993, 9223372036854775808, 14.5, 15.5),
(2, false, -15.5, -9223372036854775809, -9223372036854775809, -14.5, -15.5),
(3, null, null, null, null, null, null);
select id, hex(b), hex(d64), hex(d128), hex(d256), hex(f), hex(d)
from hex_numeric_source order by id;
➤ id[4,32,0]  ¦  hex(b)[12,16,0]  ¦  hex(d64)[12,16,0]  ¦  hex(d128)[12,16,0]  ¦  hex(d256)[12,16,0]  ¦  hex(f)[12,16,0]  ¦  hex(d)[12,16,0]  𝄀
1  ¦  1  ¦  10  ¦  20000000000001  ¦  7FFFFFFFFFFFFFFF  ¦  E  ¦  10  𝄀
2  ¦  0  ¦  FFFFFFFFFFFFFFF0  ¦  8000000000000000  ¦  8000000000000000  ¦  FFFFFFFFFFFFFFF2  ¦  FFFFFFFFFFFFFFF0  𝄀
3  ¦  null  ¦  null  ¦  null  ¦  null  ¦  null  ¦  null
create table hex_numeric_ctas as
select id, hex(b) as hb, hex(d64) as hd64, hex(d128) as hd128,
hex(d256) as hd256, hex(f) as hf, hex(d) as hd
from hex_numeric_source where id <= 2;
select * from hex_numeric_ctas order by id;
➤ id[4,32,0]  ¦  hb[12,16,0]  ¦  hd64[12,16,0]  ¦  hd128[12,16,0]  ¦  hd256[12,16,0]  ¦  hf[12,16,0]  ¦  hd[12,16,0]  𝄀
1  ¦  1  ¦  10  ¦  20000000000001  ¦  7FFFFFFFFFFFFFFF  ¦  E  ¦  10  𝄀
2  ¦  0  ¦  FFFFFFFFFFFFFFF0  ¦  8000000000000000  ¦  8000000000000000  ¦  FFFFFFFFFFFFFFF2  ¦  FFFFFFFFFFFFFFF0
prepare hex_runtime from 'select hex(?)';
set @hex_arg = 15.5;
execute hex_runtime using @hex_arg;
➤ hex(?)[12,16,0]  𝄀
10
set @hex_arg = -15.5;
execute hex_runtime using @hex_arg;
➤ hex(?)[12,16,0]  𝄀
FFFFFFFFFFFFFFF0
set @hex_arg = true;
execute hex_runtime using @hex_arg;
➤ hex(?)[12,16,0]  𝄀
1
set @hex_arg = '15.5';
execute hex_runtime using @hex_arg;
➤ hex(?)[-1,16383,0]  𝄀
31352E35
set @hex_arg = cast(15.5 as double);
execute hex_runtime using @hex_arg;
➤ hex(?)[12,16,0]  𝄀
10
set @hex_arg = null;
execute hex_runtime using @hex_arg;
➤ hex(?)[-1,16383,0]  𝄀
null
deallocate prepare hex_runtime;
prepare hex_explicit_real from 'select hex(cast(? as double))';
set @hex_arg = 15.5;
execute hex_explicit_real using @hex_arg;
➤ hex(cast(? as double))[12,16,0]  𝄀
F
set @hex_arg = -15.5;
execute hex_explicit_real using @hex_arg;
➤ hex(cast(? as double))[12,16,0]  𝄀
FFFFFFFFFFFFFFF1
deallocate prepare hex_explicit_real;
drop database hex_issue_28457;
