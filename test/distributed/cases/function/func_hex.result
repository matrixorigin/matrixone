drop database if exists hex_issue_28457;
create database hex_issue_28457;
use hex_issue_28457;
select hex(true), hex(false),
hex(cast('15.5' as decimal(18,1))), hex(cast('-15.5' as decimal(18,1))),
hex(cast(15.5 as double)), hex(cast(-15.5 as double)), hex(cast(456.789 as double));
