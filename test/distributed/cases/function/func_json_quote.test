select json_quote('a');
select json_quote('a"');
select json_quote('a"b');
select json_quote(null);
create table t1 (a varchar(10));
insert into t1 values ('a'), ('a"'), ('a"b'), (null);
select json_quote(a) from t1;
select json_quote('xax') from t1;
select json_quote(null) from t1;

select hex(json_quote(char(65, 0, 1, 31, 66)));
select hex(json_quote(char(65, 127, 66)));
select hex(json_quote('你好'));
select char_length(json_quote('abc'));
select concat(json_quote('abc'), 'x');
select json_quote('abc') = '"abc"', json_quote('abc') = 'abc';
select json_unquote(json_quote('a"b\\c'));

prepare json_quote_stmt from 'select json_quote(?)';
set @json_quote_value = 'a"b';
execute json_quote_stmt using @json_quote_value;
deallocate prepare json_quote_stmt;

prepare json_quote_length_stmt from 'select length(json_quote(?))';
set @json_quote_value = repeat('a', 16383);
execute json_quote_length_stmt using @json_quote_value;
set @json_quote_value = repeat('a', 16384);
execute json_quote_length_stmt using @json_quote_value;
set @json_quote_value = repeat(char(1), 16384);
execute json_quote_length_stmt using @json_quote_value;
deallocate prepare json_quote_length_stmt;

drop table if exists json_quote_ctas;
create table json_quote_ctas as select json_quote('abc') as quoted;
select data_type, character_maximum_length from information_schema.columns where table_schema = database() and table_name = 'json_quote_ctas' and column_name = 'quoted';
select quoted, hex(quoted), char_length(quoted) from json_quote_ctas;
drop table json_quote_ctas;

drop table if exists json_quote_null_ctas;
create table json_quote_null_ctas as select json_quote(null) as quoted;
select data_type, character_maximum_length from information_schema.columns where table_schema = database() and table_name = 'json_quote_null_ctas' and column_name = 'quoted';
select quoted from json_quote_null_ctas;
drop table json_quote_null_ctas;

drop table if exists json_quote_text_ctas;
drop table if exists json_quote_text_source;
create table json_quote_text_source (v text);
insert into json_quote_text_source values (repeat(char(1), 65535));
select length(v), length(json_quote(v)), hex(left(json_quote(v), 7)), hex(right(json_quote(v), 7)) from json_quote_text_source;
create table json_quote_text_ctas as select json_quote(v) as quoted from json_quote_text_source;
select data_type, character_maximum_length from information_schema.columns where table_schema = database() and table_name = 'json_quote_text_ctas' and column_name = 'quoted';
select length(quoted), hex(left(quoted, 7)), hex(right(quoted, 7)) from json_quote_text_ctas;
drop table json_quote_text_ctas;
drop table json_quote_text_source;
drop table t1;
