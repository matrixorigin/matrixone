null  ¦  10  𝄀
null  ¦  20
select jt.a,jt.b from json_table('{"a":[],"b":[]}', '$' columns(nested path '$.a[*]' columns(a int path '$' default '7' on empty),nested path '$.b[*]' columns(b int path '$'))) jt;
➤ a[4,32,0]  ¦  b[4,32,0]  𝄀
