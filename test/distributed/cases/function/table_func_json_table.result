prepare jt_stmt from 'select jt.n from json_table(?, ''$[*]'' columns(n int path ''$'')) jt order by jt.n';
set @jt_doc='[5,6]';
execute jt_stmt using @jt_doc;
➤ n[4,32,0]  𝄀
5  𝄀
6
set @jt_doc='[7]';
execute jt_stmt using @jt_doc;
➤ n[4,32,0]  𝄀
7
deallocate prepare jt_stmt;
