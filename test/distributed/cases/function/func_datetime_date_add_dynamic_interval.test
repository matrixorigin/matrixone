-- @suite
-- @case
-- @desc:DATE_ADD must not constant-fold row-dependent INTERVAL expressions whose first operator argument is a literal.
-- @label:bvt

drop database if exists date_add_dynamic_interval;
create database date_add_dynamic_interval;
use date_add_dynamic_interval;

select result,
       timestampdiff(second, '2026-01-01', date_add('2026-01-01', interval floor(result / 1000) second)) as direct_offset,
       timestampdiff(second, '2026-01-01', date_add('2026-01-01', interval (1000 + floor(result / 1000)) second)) as literal_first_offset,
       timestampdiff(second, '2026-01-01', date_add('2026-01-01', interval (floor(result / 1000) + 1000) second)) as literal_second_offset
from generate_series(0, 2000, 1000) g
order by result;

create table t_dynamic_interval as
select result,
       date_add('2026-01-01', interval (1000 + floor(result / 1000)) second) as ts
from generate_series(0, 2000, 1000) g;

select result,
       timestampdiff(second, '2026-01-01', ts) as persisted_offset
from t_dynamic_interval
order by result;

select count(distinct ts) as distinct_ts from t_dynamic_interval;

-- Bare SQL prepared markers must preserve interval semantics across repeated
-- executions and source-type changes.
prepare issue_27320_second from 'select date_add(''2026-01-01'', interval ? second) as added, date_sub(''2026-01-01'', interval ? second) as subtracted';
set @issue_27320_interval = 3;
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = -3;
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = null;
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = '4';
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = 'not-an-interval';
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = 5;
execute issue_27320_second using @issue_27320_interval, @issue_27320_interval;
deallocate prepare issue_27320_second;

prepare issue_27320_day_second from 'select date_add(''2026-01-01'', interval ? day_second) as added, date_sub(''2026-01-01'', interval ? day_second) as subtracted';
set @issue_27320_interval = '1 02:03:04';
execute issue_27320_day_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = '1 02:03:04:05';
execute issue_27320_day_second using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = '0 00:00:01';
execute issue_27320_day_second using @issue_27320_interval, @issue_27320_interval;
deallocate prepare issue_27320_day_second;

prepare issue_27320_year_month from 'select date_add(''2026-01-01'', interval ? year_month) as added, date_sub(''2026-01-01'', interval ? year_month) as subtracted';
set @issue_27320_interval = '1-2';
execute issue_27320_year_month using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = '1-2-3';
execute issue_27320_year_month using @issue_27320_interval, @issue_27320_interval;
set @issue_27320_interval = '0-1';
execute issue_27320_year_month using @issue_27320_interval, @issue_27320_interval;
deallocate prepare issue_27320_year_month;

drop database date_add_dynamic_interval;
