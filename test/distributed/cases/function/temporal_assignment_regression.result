CREATE TABLE joined_update (id INT PRIMARY KEY, n INT DEFAULT 7, a INT, b INT, ts TIMESTAMP(6) NOT NULL DEFAULT '2000-01-01 00:00:00' ON UPDATE CURRENT_TIMESTAMP(6));
CREATE TABLE joined_source (id INT PRIMARY KEY, a INT);
INSERT INTO joined_update VALUES (1, 7, 1, 2, '2000-01-01 00:00:00'), (2, 7, 3, 4, '2000-01-01 00:00:00');
INSERT INTO joined_source VALUES (1, 0);
UPDATE joined_update t JOIN joined_source s ON t.id = s.id SET t.n = DEFAULT;
SELECT n, ts FROM joined_update ORDER BY id;
➤ n[4,32,0]  ¦  ts[93,26,0]  𝄀
7  ¦  2000-01-01 00:00:00  𝄀
7  ¦  2000-01-01 00:00:00
CREATE SEQUENCE joined_rhs START WITH 7;
UPDATE joined_update t JOIN joined_source s ON t.id = s.id SET t.n = NEXTVAL('joined_rhs');
SELECT n, ts, CURRVAL('joined_rhs') AS consumed FROM joined_update WHERE id = 1;
➤ n[4,32,0]  ¦  ts[93,26,0]  ¦  consumed[12,65535,0]  𝄀
7  ¦  2000-01-01 00:00:00  ¦  7
UPDATE joined_update t JOIN joined_source s ON t.id = s.id SET t.a = t.b, t.b = t.a;
SELECT a, b FROM joined_update WHERE id = 1;
➤ a[4,32,0]  ¦  b[4,32,0]  𝄀
2  ¦  1
CREATE SEQUENCE inactive_rhs START WITH 1;
UPDATE joined_update t LEFT JOIN joined_source s ON t.id = s.id SET t.a = t.a, s.a = NEXTVAL('inactive_rhs');
SELECT a, CURRVAL('inactive_rhs') AS consumed FROM joined_source;
➤ a[4,32,0]  ¦  consumed[12,65535,0]  𝄀
1  ¦  1
INSERT INTO joined_source VALUES (2, 0);
CREATE SEQUENCE duplicate_rhs START WITH 7;
UPDATE joined_update t JOIN joined_source s ON t.id = 1 SET t.n = NEXTVAL('duplicate_rhs'), s.a = s.a;
SELECT n, CURRVAL('duplicate_rhs') AS consumed FROM joined_update WHERE id = 1;
➤ n[4,32,0]  ¦  consumed[12,65535,0]  𝄀
7  ¦  7
SET lc_time_names = 'en_US';
