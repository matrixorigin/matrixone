CREATE TABLE typed_ts (ts TIMESTAMP(0));
INSERT INTO typed_ts VALUES ('1970-01-01 00:00:01'), ('2024-01-02 03:04:05');
SELECT ts, ADDTIME(ts, '00:00:00.000001'), SUBTIME(ts, '-00:00:00.000001'), DATE_SUB(ts, INTERVAL 2 SECOND) FROM typed_ts ORDER BY ts;
