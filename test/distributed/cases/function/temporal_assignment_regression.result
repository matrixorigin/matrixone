2  ¦  2024-01-02 03:04:05.123456000  ¦  2
CREATE SEQUENCE ts_once START WITH 1;
UPDATE legacy_ts SET ts = FROM_UNIXTIME(1700000000 + NEXTVAL('ts_once')) WHERE id = 1;
