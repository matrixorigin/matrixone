CREATE SEQUENCE rhs_once START WITH 1;
CREATE TABLE update_once (id INT PRIMARY KEY, n BIGINT, ts TIMESTAMP(6) NOT NULL DEFAULT '2000-01-01 00:00:00' ON UPDATE CURRENT_TIMESTAMP(6));
INSERT INTO update_once VALUES (1, 1, '2000-01-01 00:00:00');
UPDATE update_once SET n = NEXTVAL('rhs_once') WHERE id = 1;
SELECT n, ts, CURRVAL('rhs_once') AS consumed FROM update_once;
