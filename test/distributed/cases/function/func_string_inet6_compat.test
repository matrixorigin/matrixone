# INET6_NTOA IPv4-compatible IPv6 formatting

SELECT INET6_NTOA(UNHEX('0000000000000000000000007F000001')) AS compatible_loopback;
SELECT INET6_NTOA(UNHEX('000000000000000000000000C0000201')) AS compatible_documentation;
SELECT INET6_NTOA(UNHEX('000000000000000000000000FFFFFFFF')) AS compatible_max;

# Low tails remain canonical hexadecimal, matching MySQL's formatting rule.
SELECT INET6_NTOA(UNHEX('00000000000000000000000000000001')) AS ipv6_loopback;
SELECT INET6_NTOA(UNHEX('00000000000000000000000000000100')) AS ipv6_100;
SELECT INET6_NTOA(UNHEX('00000000000000000000000000010000')) AS compatible_low_octet;

# Existing mapped, ordinary IPv6, and null behavior remain unchanged.
SELECT INET6_NTOA(UNHEX('00000000000000000000FFFFC0000201')) AS mapped;
SELECT INET6_NTOA(UNHEX('20010DB885A3000000008A2E03707334')) AS ordinary_ipv6;
SELECT INET6_NTOA(INET6_ATON('::192.0.2.1')) AS roundtrip_compatible;
SELECT INET6_NTOA(NULL) AS null_input;

# Exercise the vectorized/table path with mixed address classes.
CREATE TABLE inet6_compat_test (id INT, ip VARBINARY(16));
INSERT INTO inet6_compat_test VALUES
    (1, UNHEX('0000000000000000000000007F000001')),
    (2, UNHEX('00000000000000000000000000000001')),
    (3, UNHEX('00000000000000000000FFFFC0000201')),
    (4, UNHEX('20010DB885A3000000008A2E03707334')),
    (5, NULL);
SELECT id, INET6_NTOA(ip) AS formatted FROM inet6_compat_test ORDER BY id;
DROP TABLE inet6_compat_test;
