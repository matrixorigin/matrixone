select timestamp('2039-01-20 01:00:00');
select timestamp('1968-01-20 01:00:00');
select timestamp('2038-02-10 01:00:00');
select timestamp('1969-11-20 01:00:00');
select timestamp('2038-01-20 01:00:00');
select timestamp('1969-12-30 01:00:00');
select timestamp('0001-12-30 01:00:00');
select timestamp('9999-12-30 01:00:00');

drop database if exists timestamp_pair_test;
create database timestamp_pair_test;
use timestamp_pair_test;

select timestamp('2024-01-15', '12:30:00') as literal_fsp0, timestamp('2024-01-15', '12:30:00.1') as literal_fsp1, timestamp('2024-01-15', '12:30:00.123456') as literal_fsp6;

create table timestamp_pair_src(d date, dt3 datetime(3), ts3 timestamp(3), t0 time(0), t6 time(6));
insert into timestamp_pair_src values ('2024-01-15', '2024-01-15 10:00:00.123', '2024-01-15 10:00:00.123', '02:30:00', '02:30:00.000456');
select timestamp(d, t6) as date_time6, timestamp(dt3, t0) as datetime3_time0, timestamp(ts3, t6) as timestamp3_time6 from timestamp_pair_src;
select timestamp(d, d) as date_date, timestamp(d, dt3) as date_datetime, timestamp(d, ts3) as date_timestamp from timestamp_pair_src;

set @timestamp_pair_date = '2024-01-15';
set @timestamp_pair_time = '12:30:00.123456';
prepare timestamp_pair_stmt from 'select timestamp(?, ?) as prepared_pair';
execute timestamp_pair_stmt using @timestamp_pair_date, @timestamp_pair_time;
deallocate prepare timestamp_pair_stmt;

select timestamp('2024-01-02', '-25:00:00') as negative_rollover, timestamp('2024-01-01 23:30:00', '02:00:00') as positive_rollover;
select timestamp('2024-01-02', '1 01:00:00') as positive_day_time, timestamp('2024-01-02', '-1 01:00:00') as negative_day_time;
select timestamp(null, '01:00:00') as null_date, timestamp('2024-01-01', null) as null_time;
select timestamp('not-a-date', '01:00:00') as invalid_date, timestamp('2024-01-01', 'not-a-time') as invalid_time;
select timestamp('2024-01-01', '2024-01-15 12:00:00') as datetime_shaped_time, timestamp('2024-01-01', '') as empty_time;
select timestamp('2024-01-01', concat(date_add(current_date, interval 1 day), ' 12:34:56.654321')) = timestamp('2024-01-01', '12:34:56.654321') as tomorrow_text_clock, timestamp('2024-01-01', cast(concat(date_add(current_date, interval 1 day), ' 12:34:56.654321') as datetime(6))) = timestamp('2024-01-01', '12:34:56.654321') as tomorrow_typed_clock;
select timestamp('9999-12-31 23:59:59.999999', '00:00:00.000001') as upper_overflow, timestamp('0001-01-01', '-00:00:00.000001') as lower_overflow;

create table timestamp_pair_ctas as select timestamp(d, t6) as pair_value, timestamp('2024-01-15', '12:30:00') as literal_fsp0, timestamp('2024-01-15', '12:30:00.1') as literal_fsp1, timestamp('2024-01-15', '12:30:00.123456') as literal_fsp6 from timestamp_pair_src;
select column_name, column_type, is_nullable from information_schema.columns where table_schema = 'timestamp_pair_test' and table_name = 'timestamp_pair_ctas' order by ordinal_position;

drop table timestamp_pair_ctas;
drop table timestamp_pair_src;
drop database timestamp_pair_test;
