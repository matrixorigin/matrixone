DROP TABLE IF EXISTS time_extract_reviewer_matrix;
CREATE TABLE time_extract_reviewer_matrix (
case_id INT PRIMARY KEY,
v VARCHAR(128),
t TEXT,
expected VARCHAR(16)
);
