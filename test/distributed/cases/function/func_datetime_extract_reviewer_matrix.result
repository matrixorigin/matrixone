SELECT COUNT(*) AS case_count,
SUM(CASE WHEN COALESCE(CONCAT(HOUR(v), '/', MINUTE(v), '/', SECOND(v)), 'NULL') <> expected THEN 1 ELSE 0 END)
+ SUM(CASE WHEN COALESCE(CONCAT(HOUR(CAST(v AS CHAR(128))), '/', MINUTE(CAST(v AS CHAR(128))), '/', SECOND(CAST(v AS CHAR(128)))), 'NULL') <> expected THEN 1 ELSE 0 END)
+ SUM(CASE WHEN COALESCE(CONCAT(HOUR(t), '/', MINUTE(t), '/', SECOND(t)), 'NULL') <> expected THEN 1 ELSE 0 END) AS mismatches
FROM time_extract_reviewer_matrix;
