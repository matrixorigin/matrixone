# INET_ATON and INET_NTOA functions
# Basic test case from requirements
SELECT INET_ATON('10.0.5.9') AS result1;

# INET_ATON tests
# Basic IPv4 addresses
SELECT INET_ATON('10.0.5.9') AS basic_ip;
SELECT INET_ATON('192.168.1.1') AS private_ip;
SELECT INET_ATON('127.0.0.1') AS loopback;
SELECT INET_ATON('255.255.255.255') AS max_ip;
SELECT INET_ATON('0.0.0.0') AS zero_ip;
SELECT INET_ATON('010.000.005.009') AS leading_zeroes;
SELECT INET_ATON('0001.2.3.4') AS long_zero_padded_octet;
SELECT INET_ATON('::ffff:192.0.2.1') AS mapped_ipv6_not_ipv4;

DROP TABLE IF EXISTS inet_aton_leading_zeroes;
CREATE TABLE inet_aton_leading_zeroes (id INT PRIMARY KEY, ip VARCHAR(50));
INSERT INTO inet_aton_leading_zeroes VALUES (1, '010.000.005.009'), (2, '0001.2.3.4'), (3, '::ffff:192.0.2.1');
SELECT id, ip, INET_ATON(ip) AS ip_number FROM inet_aton_leading_zeroes ORDER BY id;
DROP TABLE inet_aton_leading_zeroes;

# NULL handling
SELECT INET_ATON(NULL) AS null_input;

# Invalid addresses (should return NULL)
SELECT INET_ATON('invalid') AS invalid_address;
SELECT INET_ATON('256.256.256.256') AS invalid_octet;
SELECT INET_ATON('192.168.1') AS incomplete;
SELECT INET_ATON('192.168.1.1.1') AS too_many_octets;
SELECT INET_ATON('::1') AS ipv6_address;

# INET_NTOA tests
# Basic conversions
SELECT INET_NTOA(167773449) AS ip_from_int;  -- Should be '10.0.5.9'
SELECT INET_NTOA(3232235777) AS ip_from_int2;  -- Should be '192.168.1.1'
SELECT INET_NTOA(2130706433) AS loopback_from_int;  -- Should be '127.0.0.1'
SELECT INET_NTOA(4294967295) AS max_from_int;  -- Should be '255.255.255.255'
SELECT INET_NTOA(0) AS zero_from_int;  -- Should be '0.0.0.0'

# NULL handling
SELECT INET_NTOA(NULL) AS null_input;

# Different integer types
SELECT INET_NTOA(167773449) AS uint64_test;
SELECT INET_NTOA(CAST(167773449 AS UNSIGNED)) AS uint32_test;
SELECT INET_NTOA(CAST(167773449 AS SIGNED)) AS int64_test;
SELECT INET_NTOA(CAST(167773449 AS INT)) AS int32_test;

# Round-trip tests
SELECT INET_NTOA(INET_ATON('10.0.5.9')) AS roundtrip1;
SELECT INET_NTOA(INET_ATON('192.168.1.1')) AS roundtrip2;
SELECT INET_NTOA(INET_ATON('127.0.0.1')) AS roundtrip3;
SELECT INET_NTOA(INET_ATON('255.255.255.255')) AS roundtrip4;

# Table usage
CREATE TABLE t1(id INT, ip_str VARCHAR(50), ip_int BIGINT UNSIGNED);
INSERT INTO t1 VALUES (1, '192.168.1.1', 3232235777);
INSERT INTO t1 VALUES (2, '10.0.0.1', 167772161);
INSERT INTO t1 VALUES (3, '127.0.0.1', 2130706433);
INSERT INTO t1 VALUES (4, NULL, NULL);

SELECT id, ip_str, INET_ATON(ip_str) AS ip_int FROM t1;
SELECT id, ip_int, INET_NTOA(ip_int) AS ip_str FROM t1;
DROP TABLE t1;

# WHERE clause
CREATE TABLE t1(id INT, ip_str VARCHAR(50));
INSERT INTO t1 VALUES (1, '192.168.1.1'), (2, '10.0.0.1'), (3, '127.0.0.1');
SELECT id, ip_str FROM t1 WHERE INET_ATON(ip_str) = INET_ATON('192.168.1.1');
SELECT id, ip_str FROM t1 WHERE INET_ATON(ip_str) > INET_ATON('10.0.0.1');
DROP TABLE t1;

# Multiple function calls
SELECT INET_ATON('192.168.1.1') AS ip1, INET_ATON('10.0.0.1') AS ip2, INET_ATON('127.0.0.1') AS ip3;
SELECT INET_NTOA(3232235777) AS ip1, INET_NTOA(167772161) AS ip2, INET_NTOA(2130706433) AS ip3;

# Comparison and arithmetic
CREATE TABLE t1(id INT, ip_str VARCHAR(50));
INSERT INTO t1 VALUES (1, '192.168.1.1'), (2, '192.168.1.2'), (3, '10.0.0.1');
SELECT id, ip_str, INET_ATON(ip_str) AS ip_int FROM t1 ORDER BY INET_ATON(ip_str);
SELECT id, ip_str FROM t1 WHERE INET_ATON(ip_str) BETWEEN INET_ATON('10.0.0.0') AND INET_ATON('192.168.1.255');
DROP TABLE t1;

# Edge cases
SELECT INET_ATON('0.0.0.0') AS zero_ipv4;
SELECT INET_ATON('1.1.1.1') AS small_ip;
SELECT INET_NTOA(0) AS zero_result;
SELECT INET_NTOA(16843009) AS small_result;  -- Should be '1.1.1.1'

# Large values (should handle correctly)
SELECT INET_NTOA(4294967295) AS max_uint32;
SELECT INET_NTOA(18446744073709551615) AS max_uint64;  -- Out-of-range values must not wrap to a different address.
SELECT INET_NTOA(CAST(-1 AS SIGNED)) AS negative_signed;
SELECT INET_NTOA(CAST(-1 AS INT)) AS negative_int32;
SELECT INET_NTOA(CAST(4294967296 AS SIGNED)) AS signed_overflow;
SELECT INET_NTOA(CAST(4294967296 AS UNSIGNED)) AS unsigned_overflow;

# Fractional conversion preserves the source type's rounding contract.
SELECT INET_NTOA(CAST(0.5 AS DECIMAL(18,1))) AS decimal64_half, INET_NTOA(CAST(1.5 AS DECIMAL(38,1))) AS decimal128_tie, INET_NTOA(CAST(2.5 AS DECIMAL(65,1))) AS decimal256_tie, INET_NTOA(CAST(0.5 AS DOUBLE)) AS double_half, INET_NTOA(CAST(1.5 AS DOUBLE)) AS double_tie_even_up, INET_NTOA(CAST(2.5 AS DOUBLE)) AS double_tie_even_down, INET_NTOA(CAST(4294967294.5 AS DECIMAL(20,1))) AS decimal_max_tie, INET_NTOA(CAST(4294967295.5 AS DECIMAL(20,1))) AS decimal_overflow, INET_NTOA(CAST(4294967294.5 AS DOUBLE)) AS double_max_tie, INET_NTOA(CAST(4294967295.5 AS DOUBLE)) AS double_overflow, INET_NTOA(CAST(-0.4 AS DECIMAL(3,1))) AS decimal_negative_to_zero, INET_NTOA(CAST(-0.5 AS DOUBLE)) AS double_negative_tie_to_zero;

DROP TABLE IF EXISTS inet_ntoa_typed_inputs;
CREATE TABLE inet_ntoa_typed_inputs (id INT PRIMARY KEY, d64 DECIMAL(18,1), d128 DECIMAL(38,1), d256 DECIMAL(65,1), f FLOAT, d DOUBLE, s BIGINT, u BIGINT UNSIGNED);
INSERT INTO inet_ntoa_typed_inputs VALUES
    (1, 2.5, 2.5, 2.5, 2.5, 2.5, 167772161, 4294967295),
    (2, -0.4, -0.4, -0.4, -0.5, -0.5, -1, 4294967296),
    (3, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
SELECT id, INET_NTOA(d64) AS ip_d64, INET_NTOA(d128) AS ip_d128, INET_NTOA(d256) AS ip_d256, INET_NTOA(f) AS ip_float, INET_NTOA(d) AS ip_double, INET_NTOA(s) AS ip_signed, INET_NTOA(u) AS ip_unsigned FROM inet_ntoa_typed_inputs ORDER BY id;
DROP TABLE inet_ntoa_typed_inputs;

PREPARE inet_ntoa_decimal_rebind FROM 'SELECT INET_NTOA(CAST(? AS DECIMAL(18,1))) AS ip';
SET @inet_ntoa_value = 0.5;
EXECUTE inet_ntoa_decimal_rebind USING @inet_ntoa_value;
SET @inet_ntoa_value = 2.5;
EXECUTE inet_ntoa_decimal_rebind USING @inet_ntoa_value;
SET @inet_ntoa_value = NULL;
EXECUTE inet_ntoa_decimal_rebind USING @inet_ntoa_value;
DEALLOCATE PREPARE inet_ntoa_decimal_rebind;
PREPARE inet_ntoa_double_rebind FROM 'SELECT INET_NTOA(CAST(? AS DOUBLE)) AS ip';
SET @inet_ntoa_value = 0.5;
EXECUTE inet_ntoa_double_rebind USING @inet_ntoa_value;
SET @inet_ntoa_value = 2.5;
EXECUTE inet_ntoa_double_rebind USING @inet_ntoa_value;
SET @inet_ntoa_value = NULL;
EXECUTE inet_ntoa_double_rebind USING @inet_ntoa_value;
DEALLOCATE PREPARE inet_ntoa_double_rebind;
SET @inet_ntoa_value = NULL;

# Const-NULL results must preserve the input cardinality through ORDER BY
DROP TABLE IF EXISTS const_null_order_probe;
CREATE TABLE const_null_order_probe(a INT);
INSERT INTO const_null_order_probe VALUES (1), (2);
SELECT INET_NTOA(NULL) AS empty_const_null FROM const_null_order_probe ORDER BY a;
DROP TABLE const_null_order_probe;
