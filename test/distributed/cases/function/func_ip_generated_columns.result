drop database if exists func_ip_generated_columns;
create database func_ip_generated_columns;
use func_ip_generated_columns;
drop table if exists ip_deterministic_generated;
create table ip_deterministic_generated (
id int primary key,
ip_text varchar(39),
ip_binary varbinary(16),
ipv4_number bigint unsigned generated always as (inet_aton(ip_text)) stored,
ipv4_text varchar(39) generated always as (inet_ntoa(ipv4_number)) stored,
ip6_binary varbinary(16) generated always as (inet6_aton(ip_text)) stored,
ip6_text varchar(39) generated always as (inet6_ntoa(ip_binary)) stored,
is_ipv4 int generated always as (is_ipv4(ip_text)) stored,
is_ipv6 int generated always as (is_ipv6(ip_text)) stored,
is_ipv4_compat int generated always as (is_ipv4_compat(ip_binary)) stored,
is_ipv4_mapped int generated always as (is_ipv4_mapped(ip_binary)) stored,
key idx_ipv4_number (ipv4_number),
key idx_is_ipv4_mapped (is_ipv4_mapped)
);
insert into ip_deterministic_generated (id, ip_text, ip_binary) values
(1, '192.168.1.1', unhex('00000000000000000000ffffc0a80101')),
(2, '2001:db8::1', unhex('20010db8000000000000000000000001')),
(3, null, null),
(4, 'invalid', unhex('00000000000000000000000000000001')),
(5, '::ffff:192.0.2.1', unhex('00000000000000000000ffffc0000201')),
(6, '::192.0.2.1', unhex('000000000000000000000000c0000201'));
select id, ip_text, ipv4_number, ipv4_text, hex(ip6_binary), ip6_text,
is_ipv4, is_ipv6, is_ipv4_compat, is_ipv4_mapped
from ip_deterministic_generated order by id;
