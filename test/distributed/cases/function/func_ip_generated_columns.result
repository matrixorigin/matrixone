prepare ip_conversion_reuse from 'select inet_aton(?), inet6_ntoa(?)';
set @ip_value = '192.168.1.1', @binary_value = unhex('c0a80101');
execute ip_conversion_reuse using @ip_value, @binary_value;
➤ inet_aton(?)[-5,64,0]  ¦  inet6_ntoa(?)[12,65535,0]  𝄀
3232235777  ¦  192.168.1.1
set @ip_value = 'invalid', @binary_value = unhex('01');
execute ip_conversion_reuse using @ip_value, @binary_value;
➤ inet_aton(?)[-5,64,0]  ¦  inet6_ntoa(?)[12,65535,0]  𝄀
null  ¦  null
set @ip_value = null, @binary_value = null;
execute ip_conversion_reuse using @ip_value, @binary_value;
➤ inet_aton(?)[-5,64,0]  ¦  inet6_ntoa(?)[12,65535,0]  𝄀
null  ¦  null
set @ip_value = '10.0.0.1', @binary_value = unhex('0a000001');
execute ip_conversion_reuse using @ip_value, @binary_value;
➤ inet_aton(?)[-5,64,0]  ¦  inet6_ntoa(?)[12,65535,0]  𝄀
167772161  ¦  10.0.0.1
deallocate prepare ip_conversion_reuse;
drop table if exists ip_nullable_generated;
create table ip_nullable_generated (
ip_text varchar(39) not null,
ip_binary varbinary(16) not null,
ipv4_number bigint unsigned generated always as (inet_aton(ip_text)) stored,
ip6_text varchar(39) generated always as (inet6_ntoa(ip_binary)) stored
);
insert into ip_nullable_generated (ip_text, ip_binary) values ('invalid', unhex('01'));
select ip_text, hex(ip_binary), ipv4_number, ip6_text from ip_nullable_generated;
➤ ip_text[12,39,0]  ¦  hex(ip_binary)[12,65535,0]  ¦  ipv4_number[-5,64,0]  ¦  ip6_text[12,39,0]  𝄀
invalid  ¦  01  ¦  null  ¦  null
select column_name, is_nullable
from information_schema.columns
where table_schema = database() and table_name = 'ip_nullable_generated'
order by ordinal_position;
➤ column_name[12,256,0]  ¦  is_nullable[12,3,0]  𝄀
ip_text  ¦  NO  𝄀
ip_binary  ¦  NO  𝄀
ipv4_number  ¦  YES  𝄀
ip6_text  ¦  YES
drop table ip_nullable_generated;
drop database if exists func_ip_generated_columns;
