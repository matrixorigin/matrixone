select name, column_name
from mo_catalog.mo_indexes as i
join mo_catalog.mo_tables as t on i.table_id = t.rel_id
where t.reldatabase = database()
and t.relname = 'ip_deterministic_generated'
and i.name in ('idx_ipv4_number', 'idx_is_ipv4_mapped')
and i.column_name in ('ipv4_number', 'is_ipv4_mapped')
order by name, column_name;
➤ name[12,64,0]  ¦  column_name[12,256,0]  𝄀
idx_ipv4_number  ¦  ipv4_number  𝄀
idx_is_ipv4_mapped  ¦  is_ipv4_mapped
select id from ip_deterministic_generated force index (idx_ipv4_number)
where ipv4_number = 3232235777 order by id;
➤ id[4,32,0]  𝄀
1
update ip_deterministic_generated set ip_text = '10.0.0.1' where id = 1;
select id, ipv4_number, ipv4_text from ip_deterministic_generated
force index (idx_ipv4_number) where ipv4_number = 167772161 order by id;
➤ id[4,32,0]  ¦  ipv4_number[-5,64,0]  ¦  ipv4_text[12,39,0]  𝄀
1  ¦  167772161  ¦  10.0.0.1
select id from ip_deterministic_generated force index (idx_ipv4_number)
where ipv4_number = 3232235777 order by id;
➤ id[4,32,0]
update ip_deterministic_generated
set ip_binary = unhex('00000000000000000000ffffc0000201') where id = 2;
select id from ip_deterministic_generated force index (idx_is_ipv4_mapped)
where is_ipv4_mapped = 1 order by id;
