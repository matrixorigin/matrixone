DROP TABLE t_regexp_line_terminators;
SELECT REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'b'), '^\\n', 'm') AS crlf_sealed_single_m,
REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 'm') AS crlf_exempt_run_m,
REGEXP_INSTR(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 1, 1, 0, 'm') AS crlf_exempt_run_instr_m,
HEX(REGEXP_SUBSTR(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 1, 1, 'm')) AS crlf_exempt_run_substr_m,
REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\n$\\nx', 'm') AS crlf_assertion_sealed_m,
REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\n\\nx', 'm') AS crlf_adjacent_run_m;
crlf_sealed_single_m    crlf_exempt_run_m    crlf_exempt_run_instr_m    crlf_exempt_run_substr_m    crlf_assertion_sealed_m    crlf_adjacent_run_m
0    1    3    0A78    0    1
SELECT REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_cr_m,
REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'mu') AS r2_cr_mu,
REGEXP_LIKE(CONCAT('a', CONVERT(UNHEX('E280A8') USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_ls_m,
REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(11) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_vt_m;
r2_cr_m    r2_cr_mu    r2_ls_m    r2_vt_m
1    0    1    1
