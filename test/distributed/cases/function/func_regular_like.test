select regexp_like('Cat', '*');
select regexp_like('CAT','cat','i') r;
select regexp_like('\n','.','n') r;
select regexp_like('abc\ndef','^def','m') r;
select regexp_like('CAT','cat','iiiiiiic') r;
SELECT REGEXP_LIKE('a\nb', '^b', 'mu') AS unix_lf,
       REGEXP_LIKE('a\rb', '^b', 'mu') AS unix_cr;

# Binary operands default to case-sensitive matching, while explicit i/c flags
# override the default and the rightmost flag wins. High bytes use the
# Windows-1252 regexp facade under explicit case-insensitive matching.
select regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'i') binary_i,
       regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'ci') binary_ci,
       regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'ic') binary_ic,
       regexp_like(cast(X'C9' as varbinary(1)), cast(X'E9' as varbinary(1)), 'i') binary_cp1252_i,
       regexp_like(cast(X'C3A9' as varbinary(2)), cast(X'C389' as varbinary(2)), 'i') binary_utf8_bytes_i,
       regexp_like('A', 'a', 'i') text_i;
prepare regexp_like_domain_rebind from 'select regexp_like(?, ?, ''i'')';
set @regexp_like_subject = cast(_binary'A' as varbinary(1));
set @regexp_like_pattern = cast(_binary'a' as varbinary(1));
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = cast(X'C9' as varbinary(1));
set @regexp_like_pattern = cast(X'E9' as varbinary(1));
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = 'A';
set @regexp_like_pattern = 'a';
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = cast(_binary'A' as blob);
set @regexp_like_pattern = cast(_binary'a' as blob);
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
deallocate prepare regexp_like_domain_rebind;

select regexp_like('abc', '');
select regexp_like('abc', '', 'i');
select regexp_like(NULL, '', 'i');

select 'abc' regexp '';
select 'abc' rlike '';
select 'abc' not regexp '';
select 'abc' regexp 'a';
select 'abc' rlike '^a';

# match_type may vary by row; u is valid alongside case-specific modes and
# must not abort the whole vectorized query.
DROP TABLE IF EXISTS t_regexp_match_type;
CREATE TABLE t_regexp_match_type (
    id INT,
    s VARCHAR(40),
    p VARCHAR(20),
    r VARCHAR(8),
    mt VARCHAR(8)
);
INSERT INTO t_regexp_match_type VALUES
    (1, 'Abc', 'abc', 'X', 'i'),
    (2, 'Abc', 'abc', 'X', 'c'),
    (3, 'abc', 'abc', 'X', 'u');
SELECT id,
       REGEXP_LIKE(s, p, mt) AS is_match,
       REGEXP_INSTR(s, p, 1, 1, 0, mt) AS start_pos,
       REGEXP_SUBSTR(s, p, 1, 1, mt) AS substr_value,
       REGEXP_REPLACE(s, p, r, 1, 0, mt) AS replaced
FROM t_regexp_match_type
ORDER BY id;
DROP TABLE t_regexp_match_type;
