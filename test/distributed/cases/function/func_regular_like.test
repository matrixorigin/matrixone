select regexp_like('Cat', '*');
select regexp_like('CAT','cat','i') r;
select regexp_like('\n','.','n') r;
select regexp_like('abc\ndef','^def','m') r;
select regexp_like('CAT','cat','iiiiiiic') r;
SELECT REGEXP_LIKE('a\nb', '^b', 'mu') AS unix_lf,
       REGEXP_LIKE('a\rb', '^b', 'mu') AS unix_cr;

# Binary operands default to case-sensitive matching, while explicit i/c flags
# override the default and the rightmost flag wins. High bytes use the
# Windows-1252 regexp facade under explicit case-insensitive matching.
select regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'i') binary_i,
       regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'ci') binary_ci,
       regexp_like(cast(_binary'A' as varbinary(1)), cast(_binary'a' as varbinary(1)), 'ic') binary_ic,
       regexp_like(cast(X'C9' as varbinary(1)), cast(X'E9' as varbinary(1)), 'i') binary_cp1252_i,
       regexp_like(cast(X'C3A9' as varbinary(2)), cast(X'C389' as varbinary(2)), 'i') binary_utf8_bytes_i,
       regexp_like('A', 'a', 'i') text_i;
prepare regexp_like_domain_rebind from 'select regexp_like(?, ?, ''i'')';
set @regexp_like_subject = cast(_binary'A' as varbinary(1));
set @regexp_like_pattern = cast(_binary'a' as varbinary(1));
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = cast(X'C9' as varbinary(1));
set @regexp_like_pattern = cast(X'E9' as varbinary(1));
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = 'A';
set @regexp_like_pattern = 'a';
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
set @regexp_like_subject = cast(_binary'A' as blob);
set @regexp_like_pattern = cast(_binary'a' as blob);
execute regexp_like_domain_rebind using @regexp_like_subject, @regexp_like_pattern;
deallocate prepare regexp_like_domain_rebind;

select regexp_like('abc', '');
select regexp_like('abc', '', 'i');
select regexp_like(NULL, '', 'i');

select 'abc' regexp '';
select 'abc' rlike '';
select 'abc' not regexp '';
select 'abc' regexp 'a';
select 'abc' rlike '^a';

# match_type may vary by row; u is valid alongside case-specific modes and
# must not abort the whole vectorized query.
DROP TABLE IF EXISTS t_regexp_match_type;
CREATE TABLE t_regexp_match_type (
    id INT,
    s VARCHAR(40),
    p VARCHAR(20),
    r VARCHAR(8),
    mt VARCHAR(8)
);
INSERT INTO t_regexp_match_type VALUES
    (1, 'Abc', 'abc', 'X', 'i'),
    (2, 'Abc', 'abc', 'X', 'c'),
    (3, 'abc', 'abc', 'X', 'u'),
    (4, CONCAT('a', CHAR(13), 'b'), '^b', 'X', 'm'),
    (5, CONCAT('a', CHAR(13), 'b'), '^b', 'X', 'mu');
SELECT id,
       REGEXP_LIKE(s, p, mt) AS is_match,
       REGEXP_INSTR(s, p, 1, 1, 0, mt) AS start_pos,
       REGEXP_SUBSTR(s, p, 1, 1, mt) AS substr_value,
       HEX(REGEXP_REPLACE(s, p, r, 1, 0, mt)) AS replaced_hex
FROM t_regexp_match_type
ORDER BY id;
DROP TABLE t_regexp_match_type;

# Anchors inside classes and disabled inline scopes keep their meaning.
SELECT REGEXP_LIKE('$', '[[:alpha:]^$]', 'm') AS posix_literal,
       REGEXP_LIKE('a', '[^]$]', 'm') AS negated_class,
       REGEXP_LIKE(CAST(CONCAT('a', CHAR(13), 'b') AS CHAR), '(?-m:^b)', 'm') AS scoped_off;
# Byte 0x85 is a line terminator only in the text alphabet; the binary
# alphabet is {CR, VT, FF} plus LF, so this is 0 under both modes (#30210).
SELECT REGEXP_LIKE(X'618562', _binary '^b', 'm') AS binary_nel,
       REGEXP_LIKE(X'618562', _binary '^b', 'mu') AS binary_unix;

# Regular cross-line patterns keep their input domain beyond ICU limits.
SELECT REGEXP_LIKE(s, '^a\\sb', 'm') AS matched,
       REGEXP_INSTR(s, '^a\\sb', 1, 1, 1, 'm') AS end_pos,
       HEX(REGEXP_SUBSTR(s, '^a\\sb', 1, 1, 'm')) AS matched_hex,
       LENGTH(REGEXP_REPLACE(s, '^a\\sb', 'X', 1, 1, 'm')) AS replaced_length
FROM (SELECT CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b', REPEAT('y', 1048577)) AS s) AS input;

# Issue #30210: MySQL-compatible multiline line-terminator classification.
# m treats CR, LF, CRLF, VT, FF, NEL, LS and PS as line terminators; mu keeps
# Unix LF semantics (LF inside CRLF). Separator matrix across the four
# positional entry points.
DROP TABLE IF EXISTS t_regexp_line_terminators;
CREATE TABLE t_regexp_line_terminators (
    id INT,
    name VARCHAR(8),
    s VARCHAR(16)
);
INSERT INTO t_regexp_line_terminators VALUES
    (1, 'cr',   CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b')),
    (2, 'lf',   CONCAT('a', CONVERT(CHAR(10) USING utf8mb4), 'b')),
    (3, 'crlf', CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'b')),
    (4, 'vt',   CONCAT('a', CONVERT(CHAR(11) USING utf8mb4), 'b')),
    (5, 'ff',   CONCAT('a', CONVERT(CHAR(12) USING utf8mb4), 'b')),
    (6, 'nel',  CONCAT('a', CONVERT(UNHEX('C285') USING utf8mb4), 'b')),
    (7, 'ls',   CONCAT('a', CONVERT(UNHEX('E280A8') USING utf8mb4), 'b')),
    (8, 'ps',   CONCAT('a', CONVERT(UNHEX('E280A9') USING utf8mb4), 'b'));
SELECT id, name,
       REGEXP_LIKE(s, '^b', 'm') AS like_m,
       REGEXP_LIKE(s, '^b', 'mu') AS like_mu,
       REGEXP_INSTR(s, '^b', 1, 1, 0, 'm') AS instr_m,
       REGEXP_INSTR(s, '^b', 1, 1, 0, 'mu') AS instr_mu,
       HEX(REGEXP_SUBSTR(s, '^b', 1, 1, 'm')) AS substr_m_hex,
       HEX(REGEXP_SUBSTR(s, '^b', 1, 1, 'mu')) AS substr_mu_hex,
       HEX(REGEXP_REPLACE(s, '^b', 'X', 1, 0, 'm')) AS replace_m_hex,
       HEX(REGEXP_REPLACE(s, '^b', 'X', 1, 0, 'mu')) AS replace_mu_hex
FROM t_regexp_line_terminators
ORDER BY id;
DROP TABLE t_regexp_line_terminators;

# CRLF stays atomic for anchored single-literal heads: its interior is not a
# line-start candidate. A >= 2 rune exempt literal string may start inside
# CRLF, and a zero-width assertion seal blocks the interior again.
SELECT REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'b'), '^\\n', 'm') AS crlf_sealed_single_m,
       REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 'm') AS crlf_exempt_run_m,
       REGEXP_INSTR(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 1, 1, 0, 'm') AS crlf_exempt_run_instr_m,
       HEX(REGEXP_SUBSTR(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\nx', 1, 1, 'm')) AS crlf_exempt_run_substr_m,
       REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\n$\\nx', 'm') AS crlf_assertion_sealed_m,
       REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), CONVERT(CHAR(10) USING utf8mb4), 'xb'), '^\\n\\nx', 'm') AS crlf_adjacent_run_m;

# The regexp2 route (lookaround) honors the same wide line starts.
SELECT REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_cr_m,
       REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(13) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'mu') AS r2_cr_mu,
       REGEXP_LIKE(CONCAT('a', CONVERT(UNHEX('E280A8') USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_ls_m,
       REGEXP_LIKE(CONCAT('a', CONVERT(CHAR(11) USING utf8mb4), 'b'), '(?=[\\s\\S])^b', 'm') AS r2_vt_m;

# Binary alphabet: CR, VT and FF terminate lines; byte 0x85 never does
# (case-insensitive matching cannot promote it either).
SELECT REGEXP_LIKE(X'610B62', _binary '^b', 'm') AS binary_vt_m,
       REGEXP_LIKE(X'610C62', _binary '^b', 'm') AS binary_ff_m,
       REGEXP_LIKE(X'610D62', _binary '^b', 'm') AS binary_cr_m,
       REGEXP_LIKE(X'618562', _binary '^b', 'm') AS binary_nel_m,
       REGEXP_LIKE(X'618562', _binary '^b', 'mi') AS binary_nel_mi,
       REGEXP_LIKE(X'618562', _binary '^b', 'mu') AS binary_nel_mu;
