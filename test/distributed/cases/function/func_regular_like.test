#regexp_like
SELECT REGEXP_LIKE('Cat', '.*') Result;
SELECT REGEXP_LIKE('Cat', 'b+') Result;
SELECT REGEXP_LIKE('Cat', '^Ca') Result;
SELECT REGEXP_LIKE('Cat', '^Da') Result;
SELECT REGEXP_LIKE(NULL, '.*');
SELECT REGEXP_LIKE('Cat', NULL);
SELECT REGEXP_LIKE(NULL, NULL);
# A present binary pattern is validated before a NULL subject on both routes.
select regexp_like(cast(NULL as varbinary(20)), cast(concat('^', char(92), 'x{100}') as varbinary(20)), 'm');
select regexp_like(cast(NULL as varbinary(20)), cast(concat('^', char(92), 'x{100}') as varbinary(20)), 'mu');
select regexp_like(cast(NULL as varbinary(20)), cast(_binary'^a' as varbinary(2)), 'm') as valid_binary_null;
# Mandatory repetition of a nullable dollar keeps the true terminal match.
select regexp_instr(concat('a', convert(char(13) using utf8mb4)), '($)+', 1, 2, 0, 'm') as terminal_at,
       length(regexp_substr(concat('a', convert(char(13) using utf8mb4)), '($)+', 1, 2, 'm')) as terminal_len,
       hex(regexp_replace(concat('a', convert(char(13) using utf8mb4)), '($)+', 'X', 1, 0, 'm')) as terminal_replaced;

