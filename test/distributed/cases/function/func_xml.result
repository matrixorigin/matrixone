SELECT ExtractValue('<a>x<b>y</b>z</a>', '/a') AS direct_text,
ExtractValue('<a>x<b>y</b>z</a>', '/a/text()') AS explicit_text,
ExtractValue('<a>x<b>y</b>z</a>', '/a|/a/b') AS union_text;
