x
select ifnull(json_extract('{"a":"s"}', '$.a'), 0);
➤ ifnull(json_extract({"a":"s"}, $.a), 0)[-1,16383,0]  𝄀
s
select if(json_extract('{"a":null}', '$.a'), 'y', 'n');
➤ if(json_extract({"a":null}, $.a), y, n)[12,1,0]  𝄀
n
