select ifnull(json_extract('{"a":null}', '$.a'), 'x');
➤ ifnull(json_extract({"a":null}, $.a), x)[-1,16383,0]  𝄀
null
select ifnull(json_extract('{"a":7}', '$.a'), 'x');
