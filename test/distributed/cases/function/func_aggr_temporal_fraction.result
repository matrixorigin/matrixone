2  ¦  -0.100000  ¦  -0.400000  ¦  -0.2000000000
SET @variance_fraction_id = 1;
PREPARE variance_fraction_stmt FROM
'SELECT SUM(t), AVG(t), SUM(d), AVG(d), SUM(ts), AVG(ts), VAR_POP(t), VAR_SAMP(t), STDDEV_POP(t), STDDEV_SAMP(t) FROM variance_fraction WHERE id = ?';
EXECUTE variance_fraction_stmt USING @variance_fraction_id;
➤ SUM(variance_fraction.t)[3,60,6]  ¦  AVG(variance_fraction.t)[3,42,10]  ¦  SUM(variance_fraction.d)[3,60,6]  ¦  AVG(variance_fraction.d)[3,42,10]  ¦  SUM(variance_fraction.ts)[3,60,6]  ¦  AVG(variance_fraction.ts)[3,42,10]  ¦  VAR_POP(variance_fraction.t)[3,38,12]  ¦  VAR_SAMP(variance_fraction.t)[3,38,12]  ¦  STDDEV_POP(variance_fraction.t)[3,38,12]  ¦  STDDEV_SAMP(variance_fraction.t)[3,38,12]  𝄀
0.400000  ¦  0.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237
SET @variance_fraction_id = 2;
EXECUTE variance_fraction_stmt USING @variance_fraction_id;
➤ SUM(variance_fraction.t)[3,60,6]  ¦  AVG(variance_fraction.t)[3,42,10]  ¦  SUM(variance_fraction.d)[3,60,6]  ¦  AVG(variance_fraction.d)[3,42,10]  ¦  SUM(variance_fraction.ts)[3,60,6]  ¦  AVG(variance_fraction.ts)[3,42,10]  ¦  VAR_POP(variance_fraction.t)[3,38,12]  ¦  VAR_SAMP(variance_fraction.t)[3,38,12]  ¦  STDDEV_POP(variance_fraction.t)[3,38,12]  ¦  STDDEV_SAMP(variance_fraction.t)[3,38,12]  𝄀
-0.400000  ¦  -0.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237
DEALLOCATE PREPARE variance_fraction_stmt;
CREATE VIEW temporal_sum_avg AS
SELECT id, SUM(date_value) AS date_sum, AVG(date_value) AS date_avg,
SUM(t) AS time_sum, AVG(t) AS time_avg, SUM(d) AS datetime_sum, AVG(d) AS datetime_avg,
SUM(ts) AS timestamp_sum, AVG(ts) AS timestamp_avg
FROM variance_fraction GROUP BY id;
SELECT * FROM temporal_sum_avg ORDER BY id;
➤ id[4,32,0]  ¦  date_sum[3,60,0]  ¦  date_avg[3,42,4]  ¦  time_sum[3,60,6]  ¦  time_avg[3,42,10]  ¦  datetime_sum[3,60,6]  ¦  datetime_avg[3,42,10]  ¦  timestamp_sum[3,60,6]  ¦  timestamp_avg[3,42,10]  𝄀
1  ¦  40400203  ¦  20200101.5000  ¦  0.400000  ¦  0.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  𝄀
2  ¦  40400203  ¦  20200101.5000  ¦  -0.400000  ¦  -0.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000  ¦  40400202000000.400000  ¦  20200101000000.2000000000
CREATE TABLE temporal_sum_avg_ctas AS SELECT * FROM temporal_sum_avg;
SELECT * FROM temporal_sum_avg_ctas ORDER BY id;
