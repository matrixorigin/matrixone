DROP TABLE IF EXISTS temporal_sum_avg_ctas;
DROP VIEW IF EXISTS temporal_sum_avg;
DROP TABLE IF EXISTS variance_fraction;
CREATE TABLE variance_fraction (
id INT,
date_value DATE,
t TIME(6),
d DATETIME(6),
ts TIMESTAMP(6)
);
INSERT INTO variance_fraction VALUES
(1, '2020-01-01', '00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(1, '2020-01-02', '00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(1, NULL, NULL, NULL, NULL),
(2, '2020-01-01', '-00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(2, '2020-01-02', '-00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(2, NULL, NULL, NULL, NULL);
SELECT id,
VAR_POP(t), VAR_SAMP(t), STDDEV_POP(t), STDDEV_SAMP(t),
VAR_POP(d), VAR_SAMP(d), STDDEV_POP(d), STDDEV_SAMP(d),
VAR_POP(ts), VAR_SAMP(ts), STDDEV_POP(ts), STDDEV_SAMP(ts)
FROM variance_fraction
GROUP BY id
ORDER BY id;
