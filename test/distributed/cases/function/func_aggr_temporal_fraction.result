DROP TABLE IF EXISTS variance_fraction;
CREATE TABLE variance_fraction (
id INT,
t TIME(6),
d DATETIME(6),
ts TIMESTAMP(6)
);
INSERT INTO variance_fraction VALUES
(1, '00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(1, '00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(1, NULL, NULL, NULL),
(2, '-00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(2, '-00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(2, NULL, NULL, NULL);
SELECT id,
VAR_POP(t), VAR_SAMP(t), STDDEV_POP(t), STDDEV_SAMP(t),
VAR_POP(d), VAR_SAMP(d), STDDEV_POP(d), STDDEV_SAMP(d),
VAR_POP(ts), VAR_SAMP(ts), STDDEV_POP(ts), STDDEV_SAMP(ts)
FROM variance_fraction
GROUP BY id
ORDER BY id;
