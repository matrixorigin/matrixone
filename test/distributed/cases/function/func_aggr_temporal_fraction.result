SELECT SUM(t), AVG(t), SUM(d), AVG(d), SUM(ts), AVG(ts)
FROM variance_fraction WHERE t IS NULL;
➤ SUM(t)[3,60,6]  ¦  AVG(t)[3,42,10]  ¦  SUM(d)[3,60,6]  ¦  AVG(d)[3,42,10]  ¦  SUM(ts)[3,60,6]  ¦  AVG(ts)[3,42,10]  𝄀
null  ¦  null  ¦  null  ¦  null  ¦  null  ¦  null
SELECT SUM(t), AVG(t), SUM(date_value), AVG(date_value)
FROM variance_fraction WHERE id < 0;
➤ SUM(t)[3,60,6]  ¦  AVG(t)[3,42,10]  ¦  SUM(date_value)[3,60,0]  ¦  AVG(date_value)[3,42,4]  𝄀
null  ¦  null  ¦  null  ¦  null
SELECT id, CAST(t AS DECIMAL(38,6)) AS numeric_time,
SUM(t) OVER (PARTITION BY id ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_sum,
AVG(t) OVER (PARTITION BY id ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_avg
FROM variance_fraction ORDER BY id, t;
➤ id[4,32,0]  ¦  numeric_time[3,38,6]  ¦  running_sum[3,60,6]  ¦  running_avg[3,42,10]  𝄀
