DROP TABLE IF EXISTS variance_fraction;
CREATE TABLE variance_fraction (
id INT,
t TIME(6),
d DATETIME(6),
ts TIMESTAMP(6)
);
INSERT INTO variance_fraction VALUES
(1, '00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(1, '00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(1, NULL, NULL, NULL),
(2, '-00:00:00.100000', '2020-01-01 00:00:00.100000', '2020-01-01 00:00:00.100000'),
(2, '-00:00:00.300000', '2020-01-01 00:00:00.300000', '2020-01-01 00:00:00.300000'),
(2, NULL, NULL, NULL);
SELECT id,
VAR_POP(t), VAR_SAMP(t), STDDEV_POP(t), STDDEV_SAMP(t),
VAR_POP(d), VAR_SAMP(d), STDDEV_POP(d), STDDEV_SAMP(d),
VAR_POP(ts), VAR_SAMP(ts), STDDEV_POP(ts), STDDEV_SAMP(ts)
FROM variance_fraction
GROUP BY id
ORDER BY id;
➤ id[4,32,0]  ¦  VAR_POP(t)[3,38,12]  ¦  VAR_SAMP(t)[3,38,12]  ¦  STDDEV_POP(t)[3,38,12]  ¦  STDDEV_SAMP(t)[3,38,12]  ¦  VAR_POP(d)[3,38,12]  ¦  VAR_SAMP(d)[3,38,12]  ¦  STDDEV_POP(d)[3,38,12]  ¦  STDDEV_SAMP(d)[3,38,12]  ¦  VAR_POP(ts)[3,38,12]  ¦  VAR_SAMP(ts)[3,38,12]  ¦  STDDEV_POP(ts)[3,38,12]  ¦  STDDEV_SAMP(ts)[3,38,12]  𝄀
1  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237  𝄀
2  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237  ¦  0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237
SET @variance_fraction_id = 1;
PREPARE variance_fraction_stmt FROM
'SELECT VAR_POP(t), VAR_SAMP(t), STDDEV_POP(t), STDDEV_SAMP(t) FROM variance_fraction WHERE id = ?';
EXECUTE variance_fraction_stmt USING @variance_fraction_id;
➤ VAR_POP(t)[3,38,12]  ¦  VAR_SAMP(t)[3,38,12]  ¦  STDDEV_POP(t)[3,38,12]  ¦  STDDEV_SAMP(t)[3,38,12]  𝄀
0.010000000000  ¦  0.020000000000  ¦  0.100000000000  ¦  0.141421356237
DEALLOCATE PREPARE variance_fraction_stmt;
DROP TABLE variance_fraction;
DROP TABLE IF EXISTS temporal_variance_precision;
CREATE TABLE temporal_variance_precision (
id INT PRIMARY KEY,
d DATETIME,
ts TIMESTAMP
);
INSERT INTO temporal_variance_precision VALUES
(1, '2024-01-01 01:02:03', '2024-01-01 01:02:03'),
(2, '2024-01-02 02:03:04', '2024-01-02 02:03:04'),
(3, '2024-01-03 03:04:05', '2024-01-03 03:04:05');
SELECT CAST(VAR_POP(d) AS DECIMAL(24,6)) AS datetime_var_pop,
CAST(VAR_POP(ts) AS DECIMAL(24,6)) AS timestamp_var_pop
FROM temporal_variance_precision;
➤ datetime_var_pop[3,24,6]  ¦  timestamp_var_pop[3,24,6]  𝄀
680202686800.666600  ¦  680202686800.666600
DROP TABLE temporal_variance_precision;
