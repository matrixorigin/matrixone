drop database if exists temporal_context_regression;
create database temporal_context_regression;
use temporal_context_regression;
set @temporal_context_tz = @@time_zone;
set time_zone = '+00:00';
create table temporal_context_values(id int, dc date, dt datetime(6), tm time(6), ts timestamp(6));
