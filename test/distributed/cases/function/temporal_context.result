prepare temporal_context_stmt from 'select not cast(? as time(6)) as n, abs(cast(? as time(6))) as a, floor(cast(? as time(6))) as f';
set @temporal_context_arg = '-00:00:00.000001';
execute temporal_context_stmt using @temporal_context_arg, @temporal_context_arg, @temporal_context_arg;
