# Basic test case from requirements
SELECT CAST(ADDTIME('2007-12-31 23:59:59.999999', '1 1:1:1.000002') AS CHAR) AS result1;

# Additional test cases
# TIME + TIME
SELECT TIME(ADDTIME('12:30:45', '01:15:30')) AS time_add_time;
SELECT TIME(ADDTIME('23:59:59', '00:00:01')) AS time_wrap;
SELECT TIME(ADDTIME('00:00:00', '25:00:00')) AS time_with_days;

# DATETIME + TIME
SELECT ADDTIME('2007-12-31 23:59:59', '00:00:01') AS datetime_add_second;
SELECT CAST(ADDTIME('2007-12-31 23:59:59.999999', '1 1:1:1.000002') AS CHAR) AS datetime_add_time_with_days;
SELECT ADDTIME('2024-01-01 00:00:00', '24:00:00') AS datetime_add_day;

# TIMESTAMP + TIME
SELECT ADDTIME('2007-12-31 23:59:59', '00:00:01') AS timestamp_add_second;

# String inputs
SELECT CAST(ADDTIME('2007-12-31 23:59:59.999999', '1 1:1:1.000002') AS CHAR) AS string_datetime;
SELECT TIME(ADDTIME('12:30:45', '01:15:30')) AS string_time;

# NULL handling
SELECT ADDTIME(NULL, '01:00:00') AS null_first;
SELECT ADDTIME('12:00:00', NULL) AS null_second;
SELECT ADDTIME(NULL, NULL) AS null_both;

# Edge cases
SELECT TIME(ADDTIME('00:00:00', '00:00:00')) AS zero_time;
SELECT TIME(ADDTIME('23:59:59.999999', '00:00:00.000001')) AS microsecond_precision;
SELECT TIME(ADDTIME('25:59:59', '10:00:01')) AS time_wrap_36;

# Table usage
CREATE TABLE t1(dt DATETIME, t TIME);
INSERT INTO t1 VALUES ('2007-12-31 23:59:59', '01:00:00'), ('2024-01-01 12:00:00', '02:30:00');
SELECT ADDTIME(dt, t) AS result FROM t1;
DROP TABLE t1;

# WHERE clause
CREATE TABLE t1(dt DATETIME, t TIME);
INSERT INTO t1 VALUES ('2007-12-31 23:59:59', '01:00:00'), ('2024-01-01 12:00:00', '02:30:00');
SELECT * FROM t1 WHERE ADDTIME(dt, t) > '2008-01-01 00:00:00';
DROP TABLE t1;

# Zero calendar inputs return NULL before arithmetic. Cover typed and string forms.
SELECT ADDTIME(CAST('0000-00-00 00:00:00' AS DATETIME), '00:00:01') AS zero_datetime;
SELECT ADDTIME(CAST('0000-00-00 00:00:00' AS TIMESTAMP), '00:00:01') AS zero_timestamp;
SELECT ADDTIME('0000-00-00 00:00:00', '00:00:01') AS zero_datetime_string;

# Typed TIME precision must survive DATE arithmetic (#30238).
SELECT ADDTIME(CAST('2024-02-29' AS DATE), CAST('00:00:00.123456' AS TIME(6))) AS fractional_date,
       MICROSECOND(ADDTIME(CAST('2024-02-29' AS DATE), CAST('00:00:00.123456' AS TIME(6)))) AS micros;
SELECT ADDTIME(CAST('2024-02-29' AS DATE), CAST('00:00:00.999999' AS TIME(6))) AS below_next_second,
       MICROSECOND(ADDTIME(CAST('2024-02-29' AS DATE), CAST('00:00:00.999999' AS TIME(6)))) AS micros;
SELECT ADDTIME(CAST('2024-02-29' AS DATETIME(6)), CAST('00:00:00.123456' AS TIME(6))) AS datetime_control,
       ADDTIME(CAST('2024-02-29' AS DATE), CAST('00:00:00.123' AS TIME(3))) AS milliseconds;
SELECT ADDTIME(CAST(NULL AS DATE), CAST('00:00:00.123456' AS TIME(6))) IS NULL AS null_date,
       ADDTIME(CAST('2024-02-29' AS DATE), CAST(NULL AS TIME(6))) IS NULL AS null_time,
       ADDTIME(CAST('2024-02-29' AS DATE), 'invalid') IS NULL AS invalid_duration;

DROP TABLE IF EXISTS addtime_date_fsp, addtime_date_fsp_result;
CREATE TABLE addtime_date_fsp(id INT, d DATE, t TIME(6));
INSERT INTO addtime_date_fsp VALUES
    (1, '2024-02-29', '00:00:00.123456'),
    (2, '2024-02-29', '00:00:00.999999'),
    (3, '2024-02-29', '-00:00:00.000001'),
    (4, NULL, '00:00:00.123456'),
    (5, '2024-02-29', NULL);
SELECT id, ADDTIME(d, t) AS added, MICROSECOND(ADDTIME(d, t)) AS micros,
       SUBTIME(d, t) AS subtracted FROM addtime_date_fsp ORDER BY id;

# Inferred materialization must retain both the values and their precision.
CREATE TABLE addtime_date_fsp_result AS
    SELECT id, ADDTIME(d, t) AS added, SUBTIME(d, t) AS subtracted FROM addtime_date_fsp;
SELECT column_name, data_type, datetime_precision FROM information_schema.columns
    WHERE table_schema = DATABASE() AND table_name = 'addtime_date_fsp_result'
      AND column_name IN ('added', 'subtracted') ORDER BY ordinal_position;
SELECT id, added, MICROSECOND(added) AS micros, subtracted FROM addtime_date_fsp_result ORDER BY id;
DROP TABLE addtime_date_fsp_result, addtime_date_fsp;
