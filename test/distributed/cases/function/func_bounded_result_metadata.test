-- @suite

-- @case
-- @desc: bounded conversion and binary function result domains survive CTAS
-- @label:bvt

--- @metacmp(true)

drop database if exists bounded_result_metadata;
create database bounded_result_metadata;
use bounded_result_metadata;

create table source(s varchar(12) not null, b varbinary(12) not null);
insert into source values ('hello', _binary '0123456789ab');

create table bounded_network_ctas as
select inet_ntoa(16909060) as v4_text,
       inet6_aton('2001:db8::1') as network_bytes,
       inet6_ntoa(unhex('20010DB8000000000000000000000001')) as v6_text
from source;
select column_name, column_type, is_nullable
from information_schema.columns
where table_schema = 'bounded_result_metadata' and table_name = 'bounded_network_ctas'
order by ordinal_position;
select v4_text, hex(network_bytes), v6_text from bounded_network_ctas;

create table bounded_string_ctas as
select bin(1) as bin_v,
       conv('10', 10, 2) as conv_v,
       hex(1) as hex_num,
       hex(s) as hex_text,
       unhex('41') as unhex_v,
       md5(s) as md5_v,
       sha1(s) as sha1_v,
       sha2(s, 512) as sha2_v,
       uncompressed_length(compress(s)) as uncompressed_v
from source;
select column_name, column_type, is_nullable
from information_schema.columns
where table_schema = 'bounded_result_metadata' and table_name = 'bounded_string_ctas'
order by ordinal_position;
select bin_v, conv_v, hex_num, hex_text, hex(unhex_v), md5_v, sha1_v, sha2_v, uncompressed_v
from bounded_string_ctas;

create table bounded_binary_ctas as
select compress(s) as compressed_v,
       compress(b) as compressed_binary_v,
       uncompress(compress(s)) as uncompressed_v,
       aes_encrypt(b, 'key') as aes_v,
       aes_encrypt(s, 'key') as aes_text_v
from source;
select column_name, column_type, is_nullable
from information_schema.columns
where table_schema = 'bounded_result_metadata' and table_name = 'bounded_binary_ctas'
order by ordinal_position;
select length(compressed_v), length(compressed_binary_v), uncompressed_v,
       length(aes_v), length(aes_text_v) from bounded_binary_ctas;

select count(*) as concat_contract_failures
from source
where not (concat('x') <=> 'x')
   or not (concat(NULL) <=> NULL)
   or not (concat(42) <=> '42')
   or not (concat(s) <=> s);

create table concat_runtime_result(expected varchar(10), got varchar(10));
prepare concat_runtime from
    'insert into concat_runtime_result values (?, concat(?))';
set @concat_expected = 'hello';
set @concat_value = 'hello';
execute concat_runtime using @concat_expected, @concat_value;
set @concat_expected = NULL;
set @concat_value = NULL;
execute concat_runtime using @concat_expected, @concat_value;
select count(*) as concat_prepare_failures
from concat_runtime_result
where not (expected <=> got);
deallocate prepare concat_runtime;

create table elt_runtime_result(expected varchar(10), got varchar(10));
prepare elt_runtime from
    'insert into elt_runtime_result values (?, elt(?, ''a'', ''b'', ''c''))';
set @elt_expected = 'a';
set @elt_index = cast(1.4 as decimal(4,2));
execute elt_runtime using @elt_expected, @elt_index;
set @elt_expected = 'b';
set @elt_index = cast(1.5 as decimal(4,2));
execute elt_runtime using @elt_expected, @elt_index;
set @elt_expected = 'b';
set @elt_index = cast(1.6 as decimal(4,2));
execute elt_runtime using @elt_expected, @elt_index;
set @elt_expected = 'c';
set @elt_index = cast(2.5 as decimal(4,2));
execute elt_runtime using @elt_expected, @elt_index;
set @elt_expected = 'c';
set @elt_index = cast(2.6 as decimal(4,2));
execute elt_runtime using @elt_expected, @elt_index;
SET @bounded_result_metadata_saved_sql_mode = @@session.sql_mode;
SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@bounded_result_metadata_saved_sql_mode, ''), 'MYSQL_NUMERIC_COMPATIBILITY');
set @elt_expected = 'b';
set @elt_index = '2tail';
execute elt_runtime using @elt_expected, @elt_index;
SET SESSION sql_mode = @bounded_result_metadata_saved_sql_mode;
SET @bounded_result_metadata_saved_sql_mode = NULL;
set @elt_expected = NULL;
set @elt_index = NULL;
execute elt_runtime using @elt_expected, @elt_index;
set @elt_expected = NULL;
set @elt_index = 4;
execute elt_runtime using @elt_expected, @elt_index;
select count(*) as elt_contract_failures
from elt_runtime_result
where not (expected <=> got);
deallocate prepare elt_runtime;

create table elt_double_result(got varchar(10));
prepare elt_double from
    'insert into elt_double_result values (elt(cast(? as double), ''a'', ''b''))';
set @elt_index = 1.5;
execute elt_double using @elt_index;
select count(*) as elt_double_rows from elt_double_result where got is not null;
deallocate prepare elt_double;

create view bounded_numeric_view as
select find_in_set('b', 'a,b') as pos_v,
       strcmp('a', 'b') as cmp_v,
       char_length(s) as chars_v,
       crc32(s) as crc_v
from source;
create table bounded_numeric_ctas as select * from bounded_numeric_view;
select count(*) as contract_columns
from information_schema.columns
where table_schema = 'bounded_result_metadata'
  and table_name in ('bounded_numeric_view', 'bounded_numeric_ctas')
  and ((column_name = 'pos_v' and column_type = 'INT')
    or (column_name = 'cmp_v' and column_type = 'INT')
    or (column_name = 'chars_v' and column_type = 'BIGINT')
    or (column_name = 'crc_v' and column_type = 'BIGINT UNSIGNED'));

drop database bounded_result_metadata;
