6
insert into t values ('\t');
select sum(char_length(c)) from t;
sum(char_length(c))
7
insert into t values ('\n');
select sum(char_length(c)) from t;
sum(char_length(c))
8
insert into t values ('\r');
select sum(char_length(c)) from t;
sum(char_length(c))
9
insert into t values ('10');
select sum(char_length(c)) from t;
