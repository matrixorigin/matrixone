CREATE TABLE data_table (
id INT AUTO_INCREMENT PRIMARY KEY,
json_data JSON NOT NULL
);
INSERT INTO data_table (json_data)
VALUES
('{"value": 100}'),
('{"value": -200}'),
('{"value": 150.5}'),
('{"value": 0}'),
('{"value": -99.9}'),
('{"value": 50}'),
('{"value": 300}');
