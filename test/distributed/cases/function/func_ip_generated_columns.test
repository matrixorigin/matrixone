--- @metacmp(true)
-- @suite
-- @setup
drop database if exists func_ip_generated_columns;
create database func_ip_generated_columns;
use func_ip_generated_columns;
drop table if exists ip_deterministic_generated;
create table ip_deterministic_generated (
    id int primary key,
    ip_text varchar(39),
    ip_binary varbinary(16),
    ipv4_number bigint unsigned generated always as (inet_aton(ip_text)) stored,
    ipv4_text varchar(39) generated always as (inet_ntoa(ipv4_number)) stored,
    ip6_binary varbinary(16) generated always as (inet6_aton(ip_text)) stored,
    ip6_text varchar(39) generated always as (inet6_ntoa(ip_binary)) stored,
    is_ipv4 int generated always as (is_ipv4(ip_text)) stored,
    is_ipv6 int generated always as (is_ipv6(ip_text)) stored,
    is_ipv4_compat int generated always as (is_ipv4_compat(ip_binary)) stored,
    is_ipv4_mapped int generated always as (is_ipv4_mapped(ip_binary)) stored,
    key idx_ipv4_number (ipv4_number),
    key idx_is_ipv4_mapped (is_ipv4_mapped)
);
insert into ip_deterministic_generated (id, ip_text, ip_binary) values
    (1, '192.168.1.1', unhex('00000000000000000000ffffc0a80101')),
    (2, '2001:db8::1', unhex('20010db8000000000000000000000001')),
    (3, null, null),
    (4, 'invalid', unhex('00000000000000000000000000000001')),
    (5, '::ffff:192.0.2.1', unhex('00000000000000000000ffffc0000201')),
    (6, '::192.0.2.1', unhex('000000000000000000000000c0000201'));

-- @case
-- @desc: all deterministic IP functions can be stored and read from generated columns
select id, ip_text, ipv4_number, ipv4_text, hex(ip6_binary), ip6_text,
       is_ipv4, is_ipv6, is_ipv4_compat, is_ipv4_mapped
from ip_deterministic_generated order by id;

-- @case
-- @desc: generated-column indexes exist and follow generated values after updates
select name, column_name
from mo_catalog.mo_indexes as i
join mo_catalog.mo_tables as t on i.table_id = t.rel_id
where t.reldatabase = database()
  and t.relname = 'ip_deterministic_generated'
  and i.name in ('idx_ipv4_number', 'idx_is_ipv4_mapped')
  and i.column_name in ('ipv4_number', 'is_ipv4_mapped')
order by name, column_name;
select id from ip_deterministic_generated force index (idx_ipv4_number)
where ipv4_number = 3232235777 order by id;
update ip_deterministic_generated set ip_text = '10.0.0.1' where id = 1;
select id, ipv4_number, ipv4_text from ip_deterministic_generated
force index (idx_ipv4_number) where ipv4_number = 167772161 order by id;
select id from ip_deterministic_generated force index (idx_ipv4_number)
where ipv4_number = 3232235777 order by id;
update ip_deterministic_generated
set ip_binary = unhex('00000000000000000000ffffc0000201') where id = 2;
select id from ip_deterministic_generated force index (idx_is_ipv4_mapped)
where is_ipv4_mapped = 1 order by id;

-- @case
-- @desc: invalid and NULL inputs preserve the existing function contracts
start transaction;
update ip_deterministic_generated set ip_text = 'invalid' where id = 1;
select id, ipv4_number, ipv4_text, is_ipv4, is_ipv6 from ip_deterministic_generated where id = 1;
rollback;
select id, ip_text, ipv4_number, ipv4_text, is_ipv4, is_ipv6
from ip_deterministic_generated where id = 1;
select id from ip_deterministic_generated force index (idx_ipv4_number)
where ipv4_number = 167772161 order by id;
select id, ipv4_number is null, ipv4_text is null, ip6_binary is null,
       ip6_text is null, is_ipv4 is null, is_ipv6 is null,
       is_ipv4_compat is null, is_ipv4_mapped is null
from ip_deterministic_generated where id in (3, 4) order by id;

-- @case
-- @desc: constant folding agrees with row execution for valid and invalid values
select inet_aton('10.0.0.1'), inet_aton('invalid') is null,
       inet_ntoa(167772161), inet6_ntoa(unhex('c0a80101')),
       inet6_ntoa(unhex('01')) is null,
       is_ipv4('10.0.0.1'), is_ipv6('2001:db8::1'),
       is_ipv4_compat(unhex('000000000000000000000000c0000201')),
       is_ipv4_mapped(unhex('00000000000000000000ffffc0a80101'));

-- @case
-- @desc: prepared execution resets NULL and non-NULL results across parameter values
prepare ip_conversion_reuse from 'select inet_aton(?), inet6_ntoa(?)';
set @ip_value = '192.168.1.1', @binary_value = unhex('c0a80101');
execute ip_conversion_reuse using @ip_value, @binary_value;
set @ip_value = 'invalid', @binary_value = unhex('01');
execute ip_conversion_reuse using @ip_value, @binary_value;
set @ip_value = null, @binary_value = null;
execute ip_conversion_reuse using @ip_value, @binary_value;
set @ip_value = '10.0.0.1', @binary_value = unhex('0a000001');
execute ip_conversion_reuse using @ip_value, @binary_value;
deallocate prepare ip_conversion_reuse;

-- @case
-- @desc: non-NULL base columns still allow NULL-producing IP conversions
drop table if exists ip_nullable_generated;
create table ip_nullable_generated (
    ip_text varchar(39) not null,
    ip_binary varbinary(16) not null,
    ipv4_number bigint unsigned generated always as (inet_aton(ip_text)) stored,
    ip6_text varchar(39) generated always as (inet6_ntoa(ip_binary)) stored
);
insert into ip_nullable_generated (ip_text, ip_binary) values ('invalid', unhex('01'));
select ip_text, hex(ip_binary), ipv4_number, ip6_text from ip_nullable_generated;
select column_name, is_nullable
from information_schema.columns
where table_schema = database() and table_name = 'ip_nullable_generated'
order by ordinal_position;
drop table ip_nullable_generated;

-- @teardown
drop database if exists func_ip_generated_columns;
