DROP DATABASE IF EXISTS time_extract_suffix_token_db;
CREATE DATABASE time_extract_suffix_token_db;
USE time_extract_suffix_token_db;
DROP TABLE IF EXISTS time_extract_suffix_token;
CREATE TABLE time_extract_suffix_token (
  case_id INT PRIMARY KEY,
  v VARCHAR(64),
  c CHAR(64),
  t TEXT,
  expected VARCHAR(16)
);
