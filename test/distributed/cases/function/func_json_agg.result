CREATE TABLE t3(o_id INT, attribute VARCHAR(20), value VARCHAR(20));
INSERT INTO t3 VALUES
(2,'color','red'),
(2,'fabric','silk'),
(3,'color','green'),
(3,'shape','square');
SELECT o_id, JSON_ARRAYAGG(attribute) AS attributes FROM t3 GROUP BY o_id ORDER BY o_id;
o_id    attributes
2    ["color", "fabric"]
3    ["color", "shape"]
SELECT o_id, JSON_OBJECTAGG(attribute, value) AS details FROM t3 GROUP BY o_id ORDER BY o_id;
o_id    details
2    {"color": "red", "fabric": "silk"}
3    {"color": "green", "shape": "square"}
CREATE TABLE t_dup(c VARCHAR(10), i INT);
INSERT INTO t_dup VALUES ('key',3),('key',4),('key',5);
SELECT JSON_OBJECTAGG(c,i) AS obj1 FROM t_dup;
obj1
{"key": 5}
DELETE FROM t_dup;
INSERT INTO t_dup VALUES ('key',3),('key',5),('key',4);
SELECT JSON_OBJECTAGG(c,i) AS obj2 FROM t_dup;
obj2
{"key": 4}
DROP TABLE t_dup;
DROP TABLE t3;
CREATE TABLE t_arr_ext(g INT, pos INT, v INT);
INSERT INTO t_arr_ext VALUES
(1,1,5),
(1,2,1),
(1,3,5),
(1,4,3),
(1,5,1),
(1,6,2),
(2,1,7),
(2,2,7),
(2,3,8),
(2,4,9),
(2,5,8);
SELECT g, JSON_ARRAYAGG(v) AS ordered_array FROM (SELECT g, pos, v FROM t_arr_ext ORDER BY g, pos) AS s GROUP BY g ORDER BY g;
g    ordered_array
1    [5, 1, 5, 3, 1, 2]
2    [7, 7, 8, 9, 8]
SELECT g, JSON_ARRAYAGG(v) AS distinct_array FROM (SELECT DISTINCT g, v FROM t_arr_ext ORDER BY g, v) AS s GROUP BY g ORDER BY g;
g    distinct_array
1    [1, 2, 3, 5]
2    [7, 8, 9]
DROP TABLE t_arr_ext;
CREATE TABLE t_arr_typed(t0 TIME(0), t6 TIME(6), dt0 DATETIME(0), dt6 DATETIME(6), yr YEAR);
INSERT INTO t_arr_typed VALUES ('04:05:06', '04:05:06.123456', '2024-02-03 04:05:06', '2024-02-03 04:05:06.123456', 2024);
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t0), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t0), '$[0]')), JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t6), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t6), '$[0]')) FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t0), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t0), $[0]))[12,65535,0]  ¦  JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t6), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t6), $[0]))[12,65535,0]  𝄀
TIME  ¦  04:05:06.000000  ¦  TIME  ¦  04:05:06.123456
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), '$[0]')), JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), '$[0]')) FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), $[0]))[12,65535,0]  ¦  JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), $[0]))[12,65535,0]  𝄀
DATETIME  ¦  2024-02-03 04:05:06.000000  ¦  DATETIME  ¦  2024-02-03 04:05:06.123456
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(yr), '$[0]')), JSON_CONTAINS(JSON_ARRAYAGG(yr), '2024'), JSON_CONTAINS(JSON_ARRAYAGG(yr), '"2024"') FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(yr), $[0]))[12,65535,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(yr), 2024)[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(yr), "2024")[-5,64,0]  𝄀
INTEGER  ¦  1  ¦  0
INSERT INTO t_arr_typed VALUES (NULL, NULL, NULL, NULL, NULL), ('04:05:06', '04:05:06.123456', '2024-02-03 04:05:06', '2024-02-03 04:05:06.123456', 2024);
SELECT JSON_LENGTH(JSON_ARRAYAGG(DISTINCT yr)), JSON_CONTAINS(JSON_ARRAYAGG(DISTINCT yr), '2024'), JSON_CONTAINS(JSON_ARRAYAGG(DISTINCT yr), 'null') FROM t_arr_typed;
➤ JSON_LENGTH(JSON_ARRAYAGG(distinct yr))[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(distinct yr), 2024)[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(distinct yr), null)[-5,64,0]  𝄀
2  ¦  1  ¦  1
SET @json_arrayagg_year = '2025';
PREPARE json_arrayagg_typed FROM 'SELECT JSON_ARRAYAGG(CAST(? AS YEAR))';
EXECUTE json_arrayagg_typed USING @json_arrayagg_year;
➤ JSON_ARRAYAGG(cast(? as year))[-1,2147483647,0]  𝄀
[2025]
DEALLOCATE PREPARE json_arrayagg_typed;
DROP TABLE t_arr_typed;
CREATE TABLE t_obj_ext(g INT, pos INT, k VARCHAR(20), v INT);
INSERT INTO t_obj_ext VALUES
(1,1,'alpha',10),
(1,2,'beta',20),
(1,3,'alpha',30),
(1,4,'gamma',40),
(2,1,'north',100),
(2,2,'south',200),
(2,3,'north',300),
(2,4,'east',400),
(2,5,'west',500);
SELECT g, JSON_OBJECTAGG(k,v) AS obj_map FROM (SELECT g, pos, k, v FROM t_obj_ext ORDER BY g, pos) AS s GROUP BY g ORDER BY g;
g    obj_map
1    {"alpha": 30, "beta": 20, "gamma": 40}
2    {"east": 400, "north": 300, "south": 200, "west": 500}
DROP TABLE t_obj_ext;
create database test_json;
use test_json;
drop table if exists products;
CREATE TABLE products (
id INT,
name VARCHAR(50),
price DECIMAL(10,2),
category VARCHAR(30)
);
INSERT INTO products VALUES
(1, 'iPhone', 999.99, 'Electronics'),
(2, 'MacBook', 1299.99, 'Electronics'),
(3, 'Coffee Mug', 15.99, 'Home'),
(4, 'Desk Chair', 199.99, 'Furniture');
SELECT JSON_OBJECTAGG(name, price) as products_prices
FROM products;
➤ products_prices[-1,2147483647,0]  𝄀
{"Coffee Mug": 15.99, "Desk Chair": 199.99, "MacBook": 1299.99, "iPhone": 999.99}
SELECT
category,
JSON_OBJECTAGG(name, price) as category_products
FROM products
GROUP BY category;
➤ category[12,-1,0]  ¦  category_products[-1,2147483647,0]  𝄀
Electronics  ¦  {"MacBook": 1299.99, "iPhone": 999.99}  𝄀
Home  ¦  {"Coffee Mug": 15.99}  𝄀
Furniture  ¦  {"Desk Chair": 199.99}
SELECT JSON_OBJECTAGG(
name,
JSON_OBJECT('price', price, 'category', category, 'id', id)
) as detailed_products
FROM products;
➤ detailed_products[-1,2147483647,0]  𝄀
{"Coffee Mug": {"category": "Home", "id": 3, "price": 15.99}, "Desk Chair": {"category": "Furniture", "id": 4, "price": 199.99}, "MacBook": {"category": "Electronics", "id": 2, "price": 1299.99}, "iPhone": {"category": "Electronics", "id": 1, "price": 999.99}}
SELECT
category,
COUNT(*) as product_count,
AVG(price) as avg_price,
JSON_OBJECTAGG(name, price) as products
FROM products
GROUP BY category;
➤ category[12,-1,0]  ¦  product_count[-5,64,0]  ¦  avg_price[3,18,8]  ¦  products[-1,2147483647,0]  𝄀
Electronics  ¦  2  ¦  1149.99000000  ¦  {"MacBook": 1299.99, "iPhone": 999.99}  𝄀
Home  ¦  1  ¦  15.99000000  ¦  {"Coffee Mug": 15.99}  𝄀
Furniture  ¦  1  ¦  199.99000000  ¦  {"Desk Chair": 199.99}
drop table products;
drop table if exists app_configs;
create table app_configs (
app_name VARCHAR(50),
config_key VARCHAR(50),
config_value TEXT
);
INSERT INTO app_configs VALUES
('web_app', 'database_host', '192.168.1.100'),
('web_app', 'database_port', '3306'),
('web_app', 'redis_host', '192.168.1.101'),
('web_app', 'redis_port', '6379'),
('web_app', 'log_level', 'INFO'),
('web_app', 'max_connections', '100'),
('api_service', 'port', '8080'),
('api_service', 'timeout', '30'),
('api_service', 'rate_limit', '1000'),
('api_service', 'auth_enabled', 'true'),
('api_service', 'cors_origins', '*'),
('message_queue', 'broker_url', 'amqp://localhost:5672'),
('message_queue', 'queue_name', 'task_queue'),
('message_queue', 'prefetch_count', '10'),
('message_queue', 'retry_attempts', '3'),
('cache_service', 'redis_cluster', '192.168.1.101:6379,192.168.1.102:6379'),
('cache_service', 'ttl_seconds', '3600'),
('cache_service', 'max_memory', '2GB');
SELECT
app_name,
JSON_OBJECTAGG(config_key, config_value) as app_config
FROM app_configs
GROUP BY app_name;
➤ app_name[12,-1,0]  ¦  app_config[-1,2147483647,0]  𝄀
web_app  ¦  {"database_host": "192.168.1.100", "database_port": "3306", "log_level": "INFO", "max_connections": "100", "redis_host": "192.168.1.101", "redis_port": "6379"}  𝄀
api_service  ¦  {"auth_enabled": "true", "cors_origins": "*", "port": "8080", "rate_limit": "1000", "timeout": "30"}  𝄀
message_queue  ¦  {"broker_url": "amqp://localhost:5672", "prefetch_count": "10", "queue_name": "task_queue", "retry_attempts": "3"}  𝄀
cache_service  ¦  {"max_memory": "2GB", "redis_cluster": "192.168.1.101:6379,192.168.1.102:6379", "ttl_seconds": "3600"}
SELECT
app_name,
JSON_OBJECTAGG(config_key, config_value) as app_config
FROM app_configs
WHERE app_name = 'web_app'
GROUP BY app_name;
➤ app_name[12,-1,0]  ¦  app_config[-1,2147483647,0]  𝄀
web_app  ¦  {"database_host": "192.168.1.100", "database_port": "3306", "log_level": "INFO", "max_connections": "100", "redis_host": "192.168.1.101", "redis_port": "6379"}
SELECT
app_name,
CASE
WHEN config_key LIKE 'database_%' THEN 'database'
WHEN config_key LIKE 'redis_%' THEN 'redis'
ELSE 'general'
END as config_type,
JSON_OBJECTAGG(config_key, config_value) as configs
FROM app_configs
WHERE app_name = 'web_app'
GROUP BY app_name, config_type;
➤ app_name[12,-1,0]  ¦  config_type[12,-1,0]  ¦  configs[-1,2147483647,0]  𝄀
web_app  ¦  database  ¦  {"database_host": "192.168.1.100", "database_port": "3306"}  𝄀
web_app  ¦  redis  ¦  {"redis_host": "192.168.1.101", "redis_port": "6379"}  𝄀
web_app  ¦  general  ¦  {"log_level": "INFO", "max_connections": "100"}
SELECT
app_name,
COUNT(*) as config_count,
JSON_OBJECTAGG(config_key, config_value) as all_configs
FROM app_configs
GROUP BY app_name
ORDER BY config_count DESC;
➤ app_name[12,-1,0]  ¦  config_count[-5,64,0]  ¦  all_configs[-1,2147483647,0]  𝄀
web_app  ¦  6  ¦  {"database_host": "192.168.1.100", "database_port": "3306", "log_level": "INFO", "max_connections": "100", "redis_host": "192.168.1.101", "redis_port": "6379"}  𝄀
api_service  ¦  5  ¦  {"auth_enabled": "true", "cors_origins": "*", "port": "8080", "rate_limit": "1000", "timeout": "30"}  𝄀
message_queue  ¦  4  ¦  {"broker_url": "amqp://localhost:5672", "prefetch_count": "10", "queue_name": "task_queue", "retry_attempts": "3"}  𝄀
cache_service  ¦  3  ¦  {"max_memory": "2GB", "redis_cluster": "192.168.1.101:6379,192.168.1.102:6379", "ttl_seconds": "3600"}
drop table app_configs;
drop table if exists user_attributes;
