CREATE TABLE t_arr_typed(t0 TIME(0), t6 TIME(6), dt0 DATETIME(0), dt6 DATETIME(6), yr YEAR);
INSERT INTO t_arr_typed VALUES ('04:05:06', '04:05:06.123456', '2024-02-03 04:05:06', '2024-02-03 04:05:06.123456', 2024);
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t0), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t0), '$[0]')), JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t6), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t6), '$[0]')) FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t0), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t0), $[0]))[12,65535,0]  ¦  JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(t6), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(t6), $[0]))[12,65535,0]  𝄀
TIME  ¦  04:05:06.000000  ¦  TIME  ¦  04:05:06.123456
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), '$[0]')), JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), '$[0]')), JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), '$[0]')) FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt0), $[0]))[12,65535,0]  ¦  JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), $[0]))[12,65535,0]  ¦  JSON_UNQUOTE(JSON_EXTRACT(JSON_ARRAYAGG(dt6), $[0]))[12,65535,0]  𝄀
DATETIME  ¦  2024-02-03 04:05:06.000000  ¦  DATETIME  ¦  2024-02-03 04:05:06.123456
SELECT JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(yr), '$[0]')), JSON_CONTAINS(JSON_ARRAYAGG(yr), '2024'), JSON_CONTAINS(JSON_ARRAYAGG(yr), '"2024"') FROM t_arr_typed;
➤ JSON_TYPE(JSON_EXTRACT(JSON_ARRAYAGG(yr), $[0]))[12,65535,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(yr), 2024)[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(yr), "2024")[-5,64,0]  𝄀
INTEGER  ¦  1  ¦  0
