SELECT JSON_LENGTH(JSON_ARRAYAGG(DISTINCT yr)), JSON_CONTAINS(JSON_ARRAYAGG(DISTINCT yr), '2024'), JSON_CONTAINS(JSON_ARRAYAGG(DISTINCT yr), 'null') FROM t_arr_typed;
➤ JSON_LENGTH(JSON_ARRAYAGG(distinct yr))[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(distinct yr), 2024)[-5,64,0]  ¦  JSON_CONTAINS(JSON_ARRAYAGG(distinct yr), null)[-5,64,0]  𝄀
2  ¦  1  ¦  1
