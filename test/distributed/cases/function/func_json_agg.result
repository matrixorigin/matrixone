CREATE TABLE t3(o_id INT, attribute VARCHAR(20), value VARCHAR(20));
INSERT INTO t3 VALUES
(2,'color','red'),
(2,'fabric','silk'),
(3,'color','green'),
(3,'shape','square');
SELECT o_id, JSON_ARRAYAGG(attribute) AS attributes FROM t3 GROUP BY o_id ORDER BY o_id;
o_id    attributes
2    ["color", "fabric"]
3    ["color", "shape"]
SELECT o_id, JSON_OBJECTAGG(attribute, value) AS details FROM t3 GROUP BY o_id ORDER BY o_id;
o_id    details
2    {"color": "red", "fabric": "silk"}
3    {"color": "green", "shape": "square"}
CREATE TABLE t_dup(c VARCHAR(10), i INT);
INSERT INTO t_dup VALUES ('key',3),('key',4),('key',5);
SELECT JSON_OBJECTAGG(c,i) AS obj1 FROM t_dup;
obj1
{"key": 5}
DELETE FROM t_dup;
INSERT INTO t_dup VALUES ('key',3),('key',5),('key',4);
SELECT JSON_OBJECTAGG(c,i) AS obj2 FROM t_dup;
obj2
{"key": 4}
DROP TABLE t_dup;
DROP TABLE t3;
CREATE TABLE t_obj_numeric(
row_id INT,
signed_key BIGINT,
unsigned_key BIGINT UNSIGNED,
float_key FLOAT,
decimal_key DECIMAL(12,2),
value VARCHAR(20)
);
INSERT INTO t_obj_numeric VALUES
(1, -7, 18446744073709551615, 1.25, 12.30, 'first'),
(2, 7, 2, 2.50, 0.10, 'last');
SELECT JSON_OBJECTAGG(CAST(1 AS SIGNED), value) AS signed_literal FROM t_obj_numeric WHERE row_id = 1;
signed_literal
{"1": "first"}
SELECT JSON_OBJECTAGG(signed_key, value) AS signed_key_object FROM t_obj_numeric WHERE row_id = 1;
signed_key_object
{"-7": "first"}
SELECT JSON_OBJECTAGG(unsigned_key, value) AS unsigned_key_object FROM t_obj_numeric WHERE row_id = 1;
unsigned_key_object
{"18446744073709551615": "first"}
SELECT JSON_OBJECTAGG(float_key, value) AS float_key_object FROM t_obj_numeric WHERE row_id = 1;
float_key_object
{"1.25": "first"}
SELECT JSON_OBJECTAGG(decimal_key, value) AS decimal_key_object FROM t_obj_numeric WHERE row_id = 1;
decimal_key_object
{"12.30": "first"}
SELECT JSON_OBJECTAGG(CAST(1.25 AS DOUBLE), value) AS double_key_object FROM t_obj_numeric WHERE row_id = 1;
double_key_object
{"1.25": "first"}
SELECT JSON_OBJECTAGG(CAST(0 AS SIGNED), value) AS zero_key_object FROM t_obj_numeric WHERE row_id = 2;
zero_key_object
{"0": "last"}
SELECT JSON_OBJECTAGG(row_id, value) AS integer_key_object, JSON_OBJECTAGG(row_id + 1, value) AS expression_key_object FROM t_obj_numeric WHERE row_id = 1;
➤ integer_key_object[-1,2147483647,0]  ¦  expression_key_object[-1,2147483647,0]  𝄀
{"1": "first"}  ¦  {"2": "first"}
SELECT JSON_OBJECTAGG(row_id, value) AS implicit_object, JSON_OBJECTAGG(CAST(row_id AS CHAR), value) AS explicit_object FROM t_obj_numeric WHERE row_id = 1;
➤ implicit_object[-1,2147483647,0]  ¦  explicit_object[-1,2147483647,0]  𝄀
{"1": "first"}  ¦  {"1": "first"}
SELECT JSON_OBJECTAGG(CAST(0 AS SIGNED), NULL) AS null_value_object FROM t_obj_numeric WHERE row_id = 2;
➤ null_value_object[-1,2147483647,0]  𝄀
{"0": null}
SELECT row_id, JSON_OBJECTAGG(signed_key, value) AS limited_object FROM t_obj_numeric GROUP BY row_id ORDER BY row_id LIMIT 1;
➤ row_id[4,32,0]  ¦  limited_object[-1,2147483647,0]  𝄀
1  ¦  {"-7": "first"}
SELECT JSON_CONTAINS(duplicate_object, '{"1":"first"}') OR JSON_CONTAINS(duplicate_object, '{"1":"last"}') AS duplicate_numeric FROM (SELECT JSON_OBJECTAGG(signed_key, value) AS duplicate_object FROM (SELECT CAST(1 AS SIGNED) AS signed_key, value FROM t_obj_numeric) AS unordered_numeric) AS duplicate_check;
duplicate_numeric
1
SET @json_objectagg_key = '-19';
PREPARE json_objectagg_signed_key FROM 'SELECT JSON_OBJECTAGG(CAST(? AS SIGNED), value) AS prepared_signed FROM t_obj_numeric WHERE row_id = 1';
EXECUTE json_objectagg_signed_key USING @json_objectagg_key;
➤ prepared_signed[-1,2147483647,0]  𝄀
{"-19": "first"}
SET @json_objectagg_key = '0';
EXECUTE json_objectagg_signed_key USING @json_objectagg_key;
➤ prepared_signed[-1,2147483647,0]  𝄀
{"0": "first"}
DEALLOCATE PREPARE json_objectagg_signed_key;
PREPARE json_objectagg_any_key FROM 'SELECT JSON_OBJECTAGG(?, value) AS prepared_any FROM t_obj_numeric WHERE row_id = 1';
EXECUTE json_objectagg_any_key USING @json_objectagg_key;
➤ prepared_any[-1,2147483647,0]  𝄀
{"0": "first"}
SET @json_objectagg_key = '-19';
EXECUTE json_objectagg_any_key USING @json_objectagg_key;
➤ prepared_any[-1,2147483647,0]  𝄀
{"-19": "first"}
DEALLOCATE PREPARE json_objectagg_any_key;
