medium1
25
SELECT VALIDATE_PASSWORD_STRENGTH('Password123') AS medium2;
medium2
50
SELECT VALIDATE_PASSWORD_STRENGTH('Password123!') AS strong1;
strong1
100
SELECT VALIDATE_PASSWORD_STRENGTH('MyP@ssw0rd') AS strong2;
strong2
75
