CREATE TABLE t1(plaintext VARCHAR(100));
INSERT INTO t1 VALUES ('Hello'), ('World'), ('MatrixOne');
SELECT plaintext, UNCOMPRESSED_LENGTH(COMPRESS(plaintext)) AS original_length FROM t1;
plaintext    original_length
Hello    5
World    5
MatrixOne    9
