null  ¦  null  ¦  null
set @rs=x'ff61';
select @rs regexp 'a', regexp_like(@rs,'a'), regexp_instr(@rs,'a'), hex(regexp_substr(@rs,'.')), hex(regexp_replace(@rs,'a','X'));
➤ @rs reg_match a[-7,1,0]  ¦  regexp_like(@rs, a)[-7,1,0]  ¦  regexp_instr(@rs, a)[-5,64,0]  ¦  hex(regexp_substr(@rs, .))[-1,16383,0]  ¦  hex(regexp_replace(@rs, a, X))[-1,16383,0]  𝄀
