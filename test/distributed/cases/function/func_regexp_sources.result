drop database if exists regexp_operand_sources;
create database regexp_operand_sources;
use regexp_operand_sources;
create table operands(t varchar(16), b blob, f binary(3), v varbinary(16));
insert into operands values ('éa', _binary'éa', _binary'éa', _binary'éa');
select regexp_instr(t,b), regexp_instr(t,f), regexp_instr(b,'a'), regexp_instr(f,'a') from operands;
➤ regexp_instr(t, b)[-5,64,0]  ¦  regexp_instr(t, f)[-5,64,0]  ¦  regexp_instr(b, a)[-5,64,0]  ¦  regexp_instr(f, a)[-5,64,0]  𝄀
0  ¦  0  ¦  3  ¦  3
select hex(regexp_substr(b,'.')), hex(regexp_substr(b,'.',2)), hex(regexp_substr(b,'.',2,1)) from operands;
➤ hex(regexp_substr(b, .))[-1,16383,0]  ¦  hex(regexp_substr(b, ., 2))[-1,16383,0]  ¦  hex(regexp_substr(b, ., 2, 1))[-1,16383,0]  𝄀
C3  ¦  A9  ¦  A9
select regexp_instr(t,v) from operands;
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to regexp_instr.
select regexp_like(_binary'abc','a');
Character set 'binary' cannot be used in conjunction with 'utf8mb4_general_ci' in call to regexp_like.
select regexp_instr('abc',x'61');
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to regexp_instr.
select regexp_substr(cast('abc' as binary),'.');
Character set 'binary' cannot be used in conjunction with 'utf8mb4_general_ci' in call to regexp_substr.
select regexp_replace('abc','a',cast('X' as binary));
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to regexp_replace.
select cast(null as binary) regexp 'a';
Character set 'binary' cannot be used in conjunction with 'utf8mb4_general_ci' in call to reg_match.
select cast(null as char) regexp _binary'a';
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to reg_match.
select null regexp _binary'a', cast(null as binary) regexp _binary'a';
➤ null reg_match a[-7,1,0]  ¦  cast(null as binary) reg_match a[-7,1,0]  𝄀
null  ¦  null
select _binary'abc' rlike _binary'a', _binary'abc' not regexp _binary'z';
➤ abc reg_match a[-7,1,0]  ¦  abc not reg_match z[-7,1,0]  𝄀
1  ¦  1
prepare regexp_reject_binary from 'select regexp_instr(?, _binary''a'')';
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to regexp_instr.
prepare regexp_reject_nested from 'select regexp_instr(regexp_substr(?, ?), _binary''.'')';
Character set 'utf8mb4_general_ci' cannot be used in conjunction with 'binary' in call to regexp_instr.
set @rs=_binary'éa', @rp=_binary'é';
select 'éa' regexp @rp, 'éa' rlike @rp, 'éa' not regexp @rp;
➤ éa reg_match @rp[-7,1,0]  ¦  éa reg_match @rp[-7,1,0]  ¦  éa not reg_match @rp[-7,1,0]  𝄀
0  ¦  0  ¦  1
select regexp_like('éa',@rp), regexp_like('éa',@rp,'c');
➤ regexp_like(éa, @rp)[-7,1,0]  ¦  regexp_like(éa, @rp, c)[-7,1,0]  𝄀
0  ¦  0
select regexp_instr(@rs,'é'), regexp_instr('éa',@rp), regexp_instr(@rs,@rp);
➤ regexp_instr(@rs, é)[-5,64,0]  ¦  regexp_instr(éa, @rp)[-5,64,0]  ¦  regexp_instr(@rs, @rp)[-5,64,0]  𝄀
0  ¦  0  ¦  1
select hex(regexp_substr(@rs,'é')), hex(regexp_substr('éa',@rp)), hex(regexp_substr(@rs,@rp));
➤ hex(regexp_substr(@rs, é))[12,6,0]  ¦  hex(regexp_substr(éa, @rp))[12,16,0]  ¦  hex(regexp_substr(@rs, @rp))[12,6,0]  𝄀
null  ¦  null  ¦  C3A9
set @rp=_binary'a';
select regexp_instr('éa',@rp), regexp_instr('éa',@rp,2), regexp_instr('éa',@rp,2,1), regexp_instr('éa',@rp,2,1,1);
➤ regexp_instr(éa, @rp)[-5,64,0]  ¦  regexp_instr(éa, @rp, 2)[-5,64,0]  ¦  regexp_instr(éa, @rp, 2, 1)[-5,64,0]  ¦  regexp_instr(éa, @rp, 2, 1, 1)[-5,64,0]  𝄀
2  ¦  2  ¦  2  ¦  3
select regexp_instr(@rs,'a'), regexp_instr(@rs,'a',2), regexp_instr(@rs,'a',2,1), regexp_instr(@rs,'a',2,1,1);
➤ regexp_instr(@rs, a)[-5,64,0]  ¦  regexp_instr(@rs, a, 2)[-5,64,0]  ¦  regexp_instr(@rs, a, 2, 1)[-5,64,0]  ¦  regexp_instr(@rs, a, 2, 1, 1)[-5,64,0]  𝄀
3  ¦  3  ¦  3  ¦  4
