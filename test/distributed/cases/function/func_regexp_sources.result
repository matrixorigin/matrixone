➤ hex(regexp_substr(@rs, .))[12,6,0]  ¦  hex(regexp_substr(@rs, ., 2))[12,6,0]  ¦  hex(regexp_substr(@rs, ., 2, 1))[12,6,0]  𝄀
C3  ¦  A9  ¦  A9
select hex(regexp_substr('éa',@rp)), hex(regexp_substr('éa',@rp,2)), hex(regexp_substr('éa',@rp,2,1));
➤ hex(regexp_substr(éa, @rp))[12,16,0]  ¦  hex(regexp_substr(éa, @rp, 2))[12,16,0]  ¦  hex(regexp_substr(éa, @rp, 2, 1))[12,16,0]  𝄀
61  ¦  61  ¦  61
select hex(regexp_replace(@rs,'.','X')), hex(regexp_replace(@rs,'.','X',2)), hex(regexp_replace(@rs,'.','X',2,1));
➤ hex(regexp_replace(@rs, ., X))[12,38,0]  ¦  hex(regexp_replace(@rs, ., X, 2))[12,38,0]  ¦  hex(regexp_replace(@rs, ., X, 2, 1))[12,38,0]  𝄀
585858  ¦  C35858  ¦  C35861
select hex(regexp_replace('éa',@rp,'X')), hex(regexp_replace('éa',@rp,'X',2)), hex(regexp_replace('éa',@rp,'X',2,1));
➤ hex(regexp_replace(éa, @rp, X))[12,88,0]  ¦  hex(regexp_replace(éa, @rp, X, 2))[12,88,0]  ¦  hex(regexp_replace(éa, @rp, X, 2, 1))[12,88,0]  𝄀
