set sql_mode='';
create table invalid_text(v varchar(10));
insert into invalid_text values (x'ff61');
select hex(v), regexp_instr(v,'a'), v regexp 'a', v rlike 'a', regexp_like(v,'a') from invalid_text;
➤ hex(v)[12,80,0]  ¦  regexp_instr(v, a)[-5,64,0]  ¦  v reg_match a[-7,1,0]  ¦  v reg_match a[-7,1,0]  ¦  regexp_like(v, a)[-7,1,0]  𝄀
FF61  ¦  0  ¦  0  ¦  0  ¦  0
drop table invalid_text;
prepare regexp_markers from 'select regexp_instr(?,?),hex(regexp_substr(?,?)),hex(regexp_replace(?,?,\'X\'))';
set @rs=_binary'éa', @rp=_binary'.';
execute regexp_markers using @rs,@rp,@rs,@rp,@rs,@rp;
➤ regexp_instr(?, ?)[-5,64,0]  ¦  hex(regexp_substr(?, ?))[-1,16383,0]  ¦  hex(regexp_replace(?, ?, X))[-1,16383,0]  𝄀
1  ¦  C383  ¦  585858
set @rs='éa', @rp='.';
execute regexp_markers using @rs,@rp,@rs,@rp,@rs,@rp;
➤ regexp_instr(?, ?)[-5,64,0]  ¦  hex(regexp_substr(?, ?))[-1,16383,0]  ¦  hex(regexp_replace(?, ?, X))[-1,16383,0]  𝄀
1  ¦  C3A9  ¦  5858
set @rs=_binary'éa', @rp=_binary'.';
execute regexp_markers using @rs,@rp,@rs,@rp,@rs,@rp;
➤ regexp_instr(?, ?)[-5,64,0]  ¦  hex(regexp_substr(?, ?))[-1,16383,0]  ¦  hex(regexp_replace(?, ?, X))[-1,16383,0]  𝄀
1  ¦  C383  ¦  585858
deallocate prepare regexp_markers;
prepare regexp_fresh from 'select regexp_instr(?,?),hex(regexp_substr(?,?)),hex(regexp_replace(?,?,\'X\'))';
execute regexp_fresh using @rs,@rp,@rs,@rp,@rs,@rp;
➤ regexp_instr(?, ?)[-5,64,0]  ¦  hex(regexp_substr(?, ?))[-1,16383,0]  ¦  hex(regexp_replace(?, ?, X))[-1,16383,0]  𝄀
1  ¦  C383  ¦  585858
deallocate prepare regexp_fresh;
set @rs=null, @rp=null;
drop database regexp_operand_sources;
