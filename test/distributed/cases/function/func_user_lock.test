-- @suit
-- @case
-- @desc:test for MySQL-compatible user-level lock functions
-- @label:bvt

SELECT IS_FREE_LOCK('prisma_migrate_lock') AS free_before;
SELECT GET_LOCK('prisma_migrate_lock', CAST(0 AS DOUBLE)) AS acquire_lock;
SELECT GET_LOCK('prisma_migrate_lock_decimal_timeout', 0.5) AS decimal_timeout_lock;
SELECT RELEASE_LOCK('prisma_migrate_lock_decimal_timeout') AS release_decimal_timeout_lock;
SELECT GET_LOCK('prisma_migrate_lock_double_timeout', CAST(0.5 AS DOUBLE)) AS double_timeout_lock;
SELECT RELEASE_LOCK('prisma_migrate_lock_double_timeout') AS release_double_timeout_lock;
SELECT IS_FREE_LOCK('PRISMA_MIGRATE_LOCK') AS uppercase_same_lock_in_use;
SELECT RELEASE_LOCK('PrIsMa_MiGrAtE_LoCk') AS release_mixed_case;
SELECT RELEASE_LOCK('prisma_migrate_lock') AS release_after_mixed_case;
SELECT IS_FREE_LOCK('prisma_migrate_lock') AS free_after_release;
SELECT RELEASE_LOCK('prisma_migrate_lock_never_created') AS release_never_created;

--error
SELECT GET_LOCK(NULL, NULL) AS get_null_name;
--error
SELECT RELEASE_LOCK(NULL) AS release_null_name;
--error
SELECT IS_FREE_LOCK(NULL) AS is_free_null_name;
--error
SELECT IS_USED_LOCK(NULL) AS is_used_null_name;
SELECT GET_LOCK('prisma_migrate_lock_null_timeout', NULL) AS get_null_timeout;
SELECT RELEASE_LOCK('prisma_migrate_lock_null_timeout') AS release_null_timeout_lock;
