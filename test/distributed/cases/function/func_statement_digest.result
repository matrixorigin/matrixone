SQL parser error: STATEMENT_DIGEST requires exactly one statement
select statement_digest('');
-- @regex("parser|syntax|empty|eof", true)
SQL parser error: STATEMENT_DIGEST requires a non-empty statement
select statement_digest('/* comment only */');
