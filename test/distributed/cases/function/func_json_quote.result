deallocate prepare json_quote_stmt;
drop table if exists json_quote_ctas;
create table json_quote_ctas as select json_quote('abc') as quoted;
select data_type, character_maximum_length from information_schema.columns where table_schema = database() and table_name = 'json_quote_ctas' and column_name = 'quoted';
