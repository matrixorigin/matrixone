CREATE TABLE temporal_time_format_rows(id INT, tm TIME, fmt VARCHAR(32));
INSERT INTO temporal_time_format_rows VALUES
(1, '03:04:05.000006', '%H'),
(2, '14:05:06.000007', '%i'),
(3, '23:06:07.000008', '%s.%f'),
(4, '12:00:00', NULL);
SELECT id, TIME_FORMAT(tm, fmt) AS formatted
FROM temporal_time_format_rows
ORDER BY id;
➤ id[4,32,0]  ¦  formatted[12,65535,0]  𝄀
1  ¦  03  𝄀
2  ¦  05  𝄀
3  ¦  07.000000  𝄀
4  ¦  null
DROP TABLE temporal_time_format_rows;
