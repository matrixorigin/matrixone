create table lazy_src(id int primary key, n int, js json, txt varchar(20));
insert into lazy_src values (1, 1, '{"p":1}', 'bad'), (2, 2, '{"p":1}', '[2]');
select id, elt(n, js, cast(txt as json)) as selected_value from lazy_src order by id;
