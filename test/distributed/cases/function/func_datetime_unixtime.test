SET time_zone='+00:00';
SELECT
FROM_UNIXTIME(2147483647) AS c1,
FROM_UNIXTIME(2147483648) AS c2,
FROM_UNIXTIME(2147483647.9999999) AS c3,
FROM_UNIXTIME(32536771199) AS c4,
FROM_UNIXTIME(32536771199.9999999) AS c5;

#SET TIMESTAMP=0;
SET time_zone = '+08:00';

SELECT FROM_UNIXTIME(32536771199);
SELECT UNIX_TIMESTAMP('3001-01-18 23:59:59');
SELECT FROM_UNIXTIME(32536771200);

SELECT UNIX_TIMESTAMP('3001-01-19 00:00:00');
SET time_zone = "+00:00";
SELECT FROM_UNIXTIME(32536771200);
SELECT UNIX_TIMESTAMP('3001-01-19 00:00:00');
SET time_zone = "+01:00";
# East of UTC
SELECT FROM_UNIXTIME(32536771199);
SELECT UNIX_TIMESTAMP('3001-01-19 00:59:59');
SELECT FROM_UNIXTIME(32536771200);
SELECT UNIX_TIMESTAMP('3001-01-19 01:00:00');
SET time_zone = "+09:00";
SELECT FROM_UNIXTIME(32536771199);
SELECT UNIX_TIMESTAMP("3001-01-19 08:59:59");
SELECT UNIX_TIMESTAMP("3001-01-19 09:00:00");
SET time_zone = "-01:00";
# West of UTC
SELECT FROM_UNIXTIME(32536771199);
SELECT UNIX_TIMESTAMP('3001-01-18 22:59:59');
# Overflow:
SELECT FROM_UNIXTIME(32536771200);
SELECT UNIX_TIMESTAMP('3001-01-18 23:59:59');
SET TIME_ZONE = "-07:00";
SELECT FROM_UNIXTIME(32536771199);
SELECT UNIX_TIMESTAMP('3001-01-18 15:59:59');
SELECT UNIX_TIMESTAMP('3001-01-18 16:00:00');
#Extreme values
SELECT FROM_UNIXTIME(9223372036854775807);
SELECT FROM_UNIXTIME(-9223372036854775808);
SELECT FROM_UNIXTIME(9223372036854775808);

SELECT FROM_UNIXTIME(99999999999999999999999999999999999999999999999999999999999999999);
select count(unix_timestamp());

# PR28316 temporal domain, metadata, AST serialization and CTAS persistence
SET time_zone = '+00:00';
SELECT
  FROM_UNIXTIME(CAST(32536771199.9999994 AS DECIMAL(20,7))) AS rounds_within_max,
  FROM_UNIXTIME(CAST(32536771199.9999995 AS DECIMAL(20,7))) IS NULL AS carry_past_max,
  FROM_UNIXTIME(CAST(32536771198.9999995 AS DECIMAL(20,7))) AS carry_into_max,
  FROM_UNIXTIME(CAST(32536771199.9999994 AS DECIMAL(20,7)), '%Y-%m-%d %H:%i:%s.%f') AS formatted_within_max,
  FROM_UNIXTIME(CAST(32536771199.9999995 AS DECIMAL(20,7)), '%Y-%m-%d %H:%i:%s.%f') IS NULL AS formatted_past_max;

SELECT
  DATE_SUB(CAST('0001-01-01 00:00:00.000000' AS DATETIME(6)), INTERVAL 1 MICROSECOND) IS NULL AS sub_one_below_min,
  DATE_SUB(CAST('0001-01-01 00:00:00.000000' AS DATETIME(6)), INTERVAL 2 MICROSECOND) IS NULL AS sub_two_below_min,
  TIMESTAMPADD(MICROSECOND, -2, CAST('0001-01-01 00:00:00.000000' AS DATETIME(6))) IS NULL AS timestampadd_below_min;

DROP DATABASE IF EXISTS pr28316_temporal;
CREATE DATABASE pr28316_temporal;
USE pr28316_temporal;
CREATE TABLE temporal_src (
  id INT,
  d3 DECIMAL(20,3),
  d9 DECIMAL(20,9),
  f DOUBLE,
  dt6 DATETIME(6)
);
INSERT INTO temporal_src VALUES
  (1, 1704067200.123, 1704067200.123456789, 1704067200.123456, '2024-01-01 00:00:00.123456');
SELECT
  FROM_UNIXTIME(d3) AS from_d3,
  FROM_UNIXTIME(d9) AS from_d9,
  FROM_UNIXTIME(f) AS from_float,
  DATE_ADD(dt6, INTERVAL 1 MICROSECOND) AS add_us,
  DATE_SUB(dt6, INTERVAL 1 MICROSECOND) AS sub_us,
  TIMESTAMPADD(MICROSECOND, 1, dt6) AS timestampadd_us,
  EXTRACT(MICROSECOND FROM TIMESTAMPADD(MICROSECOND, 1, dt6)) AS extracted
FROM temporal_src;
CREATE TABLE temporal_ctas AS SELECT
  id,
  FROM_UNIXTIME(d3) AS from_d3,
  FROM_UNIXTIME(d9) AS from_d9,
  FROM_UNIXTIME(f) AS from_float,
  DATE_ADD(dt6, INTERVAL 1 MICROSECOND) AS add_us,
  DATE_SUB(dt6, INTERVAL 1 MICROSECOND) AS sub_us,
  TIMESTAMPADD(MICROSECOND, 1, dt6) AS timestampadd_us,
  EXTRACT(MICROSECOND FROM TIMESTAMPADD(MICROSECOND, 1, dt6)) AS extracted
FROM temporal_src;
SELECT column_name, column_type, is_nullable
FROM information_schema.columns
WHERE table_schema = 'pr28316_temporal'
  AND table_name = 'temporal_ctas'
  AND column_name IN ('from_d3', 'from_d9', 'from_float', 'add_us', 'sub_us', 'timestampadd_us')
ORDER BY ordinal_position;
INSERT INTO temporal_ctas VALUES
  (2,
   FROM_UNIXTIME(CAST(1704067201.234 AS DECIMAL(20,3))),
   FROM_UNIXTIME(CAST(1704067201.234567891 AS DECIMAL(20,9))),
   FROM_UNIXTIME(CAST(1704067201.234567 AS DOUBLE)),
   DATE_ADD(CAST('2024-01-01 00:00:01.234567' AS DATETIME(6)), INTERVAL 1 MICROSECOND),
   DATE_SUB(CAST('2024-01-01 00:00:01.234567' AS DATETIME(6)), INTERVAL 1 MICROSECOND),
   TIMESTAMPADD(MICROSECOND, 1, CAST('2024-01-01 00:00:01.234567' AS DATETIME(6))),
   EXTRACT(MICROSECOND FROM TIMESTAMPADD(MICROSECOND, 1, CAST('2024-01-01 00:00:01.234567' AS DATETIME(6)))));
SELECT * FROM temporal_ctas ORDER BY id;
DROP DATABASE pr28316_temporal;

# reset
SET TIME_ZONE = "SYSTEM";
