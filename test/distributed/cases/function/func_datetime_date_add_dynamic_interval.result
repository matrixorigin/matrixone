create table t_calendar_interval (
id int primary key,
d date,
n decimal(18,7),
calc date as (adddate(d,n)) stored,
index idx_calc(calc)
);
insert into t_calendar_interval(id,d,n) values
(1,'2024-01-01',1.4),(2,'2024-01-01',1.5),(3,'2024-01-01',1.9),
(4,'2024-01-01',-1.5),(5,'2024-01-01',-0.0000009),(6,'2024-01-01',null);
select id, cast(date_add(d, interval n day) as char) as added,
cast(date_sub(d, interval n day) as char) as subtracted,
cast(adddate(d,n) as char) as alias_added, cast(subdate(d,n) as char) as alias_subtracted
from t_calendar_interval order by id;
