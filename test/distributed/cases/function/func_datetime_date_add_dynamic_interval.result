select cast(date_add(date '2024-01-01', interval cast(1.5 as decimal(3,1)) day) as char) as decimal_day,
cast(date_add(date '2024-01-01', interval cast(1.5 as double) day) as char) as double_day,
cast(date_add(date '2024-01-01', interval '1.5' day) as char) as text_day;
