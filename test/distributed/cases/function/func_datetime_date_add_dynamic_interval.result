2024-01-03  𝄀
2024-01-03
prepare calendar_day from 'select cast(adddate(date ''2024-01-01'', ?) as char) as prepared_day';
set @calendar_n=cast(1.5 as decimal(3,1));
execute calendar_day using @calendar_n;
➤ prepared_day[12,65535,0]  𝄀
2024-01-03
set @calendar_n='1.5';
execute calendar_day using @calendar_n;
➤ prepared_day[12,65535,0]  𝄀
2024-01-02
set @calendar_n=cast(-1.5 as decimal(3,1));
execute calendar_day using @calendar_n;
➤ prepared_day[12,65535,0]  𝄀
2023-12-30
set @calendar_n=null;
execute calendar_day using @calendar_n;
➤ prepared_day[12,65535,0]  𝄀
null
deallocate prepare calendar_day;
select cast(date_add(cast(null as date), interval cast(99999999999999999999 as decimal(20,0)) day) as char) as null_base,
cast(case when false then date_sub(date '2024-01-01', interval cast(99999999999999999999 as decimal(20,0)) day) else date '2024-01-01' end as char) as inactive;
