select cast(date_add(cast('2024-01-01' as datetime(6)), interval 1.1234567 second) as char) as added,
cast(date_sub(cast('2024-01-01' as datetime(6)), interval 1.1234567 second) as char) as subtracted,
cast(adddate(cast('2024-01-01' as datetime(6)), interval -0.0000009 second) as char) as negative_zero,
cast(subdate(cast('2024-01-01' as datetime(6)), interval -1.1234567 second) as char) as negative_sub;
