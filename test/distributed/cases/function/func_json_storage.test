-- JSON_STORAGE_SIZE reports MatrixOne's ByteJson logical payload length.
-- JSON_STORAGE_FREE is zero after validation because updates rebuild ByteJson.

drop table if exists json_storage_28034;
create table json_storage_28034 (id int primary key, j json, s varchar(128));
insert into json_storage_28034 values
    (1, 'null', 'null'),
    (2, 'true', 'true'),
    (3, '"x"', '"x"'),
    (4, '[]', '[]'),
    (5, '{}', '{}'),
    (6, '[1,2,3]', '[1,2,3]'),
    (7, '{"a":1}', '{"a":1}'),
    (8, null, null);

select id, json_storage_size(j), json_storage_size(s), json_storage_free(j), json_storage_free(s)
from json_storage_28034 order by id;
select json_storage_size(json_object('a', 1)), json_storage_size(json_array(1, 2, 3));
select json_storage_size(json_arrayagg(j)) from json_storage_28034 where id <= 3;
select json_storage_size(null), json_storage_free(null), json_storage_size(cast('null' as json));

update json_storage_28034 set j = json_set(j, '$', '{"longer":true}') where id = 7;
select id, json_storage_size(j), json_storage_free(j) from json_storage_28034 where id = 7;
update json_storage_28034 set j = json_remove(j, '$.longer') where id = 7;
select id, json_storage_size(j), json_storage_free(j) from json_storage_28034 where id = 7;

select json_storage_size('{invalid');
select json_storage_free('{invalid');

drop table json_storage_28034;
