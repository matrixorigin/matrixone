-- uuid_v7() is an alias of uuid(); uuid_v1()/uuid_v4()/uuid_v6() generate version-specific UUIDs.
select length(uuid_v7()), length(uuid_v1()), length(uuid_v4()), length(uuid_v6());
select is_uuid(uuid_v7()), is_uuid(uuid_v1()), is_uuid(uuid_v4()), is_uuid(uuid_v6());
-- the version nibble is the 15th character of the canonical string form
select substring(cast(uuid_v7() as varchar), 15, 1), substring(cast(uuid_v1() as varchar), 15, 1), substring(cast(uuid_v4() as varchar), 15, 1), substring(cast(uuid_v6() as varchar), 15, 1);
-- uuid(ts)/uuid_v7(ts) return the deterministic minimal v7 UUID for that instant (boundary value for range predicates)
select uuid_v7('2026-01-01 00:00:00') = uuid_v7('2026-01-01 00:00:00');
select uuid('2026-01-01 00:00:00') = uuid_v7('2026-01-01 00:00:00');
select uuid_v7('2026-01-01 00:00:00') < uuid_v7('2026-01-02 00:00:00');
select is_uuid(uuid_v7('2026-01-01 00:00:00')), substring(cast(uuid_v7('2026-01-01 00:00:00') as varchar), 15, 1);
select substring(cast(uuid_v7('2026-01-01 00:00:00') as varchar), 20, 17);
select uuid_v7(now()) <= uuid_v7();
select uuid_v7('9999-01-01') > uuid_v7();
-- uuid_v1(ts)/uuid_v6(ts) boundaries; v6 sorts by time in string order, v1 does not (time_low comes first)
select uuid_v1('2026-01-01 00:00:00') = uuid_v1('2026-01-01 00:00:00'), uuid_v6('2026-01-01 00:00:00') = uuid_v6('2026-01-01 00:00:00');
select is_uuid(uuid_v1('2026-01-01 00:00:00')), is_uuid(uuid_v6('2026-01-01 00:00:00'));
select substring(cast(uuid_v1('2026-01-01 00:00:00') as varchar), 15, 1), substring(cast(uuid_v6('2026-01-01 00:00:00') as varchar), 15, 1);
select uuid_v6('2026-01-01 00:00:00') < uuid_v6('2026-01-02 00:00:00');
select uuid_v6(now() - interval 1 minute) < uuid_v6();
select uuid_v6('5000-01-01') > uuid_v6();
select uuid_v6('9999-01-01');
-- uuid(interval)/uuid_vN(interval): fresh random id whose timestamp is the evaluation-time wall clock shifted by the interval
select is_uuid(uuid(interval 1 minute)), is_uuid(uuid_v7(interval 1 minute)), is_uuid(uuid_v1(interval 1 hour)), is_uuid(uuid_v6(interval 1 hour));
select substring(cast(uuid_v7(interval 1 minute) as varchar), 15, 1), substring(cast(uuid_v1(interval 1 hour) as varchar), 15, 1), substring(cast(uuid_v6(interval 1 hour) as varchar), 15, 1);
select uuid_v7(interval 1 minute) > uuid_v7(), uuid_v7(interval -1 minute) < uuid_v7();
select uuid_v6(interval 1 hour) > uuid_v6(), uuid_v6(interval -1 hour) < uuid_v6();
select uuid_v7(interval 1 month) > uuid_v7(interval 27 day), uuid_v7(interval 1 month) < uuid_v7(interval 32 day);
select uuid_v7(interval 1 minute) = uuid_v7(interval 1 minute);
select uuid_v7(interval null minute) is null;
-- extreme interval counts yield NULL (math.MinInt64 must not wrap in interval arithmetic)
select uuid_v7(interval -9223372036854775808 second) is null;
select uuid_v7(interval -9223372036854775808 microsecond) is null;
select uuid_v6(interval -9223372036854775808 second) is null, uuid_v1(interval -9223372036854775808 second) is null;
select uuid_v4(interval 1 minute);
-- the internal (count, unit) form must not be callable directly
select uuid_v7(5, 3);
select uuid(5, 3);
select uuid_v6(5, 3);
-- uuid_extract_version / uuid_extract_timestamp (PostgreSQL semantics; timestamp renders in session timezone like current_timestamp)
select uuid_extract_version(uuid()), uuid_extract_version(uuid_v1()), uuid_extract_version(uuid_v4()), uuid_extract_version(uuid_v6()), uuid_extract_version(uuid_v7());
select uuid_extract_timestamp(uuid_v7('2026-01-02 03:04:05.678'));
select uuid_extract_timestamp(uuid_v1('2026-01-02 03:04:05.678'));
select uuid_extract_timestamp(uuid_v6('2026-01-02 03:04:05.678'));
-- RFC 9562 appendix A.4 standard UUIDv6 example decodes to 2022-02-22 14:22:22 -05:00 (epoch 1645557742)
select unix_timestamp(uuid_extract_timestamp(cast('1ec9414c-232a-6b00-b3c8-9f6bdeced846' as uuid)));
select uuid_extract_version(cast('1ec9414c-232a-6b00-b3c8-9f6bdeced846' as uuid));
select uuid_extract_timestamp(uuid_v4()) is null, uuid_extract_timestamp(uuid_v7()) is not null;
select uuid_extract_version(null) is null, uuid_extract_timestamp(null) is null, cast(null as uuid) is null;
-- non-RFC variant (all-zero uuid): both extractors return NULL even for a non-NULL input
select uuid_extract_version(cast('00000000-0000-0000-0000-000000000000' as uuid)) is null, uuid_extract_timestamp(cast('00000000-0000-0000-0000-000000000000' as uuid)) is null;
-- the extractors synthesize NULL from non-NULL inputs, so planner metadata must keep their results nullable (view/CTAS)
create table uuid_extract_ctas as select uuid_extract_version(cast('00000000-0000-0000-0000-000000000000' as uuid)) v, uuid_extract_timestamp(uuid_v4()) ts;
desc uuid_extract_ctas;
select v is null, ts is null from uuid_extract_ctas;
drop table uuid_extract_ctas;
create view uuid_extract_view as select uuid_extract_version(uuid_v4()) v, uuid_extract_timestamp(uuid_v4()) ts;
desc uuid_extract_view;
drop view uuid_extract_view;
select uuid_extract_timestamp(uuid_v7('2026-01-01')) = cast('2026-01-01' as timestamp);
select uuid_extract_timestamp(uuid_v7(interval 1 day)) > current_timestamp();
select uuid_v7(1);
select uuid_v4(1);
create table uuid_versions_t (id uuid default uuid_v4() primary key, name varchar(10));
insert into uuid_versions_t (name) values ('Tom'), ('Jane'), ('Bob');
select count(distinct id) from uuid_versions_t;
drop table uuid_versions_t;
