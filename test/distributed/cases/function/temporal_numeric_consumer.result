drop database if exists temporal_numeric_consumer;
create database temporal_numeric_consumer;
use temporal_numeric_consumer;
set time_zone = '+00:00';
create table temporal_values (
id int primary key,
d date,
dt datetime(6),
tm time(6),
ts timestamp(6)
);
insert into temporal_values values
(1, '2024-01-01', '2024-01-01 10:00:00.000000', '01:02:03.000000', '2024-01-01 10:00:00.000000'),
(2, '2024-02-29', '2024-02-29 23:59:59.499999', '-00:00:00.500000', '2024-02-29 23:59:59.499999'),
(3, '2024-02-29', '2024-02-29 23:59:59.500000', '-12:00:00.500000', '2024-02-29 23:59:59.500000'),
(4, null, null, null, null);
select d & 3 as date_and,
length(d & 3) as date_and_length,
hex(d & 3) as date_and_hex,
dt | 1 as datetime_or,
length(dt | 1) as datetime_or_length,
tm ^ 1 as time_xor,
length(tm ^ 1) as time_xor_length,
d << 1 as date_left,
tm >> 1 as time_right
from temporal_values where id = 1;
