set @saved_sql_mode = @@sql_mode;
set sql_mode = '';
create table temporal_zero (
id int primary key,
d date default 0,
dt datetime(6) default 0,
tm time(6) default 0
);
insert into temporal_zero (id) values (1);
select d & 3 as date_and, dt | 0 as datetime_or, tm ^ 0 as time_xor,
bit_count(d) as date_bits, bit_count(dt) as datetime_bits, bit_count(tm) as time_bits,
sec_to_time(d) as date_seconds, sec_to_time(dt) as datetime_seconds, sec_to_time(tm) as time_seconds
from temporal_zero;
