# MongoDB aggregate-v1 uses the existing MO numeric contract. These are
# ordinary SQL regressions and intentionally do not require MongoDB.

select round(cast(0.125 as double), 2) as p0125,
       round(cast(2.675 as double), 2) as p2675,
       round(cast(-0.125 as double), 2) as n0125,
       round(cast(-2.675 as double), 2) as n2675;

select cast(avg(v) as char) as decimal_avg
from (
    select cast(0.10 as decimal(18,2)) v
    union all
    select cast(0.20 as decimal(18,2))
) x;

# Decimal64 grouped SUM/AVG share the row-wise numeric contract on both
# sides of the dense-state boundary. The unit tests assert internal routing.
drop table if exists decimal64_dense_numeric_contract;
create table decimal64_dense_numeric_contract (g int, v decimal(12,2));
insert into decimal64_dense_numeric_contract select result, cast(1.25 as decimal(12,2)) from generate_series(1,257) s;
insert into decimal64_dense_numeric_contract select result, cast(-0.25 as decimal(12,2)) from generate_series(1,257) s;
insert into decimal64_dense_numeric_contract select result, null from generate_series(1,257) s;
select count(*) as groups_seen, min(total) = 1.00 and max(total) = 1.00 as sum_ok, min(mean) = 0.50 and max(mean) = 0.50 as avg_ok, min(n) = 2 and max(n) = 2 as count_ok from (select g, sum(v) total, avg(v) mean, count(v) n from decimal64_dense_numeric_contract where g <= 1 group by g) a;
select count(*) as groups_seen, min(total) = 1.00 and max(total) = 1.00 as sum_ok, min(mean) = 0.50 and max(mean) = 0.50 as avg_ok, min(n) = 2 and max(n) = 2 as count_ok from (select g, sum(v) total, avg(v) mean, count(v) n from decimal64_dense_numeric_contract where g <= 255 group by g) a;
select count(*) as groups_seen, min(total) = 1.00 and max(total) = 1.00 as sum_ok, min(mean) = 0.50 and max(mean) = 0.50 as avg_ok, min(n) = 2 and max(n) = 2 as count_ok from (select g, sum(v) total, avg(v) mean, count(v) n from decimal64_dense_numeric_contract where g <= 256 group by g) a;
select count(*) as groups_seen, min(total) = 1.00 and max(total) = 1.00 as sum_ok, min(mean) = 0.50 and max(mean) = 0.50 as avg_ok, min(n) = 2 and max(n) = 2 as count_ok from (select g, sum(v) total, avg(v) mean, count(v) n from decimal64_dense_numeric_contract group by g) a;
select cast(sum(distinct v) as char) as distinct_sum, cast(avg(distinct v) as char) as distinct_avg from decimal64_dense_numeric_contract where g = 1;
select cast(sum(cast(0.25 as decimal(12,2))) as char) as constant_sum, cast(avg(cast(0.25 as decimal(12,2))) as char) as constant_avg from decimal64_dense_numeric_contract where g = 1;
select sum(v) is null as sum_null, avg(v) is null as avg_null from decimal64_dense_numeric_contract where v is null;
select sum(v) is null as sum_empty, avg(v) is null as avg_empty from decimal64_dense_numeric_contract where g = 0;
drop table decimal64_dense_numeric_contract;
