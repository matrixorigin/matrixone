drop database if exists col_extrema_batch;
create database col_extrema_batch;
use col_extrema_batch;
create table t(a int, b int);
insert into t values (1, 2), (9, 8);
select mo_ctl('dn', 'flush', 'col_extrema_batch.t');
mo_ctl(dn, flush, col_extrema_batch.t)
{\n  "method": "Flush",\n  "result": [\n    {\n      "returnStr": "OK"\n    }\n  ]\n}\n
select mo_table_col_max('col_extrema_batch', 't', 'a') as mx,
mo_table_col_min('col_extrema_batch', 't', 'a') as mn
from (select 1 as n union all select 2 union all select 3) x;
mx    mn
9    1
9    1
9    1
select mo_table_col_max('col_extrema_batch', 't', case when n = 2 then 'b' else 'a' end) as mx,
mo_table_col_min('col_extrema_batch', 't', case when n = 2 then 'b' else 'a' end) as mn
from (select 1 as n union all select 1 union all select 2 union all select 1) x
order by n;
mx    mn
9    1
9    1
9    1
8    2
select mo_table_col_max('col_extrema_batch', 't', case when n = 2 then null else 'a' end) as mx
from (select 1 as n union all select 2 union all select 1) x
order by n;
mx
9
9
null
select mo_table_col_max('col_extrema_batch', 't', 'a') as mx,
mo_table_col_min('col_extrema_batch', 't', 'a') as mn
from information_schema.tables limit 1;
mx    mn
9    1
select mo_table_col_max('col_extrema_batch', 't', 'a') as mx,
mo_table_col_min('col_extrema_batch', 't', 'a') as mn;
mx    mn
9    1
create table empty_t(a int);
select mo_table_col_max('col_extrema_batch', 'empty_t', 'a') as mx
from (select 1 as n union all select 2) x;
mx
null
null
drop database col_extrema_batch;
