create table vector_case_rows(
id int primary key,
choose_first bool,
a vecf32(2),
b vecf32(2)
);
insert into vector_case_rows values
(1, true,  '[1,2]', '[11,12]'),
(2, false, '[3,4]', '[13,14]'),
(3, null,  '[5,6]', '[15,16]'),
(4, true,  null,    '[17,18]');
select id, case when choose_first then a else b end as selected
from vector_case_rows
order by id;
