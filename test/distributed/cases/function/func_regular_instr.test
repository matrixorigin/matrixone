DROP TABLE IF EXISTS t;
CREATE TABLE t(str1 VARCHAR(20), str2 CHAR(20));
INSERT INTO t VALUES ('W * P', 'W + Z - O'), ('have has having', 'do does doing');
INSERT INTO t VALUES ('XV*XZ', 'PP-ZZ-DXA'), ('aa bbb cc ddd', 'k ii lll oooo');
SELECT REGEXP_INSTR(str1, '*'), REGEXP_INSTR(str2,'hav') FROM t;
drop table t;

create database big_data_test;
use big_data_test;
create table table_basic_for_load_100M(col1 varchar(100));
insert into table_basic_for_load_100M values(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy');
insert into table_basic_for_load_100M values('a');
select col1 from table_basic_for_load_100M;
select REGEXP_INSTR(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', ',',1);
select REGEXP_INSTR(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', 'a',1);
select REGEXP_INSTR(col1,',',1) from big_data_test.table_basic_for_load_100M;
select REGEXP_INSTR(col1,'a',1) from big_data_test.table_basic_for_load_100M;
select REGEXP_REPLACE(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', ',','b',1);
select REGEXP_REPLACE(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', 'a','b',1);
select REGEXP_REPLACE(col1,',','b',1) from big_data_test.table_basic_for_load_100M;
select REGEXP_REPLACE(col1,'a','b',1) from big_data_test.table_basic_for_load_100M;
select REGEXP_SUBSTR(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', ',',1);
select REGEXP_SUBSTR(',GHI,G;KL/MN?OPQR.STU-_+=VWXYZabcdefghigklmnopqrstuvwxy', 'a',1);
select REGEXP_SUBSTR(col1,',',1) from big_data_test.table_basic_for_load_100M;
select REGEXP_SUBSTR(col1,'a',1) from big_data_test.table_basic_for_load_100M;
drop database big_data_test;

# Positional arguments and returned offsets are one-based character positions,
# not byte offsets, for UTF-8 strings.
SELECT REGEXP_INSTR('甲😀乙😀丙', '😀') AS first_start,
       REGEXP_INSTR('甲😀乙😀丙', '😀', 1, 2, 0) AS second_start,
       REGEXP_INSTR('甲😀乙😀丙', '😀', 1, 2, 1) AS second_end,
       REGEXP_INSTR('甲😀乙😀丙', '😀', 3, 1, 0) AS from_third;
SELECT REGEXP_SUBSTR('甲😀乙😀丙', '😀', 3, 1) AS second_emoji,
       REGEXP_REPLACE('甲😀乙😀丙', '😀', 'X', 3, 1) AS replace_one,
       REGEXP_REPLACE('甲😀乙😀丙', '😀', 'X', 3, 0) AS replace_all_from_pos;

# INSTR rebases its matcher subject at pos; SUBSTR and REPLACE retain the
# original subject for anchors and boundaries.
SELECT REGEXP_INSTR('abc', '^', 2) AS instr_beginning,
       REGEXP_INSTR('abc', '(?m)^b', 2) AS instr_multiline_beginning,
       REGEXP_INSTR(CAST(_binary'中' AS VARBINARY(3)), CAST(_binary'^.' AS VARBINARY(2)), 2) AS binary_beginning;
SELECT REGEXP_SUBSTR('abc', '^', 2) IS NULL AS substr_original_anchor,
       REGEXP_REPLACE('abc', '^', 'X', 2) AS replace_original_anchor;

DROP DATABASE IF EXISTS regexp_utf8_test;
CREATE DATABASE regexp_utf8_test;
USE regexp_utf8_test;
DROP TABLE IF EXISTS t_regexp_utf8;
CREATE TABLE t_regexp_utf8(id INT PRIMARY KEY, s VARCHAR(40), vb VARBINARY(6), bl BLOB, b BINARY(6));
INSERT INTO t_regexp_utf8 VALUES
    (1, '甲😀乙😀丙', _binary'中中', _binary'中中', _binary'中中'),
    (2, 'ASCII', _binary'ASCII', _binary'ASCII', _binary'ASCII');
SELECT id, REGEXP_INSTR(s, '😀', 3, 1, 0) AS pos FROM t_regexp_utf8 ORDER BY id;
SELECT id, REGEXP_REPLACE(s, '😀', 'X', 3, 0) AS replaced FROM t_regexp_utf8 ORDER BY id;
SELECT ORD(vb) AS vb_ord, ORD(bl) AS blob_ord,
       REGEXP_INSTR(vb, CAST(_binary'中' AS VARBINARY(3)), 2) AS vb_pos,
       REGEXP_INSTR(bl, CAST(_binary'中' AS BINARY(3)), 2) AS blob_pos,
       HEX(REGEXP_SUBSTR(bl, CAST(_binary'中' AS BINARY(3)), 2)) AS blob_substr,
       HEX(REGEXP_REPLACE(bl, CAST(_binary'中' AS BINARY(3)), _binary'X', 2, 1)) AS blob_replace
FROM t_regexp_utf8 WHERE id = 1;

# Physical BINARY and BLOB columns remain compatible with text. An explicit
# binary cast instead owns a static binary VARCHAR domain and triggers 3995.
SELECT REGEXP_INSTR(bl, '中', 2) AS blob_text_pos,
       REGEXP_INSTR(b, '中', 2) AS binary_text_pos
FROM t_regexp_utf8 WHERE id = 1;
SELECT REGEXP_INSTR(CAST(b AS BINARY(6)), '中', 2) FROM t_regexp_utf8 WHERE id = 1;

# Static incompatibility is checked before NULL propagation or implicit casts.
SELECT CAST(NULL AS BINARY) REGEXP 'a';
SELECT 'abc' NOT REGEXP CAST(NULL AS BINARY(1));
SELECT REGEXP_LIKE(CAST(NULL AS BINARY), 'a');
SELECT REGEXP_INSTR('abc', CAST(NULL AS BINARY));
SELECT REGEXP_SUBSTR(CAST(NULL AS BINARY), 'a');
SELECT REGEXP_REPLACE('abc', 'a', CAST(NULL AS BINARY));
SELECT CAST('abc' AS BINARY) REGEXP 'a';
SELECT 'abc' REGEXP CAST('a' AS BINARY(1));
SELECT REGEXP_LIKE(CAST('abc' AS BINARY(3)), 'a');
SELECT REGEXP_INSTR('abc', CAST('b' AS BINARY));
SELECT REGEXP_SUBSTR(CAST('abc' AS BINARY), 'a');
SELECT REGEXP_REPLACE(CAST('abc' AS BINARY), 'a', 'X');

# Ordinary NULL and homogeneous binary operands retain their existing behavior.
SELECT NULL REGEXP 'a' AS untyped_null,
       CAST(NULL AS BINARY) REGEXP _binary'a' AS typed_binary_null,
       CAST('abc' AS BINARY(3)) REGEXP _binary'a' AS binary_match,
       HEX(REGEXP_SUBSTR(CAST('你好' AS BINARY), _binary'.')) AS binary_first_byte,
       HEX(REGEXP_SUBSTR('你好', '.')) AS text_first_character;

# Unbounded user-variable casts have a BLOB-compatible domain. An explicit
# length, including zero, instead owns a static binary VARCHAR domain.
SET @regexp_cast_numeric = 123;
SELECT REGEXP_LIKE(CAST(@regexp_cast_numeric AS BINARY), '1');
SET @regexp_cast_null = NULL;
SELECT REGEXP_LIKE(CAST(@regexp_cast_null AS BINARY), 'a');
SELECT REGEXP_LIKE((SELECT CAST(@regexp_cast_null AS BINARY)), 'a');
SET @regexp_cast_variable = 'abc';
SELECT REGEXP_LIKE(CAST(@regexp_cast_variable AS BINARY), 'a') AS variable_match;
SELECT REGEXP_LIKE(CAST(@regexp_cast_variable AS BINARY(3)), 'a');
SELECT REGEXP_LIKE(CAST(@regexp_cast_variable AS BINARY(0)), 'a');
SELECT REGEXP_LIKE((SELECT CAST(@regexp_cast_variable AS BINARY)), 'a') AS scalar_variable_match;
SELECT REGEXP_LIKE(v, 'a') AS derived_variable_match FROM (SELECT CAST(@regexp_cast_variable AS BINARY) v) s;
SELECT REGEXP_LIKE(v, 'a') FROM (SELECT CAST(@regexp_cast_variable AS BINARY(3)) v) s;
SELECT REGEXP_LIKE(CAST(v AS BINARY(3)), 'a') FROM (SELECT CAST(@regexp_cast_variable AS BINARY) v) s;

# Control-flow results use every declared value branch, including typed NULL.
SELECT REGEXP_LIKE(IF(TRUE, CAST('abc' AS BINARY(3)), CAST('abc' AS BINARY(3))), 'a');
SELECT REGEXP_LIKE(IF(FALSE, CAST('abc' AS BINARY(3)), CAST('abc' AS BINARY(3))), 'a');
SELECT REGEXP_LIKE(IF(FALSE, CAST('abc' AS BINARY(3)), 'abc'), 'a');
SELECT REGEXP_LIKE(IF(TRUE, CAST(NULL AS BINARY(3)), CAST(NULL AS BINARY(3))), 'a');
SELECT REGEXP_LIKE(COALESCE(CAST('abc' AS BINARY(3)), CAST('abc' AS BINARY(3))), 'a');
SELECT REGEXP_LIKE(COALESCE(CAST(NULL AS BINARY(3)), CAST(NULL AS BINARY(3))), 'a');
SELECT REGEXP_LIKE(IF(TRUE, CAST(@regexp_cast_variable AS BINARY(3)), CAST(@regexp_cast_variable AS BINARY(3))), 'a');
SELECT REGEXP_LIKE((SELECT IF(TRUE, CAST(NULL AS BINARY(3)), CAST(NULL AS BINARY(3)))), 'a');
SELECT REGEXP_LIKE(v, 'a') FROM (SELECT COALESCE(CAST(NULL AS BINARY(3)), CAST(NULL AS BINARY(3))) v) s;
SELECT REGEXP_LIKE(IF(TRUE, CAST('abc' AS BINARY(3)), CAST('abc' AS BINARY(3))), _binary'a') AS control_binary_match;
PREPARE regexp_if_cast_rejected FROM 'SELECT REGEXP_LIKE(IF(TRUE, CAST(@regexp_cast_variable AS BINARY(3)), CAST(@regexp_cast_variable AS BINARY(3))), ''a'')';
PREPARE regexp_coalesce_cast_rejected FROM 'SELECT REGEXP_LIKE(COALESCE(CAST(? AS BINARY(3)), CAST(? AS BINARY(3))), ''a'')';

# BLOB-compatible length classes propagate through expressions and projections.
SELECT REGEXP_LIKE(CAST(CONCAT(@regexp_cast_variable, '') AS BINARY), 'a') AS concat_variable_match;
SELECT REGEXP_LIKE(CAST(LOWER(@regexp_cast_variable) AS BINARY), 'a') AS lower_variable_match;
SELECT REGEXP_LIKE(CAST(v AS BINARY), 'a') AS cast_derived_variable_match FROM (SELECT @regexp_cast_variable v) s;
SELECT REGEXP_LIKE(v, 'a') AS derived_concat_match FROM (SELECT CAST(CONCAT(@regexp_cast_variable, '') AS BINARY) v) s;
SELECT REGEXP_LIKE((SELECT CAST(LOWER(@regexp_cast_variable) AS BINARY)), 'a') AS scalar_lower_match;
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, 3) AS BINARY), 'a');
# Finite declarations survive scalar projection and constant integer CASTs.
SELECT REGEXP_LIKE(CAST((SELECT SUBSTRING(@regexp_cast_variable, 1, 3)) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST(3 AS SIGNED)) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST('3' AS SIGNED)) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST(3.5 AS SIGNED)) AS BINARY), 'a');
-- Equivalent constant lengths retain the same bounded declaration.
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, 3e0) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST(3e0 AS SIGNED)) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(LEFT(@regexp_cast_variable, ABS(3)) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, -3) AS BINARY), 'a');
PREPARE regexp_float_length_rejected FROM 'SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, 3e0) AS BINARY), ''a'')';
PREPARE regexp_float_cast_length_rejected FROM 'SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST(3e0 AS SIGNED)) AS BINARY), ''a'')';
PREPARE regexp_abs_length_rejected FROM 'SELECT REGEXP_LIKE(CAST(LEFT(@regexp_cast_variable, ABS(3)) AS BINARY), ''a'')';
PREPARE regexp_negative_start_rejected FROM 'SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, -3) AS BINARY), ''a'')';

-- Static TEXT declarations retain finite lengths across query boundaries.
CREATE TABLE regexp_static_text_source(v TEXT);
INSERT INTO regexp_static_text_source VALUES ('abc');
SELECT REGEXP_LIKE(CAST((SELECT SUBSTRING(v, 1, 3) FROM regexp_static_text_source) AS BINARY), 'a');
SELECT REGEXP_LIKE(CAST(v AS BINARY), 'a') FROM (SELECT LEFT(v, 3) v FROM regexp_static_text_source) s;
DROP TABLE regexp_static_text_source;

-- Overflow during integer-argument conversion must not become a PREPARE charset error.
PREPARE regexp_unsigned_length FROM 'SELECT REGEXP_LIKE(CAST(SUBSTRING(@regexp_cast_variable, 1, CAST(9223372036854775808 AS UNSIGNED)) AS BINARY), ''a'')';
DEALLOCATE PREPARE regexp_unsigned_length;
SELECT REGEXP_LIKE(CAST(v AS BINARY), 'a') FROM (SELECT SUBSTRING(@regexp_cast_variable, 1, CAST(3 AS SIGNED)) v) s;
# A parameter witness is unknown, not a constant zero-length declaration.
PREPARE regexp_dynamic_length FROM 'SELECT REGEXP_LIKE(CAST(v AS BINARY), ''a'') AS dynamic_match FROM (SELECT SUBSTRING(@regexp_cast_variable, 1, ?) v) s';
SET @regexp_length = 3;
EXECUTE regexp_dynamic_length USING @regexp_length;
SET @regexp_length = 0;
EXECUTE regexp_dynamic_length USING @regexp_length;
SET @regexp_length = NULL;
EXECUTE regexp_dynamic_length USING @regexp_length;
SET @regexp_length = 3;
EXECUTE regexp_dynamic_length USING @regexp_length;
DEALLOCATE PREPARE regexp_dynamic_length;
SELECT REGEXP_LIKE(CAST(LOWER(@regexp_cast_variable) AS BINARY(3)), 'a');
SELECT REGEXP_LIKE(IF(TRUE, CAST(@regexp_cast_variable AS BINARY), CAST('abc' AS BINARY(3))), 'a') AS blob_branch_match;
SELECT REGEXP_LIKE(IF(FALSE, CAST(@regexp_cast_variable AS BINARY), CAST('abc' AS BINARY(3))), 'a') AS fixed_branch_match;
SELECT REGEXP_LIKE(COALESCE(CAST(@regexp_cast_variable AS BINARY), CAST('abc' AS BINARY(3))), 'a') AS coalesce_blob_match;

# Assignment history distinguishes unassigned, fresh NULL, and numeric NULL.
SELECT REGEXP_LIKE(CAST(@regexp_cast_never_assigned AS BINARY), 'a');
PREPARE regexp_unassigned_cast_rejected FROM 'SELECT REGEXP_LIKE(CAST(@regexp_cast_never_assigned AS BINARY), ''a'')';
PREPARE regexp_fresh_null_cast FROM 'SELECT REGEXP_LIKE(CAST(@regexp_cast_null AS BINARY), ''a'') AS fresh_null_match';
EXECUTE regexp_fresh_null_cast;
DEALLOCATE PREPARE regexp_fresh_null_cast;
SET @regexp_cast_numeric = NULL;
SELECT REGEXP_LIKE(CAST(@regexp_cast_numeric AS BINARY), '1');
PREPARE regexp_numeric_null_cast_rejected FROM 'SELECT REGEXP_LIKE(CAST(@regexp_cast_numeric AS BINARY), ''1'')';
-- NULL history survives projection before the outer CAST.
SELECT REGEXP_LIKE(CAST((SELECT @regexp_cast_numeric) AS BINARY), '1');
SELECT REGEXP_LIKE(CAST(v AS BINARY), '1') FROM (SELECT @regexp_cast_numeric v) s;
PREPARE regexp_numeric_null_scalar_rejected FROM 'SELECT REGEXP_LIKE(CAST((SELECT @regexp_cast_numeric) AS BINARY), ''1'')';
PREPARE regexp_numeric_null_derived_rejected FROM 'SELECT REGEXP_LIKE(CAST(v AS BINARY), ''1'') FROM (SELECT @regexp_cast_numeric v) s';
SET @regexp_history_text = 'abc';
SET @regexp_history_text = NULL;
SELECT REGEXP_LIKE(CAST((SELECT @regexp_history_text) AS BINARY), 'a') AS string_history_scalar;
PREPARE regexp_text_null_derived FROM 'SELECT REGEXP_LIKE(CAST(v AS BINARY), ''a'') AS string_history_derived FROM (SELECT @regexp_history_text v) s';
EXECUTE regexp_text_null_derived;
DEALLOCATE PREPARE regexp_text_null_derived;
PREPARE regexp_expression_cast_rebind FROM 'SELECT REGEXP_LIKE(CAST(CONCAT(@regexp_cast_variable, '''') AS BINARY), ''a'') AS concat_match, REGEXP_LIKE(CAST(LOWER(@regexp_cast_variable) AS BINARY), ''a'') AS lower_match, REGEXP_LIKE(CAST(v AS BINARY), ''a'') AS derived_match FROM (SELECT @regexp_cast_variable v) s';
EXECUTE regexp_expression_cast_rebind;
SET @regexp_cast_variable = _binary'abc';
EXECUTE regexp_expression_cast_rebind;
SET @regexp_cast_variable = NULL;
EXECUTE regexp_expression_cast_rebind;
SET @regexp_cast_variable = 'abc';
EXECUTE regexp_expression_cast_rebind;
DEALLOCATE PREPARE regexp_expression_cast_rebind;

# NULL regexp history must not change SQL EXECUTE numeric conversions.
SET @regexp_null_parameter = 1;
SET @regexp_null_parameter = NULL;
PREPARE regexp_null_conversion FROM 'SELECT SUBSTRING_INDEX(''a.b'', ''.'', COALESCE(?, 1.5)) AS null_conversion';
EXECUTE regexp_null_conversion USING @regexp_null_parameter;
SET @regexp_fresh_null_parameter = NULL;
EXECUTE regexp_null_conversion USING @regexp_fresh_null_parameter;
SET @regexp_text_null_parameter = 'abc';
SET @regexp_text_null_parameter = NULL;
EXECUTE regexp_null_conversion USING @regexp_text_null_parameter;
DEALLOCATE PREPARE regexp_null_conversion;
CREATE TABLE regexp_null_conversion_result(v VARCHAR(8));
PREPARE regexp_null_insert FROM 'INSERT INTO regexp_null_conversion_result SELECT SUBSTRING_INDEX(''a.b'', ''.'', COALESCE(?, 1.5))';
EXECUTE regexp_null_insert USING @regexp_null_parameter;
EXECUTE regexp_null_insert USING @regexp_fresh_null_parameter;
EXECUTE regexp_null_insert USING @regexp_text_null_parameter;
SELECT v FROM regexp_null_conversion_result;
DEALLOCATE PREPARE regexp_null_insert;
DROP TABLE regexp_null_conversion_result;

# Query boundaries and constant folding must retain expression-owned casts,
# including typed NULL. Physical BINARY/BLOB projections retain their exemption.
SELECT REGEXP_LIKE((SELECT CAST('a' AS BINARY)), 'a');
SELECT REGEXP_LIKE(v, 'a') FROM (SELECT CAST('a' AS BINARY) v) s;
SELECT REGEXP_LIKE(v, 'a') FROM (SELECT v FROM (SELECT CAST('a' AS BINARY) v) s) t;
SELECT REGEXP_LIKE((SELECT CAST(NULL AS BINARY)), 'a');
SELECT REGEXP_LIKE(v, 'a') FROM (SELECT CAST(NULL AS BINARY) v) s;
SELECT REGEXP_INSTR('abc', (SELECT CAST('a' AS BINARY)));
SELECT REGEXP_REPLACE('abc', 'a', (SELECT CAST(NULL AS BINARY)));
SELECT REGEXP_LIKE((SELECT b FROM t_regexp_utf8 WHERE id = 2), 'A') AS physical_binary_match,
       REGEXP_LIKE((SELECT bl FROM t_regexp_utf8 WHERE id = 2), 'A') AS physical_blob_match,
       REGEXP_LIKE((SELECT (SELECT b FROM t_regexp_utf8 WHERE id = 2)), 'A') AS nested_physical_binary_match;
SELECT REGEXP_LIKE(v, 'A') AS derived_physical_match FROM (SELECT b v FROM t_regexp_utf8 WHERE id = 2) s;
SELECT REGEXP_LIKE((SELECT CAST('a' AS BINARY)), _binary'a') AS scalar_binary_match;
SELECT REGEXP_LIKE(v, _binary'a') AS derived_binary_match FROM (SELECT CAST('a' AS BINARY) v) s;
PREPARE regexp_scalar_cast_rejected FROM 'SELECT REGEXP_LIKE((SELECT CAST(''a'' AS BINARY)), ''a'')';
PREPARE regexp_scalar_null_cast_rejected FROM 'SELECT REGEXP_LIKE((SELECT CAST(NULL AS BINARY)), ''a'')';
PREPARE regexp_scalar_param_cast_rejected FROM 'SELECT REGEXP_LIKE((SELECT CAST(? AS BINARY)), ''a'')';
PREPARE regexp_derived_param_cast_rejected FROM 'SELECT REGEXP_LIKE(v, ''a'') FROM (SELECT CAST(? AS BINARY) v) s';
PREPARE regexp_variable_cast_rebind FROM
    'SELECT REGEXP_LIKE(CAST(@regexp_cast_variable AS BINARY), ''a'') AS variable_match, REGEXP_LIKE((SELECT CAST(@regexp_cast_variable AS BINARY)), ''a'') AS scalar_variable_match, REGEXP_LIKE(v, ''a'') AS derived_variable_match FROM (SELECT CAST(@regexp_cast_variable AS BINARY) v) s';
EXECUTE regexp_variable_cast_rebind;
SET @regexp_cast_variable = _binary'abc';
EXECUTE regexp_variable_cast_rebind;
SET @regexp_cast_variable = NULL;
EXECUTE regexp_variable_cast_rebind;
SET @regexp_cast_variable = 'abc';
EXECUTE regexp_variable_cast_rebind;
DEALLOCATE PREPARE regexp_variable_cast_rebind;

# Explicit casts own the domain even when their input is a parameter marker.
PREPARE regexp_binary_cast_rejected FROM 'SELECT REGEXP_INSTR(CAST(? AS BINARY), ''a'')';
PREPARE regexp_binary_cast_rebind FROM 'SELECT HEX(REGEXP_SUBSTR(CAST(? AS BINARY), _binary''.'')) AS first_byte';
SET @regexp_binary_cast_subject = _binary'你好';
EXECUTE regexp_binary_cast_rebind USING @regexp_binary_cast_subject;
SET @regexp_binary_cast_subject = '你好';
EXECUTE regexp_binary_cast_rebind USING @regexp_binary_cast_subject;
SET @regexp_binary_cast_subject = NULL;
EXECUTE regexp_binary_cast_rebind USING @regexp_binary_cast_subject;
SET @regexp_binary_cast_subject = _binary'abc';
EXECUTE regexp_binary_cast_rebind USING @regexp_binary_cast_subject;
DEALLOCATE PREPARE regexp_binary_cast_rebind;

# SQL prepared parameters must be rebound from their current string domain on
# every execution; binary -> text -> binary must not retain stale metadata.
PREPARE regexp_domain_rebind FROM
    'SELECT ORD(?), REGEXP_INSTR(?, CAST(_binary''中'' AS VARBINARY(3)), 2), ORD(REGEXP_SUBSTR(?, CAST(_binary''中'' AS VARBINARY(3)), 2))';
SET @regexp_subject = CAST(_binary'中中' AS VARBINARY(6));
EXECUTE regexp_domain_rebind USING @regexp_subject, @regexp_subject, @regexp_subject;
SET @regexp_subject = '中中';
EXECUTE regexp_domain_rebind USING @regexp_subject, @regexp_subject, @regexp_subject;
# A NULL execution keeps the marker's PREPARE-time text domain; it is not the
# same as a bare NULL literal.
SET @regexp_subject = NULL;
EXECUTE regexp_domain_rebind USING @regexp_subject, @regexp_subject, @regexp_subject;
SET @regexp_subject = CAST(_binary'中中' AS BLOB);
EXECUTE regexp_domain_rebind USING @regexp_subject, @regexp_subject, @regexp_subject;
DEALLOCATE PREPARE regexp_domain_rebind;

# A direct PARAM_ITEM's current binary domain selects byte execution, but does
# not by itself trigger the static-binary charset restriction against text.
PREPARE regexp_marker_static_text FROM
    'SELECT REGEXP_INSTR(?, ''b'') AS marker_static_text';
SET @regexp_marker_subject = CAST(_binary'abc' AS VARBINARY(3));
EXECUTE regexp_marker_static_text USING @regexp_marker_subject;
SET @regexp_marker_subject = 'abc';
EXECUTE regexp_marker_static_text USING @regexp_marker_subject;
DEALLOCATE PREPARE regexp_marker_static_text;

# Scalar-subquery flattening must retain the runtime string domain of each
# parameter. Rebinding the same cached plan must neither lose byte semantics
# nor leak the prior execution's domain.
PREPARE regexp_scalar_domain_rebind FROM
    'SELECT REGEXP_INSTR((SELECT ? FROM t_regexp_utf8 LIMIT 1), (SELECT ? FROM t_regexp_utf8 LIMIT 1), 2) AS scalar_pos';
SET @regexp_scalar_subject = CAST(_binary'中中' AS VARBINARY(6));
SET @regexp_scalar_pattern = CAST(_binary'中' AS VARBINARY(3));
EXECUTE regexp_scalar_domain_rebind USING @regexp_scalar_subject, @regexp_scalar_pattern;
SET @regexp_scalar_subject = '中中';
SET @regexp_scalar_pattern = '中';
EXECUTE regexp_scalar_domain_rebind USING @regexp_scalar_subject, @regexp_scalar_pattern;
SET @regexp_scalar_subject = CAST(_binary'中中' AS BLOB);
EXECUTE regexp_scalar_domain_rebind USING @regexp_scalar_subject, @regexp_scalar_pattern;
SET @regexp_scalar_subject = CAST(_binary'中中' AS VARBINARY(6));
EXECUTE regexp_scalar_domain_rebind USING @regexp_scalar_subject, @regexp_scalar_pattern;
DEALLOCATE PREPARE regexp_scalar_domain_rebind;

# Derived-table and CTE projections introduce ColRefs before scalar-subquery
# flattening. Their parameter domain must survive that extra lineage hop too.
PREPARE regexp_derived_scalar_domain_rebind FROM
    'SELECT REGEXP_INSTR((SELECT d.subject FROM (SELECT ? AS subject) d), (SELECT d.pattern FROM (SELECT ? AS pattern) d), 2) AS derived_scalar_pos';
SET @regexp_derived_subject = CAST(_binary'中中' AS VARBINARY(6));
SET @regexp_derived_pattern = CAST(_binary'中' AS VARBINARY(3));
EXECUTE regexp_derived_scalar_domain_rebind USING @regexp_derived_subject, @regexp_derived_pattern;
SET @regexp_derived_subject = '中中';
SET @regexp_derived_pattern = '中';
EXECUTE regexp_derived_scalar_domain_rebind USING @regexp_derived_subject, @regexp_derived_pattern;
SET @regexp_derived_subject = CAST(_binary'中中' AS VARBINARY(6));
EXECUTE regexp_derived_scalar_domain_rebind USING @regexp_derived_subject, @regexp_derived_pattern;
SET @regexp_derived_pattern = CAST(_binary'中' AS VARBINARY(3));
EXECUTE regexp_derived_scalar_domain_rebind USING @regexp_derived_subject, @regexp_derived_pattern;
DEALLOCATE PREPARE regexp_derived_scalar_domain_rebind;

# A nested domain-preserving REGEXP expression can depend on several prepared
# parameters jointly. PREPARE must not reject the legal binary/binary state or
# retain it across a later text execution.
PREPARE regexp_nested_domain_rebind FROM
    'SELECT ORD(REGEXP_SUBSTR(?, ?)), REGEXP_INSTR(REGEXP_SUBSTR(?, ?), CAST(_binary''.'' AS VARBINARY(1)), 1)';
SET @regexp_nested_subject = CAST(_binary'中中' AS VARBINARY(6));
SET @regexp_nested_pattern = CAST(_binary'中' AS VARBINARY(3));
EXECUTE regexp_nested_domain_rebind USING @regexp_nested_subject, @regexp_nested_pattern, @regexp_nested_subject, @regexp_nested_pattern;
SET @regexp_nested_subject = '中中';
SET @regexp_nested_pattern = '中';
EXECUTE regexp_nested_domain_rebind USING @regexp_nested_subject, @regexp_nested_pattern, @regexp_nested_subject, @regexp_nested_pattern;
SET @regexp_nested_subject = NULL;
SET @regexp_nested_pattern = NULL;
EXECUTE regexp_nested_domain_rebind USING @regexp_nested_subject, @regexp_nested_pattern, @regexp_nested_subject, @regexp_nested_pattern;
SET @regexp_nested_subject = CAST(_binary'中中' AS BLOB);
SET @regexp_nested_pattern = CAST(_binary'中' AS BLOB);
EXECUTE regexp_nested_domain_rebind USING @regexp_nested_subject, @regexp_nested_pattern, @regexp_nested_subject, @regexp_nested_pattern;
DEALLOCATE PREPARE regexp_nested_domain_rebind;

# REGEXP_REPLACE's replacement participates in compatibility but cannot make
# its text subject-pattern result dynamic. The fixed outer text/binary mismatch
# must therefore be rejected at PREPARE rather than deferred to every EXECUTE.
PREPARE regexp_nested_replacement_static_mismatch FROM
    'SELECT REGEXP_INSTR(REGEXP_REPLACE(''a'', ''a'', ?), CAST(_binary''a'' AS VARBINARY(1)), 1)';
DROP TABLE t_regexp_utf8;
DROP DATABASE regexp_utf8_test;

# Binary subjects use one-based byte positions; text subjects use characters.
SELECT REGEXP_INSTR(CAST(_binary'中中' AS BINARY(6)), CAST(_binary'中' AS BINARY(3)), 2) AS binary_pos,
       REGEXP_INSTR(CAST(_binary'中中' AS VARBINARY(6)), CAST(_binary'中' AS VARBINARY(3)), 2) AS varbinary_pos,
       REGEXP_INSTR(CAST(_binary'中中' AS VARBINARY(6)), CAST(_binary'中' AS VARBINARY(3)), 2, 1, 1) AS varbinary_end;

# Binary regexp escape atoms and ranges operate on bytes, not Unicode code points.
SELECT REGEXP_INSTR(CAST(X'FF' AS BINARY(1)), CAST(X'5C784646' AS BINARY(4))) AS hex_escape,
       REGEXP_INSTR(CAST(X'FF' AS BINARY(1)), CAST(X'5B5C7838302D5C7846465D' AS BINARY(11))) AS byte_range;

# The optional match_type applies consistently to positioned REGEXP_INSTR.
SELECT REGEXP_INSTR('Abc abc', 'abc', 1, 1, 0, 'i') AS insensitive,
       REGEXP_INSTR('Abc abc', 'abc', 1, 1, 0, 'c') AS sensitive,
       REGEXP_INSTR('Abc abc', 'abc', 1, 1, 0, 'ic') AS rightmost_c,
       REGEXP_INSTR('Abc abc', 'abc', 1, 1, 0, 'ci') AS rightmost_i;
SELECT REGEXP_INSTR('a\nb', '^b', 1, 1, 0, 'mu') AS unix_lf,
       REGEXP_INSTR('a\rb', '^b', 1, 1, 0, 'mu') AS unix_cr;

# Explicit binary case folding uses the Windows-1252 byte facade without
# changing one-based byte positions. UTF-8-looking BINARY values are still bytes.
SELECT REGEXP_INSTR(CAST(X'78C9' AS BINARY(2)), CAST(X'E9' AS BINARY(1)), 1, 1, 0, 'i') AS binary_i,
       REGEXP_INSTR(CAST(X'78C9' AS VARBINARY(2)), CAST(X'E9' AS VARBINARY(1)), 1, 1, 0, 'i') AS varbinary_i;
SELECT REGEXP_INSTR(CAST(_binary'中中' AS BINARY(6)), CAST(_binary'中' AS BINARY(3)), 2, 1, 0, 'i') AS binary_byte_pos,
       REGEXP_INSTR(CAST(_binary'中中' AS VARBINARY(6)), CAST(_binary'中' AS VARBINARY(3)), 2, 1, 0, 'i') AS varbinary_byte_pos;
