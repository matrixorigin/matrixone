create database if not exists bvt31905;
use bvt31905;
drop table if exists t31905;
create table t31905 (id int primary key, tu tinyint unsigned, su smallint unsigned, iu int unsigned, ts tinyint, si smallint, ii int, bi bigint);
insert into t31905 values (1, 0, 0, 0, -1, -32768, -2147483648, -9223372036854775808);
insert into t31905 values (2, 255, 65535, 4294967295, 127, 32767, 2147483647, 9223372036854775807);
select ~tu, ~su, ~iu from t31905 order by id;
~tu	~su	~iu
