DROP TABLE IF EXISTS maketime_integer_contract;
CREATE TABLE maketime_integer_contract(h DECIMAL(10,1), m DOUBLE, s DECIMAL(10,6), g TIME(6) GENERATED ALWAYS AS (MAKETIME(h,m,s)) STORED);
INSERT INTO maketime_integer_contract(h,m,s) VALUES (12.5,58.5,1.125), (-12.5,59,59.999999), (NULL,NULL,NULL);
SELECT h,m,s,CAST(MAKETIME(h,m,s) AS VARCHAR),CAST(g AS VARCHAR) FROM maketime_integer_contract ORDER BY h;
➤ h[3,10,1]  ¦  m[8,53,31]  ¦  s[3,10,6]  ¦  cast(MAKETIME(h, m, s) as varchar)[12,65535,0]  ¦  cast(g as varchar)[12,65535,0]  𝄀
null  ¦  null  ¦  null  ¦  null  ¦  null  𝄀
-12.5  ¦  59.0  ¦  59.999999  ¦  -13:59:59.999999  ¦  -13:59:59.999999  𝄀
12.5  ¦  58.5  ¦  1.125000  ¦  13:58:01.125000  ¦  13:58:01.125000
DROP TABLE maketime_integer_contract;
PREPARE maketime_integer_stmt FROM 'SELECT CAST(MAKETIME(?, ?, 1.125) AS VARCHAR)';
SET @maketime_hour = NULL, @maketime_minute = 0;
EXECUTE maketime_integer_stmt USING @maketime_hour, @maketime_minute;
➤ cast(MAKETIME(?, ?, 1.125) as varchar)[12,65535,0]  𝄀
null
SET @maketime_hour = 12.5E0, @maketime_minute = 58.5;
EXECUTE maketime_integer_stmt USING @maketime_hour, @maketime_minute;
➤ cast(MAKETIME(?, ?, 1.125) as varchar)[12,65535,0]  𝄀
12:59:01.125
SET @maketime_hour = '12.9', @maketime_minute = 0;
EXECUTE maketime_integer_stmt USING @maketime_hour, @maketime_minute;
➤ cast(MAKETIME(?, ?, 1.125) as varchar)[12,65535,0]  𝄀
12:00:01.125
DEALLOCATE PREPARE maketime_integer_stmt;
SET @maketime_hour = NULL, @maketime_minute = NULL;
