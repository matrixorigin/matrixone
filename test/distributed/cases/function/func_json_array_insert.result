DROP TABLE IF EXISTS json_array_insert_docs;
CREATE TABLE json_array_insert_docs (
id INT PRIMARY KEY,
doc JSON
);
INSERT INTO json_array_insert_docs VALUES (1, '{"arr":[1,2]}');
UPDATE json_array_insert_docs
SET doc = JSON_ARRAY_INSERT(doc, '$.arr[1]', 9)
WHERE id = 1;
