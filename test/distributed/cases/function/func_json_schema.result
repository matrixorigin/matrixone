{"valid": true}
{"document-location": "$.a", "reason": "Invalid type. Expected: number, given: string", "schema-failed-keyword": "type", "schema-location": "#/type", "valid": false}
{"document-location": "$", "reason": "a is required", "schema-failed-keyword": "required", "schema-location": "#/required", "valid": false}
drop table t1;
