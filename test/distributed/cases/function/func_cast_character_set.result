select cast('abc' as char character set utf8mb4);
➤ cast(abc as char character set utf8mb4)[12,3,0]  𝄀
abc
select cast('abcdef' as char(3) character set utf8mb4);
➤ cast(abcdef as char(3) character set utf8mb4)[1,3,0]  𝄀
abc
select convert('你好😀a', char(2) character set utf8mb4);
➤ cast(你好😀a as char(2) character set utf8mb4)[1,2,0]  𝄀
你好
select convert('😀a', char(1) character set utf8mb3);
➤ cast(😀a as char(1) character set utf8mb3)[1,1,0]  𝄀
😀
select charset(cast('x' as char(2) character set utf8)), collation(cast('x' as char(2) character set utf8));
➤ charset(cast(x as char(2) character set utf8))[12,65535,0]  ¦  collation(cast(x as char(2) character set utf8))[12,65535,0]  𝄀
utf8mb4  ¦  utf8mb4_general_ci
select hex(cast('a' as char(3) character set binary)), length(cast('a' as char(3) character set binary)), char_length(cast('a' as char(3) character set binary)), charset(cast('a' as char(3) character set binary)), collation(cast('a' as char(3) character set binary));
➤ hex(cast(a as char(3) character set binary))[12,6,0]  ¦  length(cast(a as char(3) character set binary))[-5,64,0]  ¦  char_length(cast(a as char(3) character set binary))[-5,64,0]  ¦  charset(cast(a as char(3) character set binary))[12,65535,0]  ¦  collation(cast(a as char(3) character set binary))[12,65535,0]  𝄀
61  ¦  1  ¦  1  ¦  binary  ¦  binary
