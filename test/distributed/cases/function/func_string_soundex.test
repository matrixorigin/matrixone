# Basic test case from requirements
SELECT SOUNDEX('Hello') AS result1;

# Additional test cases
SELECT SOUNDEX('World') AS basic_string;
SELECT SOUNDEX('Test') AS test_string;
SELECT SOUNDEX('AEIOU') AS vowels_only;
SELECT SOUNDEX('Hello123') AS with_numbers;
SELECT SOUNDEX('Test!@#') AS with_special_chars;
SELECT SOUNDEX('') AS empty_string;
SELECT SOUNDEX('A') AS single_char;
SELECT SOUNDEX('AB') AS two_chars;
SELECT SOUNDEX('ABC') AS three_chars;

# NULL handling
SELECT SOUNDEX(NULL) AS null_input;

# Table usage
CREATE TABLE t1(str VARCHAR(50));
INSERT INTO t1 VALUES ('Hello'), ('World'), ('Test'), ('AEIOU');
SELECT str, SOUNDEX(str) AS soundex_code FROM t1;
DROP TABLE t1;

# WHERE clause
CREATE TABLE t1(str VARCHAR(50));
INSERT INTO t1 VALUES ('Hello'), ('World'), ('Test');
SELECT * FROM t1 WHERE SOUNDEX(str) = SOUNDEX('Hello');
DROP TABLE t1;

# Comparison - words that sound similar should have same soundex
SELECT SOUNDEX('Smith') AS smith, SOUNDEX('Smythe') AS smythe;
SELECT SOUNDEX('Robert') AS robert, SOUNDEX('Rupert') AS rupert;

# MySQL original Soundex: first-code suppression and variable-length results.
SELECT HEX(SOUNDEX('Ashcraft')) AS ashcraft, HEX(SOUNDEX('Pfister')) AS pfister, HEX(SOUNDEX('Tymczak')) AS tymczak, HEX(SOUNDEX('Quadratically')) AS quadratically, HEX(SOUNDEX('BDFJLMPR')) AS long_code, HEX(SOUNDEX('BDFJLMPRB')) AS capacity_plus_one;
SELECT LENGTH(SOUNDEX(CONCAT(REPEAT('BEB', 4096), REPEAT('BC', 64)))) AS late_growth_len, SOUNDEX(CONCAT(REPEAT('BEB', 4096), REPEAT('BC', 64))) = CONCAT('B2', REPEAT('12', 63)) AS late_growth_exact;
SELECT HEX(SOUNDEX('BEB')) AS vowel, HEX(SOUNDEX('BHB')) AS h, HEX(SOUNDEX('BWB')) AS w, HEX(SOUNDEX('B-B')) AS punctuation;
SELECT HEX(SOUNDEX('')) = '' AS empty_string, HEX(SOUNDEX('123!')) = '' AS digits_only, HEX(SOUNDEX('123!ABC')) = HEX('A120') AS leading_non_alpha;
SELECT SOUNDEX('pfister') = SOUNDEX('Pfister') AS case_insensitive;

# Column, NULL, CHAR, and prepared execution paths.
DROP TABLE IF EXISTS t_soundex_regression;
CREATE TABLE t_soundex_regression(id INT PRIMARY KEY, v VARCHAR(50));
INSERT INTO t_soundex_regression VALUES (1, 'Ashcraft'), (2, 'Pfister'), (3, 'Tymczak'), (4, 'Quadratically'), (5, '123!'), (6, NULL), (7, 'BEB'), (8, 'pfister');
SELECT id, HEX(SOUNDEX(v)) AS code_hex, LENGTH(SOUNDEX(v)) AS code_len FROM t_soundex_regression ORDER BY id;
DROP TABLE t_soundex_regression;
DROP TABLE IF EXISTS t_soundex_char;
CREATE TABLE t_soundex_char(v CHAR(8));
INSERT INTO t_soundex_char VALUES ('Pfister');
SELECT HEX(SOUNDEX(v)) AS code_hex FROM t_soundex_char;
DROP TABLE t_soundex_char;
PREPARE soundex_stmt FROM 'SELECT HEX(SOUNDEX(CAST(? AS VARCHAR(32)))) AS code_hex';
SET @soundex_input='Pfister';
EXECUTE soundex_stmt USING @soundex_input;
DEALLOCATE PREPARE soundex_stmt;
SET @soundex_input=NULL;

# A TEXT input can produce a result wider than VARCHAR's declared 65535-byte width.
DROP TABLE IF EXISTS t_soundex_long;
CREATE TABLE t_soundex_long(v MEDIUMTEXT);
INSERT INTO t_soundex_long VALUES (REPEAT('BC', 32769));
SELECT LENGTH(SOUNDEX(v)) AS code_len, HEX(LEFT(SOUNDEX(v), 16)) = HEX('B212121212121212') AS prefix_ok, HEX(RIGHT(SOUNDEX(v), 16)) = HEX('1212121212121212') AS suffix_ok FROM t_soundex_long;
DROP TABLE IF EXISTS t_soundex_ctas_65535;
CREATE TABLE t_soundex_ctas_65535 AS SELECT SOUNDEX(CAST(CONCAT(REPEAT('BC', 32767), 'B') AS VARCHAR(65535))) AS code FROM t_soundex_long LIMIT 1;
SELECT LENGTH(code) AS code_len FROM t_soundex_ctas_65535;
DROP TABLE t_soundex_ctas_65535;
DROP TABLE IF EXISTS t_soundex_ctas_65536;
CREATE TABLE t_soundex_ctas_65536 AS SELECT SOUNDEX(CAST(REPEAT('BC', 32768) AS MEDIUMTEXT)) AS code FROM t_soundex_long LIMIT 1;
SELECT LENGTH(code) AS code_len FROM t_soundex_ctas_65536;
DROP TABLE t_soundex_ctas_65536;
DROP TABLE t_soundex_long;

# VARBINARY input preserves SOUNDEX's binary result domain.
DROP TABLE IF EXISTS soundex_binary_domain;
CREATE TABLE soundex_binary_domain(id INT PRIMARY KEY, b VARBINARY(64));
INSERT INTO soundex_binary_domain VALUES
(1, CAST('Ashcraft' AS VARBINARY(64))),
(2, UNHEX('41FF42')),
(3, X''),
(4, NULL);
SELECT id, COALESCE(NULLIF(HEX(SOUNDEX(b)), ''), '<empty>') AS code_hex,
SOUNDEX(b) IS NULL AS is_null
FROM soundex_binary_domain ORDER BY id;
CREATE VIEW soundex_binary_view AS SELECT SOUNDEX(b) AS s FROM soundex_binary_domain;
CREATE TABLE soundex_binary_ctas AS SELECT SOUNDEX(b) AS s FROM soundex_binary_domain;
SELECT table_name, column_name, data_type, character_maximum_length,
character_set_name, collation_name
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('soundex_binary_view', 'soundex_binary_ctas')
ORDER BY table_name;
DROP TABLE soundex_binary_ctas;
DROP VIEW soundex_binary_view;
DROP TABLE soundex_binary_domain;

# SQL PREPARE/EXECUTE treats binary user variables as text only at the bare
# SOUNDEX marker. Reusing one prepared plan must follow each execution's type.
PREPARE soundex_prepared_28912 FROM 'SELECT HEX(SOUNDEX(?)) AS code_hex, SOUNDEX(?) IS NULL AS is_null';
SET @soundex_prepared_28912 = CAST(UNHEX('C3A9') AS VARBINARY(2));
EXECUTE soundex_prepared_28912 USING @soundex_prepared_28912, @soundex_prepared_28912;
SET @soundex_prepared_28912 = 'Pfister';
EXECUTE soundex_prepared_28912 USING @soundex_prepared_28912, @soundex_prepared_28912;
SET @soundex_prepared_28912 = CAST(UNHEX('C3A9') AS VARBINARY(2));
EXECUTE soundex_prepared_28912 USING @soundex_prepared_28912, @soundex_prepared_28912;
SET @soundex_prepared_28912 = NULL;
EXECUTE soundex_prepared_28912 USING @soundex_prepared_28912, @soundex_prepared_28912;
DEALLOCATE PREPARE soundex_prepared_28912;

# Explicit binary and direct binary inputs keep byte-oriented Soundex.
SELECT COALESCE(NULLIF(HEX(SOUNDEX(CAST(UNHEX('C3A9') AS VARBINARY(2)))), ''), '<empty>') AS direct_binary_hex;

# SOUNDS LIKE (#23010; SOUNDS LIKE subitem of #24496).
SELECT 'Hello' SOUNDS /*! LIKE */ 'Hallo' AS comment_like, 'Hello' SOUNDS /*!50000 LIKE */ 'Hallo' AS version_like, 'Hello' /*! SOUNDS */ LIKE 'Hallo' AS comment_sounds;
# Independent known results, ordinary NULL equality, and full Soundex codes.
SELECT 'Hello' SOUNDS LIKE 'Hallo' AS matched, 'Robert' SOUNDS LIKE 'Rubin' AS different, 'BDFJLMPR' SOUNDS LIKE 'BDFJLMPRB' AS full_code;
SELECT NULL SOUNDS LIKE 'Robert' AS left_null, 'Robert' SOUNDS LIKE NULL AS right_null, NULL SOUNDS LIKE NULL AS both_null;
SELECT '' SOUNDS LIKE '123!' AS empty_code, 123 SOUNDS LIKE 456 AS numeric_inputs, CAST('Robert' AS CHAR(16)) SOUNDS LIKE CAST('Rupert' AS TEXT) AS string_types;
SELECT CAST('Robert' AS VARBINARY(16)) SOUNDS LIKE CAST('Rupert' AS VARBINARY(16)) AS binary_inputs, CAST(UNHEX('C3A9') AS VARBINARY(2)) SOUNDS LIKE 'é' AS binary_text;
SELECT CONCAT('Ro', 'bert') SOUNDS /* phrase */ LIKE LOWER('RUPERT') AS expressions, 1 + 2 SOUNDS LIKE 3 * 4 AS arithmetic, 'Robert' SOUNDS LIKE 'Rupert' = 'Smith' SOUNDS LIKE 'Smythe' AS comparisons;

# The SQL mode controls NOT's operand without changing the phonetic predicate.
SET @sounds_like_saved_mode = @@sql_mode;
SET sql_mode = '';
SELECT NOT 0 SOUNDS LIKE 'a' AS default_not;
SET sql_mode = 'HIGH_NOT_PRECEDENCE';
SELECT NOT 0 SOUNDS LIKE 'a' AS high_not;
SET sql_mode = @sounds_like_saved_mode;

# Mixed rows prove vector NULL handling, filtering and CASE consumers.
DROP TABLE IF EXISTS sounds_like_inputs;
CREATE TABLE sounds_like_inputs(id INT PRIMARY KEY, sounds VARCHAR(32), other VARCHAR(32));
INSERT INTO sounds_like_inputs VALUES (1, 'Robert', 'Rupert'), (2, 'Robert', 'Rubin'), (3, NULL, 'Robert'), (4, '', '123!');
SELECT id, sounds SOUNDS LIKE other AS matched, (sounds SOUNDS LIKE other) <=> (SOUNDEX(sounds) = SOUNDEX(other)) AS equivalent FROM sounds_like_inputs ORDER BY id;
SELECT id FROM sounds_like_inputs WHERE sounds SOUNDS LIKE other ORDER BY id;
SELECT id, CASE WHEN sounds SOUNDS LIKE other THEN 'same' ELSE 'different' END AS category FROM sounds_like_inputs ORDER BY id;
SELECT sounds FROM sounds_like_inputs WHERE sounds LIKE 'Ro%' ORDER BY id;
SELECT 'alias' sounds FROM sounds_like_inputs WHERE id = 1;

# One prepared plan reuses text, binary and NULL operands; the last marker
# verifies that lowering neither duplicates nor reorders parameter occurrences.
PREPARE sounds_like_stmt FROM 'SELECT ? SOUNDS LIKE ? AS matched, ? AS marker';
SET @sounds_like_left = 'Robert', @sounds_like_right = 'Rupert', @sounds_like_marker = 7;
EXECUTE sounds_like_stmt USING @sounds_like_left, @sounds_like_right, @sounds_like_marker;
SET @sounds_like_right = 'Rubin';
EXECUTE sounds_like_stmt USING @sounds_like_left, @sounds_like_right, @sounds_like_marker;
SET @sounds_like_left = CAST(UNHEX('C3A9') AS VARBINARY(2)), @sounds_like_right = 'é';
EXECUTE sounds_like_stmt USING @sounds_like_left, @sounds_like_right, @sounds_like_marker;
SET @sounds_like_left = NULL;
EXECUTE sounds_like_stmt USING @sounds_like_left, @sounds_like_right, @sounds_like_marker;
SET @sounds_like_left = 'Robert', @sounds_like_right = 'Rupert';
EXECUTE sounds_like_stmt USING @sounds_like_left, @sounds_like_right, @sounds_like_marker;
DEALLOCATE PREPARE sounds_like_stmt;

# Export the public canonical view definition, replay it as a second view,
# and materialize its result. This exercises persisted and formatted consumers.
CREATE VIEW sounds_like_view AS SELECT id, sounds SOUNDS LIKE other AS matched FROM sounds_like_inputs;
SELECT id, matched FROM sounds_like_view ORDER BY id;
SELECT VIEW_DEFINITION LIKE '%soundex%' AND VIEW_DEFINITION NOT LIKE '%sounds like%' AS lowered FROM information_schema.views WHERE table_schema = DATABASE() AND table_name = 'sounds_like_view';
SET @sounds_like_replay_sql = (SELECT CONCAT('CREATE VIEW sounds_like_replayed AS ', VIEW_DEFINITION) FROM information_schema.views WHERE table_schema = DATABASE() AND table_name = 'sounds_like_view');
PREPARE sounds_like_replay FROM @sounds_like_replay_sql;
EXECUTE sounds_like_replay;
DEALLOCATE PREPARE sounds_like_replay;
SELECT id, matched FROM sounds_like_replayed ORDER BY id;
CREATE TABLE sounds_like_ctas AS SELECT id, sounds SOUNDS LIKE other AS matched FROM sounds_like_inputs;
SELECT id, matched FROM sounds_like_ctas ORDER BY id;
DROP TABLE sounds_like_ctas;
DROP VIEW sounds_like_replayed;
DROP VIEW sounds_like_view;
DROP TABLE sounds_like_inputs;
SET @sounds_like_saved_mode = NULL, @sounds_like_left = NULL, @sounds_like_right = NULL, @sounds_like_marker = NULL, @sounds_like_replay_sql = NULL;
