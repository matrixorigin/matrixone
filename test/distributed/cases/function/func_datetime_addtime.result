DROP TABLE IF EXISTS addtime_date_fsp, addtime_date_fsp_result;
CREATE TABLE addtime_date_fsp(id INT, d DATE, t TIME(6));
INSERT INTO addtime_date_fsp VALUES
(1, '2024-02-29', '00:00:00.123456'),
(2, '2024-02-29', '00:00:00.999999'),
(3, '2024-02-29', '-00:00:00.000001'),
(4, NULL, '00:00:00.123456'),
(5, '2024-02-29', NULL);
SELECT id, ADDTIME(d, t) AS added, MICROSECOND(ADDTIME(d, t)) AS micros,
SUBTIME(d, t) AS subtracted FROM addtime_date_fsp ORDER BY id;
➤ id[4,32,0]  ¦  added[93,26,0]  ¦  micros[-5,64,0]  ¦  subtracted[93,26,0]  𝄀
1  ¦  2024-02-29 00:00:00.123456000  ¦  123456  ¦  2024-02-28 23:59:59.876544000  𝄀
2  ¦  2024-02-29 00:00:00.999999000  ¦  999999  ¦  2024-02-28 23:59:59.000001000  𝄀
3  ¦  2024-02-28 23:59:59.999999000  ¦  999999  ¦  2024-02-29 00:00:00.000001000  𝄀
4  ¦  null  ¦  null  ¦  null  𝄀
5  ¦  null  ¦  null  ¦  null
CREATE TABLE addtime_date_fsp_result AS
SELECT id, ADDTIME(d, t) AS added, SUBTIME(d, t) AS subtracted FROM addtime_date_fsp;
SELECT column_name, data_type, datetime_precision FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 'addtime_date_fsp_result'
AND column_name IN ('added', 'subtracted') ORDER BY ordinal_position;
➤ column_name[12,256,0]  ¦  data_type[12,65535,0]  ¦  datetime_precision[-5,64,0]  𝄀
added  ¦  datetime  ¦  6  𝄀
subtracted  ¦  datetime  ¦  6
SELECT id, added, MICROSECOND(added) AS micros, subtracted FROM addtime_date_fsp_result ORDER BY id;
