select json_value('{"fname": "Joe", "lname": "Palmer"}', '$.fname');
json_value({"fname": "Joe", "lname": "Palmer"}, $.fname)
Joe
select json_value('{"fname": "Joe", "lname": "Palmer"}', '$.lname');
json_value({"fname": "Joe", "lname": "Palmer"}, $.lname)
Palmer
select json_value('{"a":[12]}', '$.a');
json_value({"a":[12]}, $.a)
[12]
select json_value('{"a":{"k":1}}', '$.a');
json_value({"a":{"k":1}}, $.a)
{"k": 1}
select json_value('{}', '$.missing' default 'empty' on empty);
json_value({}, $.missing default 'empty' on empty)
empty
select json_value('{"a":"bad"}', '$.a' returning unsigned default 7 on error);
json_value({"a":"bad"}, $.a returning unsigned default 7 on error)
7
select json_value('{"a":1,"b":2}', '$.*' returning unsigned default 7 on error);
json_value({"a":1,"b":2}, $.* returning unsigned default 7 on error)
7
select json_value('{"a":[12]}', '$.a' returning json);
json_value({"a":[12]}, $.a returning json)
[12]
select json_value('{"a":"longer"}', '$.a' returning char(4) default 'back' on error);
json_value({"a":"longer"}, $.a returning char(4) default 'back' on error)
back
select json_value(null, '$.a' default 'empty' on empty);
json_value(null, $.a default 'empty' on empty)
null
select json_value('{"d":"2024-01-02 12:34:56"}', '$.d' returning date default '2000-01-01' on error) as d;
d
2000-01-01
select json_value('{"d":"2024-01-02"}', '$.d' returning date) as d;
d
2024-01-02
select json_value('{}', '$.a' returning unsigned default 5 on empty default 7 on error) as n;
n
5
select json_value('{"a":"bad"}', '$.a' returning unsigned default 5 on empty default 7 on error) as n;
n
7
select json_value('{"a":1,"b":2}', '$.*' default 'empty' on empty default 'error' on error) as s;
s
error
select json_value('{"a":1,"b":2}', '$.*' returning json default '5' on empty default '7' on error) as j;
j
7
select json_value('{}', '$.a' returning json default '5' on empty default '7' on error) as j;
j
5
create table json_value_responses (id int, doc varchar(100));
insert into json_value_responses values (1, '{}'), (2, '{"a":"bad"}'), (3, '{"a":9}'), (4, '{"a":null}');
select id, json_value(doc, '$.a' returning unsigned default 5 on empty default 7 on error) as n from json_value_responses order by id;
id	n
1	5
2	7
3	9
4	null
select id from json_value_responses where json_value(doc, '$.a' returning unsigned default 5 on empty default 7 on error) = 7 order by id;
id
2
drop table json_value_responses;
create view json_value_view as select json_value('{"a":[12]}', '$.a') as extracted;
select extracted from json_value_view;
extracted
[12]
drop view json_value_view;
prepare json_value_stmt from 'select json_value(?, ''$.a'' returning unsigned default 7 on error)';
set @json_value_doc = '{"a":"bad"}';
execute json_value_stmt using @json_value_doc;
json_value(?, $.a returning unsigned default 7 on error)
7
deallocate prepare json_value_stmt;
drop table if exists json_value_ctas;
create table json_value_ctas as select json_value('{"a":[12]}', '$.a') as extracted;
select extracted from json_value_ctas;
extracted
[12]
drop table json_value_ctas;
drop table if exists json_value_generated;
create table json_value_generated (id int primary key, doc json, extracted varchar(512) generated always as (json_value(doc, '$.a')) stored, key extracted_idx (extracted));
insert into json_value_generated(id, doc) values (1, '{"a":[12]}'), (2, '{"a":{"k":1}}'), (3, '{"a":"scalar"}');
select id, extracted from json_value_generated order by id;
id	extracted
1	[12]
2	{"k": 1}
3	scalar
select id, extracted from json_value_generated force index(extracted_idx) where extracted = '[12]';
id	extracted
1	[12]
select id, extracted from json_value_generated force index(extracted_idx) where extracted = '{"k": 1}';
id	extracted
2	{"k": 1}
update json_value_generated set doc = '{"a":[99]}' where id = 3;
select id, extracted from json_value_generated order by id;
id	extracted
1	[12]
2	{"k": 1}
3	[99]
select id, extracted from json_value_generated force index(extracted_idx) where extracted = '[99]';
id	extracted
3	[99]
drop table json_value_generated;
select json_value('{"item": "shoes", "price": "49.95"}', '$.price');
json_value({"item": "shoes", "price": "49.95"}, $.price)
49.95
select json_value('{"a": {"b": [1,2,3]}}', '$.a.b[1]');
json_value({"a": {"b": [1,2,3]}}, $.a.b[1])
2
select json_value('{"active": true}', '$.active');
json_value({"active": true}, $.active)
true
select json_value('{"x": null}', '$.x');
json_value({"x": null}, $.x)
null
select json_value('{"a": 1}', '$.missing');
json_value({"a": 1}, $.missing)
null
select json_value(null, '$.a');
json_value(null, $.a)
null
select json_value('{}', '$[');
invalid argument json_value, bad value invalid path expression
select json_value('{"a": 1}', null);
json_value({"a": 1}, null)
null
drop table if exists t1;
create table t1 (a varchar(200));
insert into t1 values ('{"name":"Alice","age":30}'), ('{"name":"Bob","age":25}'), (null);
select json_value(a, '$.name') from t1;
json_value(a, $.name)
Alice
Bob
null
select json_value(a, '$.age') from t1;
json_value(a, $.age)
30
25
null
drop table t1;
select json_value(cast('{"a": 1, "b": 2}' as json), '$.a');
json_value(cast({"a": 1, "b": 2} as json), $.a)
1
select json_value(cast('{"a": 1, "b": 2}' as json), '$.b');
json_value(cast({"a": 1, "b": 2} as json), $.b)
2
select json_value(cast('[1,2,{"x":3}]' as json), '$[2].x');
json_value(cast([1,2,{"x":3}] as json), $[2].x)
3
select json_value(json_object('k1', 'v1', 'k2', 42), '$.k1');
json_value(json_object(k1, v1, k2, 42), $.k1)
v1
select json_value(json_object('k1', 'v1', 'k2', 42), '$.k2');
json_value(json_object(k1, v1, k2, 42), $.k2)
42
select json_value(json_array(1, 2, 3), '$[0]');
json_value(json_array(1, 2, 3), $[0])
1
select json_value(json_array(1, 2, 3), '$[2]');
json_value(json_array(1, 2, 3), $[2])
3
select json_value('{"a":1,"b":2}', '$.*');
json_value({"a":1,"b":2}, $.*)
null
select json_value('{"a":1,"b":2}', '$[*]');
json_value({"a":1,"b":2}, $[*])
null
select json_value('{"a":1,"b":2}', '$**.a');
json_value({"a":1,"b":2}, $**.a)
1
select json_value('{"x":[12],"o":{"k":1},"s":12}', '$.x');
json_value({"x":[12],"o":{"k":1},"s":12}, $.x)
[12]
select json_value('{"x":[12],"o":{"k":1},"s":12}', '$.o');
json_value({"x":[12],"o":{"k":1},"s":12}, $.o)
{"k": 1}
select json_value('{"x":[12],"o":{"k":1},"s":12}', '$.s');
json_value({"x":[12],"o":{"k":1},"s":12}, $.s)
12
select json_value('[1,2,3]', '$');
json_value([1,2,3], $)
[1, 2, 3]
select json_value('{"a":"b"}', '$');
json_value({"a":"b"}, $)
{"a": "b"}
select json_value('{}', '$');
json_value({}, $)
{}
select json_value('[]', '$');
json_value([], $)
[]
select json_value('[{}]', '$[*]');
json_value([{}], $[*])
{}
drop table if exists json_value_generated_idx;
create table json_value_generated_idx (id int primary key, doc json not null, extracted varchar(64) as (json_value(doc, '$.x')) stored, index extracted_idx(extracted));
insert into json_value_generated_idx(id, doc) values (1, '{"x":[12]}'), (2, '{"x":{"k":1}}'), (3, '{"x":"scalar"}');
select id, extracted from json_value_generated_idx order by id;
id	extracted
1	[12]
2	{"k": 1}
3	scalar
select id from json_value_generated_idx force index(extracted_idx) where extracted = '[12]';
id
1
select id from json_value_generated_idx force index(extracted_idx) where extracted = '{"k": 1}';
id
2
update json_value_generated_idx set doc = '{"x":[99]}' where id = 3;
select id, extracted from json_value_generated_idx where id = 3;
id	extracted
3	[99]
select id from json_value_generated_idx force index(extracted_idx) where extracted = 'scalar';
id
select id from json_value_generated_idx force index(extracted_idx) where extracted = '[99]';
id
3
drop table json_value_generated_idx;
