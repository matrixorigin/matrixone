# Basic test case from requirements
SELECT EXPORT_SET(5, 'Y', 'N', ',', 4) AS result1;

# Additional test cases
# Basic usage
SELECT EXPORT_SET(5, 'Y', 'N', ',', 4) AS export_set_basic;
SELECT EXPORT_SET(5, 'Y', 'N') AS export_set_default_sep;
SELECT EXPORT_SET(5, 'Y', 'N', ',') AS export_set_default_bits;

# Different bit patterns
SELECT EXPORT_SET(0, 'Y', 'N', ',', 4) AS export_set_zero;
SELECT EXPORT_SET(15, 'Y', 'N', ',', 4) AS export_set_all_ones;
SELECT EXPORT_SET(1, 'Y', 'N', ',', 4) AS export_set_one;
SELECT EXPORT_SET(8, 'Y', 'N', ',', 4) AS export_set_eight;

# Different separators
SELECT EXPORT_SET(5, 'Y', 'N', '|', 4) AS export_set_pipe;
SELECT EXPORT_SET(5, 'Y', 'N', '-', 4) AS export_set_dash;
SELECT EXPORT_SET(5, 'Y', 'N', '', 4) AS export_set_empty_sep;
SELECT EXPORT_SET(5, 'Y', 'N', ' ', 4) AS export_set_space;

# Different on/off strings
SELECT EXPORT_SET(5, 'ON', 'OFF', ',', 4) AS export_set_on_off;
SELECT EXPORT_SET(5, '1', '0', ',', 4) AS export_set_1_0;
SELECT EXPORT_SET(5, 'true', 'false', ',', 4) AS export_set_true_false;

# Different number_of_bits
SELECT EXPORT_SET(5, 'Y', 'N', ',', 1) AS export_set_1_bit;
SELECT EXPORT_SET(5, 'Y', 'N', ',', 2) AS export_set_2_bits;
SELECT EXPORT_SET(5, 'Y', 'N', ',', 8) AS export_set_8_bits;
SELECT EXPORT_SET(5, 'Y', 'N', ',', 64) AS export_set_64_bits;

# Large numbers
SELECT EXPORT_SET(255, 'Y', 'N', ',', 8) AS export_set_255;
SELECT EXPORT_SET(256, 'Y', 'N', ',', 9) AS export_set_256;

# Negative numbers (treated as unsigned)
SELECT EXPORT_SET(-1, 'Y', 'N', ',', 8) AS export_set_neg_one;

# NULL handling
SELECT EXPORT_SET(NULL, 'Y', 'N', ',', 4) AS export_set_null_bits;
SELECT EXPORT_SET(5, NULL, 'N', ',', 4) AS export_set_null_on;
SELECT EXPORT_SET(5, 'Y', NULL, ',', 4) AS export_set_null_off;
SELECT EXPORT_SET(5, 'Y', 'N', NULL, 4) AS export_set_null_sep;
SELECT EXPORT_SET(5, 'Y', 'N', ',', NULL) AS export_set_null_bits_count;

# Table usage, including a concrete INT number_of_bits column.
CREATE TABLE t1(bits INT, on_str VARCHAR(10), off_str VARCHAR(10), number_of_bits INT);
INSERT INTO t1 VALUES (5, 'Y', 'N', 4), (10, 'ON', 'OFF', 4), (15, '1', '0', 4);
SELECT bits, EXPORT_SET(bits, on_str, off_str, ',', number_of_bits) AS result FROM t1;
DROP TABLE t1;

# All supported integer widths for number_of_bits.
CREATE TABLE t_number_of_bits(
    bits INT,
    n_int8 TINYINT,
    n_int16 SMALLINT,
    n_int32 INT,
    n_int64 BIGINT,
    n_uint8 TINYINT UNSIGNED,
    n_uint16 SMALLINT UNSIGNED,
    n_uint32 INT UNSIGNED,
    n_uint64 BIGINT UNSIGNED
);
INSERT INTO t_number_of_bits VALUES (5, 4, 4, 4, 4, 4, 4, 4, 4);
SELECT
    EXPORT_SET(bits, 'Y', 'N', ',', n_int8) AS int8_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_int16) AS int16_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_int32) AS int32_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_int64) AS int64_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_uint8) AS uint8_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_uint16) AS uint16_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_uint32) AS uint32_result,
    EXPORT_SET(bits, 'Y', 'N', ',', n_uint64) AS uint64_result
FROM t_number_of_bits;
DROP TABLE t_number_of_bits;

# BIT and DECIMAL bits columns retain their native physical representation.
CREATE TABLE t_export_set_numeric(
    bits_bit BIT(8),
    bits_decimal64 DECIMAL(18, 1),
    bits_decimal128 DECIMAL(38, 1)
);
INSERT INTO t_export_set_numeric VALUES (b'10000101', 5.0, 5.0);
SELECT
    EXPORT_SET(bits_bit, 'Y', 'N', ',', 8) AS bit_result,
    EXPORT_SET(bits_decimal64, 'Y', 'N', ',', 4) AS decimal64_result,
    EXPORT_SET(bits_decimal128, 'Y', 'N', ',', 4) AS decimal128_result
FROM t_export_set_numeric;
DROP TABLE t_export_set_numeric;

# WHERE clause
CREATE TABLE t1(bits INT);
INSERT INTO t1 VALUES (5), (10), (15);
SELECT * FROM t1 WHERE EXPORT_SET(bits, 'Y', 'N', ',', 4) LIKE 'Y%';
DROP TABLE t1;

# Edge cases
SELECT EXPORT_SET(0, 'Y', 'N', ',', 0) AS export_set_zero_bits;
SELECT EXPORT_SET(0, 'Y', 'N', ',', 1) AS export_set_one_bit_zero;
SELECT LENGTH(EXPORT_SET(-1, 'Y', 'N', ',', -1)) AS export_set_negative_count_length;

# Numeric bits use the logical value and type-specific integer conversion
SELECT EXPORT_SET(CAST(1.4 AS DECIMAL(4,1)), 'Y', 'N', '', 4) AS decimal_scale_1;
SELECT EXPORT_SET(CAST(1.40 AS DECIMAL(4,2)), 'Y', 'N', '', 4) AS decimal_scale_2;
SELECT EXPORT_SET(CAST(1.400 AS DECIMAL(5,3)), 'Y', 'N', '', 4) AS decimal_scale_3;
SELECT EXPORT_SET(CAST(1.5 AS DECIMAL(4,1)), 'Y', 'N', '', 4) AS decimal_half;
SELECT EXPORT_SET(CAST(2.5 AS DECIMAL(4,1)), 'Y', 'N', '', 4) AS decimal_odd_half;
SELECT EXPORT_SET(CAST(-2.5 AS DECIMAL(4,1)), 'Y', 'N', '', 4) AS decimal_negative_half;
SELECT EXPORT_SET(CAST(0.5 AS DOUBLE), 'Y', 'N', '', 4) AS double_even_half;
SELECT EXPORT_SET(CAST(1.5 AS DOUBLE), 'Y', 'N', '', 4) AS double_odd_half;
SELECT EXPORT_SET(CAST(2.5 AS DOUBLE), 'Y', 'N', '', 4) AS double_even_integer_half;
SELECT EXPORT_SET(CAST(-2.5 AS DOUBLE), 'Y', 'N', '', 4) AS double_negative_half;
SELECT EXPORT_SET(TRUE, 'Y', 'N', '', 4) AS boolean_true;
SELECT EXPORT_SET(FALSE, 'Y', 'N', '', 4) AS boolean_false;
SELECT EXPORT_SET(CAST(2.5 AS DECIMAL(65,1)), 'Y', 'N', '', 4) AS decimal256_half;
SELECT EXPORT_SET(CAST(9223372036854775808.5 AS DECIMAL(65,1)), 'Y', 'N', '', 4) AS decimal256_positive_saturation;
SELECT EXPORT_SET(CAST(-9223372036854775809.5 AS DECIMAL(65,1)), 'Y', 'N', '', 4) AS decimal256_negative_saturation;
SELECT EXPORT_SET(CAST('NaN' AS DOUBLE), 'Y', 'N', '', 4) AS invalid_nan;
SELECT EXPORT_SET(CAST('Inf' AS DOUBLE), 'Y', 'N', '', 4) AS invalid_infinity;
SELECT EXPORT_SET(CAST(1e20 AS DOUBLE), 'Y', 'N', '', 4) AS invalid_positive_range;
SELECT EXPORT_SET(CAST(-1e20 AS DOUBLE), 'Y', 'N', '', 4) AS invalid_negative_range;

DROP TABLE IF EXISTS export_set_numeric_bits;
CREATE TABLE export_set_numeric_bits(
  id INT PRIMARY KEY,
  d1 DECIMAL(4,1),
  d2 DECIMAL(5,2),
  f DOUBLE,
  b BOOLEAN
);
INSERT INTO export_set_numeric_bits VALUES
  (1, 1.4, 1.40, 1.4, TRUE),
  (2, 1.5, 1.50, 1.5, FALSE),
  (3, 1.9, 1.90, 1.9, NULL),
  (4, -1.5, -1.50, -1.5, NULL),
  (5, 2.5, 2.50, 2.5, TRUE);
SELECT id,
  EXPORT_SET(d1, 'Y', 'N', '', 4) AS d1_bits,
  EXPORT_SET(d2, 'Y', 'N', '', 4) AS d2_bits,
  EXPORT_SET(f, 'Y', 'N', '', 4) AS f_bits,
  EXPORT_SET(b, 'Y', 'N', '', 4) AS b_bits
FROM export_set_numeric_bits ORDER BY id;

DROP TABLE IF EXISTS export_set_numeric_ctas;
CREATE TABLE export_set_numeric_ctas AS
SELECT id, EXPORT_SET(d2, 'Y', 'N', '', 4) AS bits
FROM export_set_numeric_bits;
SELECT * FROM export_set_numeric_ctas ORDER BY id;
DROP TABLE export_set_numeric_ctas;

PREPARE export_set_numeric_stmt FROM
  "SELECT EXPORT_SET(?, 'Y', 'N', '', 4) AS prepared_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_numeric_stmt USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_numeric_stmt USING @export_set_bits;
SET @export_set_bits = TRUE;
EXECUTE export_set_numeric_stmt USING @export_set_bits;
SET @export_set_bits = FALSE;
EXECUTE export_set_numeric_stmt USING @export_set_bits;
SET @export_set_bits = NULL;
EXECUTE export_set_numeric_stmt USING @export_set_bits;
SET @export_set_bits = CAST(1.5 AS DECIMAL(4,1));
EXECUTE export_set_numeric_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_numeric_stmt;

PREPARE export_set_scalar_numeric_stmt FROM
  "SELECT EXPORT_SET((SELECT ?), 'Y', 'N', '', 4) AS prepared_scalar_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_scalar_numeric_stmt USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_scalar_numeric_stmt USING @export_set_bits;
SET @export_set_bits = TRUE;
EXECUTE export_set_scalar_numeric_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_scalar_numeric_stmt;

DROP TABLE IF EXISTS export_set_scalar_input;
CREATE TABLE export_set_scalar_input(id INT);
INSERT INTO export_set_scalar_input VALUES (1);
PREPARE export_set_scalar_input_stmt FROM
  "SELECT EXPORT_SET((SELECT ? FROM export_set_scalar_input LIMIT 1), 'Y', 'N', '', 4) AS prepared_scalar_input_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_scalar_input_stmt USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_scalar_input_stmt USING @export_set_bits;
SET @export_set_bits = TRUE;
EXECUTE export_set_scalar_input_stmt USING @export_set_bits;
TRUNCATE TABLE export_set_scalar_input;
EXECUTE export_set_scalar_input_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_scalar_input_stmt;

PREPARE export_set_derived_stmt FROM
  "SELECT EXPORT_SET((SELECT x FROM (SELECT ? AS x) d LIMIT 1), 'Y', 'N', '', 4) AS derived_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_derived_stmt USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_derived_stmt USING @export_set_bits;
SET @export_set_bits = TRUE;
EXECUTE export_set_derived_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_derived_stmt;

PREPARE export_set_nested_stmt FROM
  "SELECT EXPORT_SET((SELECT ? FROM export_set_scalar_input LIMIT 1) + 0, 'Y', 'N', '', 4) AS nested_bits";
INSERT INTO export_set_scalar_input VALUES (1);
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_nested_stmt USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_nested_stmt USING @export_set_bits;
SET @export_set_bits = TRUE;
EXECUTE export_set_nested_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_nested_stmt;

PREPARE export_set_multi_scalar_stmt FROM
  "SELECT EXPORT_SET((SELECT ?) + (SELECT ?), 'Y', 'N', '', 4) AS multi_scalar_bits";
SET @export_set_left = CAST(1.5 AS DECIMAL(4,1));
SET @export_set_right = CAST(1.0 AS DECIMAL(4,1));
EXECUTE export_set_multi_scalar_stmt USING @export_set_left, @export_set_right;
SET @export_set_left = CAST(1.5 AS DOUBLE);
SET @export_set_right = CAST(1.0 AS DOUBLE);
EXECUTE export_set_multi_scalar_stmt USING @export_set_left, @export_set_right;
SET @export_set_left = TRUE;
SET @export_set_right = TRUE;
EXECUTE export_set_multi_scalar_stmt USING @export_set_left, @export_set_right;
DEALLOCATE PREPARE export_set_multi_scalar_stmt;

PREPARE export_set_explicit_decimal_stmt FROM
  "SELECT EXPORT_SET((SELECT CAST(? AS DECIMAL(4,1)) FROM export_set_scalar_input LIMIT 1), 'Y', 'N', '', 4) AS explicit_decimal_bits";
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_explicit_decimal_stmt USING @export_set_bits;
EXECUTE export_set_explicit_decimal_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_explicit_decimal_stmt;

PREPARE export_set_derived_arithmetic_stmt FROM
  "SELECT EXPORT_SET((SELECT x + y FROM (SELECT ? AS x, ? AS y) d), 'Y', 'N', '', 4) AS derived_arithmetic_bits";
SET @export_set_left = CAST(1.5 AS DECIMAL(4,1));
SET @export_set_right = CAST(1 AS DOUBLE);
EXECUTE export_set_derived_arithmetic_stmt USING @export_set_left, @export_set_right;
EXECUTE export_set_derived_arithmetic_stmt USING @export_set_left, @export_set_right;
DEALLOCATE PREPARE export_set_derived_arithmetic_stmt;

PREPARE export_set_union_stmt FROM
  "SELECT EXPORT_SET((SELECT ? UNION ALL SELECT 1 LIMIT 1), 'Y', 'N', '', 4) AS union_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_union_stmt USING @export_set_bits;
EXECUTE export_set_union_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_union_stmt;

PREPARE export_set_division_stmt FROM
  "SELECT EXPORT_SET((SELECT ? FROM export_set_scalar_input LIMIT 1) / 1, 'Y', 'N', '', 4) AS division_bits";
EXECUTE export_set_division_stmt USING @export_set_bits;
EXECUTE export_set_division_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_division_stmt;

PREPARE export_set_window_stmt FROM
  "SELECT EXPORT_SET((SELECT FIRST_VALUE(?) OVER () FROM export_set_scalar_input LIMIT 1), 'Y', 'N', '', 4) AS window_bits";
EXECUTE export_set_window_stmt USING @export_set_bits;
EXECUTE export_set_window_stmt USING @export_set_bits;
DEALLOCATE PREPARE export_set_window_stmt;

# 排序强制消费 UNION 的所有分支；重复执行改变运行时数值域。
PREPARE export_set_union_sorted FROM
  "SELECT EXPORT_SET((SELECT ? AS x UNION ALL SELECT 1 ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS union_sorted_bits";
PREPARE export_set_union_reversed FROM
  "SELECT EXPORT_SET((SELECT 1 AS x UNION SELECT ? ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS union_reversed_bits";
PREPARE export_set_aggregate FROM
  "SELECT EXPORT_SET((SELECT MAX(?) FROM export_set_scalar_input), 'Y', 'N', '', 4) AS aggregate_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_union_sorted USING @export_set_bits;
EXECUTE export_set_union_reversed USING @export_set_bits;
EXECUTE export_set_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_union_sorted USING @export_set_bits;
EXECUTE export_set_union_reversed USING @export_set_bits;
EXECUTE export_set_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(9223372036854775808.5 AS DECIMAL(65,1));
EXECUTE export_set_union_sorted USING @export_set_bits;
EXECUTE export_set_union_reversed USING @export_set_bits;
EXECUTE export_set_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_union_sorted USING @export_set_bits;
EXECUTE export_set_aggregate USING @export_set_bits;
TRUNCATE TABLE export_set_scalar_input;
EXECUTE export_set_aggregate USING @export_set_bits;
DEALLOCATE PREPARE export_set_union_sorted;
DEALLOCATE PREPARE export_set_union_reversed;
DEALLOCATE PREPARE export_set_aggregate;

# 每一层聚合/窗口必须在消费者绑定前发布完整的输出类型。
INSERT INTO export_set_scalar_input VALUES (1), (2);
PREPARE export_set_deep_aggregate FROM
  "SELECT EXPORT_SET((SELECT MAX(y) FROM (SELECT MAX(x) AS y FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d) e), 'Y', 'N', '', 4) AS deep_aggregate_bits";
PREPARE export_set_aggregate_window FROM
  "SELECT EXPORT_SET((SELECT FIRST_VALUE(x) OVER () FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d LIMIT 1), 'Y', 'N', '', 4) AS aggregate_window_bits";
PREPARE export_set_window_aggregate FROM
  "SELECT EXPORT_SET((SELECT MAX(y) FROM (SELECT FIRST_VALUE(x) OVER () AS y FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d) e), 'Y', 'N', '', 4) AS window_aggregate_bits";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_deep_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_window USING @export_set_bits;
EXECUTE export_set_window_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_deep_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_window USING @export_set_bits;
EXECUTE export_set_window_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(9223372036854775808.5 AS DECIMAL(65,1));
EXECUTE export_set_deep_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_window USING @export_set_bits;
EXECUTE export_set_window_aggregate USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_deep_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_window USING @export_set_bits;

# 10.5 与 2 区分数值排序和字典序；用户显式 CHAR 仍要求字符串排序。
PREPARE export_set_aggregate_union FROM
  "SELECT EXPORT_SET((SELECT MAX(?) AS x FROM export_set_scalar_input UNION ALL SELECT 2 ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS aggregate_union_bits";
PREPARE export_set_aggregate_union_reverse FROM
  "SELECT EXPORT_SET((SELECT 2 AS x UNION SELECT MAX(?) FROM export_set_scalar_input ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS aggregate_union_reverse_bits";
PREPARE export_set_union_user_cast FROM
  "SELECT EXPORT_SET((SELECT CAST(MAX(?) AS CHAR) AS x FROM export_set_scalar_input UNION ALL SELECT 2 ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS union_user_cast_bits";
PREPARE export_set_union_peer_cast FROM
  "SELECT EXPORT_SET((SELECT MAX(?) AS x FROM export_set_scalar_input UNION ALL SELECT CAST(2 AS CHAR) ORDER BY x DESC LIMIT 1), 'Y', 'N', '', 4) AS union_peer_cast_bits";
SET @export_set_bits = CAST(10.5 AS DECIMAL(4,1));
EXECUTE export_set_aggregate_union USING @export_set_bits;
EXECUTE export_set_aggregate_union_reverse USING @export_set_bits;
EXECUTE export_set_union_user_cast USING @export_set_bits;
EXECUTE export_set_union_peer_cast USING @export_set_bits;
SET @export_set_bits = CAST(10.5 AS DOUBLE);
EXECUTE export_set_aggregate_union USING @export_set_bits;
EXECUTE export_set_aggregate_union_reverse USING @export_set_bits;
EXECUTE export_set_union_user_cast USING @export_set_bits;
EXECUTE export_set_union_peer_cast USING @export_set_bits;
SET @export_set_bits = CAST(9223372036854775808.5 AS DECIMAL(65,1));
EXECUTE export_set_aggregate_union USING @export_set_bits;
EXECUTE export_set_aggregate_union_reverse USING @export_set_bits;
SET @export_set_bits = CAST(10.5 AS DECIMAL(4,1));
EXECUTE export_set_aggregate_union USING @export_set_bits;
EXECUTE export_set_aggregate_union_reverse USING @export_set_bits;
TRUNCATE TABLE export_set_scalar_input;
EXECUTE export_set_deep_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_window USING @export_set_bits;
EXECUTE export_set_window_aggregate USING @export_set_bits;
EXECUTE export_set_aggregate_union USING @export_set_bits;
DEALLOCATE PREPARE export_set_deep_aggregate;
DEALLOCATE PREPARE export_set_aggregate_window;
DEALLOCATE PREPARE export_set_window_aggregate;
DEALLOCATE PREPARE export_set_aggregate_union;
DEALLOCATE PREPARE export_set_aggregate_union_reverse;
DEALLOCATE PREPARE export_set_union_user_cast;
DEALLOCATE PREPARE export_set_union_peer_cast;

# 过滤、分组与 HAVING 下推后仍须追踪聚合的真实输出域。
INSERT INTO export_set_scalar_input VALUES (1), (2);
PREPARE export_set_where FROM
  "SELECT id FROM export_set_scalar_input WHERE EXPORT_SET((SELECT MAX(?) FROM export_set_scalar_input),'Y','N','',4)='NYNN' ORDER BY id";
PREPARE export_set_having FROM
  "SELECT COUNT(*) AS matching_rows FROM export_set_scalar_input HAVING EXPORT_SET((SELECT MAX(?) FROM export_set_scalar_input),'Y','N','',4)='NYNN'";
PREPARE export_set_group FROM
  "SELECT EXPORT_SET((SELECT MAX(?) FROM export_set_scalar_input),'Y','N','',4) AS group_bits, COUNT(*) AS grouped_rows FROM export_set_scalar_input GROUP BY group_bits";
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_where USING @export_set_bits;
EXECUTE export_set_having USING @export_set_bits;
EXECUTE export_set_group USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_where USING @export_set_bits;
EXECUTE export_set_having USING @export_set_bits;
EXECUTE export_set_group USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_where USING @export_set_bits;
EXECUTE export_set_group USING @export_set_bits;

# 数字 peer 在 PREPARE 隐式字符串转换/折叠后保留来源；NULLIF 的两个副本均须刷新。
PREPARE export_set_coalesce FROM
  "SELECT EXPORT_SET((SELECT COALESCE(x,1.5) FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d),'Y','N','',4) AS coalesce_bits";
PREPARE export_set_nullif FROM
  "SELECT EXPORT_SET((SELECT NULLIF(COALESCE(x,1.5),0) FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d),'Y','N','',4) AS nullif_bits";
PREPARE export_set_nullif_equal FROM
  "SELECT EXPORT_SET((SELECT NULLIF(x,1.0) FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d),'Y','N','',4) AS nullif_equal_bits";
PREPARE export_set_peer_controls FROM
  "SELECT EXPORT_SET(COALESCE(x,'1.0'),'Y','N','',4) AS text_peer, EXPORT_SET(COALESCE(x,CAST(1.0 AS CHAR)),'Y','N','',4) AS char_peer, EXPORT_SET(COALESCE(x,CAST(1.0 AS DOUBLE)),'Y','N','',4) AS double_peer, EXPORT_SET(COALESCE(x,1e0),'Y','N','',4) AS scientific_peer, EXPORT_SET(COALESCE(x,CAST(1.0 AS DECIMAL(6,2))),'Y','N','',4) AS decimal_peer, EXPORT_SET(COALESCE(CAST(x AS CHAR),1.0),'Y','N','',4) AS char_value FROM (SELECT MAX(?) AS x FROM export_set_scalar_input) d";
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_coalesce USING @export_set_bits;
EXECUTE export_set_nullif USING @export_set_bits;
EXECUTE export_set_peer_controls USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_coalesce USING @export_set_bits;
EXECUTE export_set_nullif USING @export_set_bits;
