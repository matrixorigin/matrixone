SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_folded_derived USING @export_set_bits;
SET @export_set_bits = NULL;
EXECUTE export_set_folded_derived USING @export_set_bits;
DEALLOCATE PREPARE export_set_folded_derived;

# 派生 COALESCE 变为 DOUBLE 后必须清除外层遗留的隐式 INT64 转换。
PREPARE export_set_folded_coalesce FROM
  "SELECT EXPORT_SET(COALESCE(x,1.5),'Y','N','',4) FROM (SELECT ? AS x) d";
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_folded_coalesce USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_folded_coalesce USING @export_set_bits;
SET @export_set_bits = NULL;
EXECUTE export_set_folded_coalesce USING @export_set_bits;
DEALLOCATE PREPARE export_set_folded_coalesce;

# ROUND/ABS 内折叠的派生参数仍继承生产者 TEXT 起始域。
PREPARE export_set_folded_round FROM
  "SELECT EXPORT_SET(ROUND(x,0),'Y','N','',4) FROM (SELECT ? AS x) d";
PREPARE export_set_folded_abs FROM
  "SELECT EXPORT_SET(ABS(x),'Y','N','',4) FROM (SELECT ? AS x) d";
SET @export_set_bits = '2.5';
EXECUTE export_set_folded_round USING @export_set_bits;
EXECUTE export_set_folded_abs USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_folded_round USING @export_set_bits;
EXECUTE export_set_folded_abs USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
EXECUTE export_set_folded_round USING @export_set_bits;
EXECUTE export_set_folded_abs USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_folded_round USING @export_set_bits;
EXECUTE export_set_folded_abs USING @export_set_bits;
SET @export_set_bits = NULL;
EXECUTE export_set_folded_round USING @export_set_bits;
EXECUTE export_set_folded_abs USING @export_set_bits;
DEALLOCATE PREPARE export_set_folded_round;
DEALLOCATE PREPARE export_set_folded_abs;

