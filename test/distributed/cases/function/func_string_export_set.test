# 折叠后的派生投影仍是生产者，不能按最终 ParamRef 形状视作裸参数。
PREPARE export_set_folded_derived FROM
  "SELECT EXPORT_SET(x,'Y','N','',4) FROM (SELECT ? AS x) d";
SET @export_set_bits = '2.5';
EXECUTE export_set_folded_derived USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DECIMAL(4,1));
EXECUTE export_set_folded_derived USING @export_set_bits;
SET @export_set_bits = CAST(2.5 AS DOUBLE);
