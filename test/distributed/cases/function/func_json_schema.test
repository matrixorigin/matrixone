-- valid document
select json_schema_valid('{"type":"object","properties":{"lat":{"type":"number","minimum":-90,"maximum":90}},"required":["lat"]}', '{"lat":60}');

-- missing required field
select json_schema_valid('{"type":"object","properties":{"lat":{"type":"number","minimum":-90,"maximum":90}},"required":["lat"]}', '{}');

-- value exceeds maximum
select json_schema_valid('{"type":"object","properties":{"lat":{"type":"number","minimum":-90,"maximum":90}},"required":["lat"]}', '{"lat":100}');

-- value below minimum
select json_schema_valid('{"type":"object","properties":{"lat":{"type":"number","minimum":-90,"maximum":90}},"required":["lat"]}', '{"lat":-100}');

-- without required, empty object validates
select json_schema_valid('{"type":"object","properties":{"lat":{"type":"number","minimum":-90,"maximum":90}}}', '{}');

-- number type
select json_schema_valid('{"type":"number","minimum":0,"maximum":100}', '42');
select json_schema_valid('{"type":"number","minimum":0,"maximum":100}', '200');

-- string type
select json_schema_valid('{"type":"string","minLength":2,"maxLength":5}', '"hi"');
select json_schema_valid('{"type":"string","minLength":2,"maxLength":5}', '"h"');
select json_schema_valid('{"type":"string","minLength":2,"maxLength":5}', '"too_long_string"');

-- pattern (valid regex)
select json_schema_valid('{"type":"string","pattern":"^[a-z]+$"}', '"hello"');
select json_schema_valid('{"type":"string","pattern":"^[a-z]+$"}', '"HELLO"');

-- enum
select json_schema_valid('{"type":"string","enum":["red","green","blue"]}', '"red"');
select json_schema_valid('{"type":"string","enum":["red","green","blue"]}', '"yellow"');

-- array with items
select json_schema_valid('{"type":"array","items":{"type":"number"},"minItems":1,"maxItems":3}', '[1,2,3]');
select json_schema_valid('{"type":"array","items":{"type":"number"},"minItems":1,"maxItems":3}', '[]');
select json_schema_valid('{"type":"array","items":{"type":"number"},"minItems":1,"maxItems":3}', '["a"]');

-- boolean schemas are not supported; the schema must be a JSON object
-- (these return an error in the current implementation)
-- select json_schema_valid('true', '"anything"');
-- select json_schema_valid('true', '42');
-- select json_schema_valid('true', '{"a":1}');

-- multipleOf
select json_schema_valid('{"type":"number","multipleOf":5}', '10');
select json_schema_valid('{"type":"number","multipleOf":5}', '7');

-- nested objects
select json_schema_valid('{"type":"object","properties":{"addr":{"type":"object","properties":{"city":{"type":"string"},"zip":{"type":"string"}},"required":["city"]}},"required":["addr"]}', '{"addr":{"city":"NYC","zip":"10001"}}');
select json_schema_valid('{"type":"object","properties":{"addr":{"type":"object","properties":{"city":{"type":"string"},"zip":{"type":"string"}},"required":["city"]}},"required":["addr"]}', '{"addr":{"zip":"10001"}}');

-- additionalProperties (allowed by default in draft 4)
select json_schema_valid('{"type":"object","properties":{"a":{"type":"number"}}}', '{"a":1,"b":"extra"}');

-- null inputs
select json_schema_valid(null, '{"a":1}');
select json_schema_valid('{"type":"object"}', null);

-- T_json input via json_object
select json_schema_valid(json_object('type', 'number', 'minimum', 0, 'maximum', 100), json_object('val', 42));
select json_schema_valid(json_object('type', 'number', 'minimum', 0, 'maximum', 100), json_object('val', 200));
select json_schema_valid(json_object('type', 'number', 'minimum', 0, 'maximum', 100), json_array(42));
select json_schema_valid(json_object('type', 'number', 'minimum', 0, 'maximum', 100), json_array(200));

-- validation report: valid
select json_schema_validation_report('{"type":"object","required":["name"]}', '{"name":"test"}');

-- validation report: missing required
select json_schema_validation_report('{"type":"object","required":["name","age"]}', '{"name":"test"}');

-- validation report: wrong type
select json_schema_validation_report('{"type":"object","properties":{"x":{"type":"number"}},"required":["x"]}', '{"x":"not_a_number"}');

-- validation report: out of range
select json_schema_validation_report('{"type":"number","minimum":0,"maximum":100}', '200');

-- validation report: null input
select json_schema_validation_report(null, '{}');
select json_schema_validation_report('{"type":"object"}', null);

-- const schema (json_object) validates multiple rows
drop table if exists t1;
create table t1 (j json);
insert into t1 values ('{"a":1}'), ('{"a":"not_number"}'), ('{"b":2}');
select json_schema_valid(json_object('type', 'object', 'properties', json_object('a', json_object('type', 'number')), 'required', json_array('a')), j) from t1;
select json_schema_validation_report(json_object('type', 'object', 'properties', json_object('a', json_object('type', 'number')), 'required', json_array('a')), j) from t1;
drop table t1;

-- MySQL Draft 4 dialect compatibility
select json_schema_valid('{"const":1}', '2');
select json_schema_validation_report('{"const":1}', '2');
select json_schema_valid('{"if":{"type":"integer"},"then":{"minimum":5},"else":{"pattern":"^x$"}}', '2');
select json_schema_valid('{"format":"email"}', '"not-an-email"');
select json_schema_valid('{"minimum":5,"exclusiveMinimum":true}', '5');
select json_schema_valid('{"minimum":5,"exclusiveMinimum":true}', '6');
select json_schema_valid('{"exclusiveMinimum":5}', '5');
select json_schema_valid('{"exclusiveMinimum":5}', '6');
select json_schema_valid('{"$schema":"http://json-schema.org/draft-07/schema#","const":1}', '2');

-- MySQL checks recognized combinator references before validating the container shape
select json_schema_valid('{"allOf":{"$ref":"https://example.invalid/schema"}}', '1');
select json_schema_validation_report('{"allOf":{"$ref":"https://example.invalid/schema"}}', '1');

-- MySQL discovers string $ref values throughout the complete JSON tree
select json_schema_valid('{"if":{"$ref":"https://example.invalid/schema"}}', '1');
select json_schema_validation_report('{"$defs":{"ignored":{"$ref":"file:///tmp/schema.json"}}}', '1');
select json_schema_valid('{"enum":[{"$ref":"literal"}]}', '{"$ref":"literal"}');
select json_schema_valid('{"enum":[{"$ref":1}]}', '{"$ref":1}');

-- MySQL ignores non-string $ref values at schema positions
select json_schema_valid('{"$ref":1}', '1');
select json_schema_valid('{"items":{"$ref":false}}', '[1]');
select json_schema_valid('{"allOf":[{"$ref":null}]}', '1');
select json_schema_valid('{"anyOf":[{"type":"number","$ref":1}]}', '1');
select json_schema_valid('{"oneOf":[{"type":"number","$ref":false}]}', '1');
select json_schema_valid('{"definitions":{"a":{"$ref":1}}}', '1');
select json_schema_valid('{"patternProperties":{".*":{"type":"number","$ref":null}}}', '{"a":1}');
select json_schema_valid('{"properties":{"a":{"$ref":false}}}', '{"a":1}');

-- MySQL ignores invalid exclusive bounds without changing Draft 4 boolean pairs
select json_schema_valid('{"minimum":5,"exclusiveMinimum":"5"}', '5');
select json_schema_valid('{"minimum":5,"exclusiveMinimum":null}', '5');
select json_schema_valid('{"exclusiveMinimum":true}', '5');
select json_schema_valid('{"maximum":5,"exclusiveMaximum":"5"}', '5');
select json_schema_valid('{"maximum":5,"exclusiveMaximum":null}', '5');
select json_schema_valid('{"exclusiveMaximum":true}', '5');
select json_schema_valid('{"minimum":5,"exclusiveMinimum":true}', '5');
select json_schema_valid('{"maximum":5,"exclusiveMaximum":true}', '5');
select json_schema_valid('{"not":{"type":"string","$ref":false}}', '1');
select json_schema_validation_report('{"$ref":1}', '1');
select json_schema_validation_report('{"minimum":5,"exclusiveMinimum":"5"}', '5');

drop table if exists json_schema_draft4_rows;
create table json_schema_draft4_rows (id int primary key, s varchar(1024), d json);
insert into json_schema_draft4_rows values (1, '{"format":"email"}', '"not-an-email"'), (2, '{"type":"integer","minimum":5}', '2');
select id, json_schema_valid(s, d), json_schema_validation_report(s, d) from json_schema_draft4_rows order by id;
drop table json_schema_draft4_rows;
