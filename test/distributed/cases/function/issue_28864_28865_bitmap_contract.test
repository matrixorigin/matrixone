-- #28864: bitmap positions are the 15-bit output domain of BITMAP_BIT_POSITION.
drop table if exists issue_28864_bitmap_position;
create table issue_28864_bitmap_position(v bigint unsigned);
insert into issue_28864_bitmap_position values (0), (1), (32767);
select bitmap_count(bitmap_construct_agg(v)) as valid_positions
from issue_28864_bitmap_position;

truncate table issue_28864_bitmap_position;
insert into issue_28864_bitmap_position values (32768);
select bitmap_count(bitmap_construct_agg(v)) as rejected_position
from issue_28864_bitmap_position;

select bitmap_count(cast('not-a-bitmap' as varbinary)) as malformed_bitmap;

drop table issue_28864_bitmap_position;
