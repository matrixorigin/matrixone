drop account if exists acc_idx_cap;
create account acc_idx_cap admin_name 'admin' identified by '123456';
set experimental_hnsw_index = 1;
drop database if exists idx_cap_db;
create database idx_cap_db;
use idx_cap_db;
create table t(id bigint primary key, v vecf32(3));
insert into t values (1,'[0,0,0]'), (2,'[1,1,1]'), (3,'[9,9,9]');
create index h using hnsw on t(v) op_type 'vector_l2_ops';
create table u(id bigint primary key, v vecf32(3));
insert into u values (1,'[0,0,0]'), (2,'[1,1,1]'), (3,'[9,9,9]');
create index h2 using hnsw on u(v) op_type 'vector_l2_ops';
select @@global.max_index_cache_size;
➤ @@global.max_index_cache_size[-1,16383,0]  𝄀
0
select id from t order by l2_distance(v, '[0,0,0]') asc limit 2;
➤ id[-5,64,0]  𝄀
1  𝄀
2
set global max_index_cache_size = 4096;
select @@global.max_index_cache_size;
➤ @@global.max_index_cache_size[-1,16383,0]  𝄀
4096
use idx_cap_db;
select @@global.max_index_cache_size;
➤ @@global.max_index_cache_size[-1,16383,0]  𝄀
4096
explain select id from t order by l2_distance(v, '[0,0,0]') asc limit 2;
-- @regex("Vector Index Scan on h ", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: #[0,1] ASC  𝄀
        Limit: 2  𝄀
        ->  Join  𝄀
              Join Type: INNER  𝄀
              Join Cond: (t.id = #[1,0])  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on idx_cap_db.t  𝄀
                    Runtime Filter Probe: t.id  𝄀
              ->  Vector Index Scan on h [l2_distance]  𝄀
                    Vector Index: h, Metric: l2_distance, Candidate Limit: 2
explain select id from u order by l2_distance(v, '[0,0,0]') asc limit 2;
-- @regex("Vector Index Scan on h2 ", true)
➤ TP QUERY PLAN[12,-1,0]  𝄀
Project  𝄀
  ->  Sort  𝄀
        Sort Key: #[0,1] ASC  𝄀
        Limit: 2  𝄀
        ->  Join  𝄀
              Join Type: INNER  𝄀
              Join Cond: (u.id = #[1,0])  𝄀
              Runtime Filter Build: #[-1,0]  𝄀
              ->  Table Scan on idx_cap_db.u  𝄀
                    Runtime Filter Probe: u.id  𝄀
              ->  Vector Index Scan on h2 [l2_distance]  𝄀
                    Vector Index: h2, Metric: l2_distance, Candidate Limit: 2
select id from t order by l2_distance(v, '[0,0,0]') asc limit 2;
➤ id[-5,64,0]  𝄀
1  𝄀
2
select id from u order by l2_distance(v, '[0,0,0]') asc limit 2;
➤ id[-5,64,0]  𝄀
1  𝄀
2
select id from t order by l2_distance(v, '[0,0,0]') asc limit 2;
➤ id[-5,64,0]  𝄀
1  𝄀
2
select id from u order by l2_distance(v, '[9,9,9]') asc limit 1;
➤ id[-5,64,0]  𝄀
3
set global max_index_cache_size = 0;
select @@global.max_index_cache_size;
➤ @@global.max_index_cache_size[-1,16383,0]  𝄀
0
select id from t order by l2_distance(v, '[0,0,0]') asc limit 2;
➤ id[-5,64,0]  𝄀
1  𝄀
2
drop database if exists idx_cap_db;
drop account if exists acc_idx_cap;
