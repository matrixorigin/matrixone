CREATE TABLE t_locate_test (
id INT PRIMARY KEY,
data VARCHAR(100)
) CHARACTER SET utf8mb4;
INSERT INTO t_locate_test VALUES (1, 'Hello World');
INSERT INTO t_locate_test VALUES (2, '你好世界');
INSERT INTO t_locate_test VALUES (3, 'Test测试Test');
