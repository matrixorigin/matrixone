1  ¦  مرحبا بك  𝄀
2  ¦  שלום עולם  𝄀
3  ¦  Hello مرحبا שלום
SELECT id, LENGTH(data), CHAR_LENGTH(data) FROM t_rtl_text ORDER BY id;
