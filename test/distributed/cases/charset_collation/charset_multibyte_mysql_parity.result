➤ 中 = 中[-6,8,0]  ¦  charset(a)[12,65535,0]  ¦  charset(a)[12,65535,0]  𝄀
1  ¦  utf8mb4  ¦  binary
select to_base64('中'), from_base64(to_base64('中')) = '中';
➤ to_base64(中)[12,8,0]  ¦  from_base64(to_base64(中)) = 中[-6,8,0]  𝄀
5Lit  ¦  1
