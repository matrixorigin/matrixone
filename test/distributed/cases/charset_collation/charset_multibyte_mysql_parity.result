14989485  ¦  E4B8AD  ¦  1  ¦  3  ¦  1  ¦  24  ¦  3
select substr('中文字', 2, 1), left('中文字', 2), right('中文字', 1), reverse('中文'), lpad('中', 3, '文'), rpad('中', 3, 'é'), insert('中文字', 2, 1, 'X'), mid('中文字',-1,1);
➤ substr(中文字, 2, 1)[12,1,0]  ¦  left(中文字, 2)[12,2,0]  ¦  right(中文字, 1)[12,1,0]  ¦  reverse(中文)[12,2,0]  ¦  lpad(中, 3, 文)[12,3,0]  ¦  rpad(中, 3, é)[12,3,0]  ¦  insert(中文字, 2, 1, X)[12,4,0]  ¦  mid(中文字, -1, 1)[12,1,0]  𝄀
文  ¦  中文  ¦  字  ¦  文中  ¦  文文中  ¦  中éé  ¦  中X字  ¦  字
select upper('中é'), lower('ÉÀ'), locate('文','中文'), instr('中文字','字'), position('字' in '中文字'), substring_index('中,文,字', ',', -2);
