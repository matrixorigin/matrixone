drop database if exists cov_prep;
create database cov_prep;
use cov_prep;
create table p (a int primary key, b varchar(10), c decimal(10,2), d datetime);
prepare s1 from 'insert into p values (?, ?, ?, ?)';
set @a=1, @b='x', @c=1.5, @d='2024-01-01 10:00:00';
execute s1 using @a, @b, @c, @d;
set @a=2, @b=NULL, @c='3.333', @d=NULL;
execute s1 using @a, @b, @c, @d;
select * from p order by a;
