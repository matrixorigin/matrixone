PREPARE p_param_precision FROM
'SELECT COALESCE(?,d),GREATEST(?,d),LEAST(?,d) FROM common_peers';
SET @p='1.234567';
EXECUTE p_param_precision USING @p,@p,@p;
➤ COALESCE(?, d)[3,65,30]  ¦  GREATEST(?, d)[3,65,30]  ¦  LEAST(?, d)[3,65,30]  𝄀
1.234567000000000000000000000000  ¦  2.000000000000000000000000000000  ¦  1.234567000000000000000000000000
SET @p='12345678901.23';
EXECUTE p_param_precision USING @p,@p,@p;
➤ COALESCE(?, d)[3,65,30]  ¦  GREATEST(?, d)[3,65,30]  ¦  LEAST(?, d)[3,65,30]  𝄀
12345678901.230000000000000000000000000000  ¦  12345678901.230000000000000000000000000000  ¦  2.000000000000000000000000000000
DEALLOCATE PREPARE p_param_precision;
