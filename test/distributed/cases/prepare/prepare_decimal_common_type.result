DROP DATABASE IF EXISTS prepare_decimal_common_type;
CREATE DATABASE prepare_decimal_common_type;
USE prepare_decimal_common_type;
CREATE TABLE t (
id INT PRIMARY KEY,
d64 DECIMAL(18,2),
d128 DECIMAL(38,10)
);
INSERT INTO t VALUES
