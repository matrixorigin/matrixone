1.0000000000
SET @p='999999999999999999999999999999999999tail';
EXECUTE p_wide_spelling USING @p,@p;
➤ COALESCE(?, cast(0.0000000002 as decimal(10, 10))) + 1 - COALESCE(?, cast(0.0000000002 as decimal(10, 10)))[3,65,10]  𝄀
1.0000000000
DEALLOCATE PREPARE p_wide_spelling;
