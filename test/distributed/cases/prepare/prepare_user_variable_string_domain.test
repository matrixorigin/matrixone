-- @suite
-- @case
-- 直接用户变量的字符串域属于绑定语句；marker 使用本次赋值域。
set @bound_domain_s = _binary'你';
prepare bound_domain_binary from 'select char_length(@bound_domain_s), hex(left(@bound_domain_s, 1)), ord(@bound_domain_s), @bound_domain_s + 0';
execute bound_domain_binary;

set @bound_domain_s = '你';
execute bound_domain_binary;
prepare bound_domain_text from 'select char_length(@bound_domain_s), hex(left(@bound_domain_s, 1)), ord(@bound_domain_s), @bound_domain_s + 0';
execute bound_domain_text;
execute bound_domain_binary;
select char_length(@bound_domain_s), hex(left(@bound_domain_s, 1));

prepare bound_domain_marker from 'select char_length(?), hex(left(?, 1))';
execute bound_domain_marker using @bound_domain_s, @bound_domain_s;
set @bound_domain_s = _binary'你';
execute bound_domain_marker using @bound_domain_s, @bound_domain_s;
execute bound_domain_text;
execute bound_domain_binary;

-- NULL 不丢失绑定合同；同一 session 中的语句互不改写。
set @bound_domain_s = NULL;
execute bound_domain_text;
execute bound_domain_binary;
set @bound_domain_s = '你';
execute bound_domain_text;
execute bound_domain_binary;
execute bound_domain_marker using @bound_domain_s, @bound_domain_s;

deallocate prepare bound_domain_marker;
deallocate prepare bound_domain_text;
deallocate prepare bound_domain_binary;

-- 静态 binary 身份与选中行的 text 域独立冻结，不能用后者改写 CHARSET。
set @bound_domain_s = if(false, X'ff', '你a');
prepare bound_selected_text from 'select charset(@bound_domain_s), collation(@bound_domain_s), char_length(@bound_domain_s), hex(left(@bound_domain_s, 1))';
execute bound_selected_text;
set @bound_domain_s = X'e4bda061';
execute bound_selected_text;
select charset(@bound_domain_s), char_length(@bound_domain_s), hex(left(@bound_domain_s, 1));
prepare bound_selected_binary from 'select charset(@bound_domain_s), collation(@bound_domain_s), char_length(@bound_domain_s), hex(left(@bound_domain_s, 1))';
execute bound_selected_binary;
set @bound_domain_s = if(false, X'ff', '你a');
execute bound_selected_binary;
execute bound_selected_text;
select charset(@bound_domain_s), char_length(@bound_domain_s), hex(left(@bound_domain_s, 1));
set @bound_domain_s = NULL;
execute bound_selected_text;
execute bound_selected_binary;
set @bound_domain_s = '你a';
execute bound_selected_text;
execute bound_selected_binary;
deallocate prepare bound_selected_text;
deallocate prepare bound_selected_binary;
set @bound_domain_s = NULL;
