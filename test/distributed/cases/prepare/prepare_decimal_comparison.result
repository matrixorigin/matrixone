DROP DATABASE IF EXISTS prepare_decimal_comparison;
CREATE DATABASE prepare_decimal_comparison;
USE prepare_decimal_comparison;
CREATE TABLE t (
id INT PRIMARY KEY,
d64 DECIMAL(18,2),
d128 DECIMAL(20,4)
);
