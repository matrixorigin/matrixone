select count(*) = 0 as table_all_sentinel_not_reported
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and privilege_type = 'TABLE ALL';
➤ table_all_sentinel_not_reported[-7,1,0]  𝄀
1
select count(*) = 1 as overlapping_grants_merged,
min(is_grantable) = 'YES' as effective_grantability_preserved
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and table_name = 't'
and grantee = 'table_privileges_all'
and privilege_type = 'SELECT';
➤ overlapping_grants_merged[-7,1,0]  ¦  effective_grantability_preserved[-7,1,0]  𝄀
1  ¦  1
set session enable_privilege_cache = off;
select grantee, table_catalog, table_schema, table_name, privilege_type, is_grantable
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
order by table_name, privilege_type;
➤ grantee[12,292,0]  ¦  table_catalog[12,512,0]  ¦  table_schema[12,64,0]  ¦  table_name[12,64,0]  ¦  privilege_type[12,64,0]  ¦  is_grantable[12,3,0]  𝄀
table_privileges_reader  ¦  def  ¦  table_privileges_db  ¦  t  ¦  SELECT  ¦  NO  𝄀
table_privileges_reader  ¦  def  ¦  table_privileges_db  ¦  t  ¦  UPDATE  ¦  YES  𝄀
table_privileges_reader  ¦  def  ¦  table_privileges_db  ¦  v  ¦  SELECT  ¦  YES
select count(*) = 0 as hidden_table_privilege_hidden
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and table_name = 'hidden_t';
➤ hidden_table_privilege_hidden[-7,1,0]  𝄀
1
select count(*) = 0 as unrelated_role_privilege_hidden
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and table_name = 't'
and grantee = 'table_privileges_hidden';
➤ unrelated_role_privilege_hidden[-7,1,0]  𝄀
1
alter role table_privileges_reader rename to table_privileges_reader_renamed;
select
(select count(*) = 3 from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and grantee = 'table_privileges_reader_renamed') as renamed_grantee_visible,
(select count(*) = 0 from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and grantee = 'table_privileges_reader') as stale_grantee_removed;
➤ renamed_grantee_visible[-7,1,0]  ¦  stale_grantee_removed[-7,1,0]  𝄀
1  ¦  1
alter role table_privileges_reader_renamed rename to table_privileges_reader;
revoke update on table table_privileges_db.t from table_privileges_reader;
select count(*) = 0 as revoked_privilege_removed
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and table_name = 't'
and grantee = 'table_privileges_reader'
and privilege_type = 'UPDATE';
➤ revoked_privilege_removed[-7,1,0]  𝄀
1
drop view table_privileges_db.v;
select count(*) = 0 as dropped_view_privilege_removed
from information_schema.table_privileges
where table_schema = 'table_privileges_db'
and table_name = 'v';
➤ dropped_view_privilege_removed[-7,1,0]  𝄀
1
drop database table_privileges_db;
drop user table_privileges_user;
drop role if exists table_privileges_reader, table_privileges_reader_renamed,
table_privileges_wildcard, table_privileges_hidden, table_privileges_all;
