drop sequence if exists s1;
create sequence s1 as smallint increment by -40 minvalue 30 maxvalue 100 cycle; 
select nextval('s1');
nextval(s1)
100
select nextval('s1');
nextval(s1)
60
select nextval('s1');
nextval(s1)
100
select currval('s1');
currval(s1)
100
select lastval();
lastval()
100
select setval('s1', 50);
setval(s1, 50)
50
select lastval();
lastval()
50
select nextval('s1');
nextval(s1)
100
drop sequence if exists s3;
create sequence s3 increment by 3 start with 10;
select setval('s3', 20, false);
setval(s3, 20, false)
20
select nextval('s3');
nextval(s3)
23
select setval('s3', 50, true);
setval(s3, 50, true)
50
select nextval('s3');
nextval(s3)
50