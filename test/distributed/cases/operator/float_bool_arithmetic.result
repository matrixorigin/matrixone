4  ¦  0  ¦  0  ¦  1  ¦  0  ¦  1  ¦  0  ¦  1  ¦  0
select id, f + b as p, f - b as m, f * b as t, f / b as q, f = b as eq, f > b as gt, b < f as lt from tf order by id;
➤ id[4,32,0]  ¦  p[8,53,31]  ¦  m[8,53,31]  ¦  t[8,53,31]  ¦  q[8,53,31]  ¦  eq[-6,8,0]  ¦  gt[-6,8,0]  ¦  lt[-6,8,0]  𝄀
