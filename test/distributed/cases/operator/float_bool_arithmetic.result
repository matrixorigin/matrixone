select id from tf where d > b order by id;
➤ id[4,32,0]  𝄀
1
select id from tf where f = b order by id;
➤ id[4,32,0]  𝄀
2
select nullif(1e0, true) as a, nullif(2e0, true) as b, 1e0 in (true, 3e0) as c;
