select 1e0 + true as a, true + 2.5e0 as b, 3e0 / true as c, 5e0 % true as e, 5e0 div true as g, 1e0 = true as h, 0e0 = false as i;
➤ a[8,53,31]  ¦  b[8,53,31]  ¦  c[8,53,31]  ¦  e[8,53,31]  ¦  g[-5,64,0]  ¦  h[-6,8,0]  ¦  i[-6,8,0]  𝄀
