DROP DATABASE IF EXISTS mysql_compat_high_not_precedence;
CREATE DATABASE mysql_compat_high_not_precedence;
USE mysql_compat_high_not_precedence;
SET @old_sql_mode = @@session.sql_mode;
SET SESSION sql_mode = '';
SELECT
NOT 1 BETWEEN 2 AND 3 AS default_not_between,
NOT (1 BETWEEN 2 AND 3) AS parenthesized_not_between,
(NOT 1) BETWEEN 2 AND 3 AS explicit_not_between,
NOT 0 IN (0, 1) AS default_not_in,
NOT (0 IN (0, 1)) AS parenthesized_not_in,
(NOT 0) IN (0, 1) AS explicit_not_in;
default_not_between    parenthesized_not_between    explicit_not_between    default_not_in    parenthesized_not_in    explicit_not_in
1    1    0    0    0    1
SELECT NOT 1 BETWEEN 2 AND 3 AS cached_not;
cached_not
1
SET SESSION sql_mode = 'HIGH_NOT_PRECEDENCE';
SELECT NOT 1 BETWEEN 2 AND 3 AS cached_not;
cached_not
0
SELECT
NOT 1 BETWEEN 2 AND 3 AS high_not_between,
NOT (1 BETWEEN 2 AND 3) AS parenthesized_not_between,
(NOT 1) BETWEEN 2 AND 3 AS explicit_not_between,
NOT 0 IN (0, 1) AS high_not_in,
NOT (0 IN (0, 1)) AS parenthesized_not_in,
(NOT 0) IN (0, 1) AS explicit_not_in;
high_not_between    parenthesized_not_between    explicit_not_between    high_not_in    parenthesized_not_in    explicit_not_in
0    1    0    1    0    1
SET SESSION sql_mode = '';
PREPARE p_default FROM 'SELECT NOT 1 BETWEEN 2 AND 3 AS prepared_default';
SET SESSION sql_mode = 'HIGH_NOT_PRECEDENCE';
EXECUTE p_default;
prepared_default
1
DEALLOCATE PREPARE p_default;
PREPARE p_high FROM 'SELECT NOT 1 BETWEEN 2 AND 3 AS prepared_high';
SET SESSION sql_mode = '';
EXECUTE p_high;
prepared_high
0
DEALLOCATE PREPARE p_high;
SET SESSION sql_mode = '';
CREATE VIEW v_default_high_not AS SELECT NOT 1 BETWEEN 2 AND 3 AS view_default;
SET SESSION sql_mode = 'HIGH_NOT_PRECEDENCE';
SELECT * FROM v_default_high_not;
view_default
1
CREATE VIEW v_high_high_not AS SELECT NOT 1 BETWEEN 2 AND 3 AS view_high;
SET SESSION sql_mode = '';
SELECT * FROM v_high_high_not;
view_high
0
DROP VIEW v_default_high_not;
DROP VIEW v_high_high_not;
SET SESSION sql_mode = 'HIGH_NOT_PRECEDENCE';
DROP TABLE IF EXISTS t_high_not_precedence;
CREATE TABLE t_high_not_precedence (
id INT PRIMARY KEY,
a INT
);
INSERT INTO t_high_not_precedence VALUES
(1, 0),
(2, 1),
(3, 2),
(4, 3),
(5, 4);
SELECT id
FROM t_high_not_precedence
WHERE NOT a BETWEEN 2 AND 3
ORDER BY id;
id
SELECT id
FROM t_high_not_precedence
WHERE NOT a IN (0, 1)
ORDER BY id;
id
1
2
3
4
5
SET SESSION sql_mode = @old_sql_mode;
DROP DATABASE mysql_compat_high_not_precedence;
