CREATE TABLE stu(
id INT PRIMARY KEY,
name VARCHAR(20),
class INT,
sex VARCHAR(2),
address VARCHAR(50)
);
CREATE TABLE score(
id INT PRIMARY KEY,
name VARCHAR(20),
chinese FLOAT,
math FLOAT,
english FLOAT
);
