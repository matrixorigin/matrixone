3  ¦  1  ¦  128  𝄀
4  ¦  null  ¦  null
select id, coalesce(w, b) + 0 as coalesce_w_b, coalesce(b, w) + 0 as coalesce_b_w from tb order by id;
➤ id[4,32,0]  ¦  coalesce_w_b[-5,64,0]  ¦  coalesce_b_w[-5,64,0]  𝄀
