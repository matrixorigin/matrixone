drop database if exists string_source_provenance;
create database string_source_provenance;
use string_source_provenance;
set @source_value = binary 'A\0B';
select hex(@source_value) as local_user_variable;
➤ local_user_variable[12,65535,0]  𝄀
410042
select hex(concat(@source_value, binary 'C')) as projected_string_wrapper;
➤ projected_string_wrapper[12,65535,0]  𝄀
41004243
select hex(v) as derived_user_variable from (select @source_value as v) dt;
➤ derived_user_variable[12,65535,0]  𝄀
410042
with source_cte as (select @source_value as v)
select hex(v) as cte_user_variable from source_cte;
➤ cte_user_variable[12,65535,0]  𝄀
410042
select hex(l.v) as joined_user_variable
from (select @source_value as v) l join (select 1 as id) r on l.v is not null;
➤ joined_user_variable[12,65535,0]  𝄀
410042
select hex(v) as union_all_user_variable
from (select @source_value as v union all select @source_value as v) u order by v;
➤ union_all_user_variable[12,65535,0]  𝄀
410042  𝄀
410042
select hex(v) as union_distinct_user_variable
from (select @source_value as v union select @source_value as v) u;
➤ union_distinct_user_variable[12,65535,0]  𝄀
410042
select hex(v) as grouped_user_variable, count(*) as grouped_count
from (select @source_value as v union all select @source_value as v) u group by v;
➤ grouped_user_variable[12,65535,0]  ¦  grouped_count[-5,64,0]  𝄀
410042  ¦  2
create table source_materialized(id int primary key, payload varbinary(8));
insert into source_materialized values (1, @source_value), (2, null);
select id, hex(payload) as materialized_value from source_materialized order by id;
➤ id[4,32,0]  ¦  materialized_value[12,65535,0]  𝄀
1  ¦  410042  𝄀
2  ¦  null
select id, hex(coalesce(payload, @source_value)) as remote_selected_value
from source_materialized order by id;
