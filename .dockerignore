# Ignore build artifacts
mo-data/
logs/
*.log

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore documentation
*.md
!README.md

# Ignore test files except the connector runners and their contract tests. The
# connector-ci image compiles both runners from the exact checked-out source.
test/
!test/
!test/mongodb/
!test/mongodb/**
!test/iceberg/
!test/iceberg/**
report/

# Ignore temporary files
*.tmp
*.temp
cov.out
coverage*.out

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Ignore build artifacts
cgo/*.o
cgo/*.a
cgo/*.so
cgo/*.dylib
/lib/
/dict/
/mo-service
vendor/
.proto-vendor/

# Keep what we need
!etc/
!proto/
!pkg/
!cmd/
!go.mod
!go.sum
!Makefile
!thirdparties/

# Never send locally generated native artifacts back into a container build.
thirdparties/install/
