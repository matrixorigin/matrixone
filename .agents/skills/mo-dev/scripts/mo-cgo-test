set -eu

usage() {
    echo "usage: $0 [go test flags and package patterns...]" >&2
    echo "example: $0 -race -count=1 -timeout=120s ./pkg/target/..." >&2
    echo "gpu:     MO_CL_CUDA=1 $0 -count=1 ./pkg/vectorindex/metric/" >&2
}

if [ "$#" -eq 0 ]; then
    usage
    exit 2
fi

script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
repo_root=$(git -C "$script_dir" rev-parse --show-toplevel)
case "$repo_root" in
    *[[:space:]]*)
        echo "MatrixOne's Make/CGo flags require a repository path without whitespace: $repo_root" >&2
        exit 1
        ;;
esac
source_cgo_dir="$repo_root/cgo"

goos=$(go env GOOS)
gohostos=$(go env GOHOSTOS)
goarch=$(go env GOARCH)
gohostarch=$(go env GOHOSTARCH)

if [ "$goos" != "$gohostos" ] || [ "$goarch" != "$gohostarch" ]; then
    echo "local MatrixOne CGo tests do not support cross compilation:" \
        "target=$goos/$goarch, host=$gohostos/$gohostarch" >&2
    exit 1
fi
if [ "$(go env CGO_ENABLED)" != "1" ]; then
    echo "MatrixOne CGo tests require CGO_ENABLED=1" >&2
    exit 1
fi

case "$goos" in
    darwin)
        libmo_name=libmo.dylib
        runtime_path_var=DYLD_LIBRARY_PATH
        platform_link_flags=
        ;;
    linux)
        libmo_name=libmo.so
        runtime_path_var=LD_LIBRARY_PATH
        platform_link_flags=-fopenmp
        ;;
    *)
        echo "unsupported GOOS for MatrixOne CGo tests: $goos" >&2
        exit 1
        ;;
esac

# Build artifacts are intentionally untracked, so a linked git worktree normally has
# neither libmo nor thirdparties/install even when the primary worktree already has a
# usable build. Reuse that build only when the tracked and untracked native inputs are
# clean and identical. This keeps worktree tests cheap without letting a branch-specific
# C/C++ or Makefile change link against a stale library.
native_inputs_match() {
    candidate_root=$1
    native_paths="Makefile cgo thirdparties"
    if ! repo_native_status=$(git -C "$repo_root" status \
        --porcelain --untracked-files=all -- $native_paths); then
        return 1
    fi
    if ! candidate_native_status=$(git -C "$candidate_root" status \
        --porcelain --untracked-files=all -- $native_paths); then
        return 1
    fi
    if [ -n "$repo_native_status" ] || [ -n "$candidate_native_status" ]; then
        return 1
    fi
    repo_head=$(git -C "$repo_root" rev-parse HEAD) || return 1
    candidate_head=$(git -C "$candidate_root" rev-parse HEAD) || return 1
    git -C "$repo_root" diff --quiet "$repo_head" "$candidate_head" -- $native_paths
}

native_artifact_provenance_matches() {
    candidate_root=$1
    candidate_lib=$2
    accelerator=cpu
    if [ "${MO_CL_CUDA:-}" = "1" ]; then
        accelerator=gpu
    fi
    simsimd=0
    if [ "${MO_CL_SIMSIMD:-}" = "1" ]; then
        simsimd=1
    fi
    "$source_cgo_dir/mo-native-provenance" verify \
        "$candidate_root" "$candidate_lib" "$goos" "$goarch" \
        "$accelerator" release "$simsimd"
}

artifact_root="$repo_root"
artifact_cgo_dir="$artifact_root/cgo"
thirdparty_dir="$artifact_root/thirdparties/install"
lib_dir="$thirdparty_dir/lib"
include_dir="$thirdparty_dir/include"
libmo="$artifact_cgo_dir/$libmo_name"
reuse_rejection=

if [ ! -e "$libmo" ] || [ ! -d "$include_dir" ] || [ ! -d "$lib_dir" ]; then
    # Git documents the main worktree as the first porcelain entry. Do not
    # derive it from git-common-dir: repositories created with
    # --separate-git-dir keep that directory outside the primary checkout.
    primary_root=$(git -C "$repo_root" worktree list --porcelain |
        sed -n '1s/^worktree //p')
    candidate_lib="$primary_root/cgo/$libmo_name"
    candidate_thirdparty="$primary_root/thirdparties/install"
    case "$primary_root" in
        *[[:space:]]*) reuse_rejection="primary worktree path contains whitespace" ;;
        "$repo_root") reuse_rejection="current checkout is the primary worktree" ;;
        *)
            if [ "$(git -C "$primary_root" rev-parse --is-inside-work-tree 2>/dev/null || true)" != true ]; then
                reuse_rejection="Git metadata does not expose a usable primary worktree"
            elif [ ! -e "$candidate_lib" ] ||
               [ ! -d "$candidate_thirdparty/include" ] ||
               [ ! -d "$candidate_thirdparty/lib" ]; then
                reuse_rejection="primary worktree lacks $libmo_name or thirdparties/install"
            elif ! native_inputs_match "$primary_root"; then
                reuse_rejection="native inputs differ from or are dirty in the primary worktree"
            elif ! provenance_error=$(native_artifact_provenance_matches \
                "$primary_root" "$candidate_lib" 2>&1); then
                reuse_rejection="${provenance_error:-native artifact provenance validation failed}"
            else
                artifact_root="$primary_root"
                artifact_cgo_dir="$artifact_root/cgo"
                thirdparty_dir="$artifact_root/thirdparties/install"
                lib_dir="$thirdparty_dir/lib"
                include_dir="$thirdparty_dir/include"
                libmo="$artifact_cgo_dir/$libmo_name"
                echo "using platform-matched CGo artifacts ($libmo_name) from primary worktree: $artifact_root" >&2
            fi
            ;;
    esac
fi

# MO_CL_CUDA=1 selects the GPU build, exactly as it does for `make`. It is required
# whenever libmo was built with CUDA -- not only for `-tags gpu` packages -- because a
# CUDA libmo carries undefined cu* symbols that every test binary linking it must
# resolve, whatever tags the package itself uses.
#
# Flags mirror the Makefile's MO_CL_CUDA block; keep the two in step. The rpaths do not:
# the Makefile ships $ORIGIN/lib for the distributable, while test binaries run from
# temporary directories and need absolute paths, like the libmo rpath below.
cuda_cflags=
cuda_ldflags=
cuda_rpaths=
cuda_runtime_paths=
gpu_tag_args=
cuda_fatbin=
if [ "${MO_CL_CUDA:-}" = "1" ]; then
    if [ "$goos" != linux ]; then
        echo "MO_CL_CUDA=1 is only supported on linux, not $goos" >&2
        exit 1
    fi
    if [ -z "${CONDA_PREFIX:-}" ]; then
        echo "CONDA_PREFIX env variable not found." >&2
        echo "MO_CL_CUDA=1 needs it to locate cuvs, as the Makefile does" >&2
        exit 1
    fi
    cuda_cflags="'-I/usr/local/cuda/include' '-I$CONDA_PREFIX/include'"
    cuda_ldflags="-L/usr/local/cuda/lib64/stubs -lcuda -L/usr/local/cuda/lib64 -lcudart -L$CONDA_PREFIX/lib -lcuvs -lcuvs_c -lstdc++"
    cuda_rpaths="-Wl,-rpath,/usr/local/cuda/lib64 -Wl,-rpath,$CONDA_PREFIX/lib"
    cuda_runtime_paths=":/usr/local/cuda/lib64:$CONDA_PREFIX/lib"
    cuda_fatbin="$artifact_root/mocl_kernel64.fatbin"

    # The Makefile adds `-tags gpu` under the same switch, so MO_CL_CUDA=1 must always end up
    # building the gpu-tagged files. It cannot be appended as a second -tags: go test keeps
    # only the LAST one, which would discard the caller's. Nor can it be skipped when the
    # caller passes -tags -- that was the old behaviour, and it silently excluded every
    # //go:build gpu file while still reporting a pass, so
    #     MO_CL_CUDA=1 mo-cgo-test -tags typecheck ./pkg/vectorindex/metric/
    # validated no GPU code at all and went green. MERGE instead: gpu joins the caller's tag
    # set, in whichever form they wrote it.
    merge_gpu_tag() {
        # Go accepts comma-separated tags, and historically space-separated ones. Treat both
        # as separators so `gpu` is not added twice to `-tags "foo gpu"`.
        case ",$(printf '%s' "$1" | tr ' ' ',')," in
            *,gpu,*) printf '%s' "$1" ;;
            ,,) printf 'gpu' ;;
            *) printf '%s,gpu' "$1" ;;
        esac
    }

    caller_set_tags=0
    argc=$#
    i=0
    while [ "$i" -lt "$argc" ]; do
        arg="$1"
        shift
        i=$((i + 1))
        case "$arg" in
            -tags | --tags)
                caller_set_tags=1
                if [ "$i" -lt "$argc" ] && [ $# -gt 0 ]; then
                    val="$1"
                    shift
                    i=$((i + 1))
                else
                    val=
                fi
                set -- "$@" "$arg" "$(merge_gpu_tag "$val")"
                ;;
            -tags=* | --tags=*)
                caller_set_tags=1
                set -- "$@" "${arg%%=*}=$(merge_gpu_tag "${arg#*=}")"
                ;;
            *)
                set -- "$@" "$arg"
                ;;
        esac
    done
    if [ "$caller_set_tags" -eq 0 ]; then
        gpu_tag_args="-tags gpu"
    fi
fi

for required in "$libmo" "$include_dir" "$lib_dir"; do
    if [ ! -e "$required" ]; then
        echo "missing MatrixOne CGo prerequisite: $required" >&2
        if [ -n "$reuse_rejection" ]; then
            echo "primary-worktree reuse rejected: $reuse_rejection" >&2
        fi
        echo "build the repository thirdparties and CGo libraries before testing" >&2
        exit 1
    fi
done
if [ -n "$cuda_fatbin" ] && [ ! -f "$cuda_fatbin" ]; then
    echo "missing MatrixOne CUDA runtime sidecar: $cuda_fatbin" >&2
    if [ -n "$reuse_rejection" ]; then
        echo "primary-worktree reuse rejected: $reuse_rejection" >&2
    fi
    echo "build the GPU generation with top-level: MO_CL_CUDA=1 make cgo" >&2
    exit 1
fi

# A CUDA-built libmo cannot be linked without the CUDA flags, whatever the package under
# test is. Left alone that surfaces as a page of "undefined reference to cuInit" from the
# linker, which reads like a code fault; say what it actually is instead.
if [ -z "$cuda_ldflags" ] && command -v readelf >/dev/null 2>&1; then
    if readelf -d "$libmo" 2>/dev/null | grep -q 'NEEDED.*libcuda'; then
        echo "$libmo was built with CUDA but MO_CL_CUDA is not set." >&2
        echo "re-run as: MO_CL_CUDA=1 $0 $*" >&2
        echo "or rebuild a CPU libmo with: make clean && make" >&2
        exit 1
    fi
fi

# Match the repository build contract and remove ambient module/CGo flag
# drift. CC/CXX and other standard toolchain selectors remain caller-owned.
export GOWORK=off
export CGO_CFLAGS="'-I$source_cgo_dir' '-I$include_dir'${cuda_cflags:+ $cuda_cflags}"
export CGO_LDFLAGS="'-L$lib_dir'"
if [ -n "$cuda_fatbin" ]; then
    # Go test executables live in temporary directories, while production
    # executables find the staged fatbin beside mo-service. Point the test
    # process at the exact sidecar already bound by provenance verification.
    export MO_CUDA_FATBIN_PATH="$cuda_fatbin"
fi

# cgo/lib.go owns libmo's native dependency declaration. Query that metadata
# instead of duplicating a library list here; newly added CPU dependencies then
# flow into this wrapper automatically. The repository-path check above makes
# the space-delimited result safe to append to extldflags.
cgo_link_flags=$(go -C "$repo_root" list -mod=readonly \
    -f '{{join .CgoLDFLAGS " "}}' ./cgo)
if [ -z "$cgo_link_flags" ]; then
    echo "MatrixOne's cgo package declared no native link flags" >&2
    exit 1
fi

runtime_paths="$artifact_cgo_dir:$lib_dir$cuda_runtime_paths"
if [ "$runtime_path_var" = DYLD_LIBRARY_PATH ]; then
    export DYLD_LIBRARY_PATH="$runtime_paths"
else
    export LD_LIBRARY_PATH="$runtime_paths"
fi

# go test executables run from temporary build directories. Use repository
# absolute rpaths; package-relative rpaths belong to distributable binaries.
#
# The wrapper injects libmo even when the requested package does not import
# cgo/lib.go, so it must also close libmo's dependency graph. Keep the queried
# flags after -lmo: archive resolution is order-sensitive on common linkers.
external_flags="$platform_link_flags${cuda_ldflags:+ $cuda_ldflags} -L$artifact_cgo_dir -lmo -L$lib_dir $cgo_link_flags -Wl,-rpath,$artifact_cgo_dir -Wl,-rpath,$lib_dir${cuda_rpaths:+ $cuda_rpaths}"
ldflags="-extldflags '$external_flags'"

cd "$repo_root"
exec go test -mod=readonly $gpu_tag_args -ldflags "$ldflags" "$@"
