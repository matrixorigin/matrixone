# Exercises the native provenance state machine without compiling libmo. It
# proves that source/variant transitions and interrupted builds cannot publish
# a reusable stamp until the build owner has performed the required cleanup.

set -eu

script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
provenance_source="$script_dir/../../../../cgo/mo-native-provenance"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
repo="$work/repo"
mkdir -p "$repo/cgo/cuda" "$repo/cgo/cuvs" "$repo/thirdparties" "$work/bin"
cp "$provenance_source" "$repo/cgo/mo-native-provenance"
chmod +x "$repo/cgo/mo-native-provenance"

cat >"$work/bin/go" <<'EOF'
#!/bin/sh
case "$1:$2" in
    env:GOHOSTOS) echo darwin ;;
    env:GOHOSTARCH) echo amd64 ;;
    *) exit 1 ;;
esac
EOF
chmod +x "$work/bin/go"

real_git=$(command -v git)
cat >"$work/bin/git" <<'EOF'
#!/bin/sh
if [ "${FAIL_NATIVE_ARTIFACT_HASH:-}" = 1 ]; then
    for argument in "$@"; do
        if [ "$argument" = --no-filters ]; then
            echo "injected native artifact hash failure" >&2
            exit 86
        fi
    done
fi
exec "$REAL_GIT" "$@"
EOF
chmod +x "$work/bin/git"
export REAL_GIT="$real_git"

cat >"$repo/.gitignore" <<'EOF'
cgo/*.o
cgo/*.a
cgo/*.so
cgo/*.dylib
cgo/cuda/*.o
cgo/cuvs/*.o
cgo/.mo-native-provenance
cgo/.mo-native-provenance.pending
cgo/.mo-native-provenance.building
cgo/.mo-native-provenance.tmp
thirdparties/install/
EOF
cat >"$repo/Makefile" <<'EOF'
cgo:
	@true
EOF
printf '#define VALUE 1\n' >"$repo/cgo/native.h"
printf 'native source\n' >"$repo/cgo/native.c"
printf 'thirdparty source\n' >"$repo/thirdparties/source.txt"
git -C "$repo" init --quiet
git -C "$repo" add .
git -C "$repo" -c user.name=test -c user.email=test@example.com \
    commit --quiet -m fixture

native() {
    PATH="$work/bin:$PATH" "$repo/cgo/mo-native-provenance" "$@"
}

failures=0

# Exported source archives have no Git object identity. They must keep normal
# incremental build behavior and must never receive a cross-worktree stamp.
exported="$work/exported"
mkdir -p "$exported/cgo" "$exported/thirdparties/install/include" \
    "$exported/thirdparties/install/lib"
cp "$repo/cgo/mo-native-provenance" "$exported/cgo/mo-native-provenance"
printf 'existing library\n' >"$exported/cgo/libmo.dylib"
exported_action=$(PATH="$work/bin:$PATH" "$exported/cgo/mo-native-provenance" \
    prepare "$exported" cpu release 0)
if [ "$exported_action" = local ]; then
    echo "ok   exported source keeps the local incremental path"
else
    printf 'FAIL exported source expected local, got %s\n' "$exported_action"
    failures=$((failures + 1))
fi
PATH="$work/bin:$PATH" "$exported/cgo/mo-native-provenance" \
    begin "$exported" cpu release 0
PATH="$work/bin:$PATH" "$exported/cgo/mo-native-provenance" \
    record "$exported" cpu release 0
if [ -e "$exported/cgo/.mo-native-provenance" ]; then
    echo "FAIL exported source published a reusable stamp"
    failures=$((failures + 1))
else
    echo "ok   exported source remains local-only"
fi

expect_action() {
    accelerator=$1
    optimization=$2
    simsimd=$3
    expected=$4
    build_key="$accelerator/$optimization/simsimd=$simsimd"
    actual=$(native prepare "$repo" "$accelerator" "$optimization" "$simsimd")
    if [ "$actual" = "$expected" ]; then
        printf 'ok   %-30s -> %s\n' "$build_key" "$expected"
    else
        printf 'FAIL %-30s expected %s, got %s\n' \
            "$build_key" "$expected" "$actual"
        failures=$((failures + 1))
    fi
}

expect_failure() {
    description=$1
    shift
    set +e
    "$@" >"$work/failure.out" 2>&1
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
        printf 'ok   %s\n' "$description"
    else
        printf 'FAIL %s\n' "$description"
        failures=$((failures + 1))
    fi
}

clean_cgo() {
    rm -f "$repo"/cgo/*.o "$repo"/cgo/*.a "$repo"/cgo/*.so \
        "$repo"/cgo/*.dylib "$repo"/cgo/cuda/*.o "$repo"/cgo/cuvs/*.o
}

clean_all() {
    clean_cgo
    rm -rf "$repo/thirdparties/install"
}

produce_cgo_outputs() {
    printf 'object\n' >"$repo/cgo/native.o"
    printf 'dynamic library\n' >"$repo/cgo/libmo.dylib"
    printf 'static library\n' >"$repo/cgo/libmo.a"
}

produce_outputs() {
    mkdir -p "$repo/thirdparties/install/include" \
        "$repo/thirdparties/install/lib"
    printf 'installed header\n' >"$repo/thirdparties/install/include/native.h"
    printf 'installed library\n' >"$repo/thirdparties/install/lib/libnative.a"
    produce_cgo_outputs
}

finish_build() {
    accelerator=$1
    optimization=$2
    simsimd=$3
    native begin "$repo" "$accelerator" "$optimization" "$simsimd"
    produce_outputs
    native record "$repo" "$accelerator" "$optimization" "$simsimd"
}

produce_outputs
expect_action cpu release 0 rebuild-all
expect_failure "a stale no-op cannot begin the first stamped build" \
    native begin "$repo" cpu release 0
clean_all
finish_build cpu release 0
native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu release 0
echo "ok   a cleaned first build publishes a verifiable stamp"

# Marker publication owns and recycles its temporary even when the atomic
# rename itself fails. The last committed stamp remains reusable because no
# replacement build was admitted.
mkdir -p "$work/fail-marker-bin"
cat >"$work/fail-marker-bin/mv" <<'EOF'
#!/bin/sh
exit 87
EOF
chmod +x "$work/fail-marker-bin/mv"
expect_failure "failed marker publication returns non-zero" \
    env PATH="$work/fail-marker-bin:$work/bin:$PATH" \
    "$repo/cgo/mo-native-provenance" prepare "$repo" cpu release 0
if [ ! -e "$repo/cgo/.mo-native-provenance.pending.tmp" ]; then
    echo "ok   failed marker publication recycles unpublished temporary state"
else
    echo "FAIL failed marker publication retained pending temporary state"
    failures=$((failures + 1))
fi
expect_action cpu release 0 reuse
native begin "$repo" cpu release 0
native record "$repo" cpu release 0

printf 'corrupt stamp\n' >"$repo/cgo/.mo-native-provenance"
expect_action cpu release 0 rebuild-all
clean_all
finish_build cpu release 0
echo "ok   a corrupt stamp requires a full native rebuild"

printf 'DYNAMIC LIBRARY\n' >"$repo/cgo/libmo.dylib"
touch -r "$repo/cgo/.mo-native-provenance" "$repo/cgo/libmo.dylib"
expect_action cpu release 0 rebuild-cgo
clean_cgo
finish_build cpu release 0
echo "ok   a same-size/mtime libmo change requires a CGo rebuild"

printf 'INSTALLED HEADER\n' >"$repo/thirdparties/install/include/native.h"
touch -r "$repo/cgo/.mo-native-provenance" \
    "$repo/thirdparties/install/include/native.h"
expect_action cpu release 0 rebuild-all
clean_all
finish_build cpu release 0
echo "ok   a same-size/mtime thirdparty change requires a full rebuild"

expect_failure "record cannot publish without a build-generation marker" \
    native record "$repo" cpu release 0

expect_action cpu release 0 reuse
expect_failure "a prepared generation is not reusable before completion" \
    native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu release 0
native begin "$repo" cpu release 0
native record "$repo" cpu release 0
echo "ok   unchanged inputs keep the incremental no-clean path"

# A nominally reusable generation must fail closed if an ordinary build step
# changes an output after prepare. The incomplete generation then requires a
# CGo cleanup before it can publish again.
expect_action cpu release 0 reuse
native begin "$repo" cpu release 0
printf 'changed while building\n' >>"$repo/cgo/libmo.dylib"
expect_failure "reuse rejects an artifact changed during the build" \
    native record "$repo" cpu release 0
expect_action cpu release 0 rebuild-cgo
clean_cgo
finish_build cpu release 0
echo "ok   a changed reuse generation recovers through CGo cleanup"

# An interrupted incremental build must not trust its old stamp on the next
# invocation. It escalates only to a CGo rebuild, not an expensive full rebuild.
expect_action cpu release 0 reuse
expect_action cpu release 0 rebuild-cgo
clean_cgo
finish_build cpu release 0
echo "ok   interrupted incremental build resumes with CGo cleanup"

# Current artifact diagnosis and retained generation state are independent
# axes. An interrupted reuse requires CGo cleanup, but simultaneous thirdparty
# corruption is stronger and must win even when source provenance is unchanged.
expect_action cpu release 0 reuse
printf 'CORRUPTED HEADER\n' >"$repo/thirdparties/install/include/native.h"
touch -r "$repo/cgo/.mo-native-provenance" \
    "$repo/thirdparties/install/include/native.h"
expect_action cpu release 0 rebuild-all
clean_all
finish_build cpu release 0
native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu release 0
echo "ok   interrupted recovery cannot downgrade current thirdparty corruption"

printf '#define VALUE 2\n' >"$repo/cgo/native.h"
git -C "$repo" add cgo/native.h
git -C "$repo" -c user.name=test -c user.email=test@example.com \
    commit --quiet -m 'header-only native change'
expect_action cpu release 0 rebuild-cgo
expect_failure "header-only source drift cannot relabel the old libmo" \
    native begin "$repo" cpu release 0
clean_cgo
native begin "$repo" cpu release 0
produce_cgo_outputs
expect_failure "artifact hashing failure cannot publish a malformed stamp" \
    env PATH="$work/bin:$PATH" FAIL_NATIVE_ARTIFACT_HASH=1 \
    "$repo/cgo/mo-native-provenance" record "$repo" cpu release 0
expect_failure "failed artifact hashing leaves the generation incomplete" \
    native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu release 0
expect_action cpu release 0 rebuild-cgo
clean_cgo
finish_build cpu release 0
native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu release 0
echo "ok   header-only drift requires and records a CGo rebuild"

expect_action cpu debug 0 rebuild-cgo
clean_cgo
finish_build cpu debug 0
native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu debug 0
echo "ok   release/debug switching cannot reuse the previous objects"

# SIMSIMD changes the usearch CMake flags and therefore the thirdparty artifact
# set. It is a full-generation input, not a cosmetic environment variable.
expect_action cpu debug 1 rebuild-all
clean_all
finish_build cpu debug 1
native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu debug 1
echo "ok   SIMSIMD switching cannot reuse thirdparty artifacts"

custom_action=$(CC=alternate-cc native prepare "$repo" cpu debug 1)
if [ "$custom_action" = rebuild-all ]; then
    echo "ok   a custom native toolchain profile cannot alias default artifacts"
else
    printf 'FAIL custom toolchain expected rebuild-all, got %s\n' "$custom_action"
    failures=$((failures + 1))
fi
clean_all
CC=alternate-cc native begin "$repo" cpu debug 1
produce_outputs
CC=alternate-cc native record "$repo" cpu debug 1
unset CC
expect_action cpu debug 1 rebuild-all
clean_all
finish_build cpu debug 1
echo "ok   returning to the default toolchain rebuilds one complete generation"

gpu_action=$(CONDA_PREFIX="$work/gpu-a" native prepare "$repo" gpu debug 1)
if [ "$gpu_action" = rebuild-cgo ]; then
    echo "ok   CPU/GPU switching preserves compatible thirdparties"
else
    printf 'FAIL CPU/GPU switch expected rebuild-cgo, got %s\n' "$gpu_action"
    failures=$((failures + 1))
fi
clean_cgo
(CONDA_PREFIX="$work/gpu-a" native begin "$repo" gpu debug 1)
produce_outputs
(CONDA_PREFIX="$work/gpu-a" native record "$repo" gpu debug 1)

gpu_environment_action=$(CONDA_PREFIX="$work/gpu-b" \
    native prepare "$repo" gpu debug 1)
if [ "$gpu_environment_action" = rebuild-cgo ]; then
    echo "ok   GPU environment switching rebuilds CGo but not thirdparties"
else
    printf 'FAIL GPU environment switch expected rebuild-cgo, got %s\n' \
        "$gpu_environment_action"
    failures=$((failures + 1))
fi
clean_cgo
(CONDA_PREFIX="$work/gpu-b" native begin "$repo" gpu debug 1)
produce_outputs
(CONDA_PREFIX="$work/gpu-b" native record "$repo" gpu debug 1)

gpu_cuvs_flags_action=$(CONDA_PREFIX="$work/gpu-b" \
    NVCC_FLAGS=-DPROFILE_B native prepare "$repo" gpu debug 1)
if [ "$gpu_cuvs_flags_action" = rebuild-cgo ]; then
    echo "ok   cuVS NVCC_FLAGS switching invalidates the GPU generation"
else
    printf 'FAIL cuVS NVCC_FLAGS expected rebuild-cgo, got %s\n' \
        "$gpu_cuvs_flags_action"
    failures=$((failures + 1))
fi
clean_cgo
(CONDA_PREFIX="$work/gpu-b" NVCC_FLAGS=-DPROFILE_B \
    native begin "$repo" gpu debug 1)
produce_outputs
(CONDA_PREFIX="$work/gpu-b" NVCC_FLAGS=-DPROFILE_B \
    native record "$repo" gpu debug 1)

gpu_cuvs_flags_control=$(CONDA_PREFIX="$work/gpu-b" \
    NVCC_FLAGS=-DPROFILE_B native prepare "$repo" gpu debug 1)
if [ "$gpu_cuvs_flags_control" = reuse ]; then
    echo "ok   an unchanged cuVS compiler profile remains reusable"
else
    printf 'FAIL unchanged cuVS profile expected reuse, got %s\n' \
        "$gpu_cuvs_flags_control"
    failures=$((failures + 1))
fi
(CONDA_PREFIX="$work/gpu-b" NVCC_FLAGS=-DPROFILE_B \
    native begin "$repo" gpu debug 1)
(CONDA_PREFIX="$work/gpu-b" NVCC_FLAGS=-DPROFILE_B \
    native record "$repo" gpu debug 1)

printf 'new thirdparty source\n' >>"$repo/thirdparties/source.txt"
git -C "$repo" add thirdparties/source.txt
git -C "$repo" -c user.name=test -c user.email=test@example.com \
    commit --quiet -m 'thirdparty source change'
expect_action cpu debug 1 rebuild-all
clean_all
finish_build cpu debug 1
echo "ok   thirdparty drift requires a full native rebuild"

printf '#define VALUE 3\n' >"$repo/cgo/native.h"
git -C "$repo" add cgo/native.h
git -C "$repo" -c user.name=test -c user.email=test@example.com \
    commit --quiet -m 'second header-only change'
expect_action cpu debug 1 rebuild-cgo
clean_cgo
native begin "$repo" cpu debug 1
expect_failure "an interrupted build generation is rejected" \
    native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu debug 1
expect_action cpu debug 1 rebuild-cgo
clean_cgo
finish_build cpu debug 1
echo "ok   partial failure retains the narrow rebuild requirement"

printf 'dirty edit\n' >>"$repo/cgo/native.c"
expect_action cpu debug 1 rebuild-cgo
clean_cgo
finish_build cpu debug 1
expect_failure "dirty native builds remain local-only" \
    native verify "$repo" "$repo/cgo/libmo.dylib" darwin amd64 cpu debug 1

if [ "$failures" -ne 0 ]; then
    printf '\n%d check(s) failed\n' "$failures"
    exit 1
fi
printf '\nall checks passed\n'
