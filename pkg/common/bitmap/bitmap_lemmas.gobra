// Ghost definitions and lemmas for the Gobra proof of bitmap.go. Go ignores
// .gobra files. Every lemma here is proven (none is trusted); the only trusted
// facts are the bit-operation axioms in gobra/stubs/math/bits.
package bitmap

import "math/bits"

// SumPc is the number of set bits in the first m words of s.
ghost
requires 0 <= m && m <= len(s)
decreases m
pure func SumPc(s seq[uint64], m int) int {
	return m == 0 ? 0 : SumPc(s, m-1) + bits.Pc(s[m-1])
}

// TailClear holds when no bit at or beyond nb is set in s.
ghost
decreases
pure func TailClear(s seq[uint64], nb int64) bool {
	return nb%64 == 0 || len(s) == 0 ||
		forall k int :: {bits.Bit(s[len(s)-1], k)} int(nb%64) <= k && k < 64 ==> !bits.Bit(s[len(s)-1], k)
}

// Changing word i changes the sum by the difference of its bit counts.
ghost
requires 0 <= i && i < len(s) && 0 <= m && m <= len(s)
ensures SumPc(s[i = v], m) == (i < m ? SumPc(s, m) - bits.Pc(s[i]) + bits.Pc(v) : SumPc(s, m))
decreases m
func sumUpdate(s seq[uint64], i int, v uint64, m int) {
	if m > 0 {
		sumUpdate(s, i, v, m-1)
	}
}

ghost
requires 0 <= m && m <= len(s)
requires forall i int :: {s[i]} 0 <= i && i < m ==> s[i] == 0
ensures SumPc(s, m) == 0
decreases m
func sumZero(s seq[uint64], m int) {
	if m > 0 {
		pcZero(64)
		sumZero(s, m-1)
	}
}

ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(0, k) == 0
decreases k
func pcZero(k int) {
	if k > 0 {
		pcZero(k - 1)
	}
}

// Pc(a | b) == Pc(a) + Pc(b &^ a)
ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(a|b, k) == bits.PcUpTo(a, k)+bits.PcUpTo(b&^a, k)
decreases k
func pcOr(a, b uint64, k int) {
	if k > 0 {
		pcOr(a, b, k-1)
	}
}

// Pc(a) == Pc(a & b) + Pc(a &^ b)
ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(a, k) == bits.PcUpTo(a&b, k)+bits.PcUpTo(a&^b, k)
decreases k
func pcSplit(a, b uint64, k int) {
	if k > 0 {
		pcSplit(a, b, k-1)
	}
}

// Pc(a & ^b) == Pc(a &^ b)
ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(a & ^b, k) == bits.PcUpTo(a&^b, k)
decreases k
func pcAndNot(a, b uint64, k int) {
	if k > 0 {
		pcAndNot(a, b, k-1)
	}
}

// Pc(^a) == Pc(^0 &^ a)
ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(^a, k) == bits.PcUpTo(^uint64(0)&^a, k)
decreases k
func pcNot(a uint64, k int) {
	if k > 0 {
		pcNot(a, k-1)
	}
}

// Setting or clearing a single bit changes the count by at most one.
ghost
requires 0 <= s && s < 64 && 0 <= k && k <= 64
ensures bits.PcUpTo((uint64(1)<<s)&^w, k) == ((int(s) < k && !bits.Bit(w, int(s))) ? 1 : 0)
ensures bits.PcUpTo(w&(uint64(1)<<s), k) == ((int(s) < k && bits.Bit(w, int(s))) ? 1 : 0)
decreases k
func pcBit(w uint64, s uint64, k int) {
	if k > 0 {
		pcBit(w, s, k-1)
	}
}

// w & (1<<s) == 0 exactly when bit s of w is clear.
ghost
requires 0 <= s && s < 64
ensures (w&(uint64(1)<<s) == 0) == !bits.Bit(w, int(s))
decreases
func testBit(w uint64, s uint64) {
	m := uint64(1) << s
	if w&m != 0 {
		k := bits.SomeBit(w & m)
		assert bits.Bit(w&m, k)
	} else {
		assert !bits.Bit(w&m, int(s))
	}
}

// A word is nonzero exactly when it has a set bit.
ghost
ensures (w != 0) == (exists k int :: {bits.Bit(w, k)} 0 <= k && k < 64 && bits.Bit(w, k))
decreases
func nonZero(w uint64) {
	if w != 0 {
		k := bits.SomeBit(w)
		assert bits.Bit(w, k)
	}
}

// Sums over equal prefixes are equal.
ghost
requires 0 <= m && m <= len(s) && m <= len(t)
requires forall i int :: {s[i]} {t[i]} 0 <= i && i < m ==> s[i] == t[i]
ensures SumPc(s, m) == SumPc(t, m)
decreases m
func sumPrefix(s, t seq[uint64], m int) {
	if m > 0 {
		sumPrefix(s, t, m-1)
	}
}

// Zero words add nothing to the sum.
ghost
requires 0 <= m && m <= k && k <= len(s)
requires forall i int :: {s[i]} m <= i && i < k ==> s[i] == 0
ensures SumPc(s, k) == SumPc(s, m)
decreases k - m
func sumZeroTail(s seq[uint64], m, k int) {
	if k > m {
		pcZero(64)
		sumZeroTail(s, m, k-1)
	}
}

// HasS reports whether row r is set in the words s of an nb-bit bitmap.
ghost
decreases
pure func HasS(s seq[uint64], nb int64, r int) bool {
	return 0 <= r && r < int(nb) && r/64 < len(s) && bits.Bit(s[r/64], r%64)
}

// CntS is the number of set rows below m.
ghost
requires 0 <= m
ensures 0 <= res && res <= m
decreases m
pure func CntS(s seq[uint64], nb int64, m int) (res int) {
	return m == 0 ? 0 : CntS(s, nb, m-1) + (HasS(s, nb, m-1) ? 1 : 0)
}

// Rows of word j up to bit k count as the word's bits.
ghost
requires 0 <= nb && len(s) == int((nb+63)/64) && TailClear(s, nb)
requires 0 <= j && j < len(s) && 0 <= k && k <= 64
requires CntS(s, nb, 64*j) == SumPc(s, j)
ensures CntS(s, nb, 64*j+k) == SumPc(s, j)+bits.PcUpTo(s[j], k)
decreases k
func cntWord(s seq[uint64], nb int64, j int, k int) {
	if k > 0 {
		cntWord(s, nb, j, k-1)
		r := 64*j + k - 1
		assert r/64 == j && r%64 == k-1
		if r >= int(nb) {
			assert j == len(s)-1 && nb%64 != 0 && k-1 >= int(nb%64)
			assert !bits.Bit(s[len(s)-1], k-1)
		}
		assert HasS(s, nb, r) == bits.Bit(s[j], k-1)
	}
}

// The first 64*j rows count as the first j words.
ghost
requires 0 <= nb && len(s) == int((nb+63)/64) && TailClear(s, nb)
requires 0 <= j && j <= len(s)
ensures CntS(s, nb, 64*j) == SumPc(s, j)
decreases j
func cntWords(s seq[uint64], nb int64, j int) {
	if j > 0 {
		cntWords(s, nb, j-1)
		cntWord(s, nb, j-1, 64)
	}
}

// Rows at or beyond nb are never set.
ghost
requires 0 <= nb && int(nb) <= m
ensures CntS(s, nb, m) == CntS(s, nb, int(nb))
decreases m - int(nb)
func cntBeyond(s seq[uint64], nb int64, m int) {
	if m > int(nb) {
		cntBeyond(s, nb, m-1)
	}
}

// No set row below m exactly when the count is zero.
ghost
requires 0 <= m
ensures CntS(s, nb, m) >= 0
ensures (CntS(s, nb, m) == 0) == (forall r int :: {HasS(s, nb, r)} 0 <= r && r < m ==> !HasS(s, nb, r))
decreases m
func cntZero(s seq[uint64], nb int64, m int) {
	if m > 0 {
		cntZero(s, nb, m-1)
	}
}

// SortedRows holds when sels is strictly increasing and non-negative.
ghost
decreases
pure func SortedRows(sels seq[int64]) bool {
	return (forall a int :: {sels[a]} 0 <= a && a < len(sels) ==> 0 <= sels[a]) &&
		(forall a, b int :: {sels[a], sels[b]} 0 <= a && a < b && b < len(sels) ==> sels[a] < sels[b])
}

// RankUpTo is the number of the first m entries of sels below x.
ghost
requires 0 <= m && m <= len(sels)
decreases m
pure func RankUpTo(sels seq[int64], m int, x int64) int {
	return m == 0 ? 0 : RankUpTo(sels, m-1, x) + (sels[m-1] < x ? 1 : 0)
}

// Rank is the number of entries of sels below x.
ghost
decreases
pure func Rank(sels seq[int64], x int64) int {
	return RankUpTo(sels, len(sels), x)
}

// A sorted selection has sels[i] >= i.
ghost
requires SortedRows(sels) && 0 <= m && m <= len(sels)
ensures forall i int :: {sels[i]} 0 <= i && i < m ==> sels[i] >= int64(i)
decreases m
func selsAtLeastIndex(sels seq[int64], m int) {
	if m > 0 {
		selsAtLeastIndex(sels, m-1)
		if m > 1 {
			assert sels[m-2] < sels[m-1]
		}
	}
}

// If exactly the entries before idx are below x, the rank of x is idx.
ghost
requires 0 <= idx && idx <= len(sels) && 0 <= m && m <= len(sels)
requires forall j int :: {sels[j]} 0 <= j && j < idx ==> sels[j] < x
requires forall j int :: {sels[j]} idx <= j && j < len(sels) ==> sels[j] >= x
ensures RankUpTo(sels, m, x) == (m < idx ? m : idx)
decreases m
func RankAt(sels seq[int64], m int, x int64, idx int) {
	if m > 0 {
		RankAt(sels, m-1, x, idx)
	}
}

// Counting the bits of w inside a mask that keeps exactly bits [a, b).
ghost
requires 0 <= a && a <= b && b <= 64 && 0 <= k && k <= 64
requires forall j int :: {bits.Bit(m, j)} 0 <= j && j < 64 ==> bits.Bit(m, j) == (a <= j && j < b)
ensures bits.PcUpTo(w&m, k) == bits.PcUpTo(w, k < b ? k : b)-bits.PcUpTo(w, k < a ? k : a)
decreases k
func pcMask(w, m uint64, a, b, k int) {
	if k > 0 {
		pcMask(w, m, a, b, k-1)
	}
}

// Every word boundary splits the row count like the word sums.
ghost
requires 0 <= nb && len(s) == int((nb+63)/64) && TailClear(s, nb)
requires 0 <= m && m <= len(s)
ensures forall j int :: {SumPc(s, j)} 0 <= j && j <= m ==> CntS(s, nb, 64*j) == SumPc(s, j)
decreases m
func cntAllWords(s seq[uint64], nb int64, m int) {
	if m > 0 {
		cntAllWords(s, nb, m-1)
		cntWord(s, nb, m-1, 64)
	}
}

// Same words with the same word count mean the same rows, whatever the bit
// lengths: rows between the two lengths are tail bits, which are clear.
ghost
requires 0 <= nb1 && 0 <= nb2 && len(s) == int((nb1+63)/64) && len(s) == int((nb2+63)/64)
requires TailClear(s, nb1) && TailClear(s, nb2)
ensures forall r int :: {HasS(s, nb1, r)} {HasS(s, nb2, r)} HasS(s, nb1, r) == HasS(s, nb2, r)
decreases
func sameWordsSameRows(s seq[uint64], nb1, nb2 int64) {
	assert forall r int :: {HasS(s, nb1, r)} {HasS(s, nb2, r)} 0 <= r && int(nb1) <= r && r < int(nb2) ==>
		r/64 == len(s)-1 && nb1%64 != 0 && r%64 >= int(nb1%64)
	assert forall r int :: {HasS(s, nb1, r)} {HasS(s, nb2, r)} 0 <= r && int(nb2) <= r && r < int(nb1) ==>
		r/64 == len(s)-1 && nb2%64 != 0 && r%64 >= int(nb2%64)
	assert forall r int :: {HasS(s, nb1, r)} {HasS(s, nb2, r)} 0 <= r && int(nb1) <= r && r < int(nb2) ==>
		!bits.Bit(s[len(s)-1], r%64) && !HasS(s, nb2, r)
	assert forall r int :: {HasS(s, nb1, r)} {HasS(s, nb2, r)} 0 <= r && int(nb2) <= r && r < int(nb1) ==>
		!bits.Bit(s[len(s)-1], r%64) && !HasS(s, nb1, r)
}

// The number of set rows below m is between 0 and m, and grows with m.
ghost
requires 0 <= a && a <= b
ensures 0 <= CntS(s, nb, a) && CntS(s, nb, a) <= CntS(s, nb, b) && CntS(s, nb, b)-CntS(s, nb, a) <= b-a
ensures CntS(s, nb, a) <= a
decreases b
func cntMono(s seq[uint64], nb int64, a, b int) {
	if b > a {
		cntMono(s, nb, a, b-1)
	} else {
		cntLe(s, nb, a)
	}
}

// The number of set rows below m is between 0 and m.
ghost
requires 0 <= m
ensures 0 <= CntS(s, nb, m) && CntS(s, nb, m) <= m
decreases m
func cntLe(s seq[uint64], nb int64, m int) {
	if m > 0 {
		cntLe(s, nb, m-1)
	}
}

// A set row a followed by unset rows up to b adds exactly one.
ghost
requires 0 <= a && a < b && HasS(s, nb, a)
requires forall r int :: {HasS(s, nb, r)} a < r && r < b ==> !HasS(s, nb, r)
ensures CntS(s, nb, b) == CntS(s, nb, a)+1
decreases b
func cntStep(s seq[uint64], nb int64, a, b int) {
	if b > a+1 {
		cntStep(s, nb, a, b-1)
	}
}

// An equal count at a and b means no set row in [a, b).
ghost
requires 0 <= a && a <= b && CntS(s, nb, a) == CntS(s, nb, b)
ensures forall r int :: {HasS(s, nb, r)} a <= r && r < b ==> !HasS(s, nb, r)
decreases b
func cntFlat(s seq[uint64], nb int64, a, b int) {
	if b > a {
		cntMono(s, nb, a, b-1)
		cntFlat(s, nb, a, b-1)
	}
}

// RankOff is the number of rows r + off below s, for set rows r.
ghost
requires 0 <= off
decreases
pure func RankOff(s seq[uint64], nb int64, off int, x int) int {
	return x >= off ? CntS(s, nb, x-off) : 0
}

// The count of set rows is monotonic over [0, m].
ghost
requires 0 <= m
ensures forall a, b int :: {CntS(s, nb, a), CntS(s, nb, b)} 0 <= a && a <= b && b <= m ==> CntS(s, nb, a) <= CntS(s, nb, b)
decreases m
func cntMonoAll(s seq[uint64], nb int64, m int) {
	if m > 0 {
		cntMonoAll(s, nb, m-1)
	}
}

// Distinct set rows have distinct counts below them.
ghost
requires 0 <= a && HasS(s, nb, a) && 0 <= nb
ensures forall r int :: {HasS(s, nb, r)} HasS(s, nb, r) && CntS(s, nb, r) == CntS(s, nb, a) ==> r == a
decreases
func cntInjS(s seq[uint64], nb int64, a int) {
	cntMonoAll(s, nb, int(nb))
	assert forall r int :: {HasS(s, nb, r)} HasS(s, nb, r) && r < a ==> CntS(s, nb, r+1) == CntS(s, nb, r)+1 && CntS(s, nb, r+1) <= CntS(s, nb, a)
	assert forall r int :: {HasS(s, nb, r)} HasS(s, nb, r) && a < r ==> CntS(s, nb, a+1) == CntS(s, nb, a)+1 && CntS(s, nb, a+1) <= CntS(s, nb, r)
}

// InRowsU holds when r is one of the first m entries of s.
ghost
requires 0 <= m && m <= len(s)
decreases m
pure func InRowsU(s seq[uint64], m int, r int) bool {
	return m > 0 && (int(s[m-1]) == r || InRowsU(s, m-1, r))
}

// OutB is bit p of an output stream written in place: whole words in s
// below word, then the pending bits in pend.
ghost
requires 0 <= word && word <= len(s) && 0 <= p
decreases
pure func OutB(s seq[uint64], pend uint64, word int, p int) bool {
	return p < 64*word ? bits.Bit(s[p/64], p%64) : bits.Bit(pend, p-64*word)
}

// All 64 bits of ^0 are set.
ghost
requires 0 <= k && k <= 64
ensures bits.PcUpTo(^uint64(0), k) == k
decreases k
func pcOnes(k int) {
	if k > 0 {
		pcOnes(k - 1)
	}
}

// PcUpTo is monotonic, at most its bound, and steps by one at each set bit.
ghost
requires 0 <= m && m <= 64
ensures forall a, b int :: {bits.PcUpTo(w, a), bits.PcUpTo(w, b)} 0 <= a && a <= b && b <= m ==> bits.PcUpTo(w, a) <= bits.PcUpTo(w, b)
ensures forall a int :: {bits.PcUpTo(w, a)} 0 <= a && a <= m ==> 0 <= bits.PcUpTo(w, a) && bits.PcUpTo(w, a) <= a
decreases m
func pcMonoAll(w uint64, m int) {
	if m > 0 {
		pcMonoAll(w, m-1)
	}
}

// The popcount of the bits of w below t is PcUpTo(w, t).
ghost
requires 0 <= t && t < 64
ensures bits.Pc(w&(^uint64(0)>>(64-uint64(t)))) == bits.PcUpTo(w, t)
decreases
func pcLow(w uint64, t int) {
	assert forall j int :: {bits.Bit(^uint64(0)>>(64-uint64(t)), j)} 0 <= j && j < 64 ==> bits.Bit(^uint64(0)>>(64-uint64(t)), j) == (j < t)
	pcMask(w, ^uint64(0)>>(64-uint64(t)), 0, t, 64)
}

// Strictly increasing entries grow by at least their index distance.
ghost
requires SortedRows(sels) && 0 <= m && m <= len(sels)
ensures forall i, j int :: {sels[i], sels[j]} 0 <= i && i <= j && j < m ==> sels[j]-sels[i] >= int64(j-i)
decreases m
func selsGap(sels seq[int64], m int) {
	if m > 1 {
		selsGap(sels, m-1)
		assert forall i int :: {sels[i]} 0 <= i && i < m-1 ==> sels[m-1]-sels[i] >= (sels[m-2]-sels[i])+1
	}
}

// Quantified form of pcOnes.
ghost
requires 0 <= m && m <= 64
ensures forall k int :: {bits.PcUpTo(^uint64(0), k)} 0 <= k && k <= m ==> bits.PcUpTo(^uint64(0), k) == k
decreases m
func pcOnesAll(m int) {
	if m > 0 {
		pcOnesAll(m - 1)
		pcOnes(m)
	}
}

// Setting a clear bit v adds one to the counts above v.
ghost
requires 0 <= v && v < 64 && !bits.Bit(rm, v) && 0 <= m && m <= 64
ensures forall k int :: {bits.PcUpTo(rm|(uint64(1)<<uint64(v)), k)} 0 <= k && k <= m ==>
	bits.PcUpTo(rm|(uint64(1)<<uint64(v)), k) == bits.PcUpTo(rm, k)+(v < k ? 1 : 0)
decreases m
func pcAddBitAll(rm uint64, v int, m int) {
	if m > 0 {
		pcAddBitAll(rm, v, m-1)
	}
	pcOr(rm, uint64(1)<<uint64(v), m)
	pcBit(rm, uint64(v), m)
}

// keep is the complement of rm below V and clear from V up.
ghost
requires 0 <= V && V <= 64 && 0 <= m && m <= 64
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 ==> bits.Bit(keep, b) == (b < V && !bits.Bit(rm, b))
ensures forall b int :: {bits.PcUpTo(keep, b)} 0 <= b && b <= m ==>
	bits.PcUpTo(keep, b) == (b <= V ? b-bits.PcUpTo(rm, b) : V-bits.PcUpTo(rm, V))
decreases m
func pcKeep(rm, keep uint64, V int, m int) {
	if m > 0 {
		pcKeep(rm, keep, V, m-1)
	}
}

// If the first m entries are below lo, each counts below every x >= lo.
ghost
requires 0 <= m && m <= len(sels)
requires forall j int :: {sels[j]} 0 <= j && j < m ==> sels[j] < lo
ensures forall x int64 :: {RankUpTo(sels, m, x)} x >= lo ==> RankUpTo(sels, m, x) == m
decreases m
func rankPrefix(sels seq[int64], m int, lo int64) {
	if m > 0 {
		rankPrefix(sels, m-1, lo)
	}
}

// Entries from m to k at or above hi count below no x <= hi.
ghost
requires 0 <= m && m <= k && k <= len(sels)
requires forall j int :: {sels[j]} m <= j && j < k ==> sels[j] >= hi
ensures forall x int64 :: {RankUpTo(sels, k, x)} x <= hi ==> RankUpTo(sels, k, x) == RankUpTo(sels, m, x)
decreases k - m
func rankTail(sels seq[int64], m, k int, hi int64) {
	if k > m {
		rankTail(sels, m, k-1, hi)
	}
}

// A run of entries base, base+1, ... counts like the integers.
ghost
requires 0 <= i0 && 0 <= m && i0+m <= len(sels)
requires forall j int :: {sels[j]} i0 <= j && j < i0+m ==> sels[j] == base+int64(j-i0)
ensures forall x int64 :: {RankUpTo(sels, i0+m, x)} base <= x ==>
	RankUpTo(sels, i0+m, x) == RankUpTo(sels, i0, x)+(x-base < int64(m) ? int(x-base) : m)
decreases m
func rankRun(sels seq[int64], i0, m int, base int64) {
	if m > 0 {
		rankRun(sels, i0, m-1, base)
	}
}

// Quantified form of cntWord.
ghost
requires 0 <= nb && len(s) == int((nb+63)/64) && TailClear(s, nb)
requires 0 <= j && j < len(s) && 0 <= m && m <= 64
requires CntS(s, nb, 64*j) == SumPc(s, j)
ensures forall k int :: {bits.PcUpTo(s[j], k)} 0 <= k && k <= m ==> CntS(s, nb, 64*j+k) == SumPc(s, j)+bits.PcUpTo(s[j], k)
decreases m
func cntWordAll(s seq[uint64], nb int64, j int, m int) {
	if m > 0 {
		cntWordAll(s, nb, j, m-1)
	}
	cntWord(s, nb, j, m)
}

// The rows of word x0/64 removed by an offset selection bitmap: if bit b of
// rm says whether row x0+b is removed, RankOff grows by rm's counts.
ghost
requires 0 <= off && 0 <= x0 && 0 <= m && m <= 64
requires forall b int :: {bits.Bit(rm, b)} 0 <= b && b < 64 ==> bits.Bit(rm, b) == (x0+b >= off && HasS(s, nb, x0+b-off))
ensures forall b int :: {bits.PcUpTo(rm, b)} 0 <= b && b <= m ==> RankOff(s, nb, off, x0+b) == RankOff(s, nb, off, x0)+bits.PcUpTo(rm, b)
decreases m
func rankOffWord(s seq[uint64], nb int64, off int, x0 int, rm uint64, m int) {
	if m > 0 {
		rankOffWord(s, nb, off, x0, rm, m-1)
		assert RankOff(s, nb, off, x0+m) == RankOff(s, nb, off, x0+m-1)+((x0+m-1 >= off && HasS(s, nb, x0+m-1-off)) ? 1 : 0)
	}
}

// A count of set rows never exceeds the row bound.
ghost
requires 0 <= m && m <= len(s)
ensures 0 <= SumPc(s, m) && SumPc(s, m) <= 64*m
decreases m
func sumPcBound(s seq[uint64], m int) {
	if m > 0 {
		sumPcBound(s, m-1)
		pcMonoAll(s[m-1], 64)
	}
}

// Quantified form of pcZero.
ghost
requires 0 <= m && m <= 64
ensures forall k int :: {bits.PcUpTo(0, k)} 0 <= k && k <= m ==> bits.PcUpTo(0, k) == 0
decreases m
func pcZeroAll(m int) {
	if m > 0 {
		pcZeroAll(m - 1)
	}
}

// One word of an ordered remove: the rows of word w that sels keeps land at
// their final positions. pos0/pos1 are the stream lengths before and after
// the word; d0, d1 and friends are the output stream states (see OutB).
ghost
requires 0 <= w && w < len(orig) && 0 < V && V <= 64 && 64*w+V <= int(oldLength) && 64*w+V <= 64*len(orig) && e0 == 64*w && e1 == 64*w+V
requires forall b int :: {bits.PcUpTo(rm, b)} 0 <= b && b <= 64 ==> Rank(ss, int64(64*w+b)) == i0+bits.PcUpTo(rm, b)
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 ==> bits.Bit(keep, b) == (b < V && !bits.Bit(rm, b))
requires forall b int :: {bits.PcUpTo(keep, b)} 0 <= b && b <= 64 ==> bits.PcUpTo(keep, b) == (b <= V ? b-bits.PcUpTo(rm, b) : V-bits.PcUpTo(rm, V))
requires src == orig[w]
requires 0 <= o0 && o0 <= len(d0) && 0 <= o1 && o1 <= len(d1)
requires 0 <= pos0 && pos0 == 64*w-i0 && pos1 == pos0+bits.PcUpTo(keep, 64)
requires forall p int :: {OutB(d1, p1, o1, p)} 0 <= p && p < pos0 ==> OutB(d1, p1, o1, p) == OutB(d0, p0, o0, p)
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 && bits.Bit(keep, b) ==>
	0 <= bits.PcUpTo(keep, b) && bits.PcUpTo(keep, b) < bits.PcUpTo(keep, 64) &&
	OutB(d1, p1, o1, pos0+bits.PcUpTo(keep, b)) == bits.Bit(src, b)
requires RemoveRel(ss, orig, oldLength, e0, d0, p0, o0, pos0)
ensures pos1 == e1-Rank(ss, int64(e1))
ensures forall s int :: {HasS(orig, oldLength, s)} 0 <= s && s < e1 && Rank(ss, int64(s+1)) == Rank(ss, int64(s)) ==>
	0 <= s-Rank(ss, int64(s)) && s-Rank(ss, int64(s)) < pos1 &&
	OutB(d1, p1, o1, s-Rank(ss, int64(s))) == HasS(orig, oldLength, s)
ensures 0 <= o1 && o1 <= len(d1) && RemoveRel(ss, orig, oldLength, e1, d1, p1, o1, pos1)
decreases
func removeStepRank(ss seq[int64], orig seq[uint64], oldLength int64, w int, V int, i0 int, rm, keep, src uint64, e0, e1 int,
	d0 seq[uint64], p0 uint64, o0 int, pos0 int, d1 seq[uint64], p1 uint64, o1 int, pos1 int) {
	pcMonoAll(keep, 64)
	assert forall b int :: {bits.PcUpTo(rm, b)} 0 <= b && b < 64 ==> bits.PcUpTo(rm, b+1) == bits.PcUpTo(rm, b)+(bits.Bit(rm, b) ? 1 : 0)
	assert bits.PcUpTo(rm, 0) == 0 && bits.PcUpTo(rm, V) == bits.PcUpTo(rm, V)
	// Rows of earlier words keep their output bits.
	assert forall s int :: {HasS(orig, oldLength, s)} 0 <= s && s < e0 && Rank(ss, int64(s+1)) == Rank(ss, int64(s)) ==>
		0 <= s-Rank(ss, int64(s)) && s-Rank(ss, int64(s)) < pos1 &&
		OutB(d0, p0, o0, s-Rank(ss, int64(s))) == HasS(orig, oldLength, s) &&
		OutB(d1, p1, o1, s-Rank(ss, int64(s))) == HasS(orig, oldLength, s)
	// Rows of word w: a kept row is a set bit of keep and lands at its rank in keep.
	assert forall s int :: {HasS(orig, oldLength, s)} e0 <= s && s < e1 ==>
		s/64 == w && s%64 == s-64*w && HasS(orig, oldLength, s) == bits.Bit(orig[w], s-64*w) &&
		Rank(ss, int64(s)) == i0+bits.PcUpTo(rm, s-64*w) && Rank(ss, int64(s+1)) == i0+bits.PcUpTo(rm, s-64*w+1)
	assert forall s int :: {HasS(orig, oldLength, s)} e0 <= s && s < e1 && Rank(ss, int64(s+1)) == Rank(ss, int64(s)) ==>
		bits.Bit(keep, s-64*w) && s-Rank(ss, int64(s)) == pos0+bits.PcUpTo(keep, s-64*w) &&
		0 <= s-Rank(ss, int64(s)) && s-Rank(ss, int64(s)) < pos1 &&
		OutB(d1, p1, o1, s-Rank(ss, int64(s))) == HasS(orig, oldLength, s)
}

// A rank is between zero and the number of entries counted.
ghost
requires 0 <= m && m <= len(sels)
ensures 0 <= RankUpTo(sels, m, x) && RankUpTo(sels, m, x) <= m
decreases m
func rankBounds(sels seq[int64], m int, x int64) {
	if m > 0 {
		rankBounds(sels, m-1, x)
	}
}

// One word of a mask select: the set rows of sels in word ws land at their
// counts. top bounds the source bits that can be set (see appendKept).
ghost
requires 0 <= ws && ws < len(sq) && 0 <= off && 0 <= pos0 && pos0 <= 64*ws && 0 <= oldLength
requires forall k int :: {bits.PcUpTo(keep, k)} 0 <= k && k <= 64 ==> CntS(sq, snb, 64*ws+k) == pos0+bits.PcUpTo(keep, k)
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 ==> HasS(sq, snb, 64*ws+b) == bits.Bit(keep, b)
requires forall b int :: {bits.Bit(src, b)} 0 <= b && b < 64 ==> bits.Bit(src, b) == HasS(orig, oldLength, 64*ws+off+b)
requires 0 <= o0 && o0 <= len(d0) && 0 <= o1 && o1 <= len(d1)
requires pos1 == pos0+bits.PcUpTo(keep, 64)
requires forall p int :: {OutB(d1, p1, o1, p)} 0 <= p && p < pos0 ==> OutB(d1, p1, o1, p) == OutB(d0, p0, o0, p)
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 && bits.Bit(keep, b) ==>
	0 <= bits.PcUpTo(keep, b) && bits.PcUpTo(keep, b) < bits.PcUpTo(keep, 64) &&
	OutB(d1, p1, o1, pos0+bits.PcUpTo(keep, b)) == bits.Bit(src, b)
requires forall r int :: {HasS(sq, snb, r)} 0 <= r && r < 64*ws && HasS(sq, snb, r) ==>
	0 <= CntS(sq, snb, r) && CntS(sq, snb, r) < pos0 && OutB(d0, p0, o0, CntS(sq, snb, r)) == HasS(orig, oldLength, r+off)
ensures forall r int :: {HasS(sq, snb, r)} 0 <= r && r < 64*ws+64 && HasS(sq, snb, r) ==>
	0 <= CntS(sq, snb, r) && CntS(sq, snb, r) < pos1 && OutB(d1, p1, o1, CntS(sq, snb, r)) == HasS(orig, oldLength, r+off)
decreases
func selectMaskStep(sq seq[uint64], snb int64, orig seq[uint64], oldLength int64, off int, ws int, keep, src uint64,
	d0 seq[uint64], p0 uint64, o0 int, pos0 int, d1 seq[uint64], p1 uint64, o1 int, pos1 int) {
	pcMonoAll(keep, 64)
	assert forall r int :: {HasS(sq, snb, r)} 0 <= r && r < 64*ws && HasS(sq, snb, r) ==>
		0 <= CntS(sq, snb, r) && CntS(sq, snb, r) < pos0 && pos0 <= pos1 &&
		OutB(d0, p0, o0, CntS(sq, snb, r)) == HasS(orig, oldLength, r+off) &&
		OutB(d1, p1, o1, CntS(sq, snb, r)) == HasS(orig, oldLength, r+off)
	assert forall r int :: {HasS(sq, snb, r)} 64*ws <= r && r < 64*ws+64 ==>
		r-64*ws >= 0 && r-64*ws < 64 && r == 64*ws+(r-64*ws) &&
		HasS(sq, snb, r) == bits.Bit(keep, r-64*ws) && CntS(sq, snb, r) == pos0+bits.PcUpTo(keep, r-64*ws)
	assert forall r int :: {HasS(sq, snb, r)} 64*ws <= r && r < 64*ws+64 && HasS(sq, snb, r) ==>
		bits.Bit(keep, r-64*ws) && 0 <= CntS(sq, snb, r) && CntS(sq, snb, r) < pos1 &&
		OutB(d1, p1, o1, CntS(sq, snb, r)) == bits.Bit(src, r-64*ws) &&
		bits.Bit(src, r-64*ws) == HasS(orig, oldLength, r+off)
}

// One word of a mask remove: like removeStepRank, with the removed rows
// given by an offset selection bitmap and their count by RankOff.
// One word of a mask remove: like removeStepRank, with the removed rows
// given by an offset selection bitmap and their count by RankOff. Its
// pre- and postcondition are removeMask's loop invariant at word w and w+1,
// where e0 and e1 are min(64*w, Len) and min(64*(w+1), Len).
ghost
requires 0 <= off && 0 <= w && w < len(orig) && 64*w+V <= int(oldLength)
requires 0 < V && V <= 64 && e0 == 64*w && e1 == 64*w+V && 64*w+V <= 64*len(orig)
requires forall b int :: {bits.PcUpTo(rm, b)} 0 <= b && b <= 64 ==> RankOff(sq, snb, off, 64*w+b) == i0+bits.PcUpTo(rm, b)
requires forall b int :: {bits.Bit(rm, b)} 0 <= b && b < 64 ==> bits.Bit(rm, b) == (64*w+b >= off && HasS(sq, snb, 64*w+b-off))
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 ==> bits.Bit(keep, b) == (b < V && !bits.Bit(rm, b))
requires forall b int :: {bits.PcUpTo(keep, b)} 0 <= b && b <= 64 ==> bits.PcUpTo(keep, b) == (b <= V ? b-bits.PcUpTo(rm, b) : V-bits.PcUpTo(rm, V))
requires src == orig[w]
requires 0 <= o0 && o0 <= len(d0) && 0 <= o1 && o1 <= len(d1)
requires 0 <= pos0 && pos0 == 64*w-i0 && pos1 == pos0+bits.PcUpTo(keep, 64)
requires forall p int :: {OutB(d1, p1, o1, p)} 0 <= p && p < pos0 ==> OutB(d1, p1, o1, p) == OutB(d0, p0, o0, p)
requires forall b int :: {bits.Bit(keep, b)} 0 <= b && b < 64 && bits.Bit(keep, b) ==>
	0 <= bits.PcUpTo(keep, b) && bits.PcUpTo(keep, b) < bits.PcUpTo(keep, 64) &&
	OutB(d1, p1, o1, pos0+bits.PcUpTo(keep, b)) == bits.Bit(src, b)
requires RemoveMaskRel(sq, snb, off, orig, oldLength, e0, d0, p0, o0, pos0)
ensures pos1 == e1-RankOff(sq, snb, off, e1)
ensures forall s int :: {HasS(orig, oldLength, s)} 0 <= s && s < e1 && !(s >= off && HasS(sq, snb, s-off)) ==>
	0 <= s-RankOff(sq, snb, off, s) && s-RankOff(sq, snb, off, s) < pos1 &&
	OutB(d1, p1, o1, s-RankOff(sq, snb, off, s)) == HasS(orig, oldLength, s)
ensures RemoveMaskRel(sq, snb, off, orig, oldLength, e1, d1, p1, o1, pos1)
decreases
func removeStepOff(sq seq[uint64], snb int64, off int, orig seq[uint64], oldLength int64, e0, e1 int, w int, V int, i0 int, rm, keep, src uint64,
	d0 seq[uint64], p0 uint64, o0 int, pos0 int, d1 seq[uint64], p1 uint64, o1 int, pos1 int) {
	pcMonoAll(keep, 64)
	assert bits.PcUpTo(rm, 0) == 0
	assert forall s int :: {HasS(orig, oldLength, s)} 0 <= s && s < e0 && !(s >= off && HasS(sq, snb, s-off)) ==>
		0 <= s-RankOff(sq, snb, off, s) && s-RankOff(sq, snb, off, s) < pos1 &&
		OutB(d0, p0, o0, s-RankOff(sq, snb, off, s)) == HasS(orig, oldLength, s) &&
		OutB(d1, p1, o1, s-RankOff(sq, snb, off, s)) == HasS(orig, oldLength, s)
	assert forall s int :: {HasS(orig, oldLength, s)} e0 <= s && s < e1 ==>
		s/64 == w && s%64 == s-64*w && HasS(orig, oldLength, s) == bits.Bit(orig[w], s-64*w) &&
		RankOff(sq, snb, off, s) == i0+bits.PcUpTo(rm, s-64*w) &&
		bits.Bit(rm, s-64*w) == (s >= off && HasS(sq, snb, s-off))
	assert forall s int :: {HasS(orig, oldLength, s)} e0 <= s && s < e1 && !(s >= off && HasS(sq, snb, s-off)) ==>
		bits.Bit(keep, s-64*w) && s-RankOff(sq, snb, off, s) == pos0+bits.PcUpTo(keep, s-64*w) &&
		0 <= s-RankOff(sq, snb, off, s) && s-RankOff(sq, snb, off, s) < pos1 &&
		OutB(d1, p1, o1, s-RankOff(sq, snb, off, s)) == HasS(orig, oldLength, s)
}

