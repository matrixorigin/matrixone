	assert forall r int :: {HasS(sq, snb, r)} HasS(sq, snb, r) ==> 0 <= r && r < int(snb) && r < 64*len(sq)
	assert forall r int :: {HasS(sq, snb, r)} HasS(sq, snb, r) && 64*ws <= r ==> CntS(sq, snb, 64*ws) <= CntS(sq, snb, r)
