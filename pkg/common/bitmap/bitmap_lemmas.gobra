func chainOut(d0 seq[uint64], pe uint64, o int, d1, d2 seq[uint64], L int) {
}

// selectMaskPost turns selectMask's loop invariant and the final data words
// d4 into its postcondition: each selected row r with a count below L lands
// at row CntS(r) of d4.
ghost
requires 0 <= snb && len(sq) == int((snb+63)/64) && TailClear(sq, snb) && 0 <= ws && ws <= len(sq)
requires 0 <= out && out <= len(d2) && 0 <= L && L <= int(oldLength) && L <= 64*len(d4) && L <= pos
requires CntS(sq, snb, 64*ws) == pos
