// Gobra stub for pkg/common/mpool. The verified bitmap code only names the
// pool type; allocation and release go through the bitmap's trusted memory
// primitives (bitmap_mem.gobra), so no MPool method is declared here.
package mpool

type MPool struct {
	id int
}
